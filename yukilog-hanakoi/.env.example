# YukiLog 前端环境变量配置模板
# 复制此文件为 .env 并填写实际配置

# 后端 API 地址（SSR 服务端渲染时使用，内网地址）
# 用于前端服务器直接调用后端 API，无需通过公网
PUBLIC_API_URL=http://localhost:3639

# 网站公网地址（浏览器端使用）
# 用于浏览器中的 API 请求，会通过 nginx 代理到后端
PUBLIC_SITE_URL=https://blog.yeastar.xin

# 🔧 开发模式配置
# 设置为 true 可跳过后台登录认证（仅用于开发调试样式）
PUBLIC_DEV_SKIP_AUTH=false
