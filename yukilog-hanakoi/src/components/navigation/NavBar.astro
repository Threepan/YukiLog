---
// ================================
// 导航栏组件
// 鼠标靠近后浮出，带圆角和阴影
// stickyOnly: 非首页直接以岛屿模式展示
// ================================

import { contentConfig, navItems } from '../../lib/config.ts';
import { svgIcons } from '../../lib/svg-icons';
import NavItem from './NavItem.astro';

interface Props {
  stickyOnly?: boolean;
}

const { stickyOnly = false } = Astro.props;

// 为固定元素的SVG生成唯一ID，避免与navbar内部SVG的mask ID冲突
function deduplicateSvgIds(svg: string, suffix: string): string {
  return svg
    .replace(/id='([^']+)'/g, (_, id) => `id='${id}${suffix}'`)
    .replace(/url\(#([^)]+)\)/g, (_, id) => `url(#${id}${suffix})`);
}
const brandText = contentConfig.components.navbar.brand;

const searchIcon = svgIcons.search;
const searchIconFixed = deduplicateSvgIds(searchIcon, '_fixed');
---

<nav class="navbar" id="navbar" data-sticky-only={stickyOnly ? 'true' : undefined}>
  <div class="navbar-container">
    <a href="/" class="navbar-inner-logo">{brandText}</a>
    
    <div class="navbar-items">
      {navItems.map((item, index) => (
        <NavItem {...item} index={index} />
      ))}
    </div>
    
    <div class="navbar-inner-actions">
      <button class="navbar-action-btn" aria-label="搜索">
        <span set:html={searchIcon}></span>
      </button>
    </div>
  </div>
</nav>

<div class="navbar-fixed-elements" id="navbar-fixed">
  <a href="/" class="navbar-logo">{brandText}</a>
  
  <div class="navbar-actions">
    <button class="navbar-action-btn" id="search-toggle" aria-label="搜索">
      <span set:html={searchIconFixed}></span>
    </button>
  </div>
</div>

<style>
/* 导航栏容器 */
.navbar {
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 50px;
  background: var(--color-white);
  z-index: var(--z-nav);
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms var(--ease-gentle),
              width 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              border-radius 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              top 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              box-shadow 500ms var(--ease-gentle);
  
  &.active {
    opacity: 1;
    pointer-events: auto;
  }
  
  &.sticky {
    opacity: 1;
    pointer-events: auto;
    width: auto;
    top: 10px;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-blue), var(--shadow-xs);
  }
}

.navbar-container {
  height: 100%;
  margin: 0 auto;
  padding: 0 var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
}

/* 固定显示的 Logo 和操作图标 */
.navbar-fixed-elements {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 50px;
  pointer-events: none;
  z-index: var(--z-nav) + 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 var(--spacing-xl);
  transition: opacity 400ms var(--ease-gentle);
  
  /* sticky时隐藏（logo和图标收入navbar内部） */
  &.hidden {
    opacity: 0;
    pointer-events: none;
  }
}

/* 左侧 Logo（始终显示） */
.navbar-logo {
  font-size: 1.5rem;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  text-decoration: none;
  flex-shrink: 0;
  pointer-events: auto;
  white-space: nowrap;

  &:hover {
    color: var(--color-blue);
  }
}

/* 内部Logo（仅sticky时显示） */
.navbar-inner-logo {
  font-size: 1.5rem;
  font-weight: var(--font-weight-bold);
  color: var(--color-text);
  text-decoration: none;
  flex-shrink: 0;
  white-space: nowrap;
  display: none;
  
  &:hover {
    color: var(--color-blue);
  }

  .navbar.sticky & {
    display: block;
  }
}

/* 内部操作图标（仅sticky时显示） */
.navbar-inner-actions {
  display: none;
  align-items: center;
  gap: var(--spacing-sm);
  flex-shrink: 0;
  
  .navbar.sticky & {
    display: flex;
  }
}

/* 中间导航项（标签动画独立控制） */
.navbar-items {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 单个标签的滑入动画（使用 :global 穿透 Astro 作用域） */
.navbar :global(.nav-item) {
  opacity: 0;
  transform: translateX(40px);
  transition: color 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.navbar.active :global(.nav-item),
.navbar.sticky :global(.nav-item) {
  animation: nav-item-enter 600ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  transition: color 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

/* 为每个标签设置不同的延迟 */
.navbar.active :global(.nav-item:nth-child(1)),
.navbar.sticky :global(.nav-item:nth-child(1)) { animation-delay: 0ms; }
.navbar.active :global(.nav-item:nth-child(2)),
.navbar.sticky :global(.nav-item:nth-child(2)) { animation-delay: 150ms; }
.navbar.active :global(.nav-item:nth-child(3)),
.navbar.sticky :global(.nav-item:nth-child(3)) { animation-delay: 300ms; }
.navbar.active :global(.nav-item:nth-child(4)),
.navbar.sticky :global(.nav-item:nth-child(4)) { animation-delay: 450ms; }
.navbar.active :global(.nav-item:nth-child(5)),
.navbar.sticky :global(.nav-item:nth-child(5)) { animation-delay: 600ms; }
.navbar.active :global(.nav-item:nth-child(6)),
.navbar.sticky :global(.nav-item:nth-child(6)) { animation-delay: 750ms; }

@keyframes nav-item-enter {
  from {
    opacity: 0;
    transform: translateX(40px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

/* 右侧操作图标（始终显示） */
.navbar-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  flex-shrink: 0;
  pointer-events: auto;
  
  /* 固定元素中的按钮 */
  .navbar-action-btn {
    color: var(--color-text);
    
    &:hover {
      background: var(--white-alpha-15);
      color: var(--color-blue);
    }
  }
}

.navbar-action-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: none;
  color: var(--color-text);
  cursor: pointer;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast) var(--ease-out);
  
  :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  &:hover {
    background: var(--color-bg);
    color: var(--color-blue);
  }
}

/* 响应式 */
@media (max-width: 968px) {
  .navbar-container,
  .navbar-fixed-elements {
    padding: 0 var(--spacing-md);
  }

  .navbar-items {
    gap: 2px;
    max-width: calc(100vw - 180px);
    overflow-x: auto;
    scrollbar-width: none;

    &::-webkit-scrollbar {
      display: none;
    }
  }

  .navbar-inner-logo {
    font-size: 1.2rem;
  }
}

@media (max-width: 640px) {
  .navbar-logo,
  .navbar-inner-logo {
    display: none;
  }

  .navbar-container {
    justify-content: center;
    gap: var(--spacing-xs);
  }

  .navbar-items {
    max-width: calc(100vw - 96px);
  }
}
</style>

<script>
  // 导航栏显隐逻辑（兼容 Astro ClientRouter）
  declare global {
    interface Window {
      __yukilogNavbarCleanup?: () => void;
    }
  }

  function initNavbar() {
    // 清理上一页绑定的监听，避免重复绑定
    window.__yukilogNavbarCleanup?.();

    const navbar = document.getElementById('navbar');
    const navbarFixed = document.getElementById('navbar-fixed');
    if (!navbar || !navbarFixed) {
      window.__yukilogNavbarCleanup = undefined;
      return;
    }

    const stickyOnly = navbar.dataset.stickyOnly === 'true';

    const getThreshold = () => window.innerHeight;

    const onScroll = () => {
      const threshold = getThreshold();
      if (window.scrollY >= threshold - 50) {
        navbar.classList.add('sticky');
        navbarFixed.classList.add('hidden');
        navbar.classList.remove('active');
      } else {
        navbar.classList.remove('sticky');
        navbarFixed.classList.remove('hidden');
      }
    };

    const onMouseMove = (e: MouseEvent) => {
      const threshold = getThreshold();
      if (e.clientY < 80 && window.scrollY < threshold) {
        navbar.classList.add('active');
      } else if (window.scrollY < threshold) {
        navbar.classList.remove('active');
      }
    };

    if (stickyOnly) {
      // 非首页：直接以岛屿模式展示，隐藏固定元素
      navbar.classList.add('sticky');
      navbar.classList.remove('active');
      navbarFixed.classList.add('hidden');

      window.__yukilogNavbarCleanup = () => {
        // stickyOnly 模式无全局监听，无需解绑
      };
      return;
    }

    // 首页：绑定滚动和鼠标监听
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('mousemove', onMouseMove);

    // 初始状态同步
    onScroll();

    window.__yukilogNavbarCleanup = () => {
      window.removeEventListener('scroll', onScroll);
      document.removeEventListener('mousemove', onMouseMove);
    };
  }

  document.addEventListener('astro:page-load', initNavbar);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNavbar, { once: true });
  } else {
    initNavbar();
  }
</script>

