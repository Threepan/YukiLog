---
// ================================
// 导航栏组件
// 鼠标靠近后浮出，带圆角和阴影
// stickyOnly: 非首页直接以岛屿模式展示
// ================================

import { contentConfig, navItems } from '../../lib/config.ts';
import NavItem from './NavItem.astro';

interface Props {
  stickyOnly?: boolean;
}

const { stickyOnly = false } = Astro.props;

// 导入右侧图标
const lightIcon = await import('../../assets/icon/ui/light.svg?raw');
const dartIcon = await import('../../assets/icon/ui/dart.svg?raw');
const searchIcon = await import('../../assets/icon/ui/search.svg?raw');

// 为固定元素的SVG生成唯一ID，避免与navbar内部SVG的mask ID冲突
function deduplicateSvgIds(svg: string, suffix: string): string {
  return svg
    .replace(/id='([^']+)'/g, (_, id) => `id='${id}${suffix}'`)
    .replace(/url\(#([^)]+)\)/g, (_, id) => `url(#${id}${suffix})`);
}
const lightIconFixed = deduplicateSvgIds(lightIcon.default, '_fixed');
const searchIconFixed = deduplicateSvgIds(searchIcon.default, '_fixed');
const brandText = contentConfig.components.navbar.brand;
---

<nav class="navbar" id="navbar" data-sticky-only={stickyOnly ? 'true' : undefined}>
  <div class="navbar-container">
    <a href="/" class="navbar-inner-logo">{brandText}</a>
    
    <div class="navbar-items">
      {navItems.map((item, index) => (
        <NavItem {...item} index={index} />
      ))}
    </div>
    
    <div class="navbar-inner-actions">
      <button class="navbar-action-btn" aria-label="切换主题">
        <span set:html={lightIcon.default}></span>
      </button>
      <button class="navbar-action-btn" aria-label="搜索">
        <span set:html={searchIcon.default}></span>
      </button>
    </div>
  </div>
</nav>

<div class="navbar-fixed-elements" id="navbar-fixed">
  <a href="/" class="navbar-logo">{brandText}</a>
  
  <div class="navbar-actions">
    <button class="navbar-action-btn" id="theme-toggle" aria-label="切换主题">
      <span set:html={lightIconFixed}></span>
    </button>
    <button class="navbar-action-btn" id="search-toggle" aria-label="搜索">
      <span set:html={searchIconFixed}></span>
    </button>
  </div>
</div>

<style lang="scss">
// 导航栏容器
.navbar {
  position: fixed;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 100%;
  height: 50px;
  background: $lian-white;
  z-index: $z-nav;
  opacity: 0;
  pointer-events: none;
  transition: opacity 400ms $ease-gentle,
              width 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              border-radius 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              top 500ms cubic-bezier(0.22, 0.61, 0.36, 1),
              box-shadow 500ms $ease-gentle;
  
  &.active {
    opacity: 1;
    pointer-events: auto;
  }
  
  &.sticky {
    opacity: 1;
    pointer-events: auto;
    width: auto;
    top: 10px;
    border-radius: $radius-xl;
    box-shadow: $shadow-blue, 0 4px 16px rgba(0, 0, 0, 0.04);
  }
}

.navbar-container {
  height: 100%;
  margin: 0 auto;
  padding: 0 $spacing-lg;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: $spacing-md;
}

// 固定显示的 Logo 和操作图标
.navbar-fixed-elements {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 50px;
  pointer-events: none;
  z-index: $z-nav + 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 $spacing-xl;
  transition: opacity 400ms $ease-gentle;
  
  // sticky时隐藏（logo和图标收入navbar内部）
  &.hidden {
    opacity: 0;
    pointer-events: none;
  }
}

// 左侧 Logo（始终显示）
.navbar-logo {
  font-size: 1.5rem;
  font-weight: $font-weight-bold;
  color: $lian-text;
  text-decoration: none;
  flex-shrink: 0;
  pointer-events: auto;
  white-space: nowrap;

  &:hover {
    color: $lian-blue;
  }
}

// 内部Logo（仅sticky时显示）
.navbar-inner-logo {
  font-size: 1.5rem;
  font-weight: $font-weight-bold;
  color: $lian-text;
  text-decoration: none;
  flex-shrink: 0;
  white-space: nowrap;
  display: none;
  
  &:hover {
    color: $lian-blue;
  }

  .navbar.sticky & {
    display: block;
  }
}

// 内部操作图标（仅sticky时显示）
.navbar-inner-actions {
  display: none;
  align-items: center;
  gap: $spacing-sm;
  flex-shrink: 0;
  
  .navbar.sticky & {
    display: flex;
  }
}

// 中间导航项（标签动画独立控制）
.navbar-items {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  flex-shrink: 0;
}

// 单个标签的滑入动画（使用 :global 穿透 Astro 作用域）
.navbar :global(.nav-item) {
  opacity: 0;
  transform: translateX(40px);
  transition: color 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

.navbar.active :global(.nav-item),
.navbar.sticky :global(.nav-item) {
  animation: nav-item-enter 600ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  transition: color 200ms cubic-bezier(0.22, 0.61, 0.36, 1);
}

// 为每个标签设置不同的延迟
@for $i from 0 through 5 {
  .navbar.active :global(.nav-item:nth-child(#{$i + 1})),
  .navbar.sticky :global(.nav-item:nth-child(#{$i + 1})) {
    animation-delay: #{$i * 150}ms;
  }
}

@keyframes nav-item-enter {
  from {
    opacity: 0;
    transform: translateX(40px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

// 右侧操作图标（始终显示）
.navbar-actions {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
  flex-shrink: 0;
  pointer-events: auto;
  
  // 固定元素中的按钮用白色（在暗背景上）
  .navbar-action-btn {
    color: $lian-text;
    
    &:hover {
      background: rgba(255, 255, 255, 0.15);
      color: $lian-blue;
    }
  }
}

.navbar-action-btn {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: none;
  color: $lian-text;
  cursor: pointer;
  border-radius: $radius-sm;
  transition: all $transition-fast $ease-out;
  
  :global(svg) {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  
  &:hover {
    background: $lian-bg;
    color: $lian-blue;
  }
}

// 响应式
@media (max-width: $container-md) {
  .navbar-container,
  .navbar-fixed-elements {
    padding: 0 $spacing-md;
  }
}
</style>

<script>
  // 导航栏显隐逻辑
  const navbar = document.getElementById('navbar');
  const navbarFixed = document.getElementById('navbar-fixed');
  if (!navbar || !navbarFixed) throw new Error('Navbar not found');

  const stickyOnly = navbar.dataset.stickyOnly === 'true';

  if (stickyOnly) {
    // 非首页：直接以岛屿模式展示，隐藏固定元素
    navbar.classList.add('sticky');
    navbarFixed.classList.add('hidden');
  } else {
    const getThreshold = () => window.innerHeight;

    // 监听滚动
    window.addEventListener('scroll', () => {
      const threshold = getThreshold();
      if (window.scrollY >= threshold - 50) {
        navbar.classList.add('sticky');
        navbarFixed.classList.add('hidden');
      } else {
        navbar.classList.remove('sticky');
        navbarFixed.classList.remove('hidden');
      }
    });

    // 鼠标靠近顶部时显示
    document.addEventListener('mousemove', (e) => {
      const threshold = getThreshold();
      if (e.clientY < 80 && window.scrollY < threshold) {
        navbar.classList.add('active');
      } else if (window.scrollY < threshold) {
        navbar.classList.remove('active');
      }
    });
  }
</script>
