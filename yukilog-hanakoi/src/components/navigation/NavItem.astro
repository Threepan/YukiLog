---
// ================================
// 导航项组件
// 左图标 + 右文字，支持滑入动画
// ================================

interface Props {
  label: string;
  href: string;
  icon?: string;
  index: number;
}

const { label, href, icon, index } = Astro.props;
const isActive = Astro.url.pathname === href;
const isHome = href === '/';

// 动态导入图标
const icons: Record<string, any> = {
  home: await import('../../assets/icon/nav/home.svg?raw'),
  theme: await import('../../assets/icon/nav/theme.svg?raw'),
  archive: await import('../../assets/icon/nav/archive.svg?raw'),
  tag: await import('../../assets/icon/nav/tag.svg?raw'),
  links: await import('../../assets/icon/nav/links.svg?raw'),
  about: await import('../../assets/icon/nav/about.svg?raw'),
};

const iconSvg = icon && icons[icon] ? icons[icon].default : null;
---

<a
  href={href}
  class:list={['nav-item', { active: isActive }]}
  style={`--index: ${index}`}
  onclick={isHome && isActive ? "event.preventDefault(); location.reload(true);" : undefined}
>
  {iconSvg && (
    <span class="nav-icon" set:html={iconSvg}></span>
  )}
  <span class="nav-label">{label}</span>
</a>

<style lang="scss">
.nav-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: $spacing-xs;
  padding: $spacing-sm $spacing-md;
  color: $lian-text;
  font-weight: $font-weight-medium;
  font-size: $font-size-base;
  text-decoration: none;
  white-space: nowrap;
  transition: color $transition-base $ease-gentle;
  
  // 下划线（从左到右，宽度缩短）
  &::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 15%;
    width: 0;
    height: 2px;
    background: currentColor;
    transition: width $transition-base $ease-gentle;
  }
  
  &:hover {
    color: $lian-blue;
    
    &::after {
      width: 70%;
    }
  }
  
  &.active {
    color: $lian-pink;
    
    &::after {
      width: 70%;
    }
  }
}

.nav-icon {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  
  :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
}

.nav-label {
  position: relative;
  line-height: 1;
}
</style>
