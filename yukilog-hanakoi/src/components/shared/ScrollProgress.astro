---
// ================================
// 全局滚动进度组件
// - 顶部进度条（粉色，从中间向两边扩展）
// - 左下角回到顶部按钮（显示实时百分比）
// ================================

// 箭头 SVG
const arrowUpSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>`;
---

<!-- 顶部进度条 -->
<div class="scroll-progress-bar" id="scroll-progress-bar" aria-hidden="true"></div>

<!-- 回到顶部按钮 -->
<button class="back-to-top" id="back-to-top" aria-label="回到顶部" title="回到顶部">
  <span class="btt-icon" set:html={arrowUpSvg}></span>
  <span class="btt-percent" id="btt-percent">0%</span>
</button>

<style lang="scss">
  // 顶部进度条
  .scroll-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: transparent;
    z-index: $z-modal + 1; // 在所有内容之上
    pointer-events: none;

    &::after {
      content: "";
      display: block;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        $lian-pink 20%,
        $lian-pink 80%,
        transparent
      );
      transform: scaleX(var(--p, 0));
      transform-origin: center;
    }
  }

  // 回到顶部按钮
  .back-to-top {
    position: fixed;
    bottom: $spacing-xl;
    left: $spacing-xl;
    z-index: $z-modal;
    
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    
    width: 48px;
    height: 48px;
    padding: 0;
    
    background: rgba(white, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid $lian-border;
    border-radius: $radius-sm;
    box-shadow: $shadow-pink;
    
    color: $lian-text-light;
    cursor: pointer;
    
    // 默认隐藏，滚动后显示
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
    transition:
      opacity 300ms $ease-gentle,
      transform 300ms $ease-gentle,
      box-shadow 200ms $ease-gentle,
      border-color 200ms $ease-gentle;

    &.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    &:hover {
      box-shadow: $shadow-pink-hover;
      border-color: $lian-pink;
      color: $lian-pink;
    }

    &:active {
      transform: scale(0.95);
    }
  }

  .btt-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;

    :global(svg) {
      width: 16px;
      height: 16px;
    }
  }

  .btt-percent {
    font-size: 10px;
    font-weight: $font-weight-medium;
    line-height: 1;
    letter-spacing: -0.02em;
  }
</style>

<script>
  (function () {
    const bar = document.getElementById('scroll-progress-bar');
    const btn = document.getElementById('back-to-top');
    const percentEl = document.getElementById('btt-percent');
    if (!bar || !btn || !percentEl) return;

    let ticking = false;

    function updateProgress() {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;

      if (docHeight <= 0) {
        bar.style.setProperty('--p', '0');
        percentEl.textContent = '0%';
        btn.classList.remove('visible');
        ticking = false;
        return;
      }

      const progress = Math.min(scrollTop / docHeight, 1);
      const percent = Math.round(progress * 100);

      bar.style.setProperty('--p', String(progress));
      percentEl.textContent = `${percent}%`;

      if (scrollTop > 200) {
        btn.classList.add('visible');
      } else {
        btn.classList.remove('visible');
      }

      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateProgress);
        ticking = true;
      }
    }, { passive: true });

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    updateProgress();
  })();
</script>
