---
// ================================
// 文章列表卡片组件（通用）
// 用于主题详情页、标签页等场景
// 封面图作为整个卡片的背景，加暗色渐变滤镜
// 双栏网格布局由父容器控制
// ================================

interface Props {
  post: {
    title: string;
    slug: string;
    summary?: string | null;
    cover_image?: string | null;
    created_at: string;
    tags?: ReadonlyArray<{ readonly name: string; readonly slug: string }>;
  };
  index: number;
}

const { post, index } = Astro.props;
const hasCover = !!post.cover_image;
---

<a
  href={`/posts/${post.slug}`}
  class="post-list-card"
  style={`--pi: ${index}`}
>
  <!-- 背景层：封面图或渐变色 -->
  {hasCover ? (
    <div class="plc-bg" style={`background-image: url('${post.cover_image}')`}></div>
  ) : (
    <div class="plc-bg plc-bg-fallback" data-index={index}></div>
  )}

  <!-- 暗色滤镜层 -->
  <div class="plc-overlay"></div>

  <!-- 内容层 -->
  <div class="plc-content">
    <h3 class="plc-title">{post.title}</h3>
    {post.summary && <p class="plc-summary">{post.summary}</p>}
    <div class="plc-meta">
      <time class="plc-date">
        {new Date(post.created_at).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.tags && post.tags.length > 0 && (
        <div class="plc-tags">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="plc-tag">#{tag.name}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>

<style lang="scss">
  // 备用渐变色组（无封面图时轮流使用）
  $fallback-gradients: (
    "linear-gradient(135deg, #7EB6D9 0%, #E8A4B4 100%)",
    "linear-gradient(135deg, #E8A4B4 0%, #f0c0a0 100%)",
    "linear-gradient(135deg, #93c2e0 0%, #7EB6D9 100%)",
    "linear-gradient(135deg, #a8d5ba 0%, #7EB6D9 100%)",
    "linear-gradient(135deg, #E8A4B4 0%, #93c2e0 100%)",
  );

  .post-list-card {
    display: block;
    position: relative;
    min-height: 220px;
    border-radius: $radius-lg;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;

    // 入场动画：默认不可见
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 500ms $ease-gentle,
      transform 500ms $ease-gentle,
      box-shadow $transition-base $ease-gentle;
    transition-delay: calc(var(--pi) * 60ms);

    &.visible {
      opacity: 1;
      transform: translateY(0);
    }

    &:hover {
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
      transform: translateY(-6px);

      .plc-bg {
        transform: scale(1.06);
      }

      .plc-overlay {
        background: linear-gradient(
          to top,
          rgba(0, 0, 0, 0.80) 0%,
          rgba(0, 0, 0, 0.45) 50%,
          rgba(0, 0, 0, 0.25) 100%
        );
      }

      &.visible {
        transform: translateY(-6px);
      }
    }
  }

  // 背景层
  .plc-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 600ms $ease-gentle;
    will-change: transform;
  }

  // 无封面图的备用渐变：通过 nth-child 交替
  // 子组件无法直接获取 nth-child，由父容器 CSS 控制
  .plc-bg-fallback {
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
  }

  // 暗色叠加层（从底部往上渐变，使文字可读）
  .plc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.35) 50%,
      rgba(0, 0, 0, 0.15) 100%
    );
    transition: background $transition-base $ease-gentle;
  }

  // 内容层（定位在暗色层之上）
  .plc-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: $spacing-lg;
    min-height: 220px;
    height: 100%;
    box-sizing: border-box;
  }

  .plc-title {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
    color: #fff;
    margin: 0 0 $spacing-xs;
    line-height: $line-height-tight;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .plc-summary {
    font-size: $font-size-sm;
    color: rgba(255, 255, 255, 0.82);
    line-height: $line-height-base;
    margin: 0 0 $spacing-xs;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    flex-wrap: wrap;
    margin-top: $spacing-xs;
  }

  .plc-date {
    font-size: $font-size-xs;
    color: rgba(255, 255, 255, 0.65);
    font-family: $font-family-code;
  }

  .plc-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: $font-size-xs;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.18);
    padding: 1px 8px;
    border-radius: 12px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  // 响应式
  @media (max-width: $container-sm) {
    .plc-content {
      min-height: 180px;
      padding: $spacing-md;
    }
  }
</style>


<style lang="scss">
  .post-list-card {
    display: block;
    padding: $spacing-lg $spacing-xl;
    background: var(--color-white);
    border-radius: $radius-sm;
    text-decoration: none;
    box-shadow: $shadow-sm;
    border-left: 3px solid transparent;
    overflow: hidden;
    transition:
      box-shadow $transition-base $ease-gentle,
      transform $transition-base $ease-gentle,
      border-color $transition-base $ease-gentle;

    // 入场动画
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 500ms $ease-gentle,
      transform 500ms $ease-gentle,
      box-shadow $transition-base $ease-gentle,
      border-color $transition-base $ease-gentle;
    transition-delay: calc(var(--pi) * 60ms);

    &.has-cover {
      padding: 0;
      border-left: none;

      .plc-info {
        padding: $spacing-md $spacing-xl $spacing-lg;
      }
    }

    &.visible {
      opacity: 1;
      transform: translateY(0);
    }

    &:hover {
      box-shadow: $shadow-blue;
      transform: translateY(-2px);
      border-left-color: $lian-blue;

      .plc-title {
        color: $lian-blue;
      }

      .plc-cover img {
        transform: scale(1.06);
      }
    }

    &:nth-child(even):hover {
      box-shadow: $shadow-pink;
      border-left-color: $lian-pink;

      .plc-title {
        color: $lian-pink;
      }
    }
  }

  .plc-cover {
    width: 100%;
    min-height: 140px;
    max-height: 320px;
    overflow: hidden;

    img {
      width: 100%;
      height: auto;
      min-height: 140px;
      max-height: 320px;
      object-fit: cover;
      display: block;
      transition: transform 500ms $ease-gentle;
    }
  }

  .plc-info {
    display: flex;
    flex-direction: column;
    gap: $spacing-xs;
  }

  .plc-title {
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    margin: 0;
    line-height: $line-height-tight;
    transition: color $transition-fast $ease-gentle;
  }

  .plc-summary {
    font-size: $font-size-sm;
    color: $lian-text-light;
    line-height: $line-height-base;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    margin-top: $spacing-xs;
  }

  .plc-date {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    font-family: $font-family-code;
  }

  .plc-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: $font-size-xs;
    color: $lian-pink;
    background: rgba($lian-pink, 0.08);
    padding: 1px 8px;
    border-radius: 12px;
  }

  @media (max-width: $container-sm) {
    .post-list-card {
      padding: $spacing-md;

      &.has-cover {
        padding: 0;
      }
    }
  }
</style>
