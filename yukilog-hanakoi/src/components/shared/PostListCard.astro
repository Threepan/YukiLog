---
// ================================
// 文章列表卡片组件（通用）
// 用于主题详情页、标签页等场景
// 封面图作为整个卡片的背景，加暗色渐变滤镜
// 双栏网格布局由父容器控制
// ================================

interface Props {
  post: {
    title: string;
    slug: string;
    summary?: string | null;
    cover_image?: string | null;
    created_at: string;
    tags?: ReadonlyArray<{ readonly name: string; readonly slug: string }>;
  };
  index: number;
}

const { post, index } = Astro.props;
const hasCover = !!post.cover_image;
---

<a
  href={`/posts/${post.slug}`}
  class="post-list-card"
  style={`--pi: ${index}`}
>
  <!-- 封面图（自然高度）或渐变占位 -->
  {hasCover ? (
    <div class="plc-cover">
      <img src={post.cover_image!} alt={post.title} loading="lazy" />
    </div>
  ) : (
    <div class="plc-fallback"></div>
  )}

  <!-- 文字信息 -->
  <div class="plc-body">
    <h3 class="plc-title">{post.title}</h3>
    {post.summary && <p class="plc-summary">{post.summary}</p>}
    <div class="plc-meta">
      <time class="plc-date">
        {new Date(post.created_at).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.tags && post.tags.length > 0 && (
        <div class="plc-tags">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="plc-tag">#{tag.name}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>

<style>
  /* ===== 基础卡片 ===== */
  .post-list-card {
    display: block;
    background: var(--color-white);
    border-radius: 18px;
    border-left: 3px solid transparent;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    break-inside: avoid;          /* 瀑布流列不拆断 */
    margin-bottom: 1.25rem;       /* 同列卡片间距 */

    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 500ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--pi) * 60ms);
  }

  .post-list-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* 奇数项：蓝色 hover */
  .post-list-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-left-color: var(--color-blue);
    transform: translateY(-3px);
  }

  /* 偶数项：粉色 hover */
  .post-list-card:nth-child(even):hover {
    box-shadow: var(--shadow-pink-md);
    border-left-color: var(--color-pink);
  }

  /* ===== 封面图（自然尺寸）===== */
  .plc-cover {
    overflow: hidden;
    line-height: 0;  /* 消除 img 下方空隙 */
  }

  .plc-cover img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-list-card:hover .plc-cover img {
    transform: scale(1.04);
  }

  /* ===== 无封面渐变占位 ===== */
  .plc-fallback {
    height: 100px;
    background: linear-gradient(135deg, var(--blue-alpha-15) 0%, var(--pink-alpha-15) 100%);
  }

  /* ===== 文字区域 ===== */
  .plc-body {
    padding: 1.125rem 1.5rem 1.375rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .plc-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.35;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-list-card:hover .plc-title {
    color: var(--color-blue);
  }

  .post-list-card:nth-child(even):hover .plc-title {
    color: var(--color-pink);
  }

  .plc-summary {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .plc-date {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .plc-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: 0.6875rem;
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    padding: 1px 7px;
    border-radius: 10px;
  }

  @media (max-width: 640px) {
    .post-list-card {
      margin-bottom: 1rem;
    }
  }
</style>
