---
// ================================
// 文章列表卡片组件（通用）
// 用于主题详情页、标签页等场景
// 封面图作为整个卡片的背景，加暗色渐变滤镜
// 双栏网格布局由父容器控制
// ================================

interface Props {
  post: {
    title: string;
    slug: string;
    summary?: string | null;
    cover_image?: string | null;
    created_at: string;
    tags?: ReadonlyArray<{ readonly name: string; readonly slug: string }>;
  };
  index: number;
}

const { post, index } = Astro.props;
const hasCover = !!post.cover_image;
---

<a
  href={`/posts/${post.slug}`}
  class="post-list-card"
  style={`--pi: ${index}`}
>
  <!-- 背景层：封面图或渐变色 -->
  {hasCover ? (
    <div class="plc-bg" style={`background-image: url('${post.cover_image}')`}></div>
  ) : (
    <div class="plc-bg plc-bg-fallback" data-index={index}></div>
  )}

  <!-- 暗色滤镜层 -->
  <div class="plc-overlay"></div>

  <!-- 内容层 -->
  <div class="plc-content">
    <h3 class="plc-title">{post.title}</h3>
    {post.summary && <p class="plc-summary">{post.summary}</p>}
    <div class="plc-meta">
      <time class="plc-date">
        {new Date(post.created_at).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.tags && post.tags.length > 0 && (
        <div class="plc-tags">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="plc-tag">#{tag.name}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>

<style>
  /* 备用渐变：无封面图时 */
  .plc-bg-fallback {
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
  }

  .post-list-card {
    display: block;
    position: relative;
    min-height: 220px;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    cursor: pointer;

    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 500ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--pi) * 60ms);
  }

  .post-list-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .post-list-card:hover {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.35);
    transform: translateY(-6px);
  }

  .post-list-card.visible:hover {
    transform: translateY(-6px);
  }

  .post-list-card:hover .plc-bg {
    transform: scale(1.06);
  }

  .post-list-card:hover .plc-overlay {
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.80) 0%,
      rgba(0, 0, 0, 0.45) 50%,
      rgba(0, 0, 0, 0.25) 100%
    );
  }

  /* 背景层 */
  .plc-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  /* 暗色叠加层 */
  .plc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.72) 0%,
      rgba(0, 0, 0, 0.35) 50%,
      rgba(0, 0, 0, 0.15) 100%
    );
    transition: background 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 内容层：绝对定位贴底 */
  .plc-content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.25rem 1.25rem;
  }

  .plc-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.375rem;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  .plc-summary {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.82);
    line-height: 1.6;
    margin: 0 0 0.375rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.375rem;
  }

  .plc-date {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .plc-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(255, 255, 255, 0.18);
    padding: 1px 8px;
    border-radius: 12px;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  @media (max-width: 640px) {
    .plc-content {
      padding: 1rem;
    }
  }
</style>


<style>
  .post-list-card {
    display: block;
    padding: 2rem 3rem;
    background: var(--color-white);
    border-radius: 16px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    border-left: 3px solid transparent;
    overflow: hidden;

    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 500ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--pi) * 60ms);
  }

  .post-list-card.has-cover {
    padding: 0;
    border-left: none;
  }

  .post-list-card.has-cover .plc-info {
    padding: 1.5rem 3rem 2rem;
  }

  .post-list-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .post-list-card:hover {
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-2px);
    border-left-color: var(--color-blue);
  }

  .post-list-card:hover .plc-title {
    color: var(--color-blue);
  }

  .post-list-card:hover .plc-cover img {
    transform: scale(1.06);
  }

  .post-list-card:nth-child(even):hover {
    box-shadow: var(--shadow-pink-md);
    border-left-color: var(--color-pink);
  }

  .post-list-card:nth-child(even):hover .plc-title {
    color: var(--color-pink);
  }

  .plc-cover {
    width: 100%;
    min-height: 140px;
    max-height: 320px;
    overflow: hidden;
  }

  .plc-cover img {
    width: 100%;
    height: auto;
    min-height: 140px;
    max-height: 320px;
    object-fit: cover;
    display: block;
    transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .plc-info {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .plc-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    line-height: 1.25;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .plc-summary {
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .plc-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .plc-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: 0.75rem;
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    padding: 1px 8px;
    border-radius: 12px;
  }

  @media (max-width: 640px) {
    .post-list-card {
      padding: 1.5rem;
    }

    .post-list-card.has-cover {
      padding: 0;
    }
  }
</style>
