---
// ================================
// 文章列表卡片组件（通用）
// 用于主题详情页、标签页等场景
// 架构：与主页 ArticleCard 相同的稳定方案
//   - 卡片 hover 只改 box-shadow，绝不改 transform
//   - 图片 scale 由独立内层 .plc-cover-inner 裁剪
//   - 避免 transform + overflow:hidden + border-radius 合成层冲突
// ================================

interface Props {
  post: {
    title: string;
    slug: string;
    summary?: string | null;
    cover_image?: string | null;
    created_at: string;
    tags?: ReadonlyArray<{ readonly name: string; readonly slug: string }>;
  };
  index: number;
}

const { post, index } = Astro.props;
const hasCover = !!post.cover_image;
---

<a
  href={`/posts/${post.slug}`}
  class="post-list-card"
  class:list={[{ 'has-cover': hasCover }]}
  style={`--pi: ${index}`}
>
  {/* 封面区域 */}
  <div class="plc-cover">
    <div class="plc-cover-inner">
      {hasCover ? (
        <img src={post.cover_image!} alt="" loading="lazy" />
      ) : (
        <div class="plc-fallback"></div>
      )}
    </div>
    {/* 渐变遮罩 */}
    <div class="plc-overlay"></div>
  </div>

  {/* 文字信息（绝对定位，贴底）*/}
  <div class="plc-body">
    <h3 class="plc-title">{post.title}</h3>
    {post.summary && <p class="plc-summary">{post.summary}</p>}
    <div class="plc-meta">
      <time class="plc-date">
        {new Date(post.created_at).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
      {post.tags && post.tags.length > 0 && (
        <div class="plc-tags">
          {post.tags.slice(0, 3).map((tag) => (
            <span class="plc-tag">#{tag.name}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>

<style>
  /* ========================================
     卡片容器
     关键：hover 只改 box-shadow / border-color
     绝不改 transform → 圆角永远不会丢失
     ======================================== */
  .post-list-card {
    position: relative;
    display: block;
    border-radius: 18px;
    border-left: 3px solid transparent;
    overflow: hidden;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    break-inside: avoid;
    margin-bottom: 1.25rem;

    /* 入场动画（一次性 transition，不影响后续 hover） */
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 500ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 500ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow 300ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color 300ms cubic-bezier(0.4, 0, 0.2, 1);
    transition-delay: calc(var(--pi) * 60ms);
  }

  .post-list-card.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* hover：只改阴影和边框色，不改 transform */
  .post-list-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-left-color: var(--color-blue);
  }

  .post-list-card:nth-child(even):hover {
    box-shadow: var(--shadow-pink-md);
    border-left-color: var(--color-pink);
  }

  /* ========================================
     封面区域
     ======================================== */
  .plc-cover {
    position: relative;
    width: 100%;
  }

  /* 内层裁剪容器 — 隔离图片 scale 动画 */
  .plc-cover-inner {
    width: 100%;
    height: 100%;
    overflow: hidden;

    img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: cover;
      transition: transform 500ms cubic-bezier(0.4, 0, 0.2, 1);
    }
  }

  .post-list-card:hover .plc-cover-inner img {
    transform: scale(1.05);
  }

  /* 无封面占位 */
  .plc-fallback {
    width: 100%;
    min-height: 220px;
    background: linear-gradient(135deg, var(--blue-alpha-15) 0%, var(--pink-alpha-15) 100%);
  }

  /* 渐变遮罩 */
  .plc-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.25) 50%,
      rgba(0, 0, 0, 0.55) 100%
    );
    pointer-events: none;
  }

  .post-list-card:not(.has-cover) .plc-overlay {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.1) 100%
    );
  }

  /* ========================================
     文字区域（绝对定位贴底）
     ======================================== */
  .plc-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .plc-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #fff;
    margin: 0;
    line-height: 1.4;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: color 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-list-card:not(.has-cover) .plc-title {
    color: var(--color-text);
    text-shadow: none;
  }

  .post-list-card:hover .plc-title {
    color: var(--color-blue);
  }

  .post-list-card:nth-child(even):hover .plc-title {
    color: var(--color-pink);
  }

  .plc-summary {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.65;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }

  .post-list-card:not(.has-cover) .plc-summary {
    color: var(--color-text-light);
    text-shadow: none;
  }

  .plc-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .plc-date {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.85);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .post-list-card:not(.has-cover) .plc-date {
    color: var(--color-text-muted);
    text-shadow: none;
  }

  .plc-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .plc-tag {
    font-size: 0.6875rem;
    color: #fff;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(8px);
    padding: 2px 9px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .post-list-card:not(.has-cover) .plc-tag {
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    backdrop-filter: none;
    border: none;
    text-shadow: none;
  }

  /* ========================================
     响应式
     ======================================== */
  @media (max-width: 640px) {
    .post-list-card {
      margin-bottom: 1rem;
    }

    .plc-fallback {
      min-height: 200px;
    }

    .plc-body {
      padding: 1.25rem 1.5rem;
    }

    .plc-title {
      font-size: 1rem;
    }
  }
</style>
