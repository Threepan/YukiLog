---
// ================================
// 页面 Hero 横幅组件
// 用于主题、归档、标签页面顶部
// 背景图 + 大图标 + 标题文字
// ================================

interface Props {
  title: string;
  subtitle?: string;
  icon: string; // raw SVG string
}

import { contentConfig } from "../../lib/config";

const { title, subtitle, icon } = Astro.props;

// 背景图来自全局配置（yukilog.config.ts）
const headerImageName = contentConfig.hero.headerGif;
const headerImageModules = import.meta.glob("../../assets/image/header/*", {
  eager: true,
  query: "?url",
  import: "default",
}) as Record<string, string>;
const heroBgSrc =
  Object.entries(headerImageModules).find(([path]) =>
    path.endsWith(`/${headerImageName}`)
  )?.[1] ?? Object.values(headerImageModules)[0] ?? "";
---

<div class="page-hero">
  <div class="hero-bg">
    <img src={heroBgSrc} alt="" aria-hidden="true" />
  </div>
  <div class="hero-content">
    <span class="hero-icon" set:html={icon} />
    <h1 class="hero-title">{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
  </div>
</div>

<style lang="scss">
  .page-hero {
    position: relative;
    height: 40vh;
    min-height: 220px;
    max-height: 360px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  // 背景图层
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    // 底部渐隐到页面背景色，柔和衔接下方内容
    &::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 30%;
      background: linear-gradient(to bottom, transparent, $lian-bg);
      pointer-events: none;
    }
  }

  // 内容层
  .hero-content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-sm;
    opacity: 0;
    animation: hero-enter 700ms $ease-gentle 150ms forwards;
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  // 大图标
  .hero-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background: var(--white-alpha-85);
    border-radius: $radius-md;
    box-shadow: $shadow-md;

    :global(svg) {
      width: 28px;
      height: 28px;
      fill: $lian-blue;
    }
  }

  // 标题
  .hero-title {
    font-size: $font-size-3xl;
    font-weight: $font-weight-semibold;
    color: var(--color-on-primary);
    margin: 0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    letter-spacing: 0.08em;
  }

  // 副标题
  .hero-subtitle {
    font-size: $font-size-base;
    color: var(--white-alpha-85);
    margin: 0;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
    letter-spacing: 0.04em;
  }

  // 响应式
  @media (max-width: $container-sm) {
    .page-hero {
      min-height: 180px;
    }

    .hero-icon {
      width: 44px;
      height: 44px;

      :global(svg) {
        width: 22px;
        height: 22px;
      }
    }

    .hero-title {
      font-size: $font-size-2xl;
    }
  }
</style>
