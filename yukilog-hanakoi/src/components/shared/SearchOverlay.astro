---
// ================================
// 全局搜索弹窗组件
// 全屏遮罩 + 居中搜索面板
// 支持防抖搜索、键盘导航、Ctrl+K 快捷键
// ================================

import { svgIcons } from '../../lib/svg-icons';
---

<div class="search-overlay" id="search-overlay">
  <div class="search-backdrop" id="search-backdrop"></div>
  
  <div class="search-panel">
    <!-- 搜索输入区域 -->
    <div class="search-header">
      <div class="search-input-wrapper">
        <span class="search-input-icon" set:html={svgIcons.search}></span>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder="搜索文章标题、摘要、内容…"
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd">ESC</kbd>
      </div>
    </div>

    <!-- 搜索结果区域 -->
    <div class="search-body" id="search-body">
      <!-- 初始提示 -->
      <div class="search-hint" id="search-hint">
        <p>输入关键词开始搜索</p>
        <div class="search-hint-shortcuts">
          <span><kbd>↑</kbd><kbd>↓</kbd> 导航</span>
          <span><kbd>Enter</kbd> 打开</span>
          <span><kbd>ESC</kbd> 关闭</span>
        </div>
      </div>

      <!-- 加载中 -->
      <div class="search-loading" id="search-loading" style="display:none">
        <div class="search-spinner"></div>
        <p>搜索中…</p>
      </div>

      <!-- 无结果 -->
      <div class="search-empty" id="search-empty" style="display:none">
        <p>没有找到相关文章</p>
      </div>

      <!-- 结果列表 -->
      <div class="search-results" id="search-results" style="display:none">
        <ul class="search-result-list" id="search-result-list"></ul>
        <div class="search-pagination" id="search-pagination"></div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  // 遮罩层
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: $z-modal;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity $transition-base $ease-gentle,
                visibility $transition-base $ease-gentle;

    &.active {
      opacity: 1;
      visibility: visible;

      .search-panel {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(4px);
  }

  // 搜索面板
  .search-panel {
    position: relative;
    width: 90%;
    max-width: 640px;
    max-height: 70vh;
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-lg, 0 0 0 1px rgba(0, 0, 0, 0.04);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(-12px) scale(0.98);
    opacity: 0;
    transition: transform $transition-base $ease-gentle,
                opacity $transition-base $ease-gentle;
  }

  // 搜索输入区域
  .search-header {
    padding: $spacing-sm $spacing-md;
    border-bottom: 1px solid $lian-divider;
    flex-shrink: 0;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
  }

  .search-input-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: $lian-text-muted;
    display: flex;
    align-items: center;
    justify-content: center;

    :global(svg) {
      width: 20px;
      height: 20px;
      fill: currentColor;
    }
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-size: $font-size-lg;
    color: $lian-text;
    font-family: $font-family-base;
    padding: $spacing-xs 0;

    &::placeholder {
      color: $lian-text-muted;
    }
  }

  .search-kbd {
    flex-shrink: 0;
    padding: 2px 8px;
    font-size: $font-size-xs;
    font-family: $font-family-code;
    color: $lian-text-muted;
    background: $lian-bg;
    border: 1px solid $lian-border;
    border-radius: 6px;
    line-height: 1.4;
  }

  // 搜索结果区域
  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: $spacing-sm $spacing-md $spacing-md;

    // 自定义滚动条
    &::-webkit-scrollbar {
      width: 4px;
    }
    &::-webkit-scrollbar-track {
      background: transparent;
    }
    &::-webkit-scrollbar-thumb {
      background: $lian-border;
      border-radius: 2px;
    }
  }

  // 初始提示
  .search-hint,
  .search-loading,
  .search-empty {
    padding: $spacing-xl 0;
    text-align: center;
    color: $lian-text-muted;

    p {
      margin: 0;
      font-size: $font-size-sm;
    }
  }

  .search-hint-shortcuts {
    display: flex;
    justify-content: center;
    gap: $spacing-md;
    margin-top: $spacing-sm;
    font-size: $font-size-xs;
    color: $lian-text-muted;

    kbd {
      padding: 1px 6px;
      font-family: $font-family-code;
      background: $lian-bg;
      border: 1px solid $lian-border;
      border-radius: 4px;
      font-size: 11px;
      margin: 0 2px;
    }
  }

  // 加载动画
  .search-spinner {
    width: 24px;
    height: 24px;
    margin: 0 auto $spacing-xs;
    border: 2px solid $lian-border;
    border-top-color: $lian-blue;
    border-radius: 50%;
    animation: search-spin 600ms linear infinite;
  }

  @keyframes search-spin {
    to { transform: rotate(360deg); }
  }

  // 结果列表
  .search-result-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .search-result-item {
    border-radius: $radius-sm;
    transition: background $transition-fast $ease-gentle;

    &.active,
    &:hover {
      background: $lian-bg;
    }

    a {
      display: block;
      padding: $spacing-sm $spacing-sm;
      text-decoration: none;
      color: inherit;
    }
  }

  .search-result-title {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    margin: 0 0 4px;
    line-height: $line-height-tight;

    :global(mark) {
      background: rgba($lian-blue, 0.18);
      color: $lian-blue;
      padding: 0 2px;
      border-radius: 3px;
    }
  }

  .search-result-excerpt {
    font-size: $font-size-sm;
    color: $lian-text-light;
    line-height: $line-height-base;
    margin: 0 0 6px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    :global(mark) {
      background: rgba($lian-pink, 0.18);
      color: $lian-pink;
      padding: 0 2px;
      border-radius: 3px;
    }
  }

  .search-result-meta {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    font-size: $font-size-xs;
    color: $lian-text-muted;
  }

  .search-result-tag {
    color: $lian-pink;
    background: rgba($lian-pink, 0.08);
    padding: 1px 8px;
    border-radius: 12px;
  }

  // 分页
  .search-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: $spacing-xs;
    padding-top: $spacing-sm;

    &:empty {
      display: none;
    }
  }

  .search-page-btn {
    padding: 4px 12px;
    font-size: $font-size-xs;
    color: $lian-text-light;
    background: $lian-bg;
    border: 1px solid $lian-border;
    border-radius: 8px;
    cursor: pointer;
    transition: all $transition-fast $ease-gentle;

    &:hover {
      border-color: $lian-blue;
      color: $lian-blue;
    }

    &:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }
  }

  .search-page-info {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    font-family: $font-family-code;
  }

  // 响应式
  @media (max-width: $container-sm) {
    .search-overlay {
      padding-top: 6vh;
    }

    .search-panel {
      width: 95%;
      max-height: 80vh;
    }

    .search-hint-shortcuts {
      flex-direction: column;
      gap: $spacing-xs;
    }
  }
</style>

<script>
  import { postsApi } from '../../lib/api';
  import type { PostWithRelations } from '../../types/api';

  // ============ DOM 元素 ============
  const overlay = document.getElementById('search-overlay')!;
  const backdrop = document.getElementById('search-backdrop')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const hint = document.getElementById('search-hint')!;
  const loading = document.getElementById('search-loading')!;
  const empty = document.getElementById('search-empty')!;
  const results = document.getElementById('search-results')!;
  const resultList = document.getElementById('search-result-list')!;
  const pagination = document.getElementById('search-pagination')!;

  // ============ 状态 ============
  let isOpen = false;
  let activeIndex = -1;
  let currentPage = 1;
  let currentQuery = '';
  let debounceTimer: ReturnType<typeof setTimeout> | null = null;
  const PAGE_SIZE = 8;

  // ============ 打开 / 关闭 ============
  function openSearch() {
    isOpen = true;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    // 延迟聚焦，等动画开始
    requestAnimationFrame(() => input.focus());
  }

  function closeSearch() {
    isOpen = false;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
    input.value = '';
    currentQuery = '';
    currentPage = 1;
    activeIndex = -1;
    showView('hint');
  }

  // ============ 视图切换 ============
  function showView(view: 'hint' | 'loading' | 'empty' | 'results') {
    hint.style.display = view === 'hint' ? '' : 'none';
    loading.style.display = view === 'loading' ? '' : 'none';
    empty.style.display = view === 'empty' ? '' : 'none';
    results.style.display = view === 'results' ? '' : 'none';
  }

  // ============ 搜索逻辑 ============
  async function doSearch(query: string, page: number) {
    if (!query.trim()) {
      showView('hint');
      return;
    }

    showView('loading');
    currentQuery = query;
    currentPage = page;

    try {
      const data = await postsApi.search({
        q: query,
        page,
        page_size: PAGE_SIZE,
      });

      if (data.items.length === 0) {
        showView('empty');
        return;
      }

      renderResults(data.items);
      renderPagination(data.page, data.total_pages, data.total);
      showView('results');
      activeIndex = -1;
      updateActiveItem();
    } catch {
      showView('empty');
    }
  }

  // ============ 渲染结果 ============
  function renderResults(items: PostWithRelations[]) {
    resultList.innerHTML = items.map((item, i) => {
      const post = item.post;
      const date = new Date(post.created_at).toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      });
      const tags = item.tags.map(t => `<span class="search-result-tag">#${t.name}</span>`).join('');
      const summary = post.summary || '';
      const content = post.content || '';
      // 优先展示 summary（已含高亮），不存在则回退到 content（含高亮摘要）
      const excerpt = summary || content;

      return `
        <li class="search-result-item" data-index="${i}">
          <a href="/posts/${post.slug}">
            <div class="search-result-title">${post.title}</div>
            ${excerpt ? `<div class="search-result-excerpt">${excerpt}</div>` : ''}
            <div class="search-result-meta">
              <time>${date}</time>
              ${tags}
            </div>
          </a>
        </li>
      `;
    }).join('');
  }

  function renderPagination(page: number, totalPages: number, total: number) {
    if (totalPages <= 1) {
      pagination.innerHTML = '';
      return;
    }

    pagination.innerHTML = `
      <button class="search-page-btn" id="search-prev" ${page <= 1 ? 'disabled' : ''}>上一页</button>
      <span class="search-page-info">${page} / ${totalPages}（共 ${total} 篇）</span>
      <button class="search-page-btn" id="search-next" ${page >= totalPages ? 'disabled' : ''}>下一页</button>
    `;

    document.getElementById('search-prev')?.addEventListener('click', () => {
      if (currentPage > 1) doSearch(currentQuery, currentPage - 1);
    });
    document.getElementById('search-next')?.addEventListener('click', () => {
      if (currentPage < totalPages) doSearch(currentQuery, currentPage + 1);
    });
  }

  // ============ 键盘导航 ============
  function getItems(): NodeListOf<Element> {
    return resultList.querySelectorAll('.search-result-item');
  }

  function updateActiveItem() {
    const items = getItems();
    items.forEach((el, i) => {
      el.classList.toggle('active', i === activeIndex);
      if (i === activeIndex) {
        el.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  // ============ 事件绑定 ============

  // 点击遮罩关闭
  backdrop.addEventListener('click', closeSearch);

  // 输入防抖搜索
  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (debounceTimer) clearTimeout(debounceTimer);

    if (!q) {
      showView('hint');
      return;
    }

    debounceTimer = setTimeout(() => {
      doSearch(q, 1);
    }, 300);
  });

  // 键盘快捷键
  input.addEventListener('keydown', (e) => {
    const items = getItems();
    const count = items.length;

    switch (e.key) {
      case 'ArrowDown':
        e.preventDefault();
        if (count > 0) {
          activeIndex = (activeIndex + 1) % count;
          updateActiveItem();
        }
        break;

      case 'ArrowUp':
        e.preventDefault();
        if (count > 0) {
          activeIndex = activeIndex <= 0 ? count - 1 : activeIndex - 1;
          updateActiveItem();
        }
        break;

      case 'Enter':
        e.preventDefault();
        if (activeIndex >= 0 && activeIndex < count) {
          const link = items[activeIndex].querySelector('a') as HTMLAnchorElement;
          if (link) {
            closeSearch();
            window.location.href = link.href;
          }
        }
        break;

      case 'Escape':
        e.preventDefault();
        closeSearch();
        break;
    }
  });

  // 全局快捷键：Ctrl+K / Cmd+K 打开搜索
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (isOpen) {
        closeSearch();
      } else {
        openSearch();
      }
    }

    // ESC 全局关闭
    if (e.key === 'Escape' && isOpen) {
      closeSearch();
    }
  });

  // 搜索按钮绑定（NavBar 中的两个搜索按钮）
  // 1) 固定元素中的 #search-toggle
  document.getElementById('search-toggle')?.addEventListener('click', openSearch);

  // 2) navbar 内部的搜索按钮（通过 aria-label 定位）
  document.querySelectorAll('.navbar-inner-actions .navbar-action-btn[aria-label="搜索"]').forEach(btn => {
    btn.addEventListener('click', openSearch);
  });
</script>
