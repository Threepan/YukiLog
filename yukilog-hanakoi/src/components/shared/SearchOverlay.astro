---
// ================================
// 全局搜索弹窗组件
// 全屏遮罩 + 居中搜索面板
// 支持防抖搜索、键盘导航、Ctrl+K 快捷键
// ================================

import { svgIcons } from '../../lib/svg-icons';
import { contentConfig } from '../../lib/config';

const sc = contentConfig.components.search;
---

<div class="search-overlay" id="search-overlay"
  data-hint={sc.hint}
  data-loading={sc.loading}
  data-no-result={sc.noResult}
  data-prev={sc.prevPage}
  data-next={sc.nextPage}
>
  <div class="search-backdrop" id="search-backdrop"></div>
  
  <div class="search-panel">
    <!-- 搜索输入区域 -->
    <div class="search-header">
      <div class="search-input-wrapper">
        <span class="search-input-icon" set:html={svgIcons.search}></span>
        <input
          type="text"
          id="search-input"
          class="search-input"
          placeholder={sc.placeholder}
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd">ESC</kbd>
      </div>
    </div>

    <!-- 搜索结果区域 -->
    <div class="search-body" id="search-body">
      <!-- 初始提示 -->
      <div class="search-hint" id="search-hint">
        <p>{sc.hint}</p>
        <div class="search-hint-shortcuts">
          <span><kbd>↑</kbd><kbd>↓</kbd> {sc.keyboard.navigate}</span>
          <span><kbd>Enter</kbd> {sc.keyboard.open}</span>
          <span><kbd>ESC</kbd> {sc.keyboard.close}</span>
        </div>
      </div>

      <!-- 加载中 -->
      <div class="search-loading" id="search-loading" style="display:none">
        <div class="search-spinner"></div>
        <p>{sc.loading}</p>
      </div>

      <!-- 无结果 -->
      <div class="search-empty" id="search-empty" style="display:none">
        <p>{sc.noResult}</p>
      </div>

      <!-- 结果列表 -->
      <div class="search-results" id="search-results" style="display:none">
        <ul class="search-result-list" id="search-result-list"></ul>
        <div class="search-pagination" id="search-pagination"></div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  // 遮罩层
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: $z-modal;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 12vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity $transition-base $ease-gentle,
                visibility $transition-base $ease-gentle;

    &.active {
      opacity: 1;
      visibility: visible;

      .search-panel {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }
  }

  .search-backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay-bg);
    backdrop-filter: blur(8px);
    animation: fadeIn $transition-base $ease-gentle;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  // 搜索面板
  .search-panel {
    position: relative;
    width: 90%;
    max-width: 680px;
    max-height: 70vh;
    background: var(--color-white);
    border-radius: $radius-lg;
    box-shadow: 0 20px 60px var(--shadow-2xl), 
                0 0 0 1px var(--blue-alpha-10);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: translateY(-20px) scale(0.95);
    opacity: 0;
    transition: transform $transition-base $ease-gentle,
                opacity $transition-base $ease-gentle;
  }

  // 搜索输入区域
  .search-header {
    padding: $spacing-md $spacing-lg;
    background: linear-gradient(135deg, var(--blue-alpha-02) 0%, var(--pink-alpha-02) 100%);
    border-bottom: 2px solid var(--blue-alpha-08);
    flex-shrink: 0;
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-xs $spacing-sm;
    background: var(--color-white);
    border: 2px solid $lian-border;
    border-radius: $radius-sm;
    transition: all $transition-base $ease-gentle;

    &:focus-within {
      border-color: $lian-blue;
      box-shadow: 0 0 0 4px var(--blue-alpha-10);
      transform: translateY(-2px);
    }
  }

  .search-input-icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 0 0 1.48-5.34c-.47-2.78-2.79-5-5.59-5.34a6.505 6.505 0 0 0-7.27 7.27c.34 2.8 2.56 5.12 5.34 5.59a6.5 6.5 0 0 0 5.34-1.48l.27.28v.79l4.25 4.25c.41.41 1.08.41 1.49 0 .41-.41.41-1.08 0-1.49L15.5 14zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>');
    mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 0 0 1.48-5.34c-.47-2.78-2.79-5-5.59-5.34a6.505 6.505 0 0 0-7.27 7.27c.34 2.8 2.56 5.12 5.34 5.59a6.5 6.5 0 0 0 5.34-1.48l.27.28v.79l4.25 4.25c.41.41 1.08.41 1.49 0 .41-.41.41-1.08 0-1.49L15.5 14zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>');
    -webkit-mask-size: contain;
    mask-size: contain;
    display: flex;
    align-items: center;
    justify-content: center;

    :global(svg) {
      display: none;
    }
  }

  .search-input {
    flex: 1;
    border: none;
    outline: none;
    background: none;
    font-size: $font-size-base;
    color: $lian-text;
    font-family: $font-family-base;
    padding: 0;

    &::placeholder {
      color: $lian-text-muted;
    }
  }

  .search-kbd {
    flex-shrink: 0;
    padding: 3px 10px;
    font-size: $font-size-xs;
    font-family: $font-family-code;
    font-weight: $font-weight-medium;
    color: $lian-text;
    background: var(--gradient-blue-pink);
    border: 1px solid var(--blue-alpha-20);
    border-radius: 6px;
    line-height: 1.4;
    box-shadow: 0 1px 3px var(--shadow-xs);
  }

  // 搜索结果区域
  .search-body {
    flex: 1;
    overflow-y: auto;
    padding: $spacing-sm $spacing-md $spacing-md;

    // 自定义滚动条
    &::-webkit-scrollbar {
      width: 4px;
    }
    &::-webkit-scrollbar-track {
      background: transparent;
    }
    &::-webkit-scrollbar-thumb {
      background: $lian-border;
      border-radius: 2px;
    }
  }

  // 初始提示
  .search-hint,
  .search-loading,
  .search-empty {
    padding: $spacing-xl 0;
    text-align: center;
    color: $lian-text-muted;

    p {
      margin: 0;
      font-size: $font-size-sm;
    }
  }

  .search-hint-shortcuts {
    display: flex;
    justify-content: center;
    gap: $spacing-lg;
    margin-top: $spacing-md;
    font-size: $font-size-sm;
    color: $lian-text;

    kbd {
      padding: 3px 8px;
      font-family: $font-family-code;
      font-weight: $font-weight-medium;
      background: var(--gradient-blue-pink);
      border: 1px solid var(--blue-alpha-20);
      border-radius: 4px;
      font-size: $font-size-xs;
      margin: 0 3px;
      box-shadow: 0 1px 3px var(--shadow-xs);
    }
  }

  // 加载动画
  .search-spinner {
    width: 32px;
    height: 32px;
    margin: 0 auto $spacing-md;
    border: 3px solid var(--border-alpha-30);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: search-spin 600ms linear infinite;
  }

  @keyframes search-spin {
    to { transform: rotate(360deg); }
  }

  // 结果列表
  .search-result-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }

  .search-result-item {
    background: var(--color-white);
    border: 1px solid $lian-divider;
    border-radius: $radius-sm;
    transition: all $transition-base $ease-gentle;
    box-shadow: 0 1px 3px var(--shadow-xs);

    &.active,
    &:hover {
      background: linear-gradient(135deg, var(--blue-alpha-03) 0%, var(--pink-alpha-03) 100%);
      border-color: var(--blue-alpha-20);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px var(--blue-alpha-15);
    }

    a {
      display: block;
      padding: $spacing-md $spacing-lg;
      text-decoration: none;
      color: inherit;
    }
  }

  .search-result-title {
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    color: $lian-text;
    margin: 0 0 $spacing-sm;
    line-height: $line-height-tight;

    :global(mark) {
      background: linear-gradient(135deg, var(--blue-alpha-15) 0%, var(--pink-alpha-15) 100%);
      color: $lian-blue;
      padding: 2px 6px;
      border-radius: 4px;
      font-weight: $font-weight-bold;
      border: 1px solid var(--blue-alpha-20);
    }
  }

  .search-result-excerpt {
    font-size: $font-size-sm;
    color: $lian-text-light;
    line-height: $line-height-relaxed;
    margin: 0 0 $spacing-sm;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    :global(mark) {
      background: linear-gradient(135deg, var(--pink-alpha-12) 0%, var(--pink-alpha-18) 100%);
      color: $lian-pink;
      padding: 1px 4px;
      border-radius: 3px;
      font-weight: $font-weight-medium;
    }
  }

  .search-result-meta {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    font-size: $font-size-xs;
    color: $lian-text-muted;
  }

  .search-result-tag {
    display: inline-block;
    padding: 2px 10px;
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: $lian-pink;
    background: linear-gradient(135deg, var(--pink-alpha-08) 0%, var(--pink-alpha-12) 100%);
    border: 1px solid var(--pink-alpha-20);
    border-radius: 12px;
    transition: all $transition-fast $ease-gentle;

    &:hover {
      background: linear-gradient(135deg, var(--pink-alpha-15) 0%, var(--pink-alpha-20) 100%);
      transform: scale(1.05);
    }
  }

  // 分页
  .search-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: $spacing-xs;
    padding-top: $spacing-sm;

    &:empty {
      display: none;
    }
  }

  .search-page-btn {
    padding: $spacing-xs $spacing-md;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    box-shadow: var(--shadow-blue-sm);

    &:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: var(--shadow-blue-lg);
    }

    &:active:not(:disabled) {
      transform: translateY(0);
    }

    &:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      transform: none;
    }
  }

  .search-page-info {
    font-size: $font-size-sm;
    color: $lian-text;
    font-family: $font-family-code;
    font-weight: $font-weight-medium;
    padding: $spacing-xs $spacing-sm;
    background: var(--gradient-blue-pink);
    border-radius: $radius-sm;
  }

  // 响应式
  @media (max-width: $container-sm) {
    .search-overlay {
      padding-top: 6vh;
    }

    .search-panel {
      width: 95%;
      max-height: 80vh;
    }

    .search-hint-shortcuts {
      flex-direction: column;
      gap: $spacing-xs;
    }
  }
</style>

<script>
  import { postsApi } from '../../lib/api';
  import type { PostWithRelations } from '../../types/api';

  declare global {
    interface Window {
      __yukilogSearchCleanup?: () => void;
    }
  }

  document.addEventListener('astro:page-load', () => {
    window.__yukilogSearchCleanup?.();

    // ============ DOM 元素 ============
    const overlay = document.getElementById('search-overlay');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const hint = document.getElementById('search-hint');
    const loading = document.getElementById('search-loading');
    const empty = document.getElementById('search-empty');
    const results = document.getElementById('search-results');
    const resultList = document.getElementById('search-result-list');
    const pagination = document.getElementById('search-pagination');

    if (!overlay || !backdrop || !input || !hint || !loading || !empty || !results || !resultList || !pagination) {
      window.__yukilogSearchCleanup = undefined;
      return;
    }

    // ============ 状态 ============
    let isOpen = false;
    let activeIndex = -1;
    let currentPage = 1;
    let currentQuery = '';
    let debounceTimer: ReturnType<typeof setTimeout> | null = null;
    const PAGE_SIZE = 8;

    // ============ 打开 / 关闭 ============
    function openSearch() {
      isOpen = true;
      overlay!.classList.add('active');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => input!.focus());
    }

    function closeSearch() {
      isOpen = false;
      overlay!.classList.remove('active');
      document.body.style.overflow = '';
      input!.value = '';
      currentQuery = '';
      currentPage = 1;
      activeIndex = -1;
      showView('hint');
    }

    // ============ 视图切换 ============
    function showView(view: 'hint' | 'loading' | 'empty' | 'results') {
      hint!.style.display = view === 'hint' ? '' : 'none';
      loading!.style.display = view === 'loading' ? '' : 'none';
      empty!.style.display = view === 'empty' ? '' : 'none';
      results!.style.display = view === 'results' ? '' : 'none';
    }

    // ============ 搜索逻辑 ============
    async function doSearch(query: string, page: number) {
      if (!query.trim()) {
        showView('hint');
        return;
      }

      showView('loading');
      currentQuery = query;
      currentPage = page;

      try {
        const data = await postsApi.search({
          q: query,
          page,
          page_size: PAGE_SIZE,
        });

        if (data.items.length === 0) {
          showView('empty');
          return;
        }

        renderResults(data.items);
        renderPagination(data.page, data.total_pages, data.total);
        showView('results');
        activeIndex = -1;
        updateActiveItem();
      } catch {
        showView('empty');
      }
    }

    // ============ 渲染结果 ============
    function renderResults(items: PostWithRelations[]) {
      resultList!.innerHTML = items.map((item, i) => {
        const post = item.post;
        const date = new Date(post.created_at).toLocaleDateString('zh-CN', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        const tags = item.tags.map(t => `<span class="search-result-tag">#${t.name}</span>`).join('');
        const summary = post.summary || '';
        const content = post.content || '';
        const excerpt = summary || content;

        return `
          <li class="search-result-item" data-index="${i}">
            <a href="/posts/${post.slug}">
              <div class="search-result-title">${post.title}</div>
              ${excerpt ? `<div class="search-result-excerpt">${excerpt}</div>` : ''}
              <div class="search-result-meta">
                <time>${date}</time>
                ${tags}
              </div>
            </a>
          </li>
        `;
      }).join('');
    }

    function renderPagination(page: number, totalPages: number, total: number) {
      if (totalPages <= 1) {
        pagination!.innerHTML = '';
        return;
      }

      const overlayEl = document.getElementById('search-overlay')!;
      const prevText = overlayEl.dataset.prev || '上一页';
      const nextText = overlayEl.dataset.next || '下一页';

      pagination!.innerHTML = `
        <button class="search-page-btn" id="search-prev" ${page <= 1 ? 'disabled' : ''}>${prevText}</button>
        <span class="search-page-info">${page} / ${totalPages}（共 ${total} 篇）</span>
        <button class="search-page-btn" id="search-next" ${page >= totalPages ? 'disabled' : ''}>${nextText}</button>
      `;

      document.getElementById('search-prev')?.addEventListener('click', () => {
        if (currentPage > 1) doSearch(currentQuery, currentPage - 1);
      });
      document.getElementById('search-next')?.addEventListener('click', () => {
        if (currentPage < totalPages) doSearch(currentQuery, currentPage + 1);
      });
    }

    // ============ 键盘导航 ============
    function getItems(): NodeListOf<Element> {
      return resultList!.querySelectorAll('.search-result-item');
    }

    function updateActiveItem() {
      const items = getItems();
      items.forEach((el, i) => {
        el.classList.toggle('active', i === activeIndex);
        if (i === activeIndex) {
          el.scrollIntoView({ block: 'nearest' });
        }
      });
    }

    // ============ 事件绑定 ============
    backdrop.addEventListener('click', closeSearch);

    input.addEventListener('input', () => {
      const q = input!.value.trim();
      if (debounceTimer) clearTimeout(debounceTimer);

      if (!q) {
        showView('hint');
        return;
      }

      debounceTimer = setTimeout(() => {
        doSearch(q, 1);
      }, 300);
    });

    input.addEventListener('keydown', (e) => {
      const items = getItems();
      const count = items.length;

      switch (e.key) {
        case 'ArrowDown':
          e.preventDefault();
          if (count > 0) {
            activeIndex = (activeIndex + 1) % count;
            updateActiveItem();
          }
          break;

        case 'ArrowUp':
          e.preventDefault();
          if (count > 0) {
            activeIndex = activeIndex <= 0 ? count - 1 : activeIndex - 1;
            updateActiveItem();
          }
          break;

        case 'Enter':
          e.preventDefault();
          if (activeIndex >= 0 && activeIndex < count) {
            const link = items[activeIndex].querySelector('a') as HTMLAnchorElement;
            if (link) {
              closeSearch();
              window.location.href = link.href;
            }
          }
          break;

        case 'Escape':
          e.preventDefault();
          closeSearch();
          break;
      }
    });

    // 全局快捷键：Ctrl+K / Cmd+K
    const onGlobalKeydown = (e: KeyboardEvent) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
        e.preventDefault();
        if (isOpen) {
          closeSearch();
        } else {
          openSearch();
        }
      }

      if (e.key === 'Escape' && isOpen) {
        closeSearch();
      }
    };

    document.addEventListener('keydown', onGlobalKeydown);

    // 搜索按钮绑定
    document.getElementById('search-toggle')?.addEventListener('click', openSearch);
    document.querySelectorAll('.navbar-inner-actions .navbar-action-btn[aria-label="搜索"]').forEach(btn => {
      btn.addEventListener('click', openSearch);
    });

    window.__yukilogSearchCleanup = () => {
      document.removeEventListener('keydown', onGlobalKeydown);
    };
  });
</script>
