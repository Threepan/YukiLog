---
// ================================
// 背景音乐播放器
// 自动循环播放，带淡入淡出效果
// ================================

// 导入音乐文件
const musicUrl = await import('../../assets/music/时空漫步.mp3?url');
---

<audio id="bg-music" loop preload="auto">
  <source src={musicUrl.default} type="audio/mpeg" />
</audio>

<style lang="scss">
  audio {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>

<script>
  const audio = document.getElementById('bg-music') as HTMLAudioElement;
  
  if (!audio) {
    throw new Error('Music player audio element not found');
  }
  
  const fadeInDuration = 800;
  const maxVolume = 0.4;
  const STORAGE_KEY = 'yukilog-music';
  let started = false;
  
  // 从 sessionStorage 恢复播放进度
  function restoreProgress() {
    try {
      const saved = sessionStorage.getItem(STORAGE_KEY);
      if (saved) {
        const { time, timestamp } = JSON.parse(saved);
        // 页面切换耗时补偿（估算经过的时间）
        const elapsed = (Date.now() - timestamp) / 1000;
        const resumeTime = time + elapsed;
        if (resumeTime > 0 && isFinite(resumeTime) && resumeTime < audio.duration) {
          audio.currentTime = resumeTime;
        } else if (resumeTime > 0 && isFinite(resumeTime)) {
          // duration 还没加载好，等 loadedmetadata 后再设置
          audio.addEventListener('loadedmetadata', () => {
            if (resumeTime < audio.duration) {
              audio.currentTime = resumeTime;
            }
          }, { once: true });
        }
      }
    } catch {}
  }

  // 定期保存播放进度
  function saveProgress() {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
        time: audio.currentTime,
        timestamp: Date.now(),
      }));
    } catch {}
  }

  // 页面离开时保存
  window.addEventListener('beforeunload', saveProgress);
  // 每 2 秒保存一次
  setInterval(saveProgress, 2000);
  
  function fadeIn() {
    const startTime = Date.now();
    const fadeInterval = setInterval(() => {
      const elapsed = Date.now() - startTime;
      const progress = Math.min(elapsed / fadeInDuration, 1);
      const easedProgress = progress * (2 - progress);
      audio.volume = easedProgress * maxVolume;
      if (progress >= 1) clearInterval(fadeInterval);
    }, 30);
  }
  
  function tryPlay() {
    if (started) return;
    audio.volume = 0;
    restoreProgress();
    
    const p = audio.play();
    if (p) {
      p.then(() => {
        started = true;
        fadeIn();
        cleanup();
      }).catch(() => {});
    }
  }
  
  function cleanup() {
    events.forEach(e => document.removeEventListener(e, tryPlay));
  }
  
  const events = ['click', 'touchstart', 'scroll', 'keydown', 'mousemove', 'pointerdown'];
  
  tryPlay();
  
  events.forEach(e =>
    document.addEventListener(e, tryPlay, { passive: true })
  );
  
  let retryCount = 0;
  const retryInterval = setInterval(() => {
    if (started || retryCount > 20) {
      clearInterval(retryInterval);
      return;
    }
    tryPlay();
    retryCount++;
  }, 250);
</script>
