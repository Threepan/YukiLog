---
// ================================
// 申请友链 Modal 表单
// 温柔的信封风格弹窗
// ================================

import { API_BASE_URL, contentConfig } from '../../lib/config';
import { svgIcons } from '../../lib/svg-icons';

const applyConfig = contentConfig.components.applyLinkModal;
---

<!-- 触发按钮 -->
<div class="apply-section" id="apply-section">
  <p class="apply-hint">{applyConfig.hint}</p>
  <button class="apply-btn" id="apply-link-btn" type="button">
    <span set:html={svgIcons.envelope}></span>
    <span>{applyConfig.triggerButton}</span>
  </button>
</div>

<!-- Modal 遮罩 + 弹窗 -->
<div class="modal-overlay" id="apply-modal" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-label="申请友链">
    <button class="modal-close" id="modal-close" type="button" aria-label="关闭">
      <span set:html={svgIcons.close}></span>
    </button>

    <h3 class="modal-title">{applyConfig.title}</h3>
    <p class="modal-subtitle">{applyConfig.subtitle}</p>

    <form class="apply-form" id="apply-form">
      <div class="form-group">
        <label for="link-title">站点名称 <span class="required">*</span></label>
        <input type="text" id="link-title" name="title" required placeholder="你的站点叫什么？" maxlength="50" />
      </div>

      <div class="form-group">
        <label for="link-url">站点地址 <span class="required">*</span></label>
        <input type="url" id="link-url" name="url" required placeholder="https://..." maxlength="200" />
      </div>

      <div class="form-group">
        <label for="link-avatar">头像地址</label>
        <input type="url" id="link-avatar" name="avatar" placeholder="https://...（可选）" maxlength="300" />
      </div>

      <div class="form-group">
        <label for="link-desc">一句话介绍</label>
        <textarea id="link-desc" name="description" placeholder="用一句话描述你的站点吧（可选）" maxlength="100" rows="2"></textarea>
      </div>

      <button type="submit" class="submit-btn" id="submit-btn">
        <span class="submit-text">{applyConfig.submitText}</span>
        <span class="submit-loading" style="display:none;">{applyConfig.submitLoadingText}</span>
      </button>

      <p class="form-result" id="form-result"></p>
    </form>
  </div>
</div>

<style lang="scss">
@use "sass:color";

  // 申请区域
  .apply-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-xxl 0 $spacing-xl;
    opacity: 0;
    animation: fade-up 500ms $ease-gentle 800ms forwards;
  }

  @keyframes fade-up {
    to {
      opacity: 1;
      transform: translateY(0);
    }
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .apply-hint {
    font-size: $font-size-sm;
    color: $lian-text-muted;
    margin: 0;
  }

  .apply-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 28px;
    background: $lian-white;
    border: 1px solid $lian-border;
    border-radius: $radius-md;
    box-shadow: $shadow-pink;
    color: $lian-text;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    cursor: pointer;
    transition:
      box-shadow $transition-base $ease-gentle,
      border-color $transition-base $ease-gentle,
      transform $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;

    svg {
      color: $lian-pink;
      transition: transform $transition-fast $ease-gentle;
    }

    &:hover {
      box-shadow: $shadow-pink-hover;
      border-color: $lian-pink;
      color: $lian-pink;

      svg {
        transform: translateY(-2px);
      }
    }

    &:active {
      transform: scale(0.97);
    }
  }

  // Modal 遮罩
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: $z-modal;
    display: flex;
    align-items: center;
    justify-content: center;
    background: $overlay-bg;
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms $ease-gentle;

    &.open {
      opacity: 1;
      pointer-events: auto;

      .modal-card {
        transform: translateY(0) scale(1);
        opacity: 1;
      }
    }
  }

  // Modal 卡片
  .modal-card {
    position: relative;
    width: 90%;
    max-width: 440px;
    max-height: 90vh;
    overflow-y: auto;
    background: $lian-white;
    border-radius: $radius-xl;
    box-shadow: $shadow-pink, 0 20px 60px rgba(0, 0, 0, 0.1);
    padding: $spacing-xl $spacing-xl $spacing-lg;
    transform: translateY(20px) scale(0.97);
    opacity: 0;
    transition:
      transform 300ms $ease-gentle,
      opacity 300ms $ease-gentle;
  }

  .modal-close {
    position: absolute;
    top: $spacing-sm;
    right: $spacing-sm;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: none;
    color: $lian-text-muted;
    cursor: pointer;
    border-radius: 50%;
    transition:
      background $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;

    &:hover {
      background: $lian-bg;
      color: $lian-text;
    }
  }

  .modal-title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: $lian-text;
    margin: 0;
  }

  .modal-subtitle {
    font-size: $font-size-sm;
    color: $lian-text-muted;
    margin: $spacing-xs 0 $spacing-lg;
  }

  // 表单
  .apply-form {
    display: flex;
    flex-direction: column;
    gap: $spacing-md;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;

    label {
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text;

      .required {
        color: $lian-pink;
      }
    }

    input,
    textarea {
      width: 100%;
      padding: 10px 14px;
      border: 1px solid $lian-border;
      border-radius: $radius-sm;
      font-size: $font-size-sm;
      font-family: $font-family-base;
      color: $lian-text;
      background: white;
      transition:
        border-color $transition-fast $ease-gentle,
        box-shadow $transition-fast $ease-gentle;
      outline: none;
      box-sizing: border-box;

      &::placeholder {
        color: $lian-text-muted;
      }

      &:focus {
        border-color: $lian-pink;
        box-shadow: 0 0 0 3px rgba($lian-pink, 0.1);
      }
    }

    textarea {
      resize: vertical;
      min-height: 60px;
    }
  }

  .submit-btn {
    width: 100%;
    padding: 12px 0;
    border: none;
    border-radius: $radius-sm;
    background: linear-gradient(135deg, $lian-pink, color.adjust($lian-pink, $lightness: 8%));
    color: white;
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    cursor: pointer;
    transition:
      opacity $transition-fast $ease-gentle,
      transform $transition-fast $ease-gentle;

    &:hover {
      opacity: 0.9;
    }

    &:active {
      transform: scale(0.98);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  .form-result {
    font-size: $font-size-sm;
    text-align: center;
    margin: 0;
    min-height: 1.4em;

    &.success {
      color: $lian-success;
    }

    &.error {
      color: $lian-error;
    }
  }
</style>

<script define:vars={{ API_BASE_URL }}>
  (function () {
    const openBtn = document.getElementById('apply-link-btn');
    const modal = document.getElementById('apply-modal');
    const closeBtn = document.getElementById('modal-close');
    const form = document.getElementById('apply-form');
    const result = document.getElementById('form-result');
    const submitBtn = document.getElementById('submit-btn');
    if (!openBtn || !modal || !closeBtn || !form || !result || !submitBtn) return;

    function openModal() {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);

    // 点击遮罩关闭
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });

    // ESC 关闭
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });

    // 提交表单
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = {
        title: formData.get('title'),
        url: formData.get('url'),
        avatar: formData.get('avatar') || null,
        description: formData.get('description') || null,
      };

      const textEl = submitBtn.querySelector('.submit-text');
      const loadingEl = submitBtn.querySelector('.submit-loading');

      try {
        submitBtn.disabled = true;
        if (textEl) textEl.style.display = 'none';
        if (loadingEl) loadingEl.style.display = 'inline';

        const res = await fetch(`${API_BASE_URL}/api/public/links/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const json = await res.json();

        if (json.success) {
          result.textContent = '✨ 信已寄出，恋收到后会认真查看的';
          result.className = 'form-result success';
          form.reset();
          setTimeout(closeModal, 2000);
        } else {
          result.textContent = json.message || '寄送失败了，请稍后再试';
          result.className = 'form-result error';
        }
      } catch {
        result.textContent = '网络出了点问题，请稍后再试';
        result.className = 'form-result error';
      } finally {
        submitBtn.disabled = false;
        if (textEl) textEl.style.display = 'inline';
        if (loadingEl) loadingEl.style.display = 'none';
      }
    });
  })();
</script>
