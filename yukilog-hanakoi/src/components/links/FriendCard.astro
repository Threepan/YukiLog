---
// ================================
// 友链卡片 - 散落便签风格
// 微旋转 + 悬停拿起效果
// ================================

interface Props {
  name: string;
  description: string | null;
  avatar: string | null;
  url: string;
  index: number;
}

const { name, description, avatar, url, index } = Astro.props;

// 根据 index 产生确定性的微小旋转角度（±1°~±3°）
const rotations = [-2.5, 1.8, -1.2, 3, -1.8, 2.2, -2.8, 1.5, -0.8, 2.6];
const rotation = rotations[index % rotations.length];

// 交替粉蓝阴影
const isPink = index % 2 === 0;
---

<a
  href={url}
  target="_blank"
  rel="noopener"
  class:list={["friend-card", { pink: isPink, blue: !isPink }]}
  style={`--rotation: ${rotation}deg`}
  data-index={index}
>
  <div class="friend-avatar-wrap">
    {avatar ? (
      <img src={avatar} alt={name} class="friend-avatar" loading="lazy" />
    ) : (
      <div class="friend-avatar friend-avatar-fallback">
        {name.charAt(0)}
      </div>
    )}
  </div>

  <div class="friend-info">
    <span class="friend-name">{name}</span>
    {description && <span class="friend-desc">{description}</span>}
  </div>
</a>

<style lang="scss">
  .friend-card {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-sm $spacing-md;
    background: $lian-white;
    border-radius: $radius-md;
    text-decoration: none;
    color: $lian-text;
    transform: rotate(var(--rotation));
    transition:
      transform 300ms $ease-gentle,
      box-shadow 300ms $ease-gentle;

    // 入场动画
    opacity: 0;
    animation: card-enter 500ms $ease-gentle forwards;
    animation-delay: calc(var(--i, 0) * 80ms + 400ms);

    &.pink {
      box-shadow: $shadow-pink;
    }

    &.blue {
      box-shadow: $shadow-blue;
    }

    // 悬停："拿起来"
    &:hover {
      transform: rotate(0deg) translateY(-6px) scale(1.04);
      z-index: 2;

      &.pink {
        box-shadow: $shadow-pink-hover;
      }

      &.blue {
        box-shadow: $shadow-blue-hover;
      }

      .friend-avatar {
        transform: scale(1.1);
      }
    }

    &:active {
      transform: rotate(0deg) translateY(-2px) scale(1.01);
    }
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: rotate(var(--rotation)) translateY(20px);
    }
    to {
      opacity: 1;
      transform: rotate(var(--rotation));
    }
  }

  .friend-avatar-wrap {
    flex-shrink: 0;
  }

  .friend-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
    transition: transform $transition-fast $ease-gentle;
  }

  .friend-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, $lian-pink, $lian-blue);
    color: white;
    font-size: $font-size-lg;
    font-weight: $font-weight-semibold;
  }

  .friend-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .friend-name {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-desc {
    font-size: $font-size-xs;
    color: $lian-text-light;
    line-height: $line-height-base;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
