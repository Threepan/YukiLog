---
// ================================
// 最好的朋友 - 信封展开式设计
// 模拟收到一封来信的仪式感体验
// ================================

interface Props {
  name: string;
  description: string;
  avatar: string;
  url: string;
  message: string; // 寄语
  friendSince: string;
  greeting: string;
  sinceLabel: string;
  visitText: string;
}

import { svgIcons } from '../../lib/svg-icons';

const { name, description, avatar, url, message, friendSince, greeting, sinceLabel, visitText } = Astro.props;
---

<section class="friend-letter-section" id="friend-spotlight">
  <!-- 信封容器 -->
  <div class="envelope-container">
    <!-- 信封主体 -->
    <div class="envelope">
      <div class="envelope-flap"></div>
      <div class="envelope-body"></div>
    </div>

    <!-- 信纸 -->
    <a href={url} target="_blank" rel="noopener" class="letter-paper">
      <!-- 蜡封印章（头像） -->
      <div class="wax-seal">
        <div class="seal-glow"></div>
        <img src={avatar} alt={name} class="seal-avatar" loading="eager" />
        <div class="seal-decoration"></div>
      </div>

      <!-- 信纸内容 -->
      <div class="letter-content">
        <p class="letter-greeting">{greeting}</p>
        <h2 class="letter-name">{name}</h2>
        <p class="letter-desc">{description}</p>
        
        <blockquote class="letter-message">
          <span class="quote-mark-left">"</span>
          {message}
          <span class="quote-mark-right">"</span>
        </blockquote>

        <div class="letter-meta">
          <span class="letter-date">{sinceLabel} {friendSince}</span>
        </div>
      </div>

      <!-- 访问按钮 -->
      <div class="letter-action">
        <span class="action-text">
          {visitText}
          <span class="action-icon" set:html={svgIcons.arrowRightLine}></span>
        </span>
      </div>
    </a>
  </div>
</section>

<style>
/* ================================ */
  /* 信封展开式设计 */
  /* ================================ */
  
  .friend-letter-section {
    display: flex;
    justify-content: center;
    padding: var(--spacing-xxl) 0 calc(var(--spacing-xxl) * 1.5);
    perspective: 1000px; /* 3D 视角 */
  }

  .envelope-container {
    position: relative;
    width: min(540px, 100%);
    min-height: 480px;
  }

  /* ================================ */
  /* 信封 */
  /* ================================ */
  .envelope {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 460px;
    height: 280px;
    z-index: 1;
    opacity: 0;
    animation: envelope-appear 500ms var(--ease-gentle) 200ms forwards;
  }

  @keyframes envelope-appear {
    to { opacity: 1; }
  }

  /* 信封主体 */
  .envelope-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(135deg, 
      var(--color-pink-l15) 0%,
      var(--color-pink-l10) 100%
    );
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    box-shadow: 
      0 4px 16px rgba(232, 164, 180, 0.2),
      inset 0 -2px 8px rgba(250, 250, 250, 0.3);
  }

  /* 信封盖（三角形） */
  .envelope-flap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(180deg,
      var(--color-pink-l12) 0%,
      var(--color-pink-l8) 100%
    );
    clip-path: polygon(0 0, 50% 60%, 100% 0);
    transform-origin: top center;
    box-shadow: 0 2px 12px rgba(232, 164, 180, 0.3);
    animation: flap-open 600ms var(--ease-out) 400ms forwards;
  }

  @keyframes flap-open {
    from {
      transform: rotateX(0deg);
    }
    to {
      transform: rotateX(-120deg);
    }
  }

  /* ================================ */
  /* 信纸 */
  /* ================================ */
  .letter-paper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    padding: var(--spacing-xxl) calc(var(--spacing-xl) * 1.5) var(--spacing-xl);
    background: 
      repeating-linear-gradient(
        transparent,
        transparent 31px,
        var(--muted-alpha-08) 31px,
        var(--muted-alpha-08) 32px
      ),
      linear-gradient(to bottom,
        var(--color-white) 0%,
        var(--color-white) 100%
      );
    border-radius: var(--radius-lg);
    box-shadow: 
      0 8px 32px rgba(44, 62, 80, 0.12),
      0 2px 8px rgba(232, 164, 180, 0.08);
    text-decoration: none;
    color: var(--color-text);
    z-index: 2;
    
    transform: translateY(60px);
    opacity: 0;
    animation: letter-slide-out 800ms var(--ease-out) 600ms forwards;

    transition: 
      transform 400ms var(--ease-gentle),
      box-shadow 400ms var(--ease-gentle);

    &:hover {
      transform: translateY(-6px);
      box-shadow: 
        0 12px 48px rgba(44, 62, 80, 0.16),
        0 4px 16px rgba(232, 164, 180, 0.2);

      .seal-avatar {
        transform: rotate(5deg) scale(1.05);
      }

      .action-icon svg {
        transform: translateX(4px);
      }
    }
  }

  @keyframes letter-slide-out {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  /* ================================ */
  /* 蜡封印章 */
  /* ================================ */
  .wax-seal {
    position: relative;
    width: 100px;
    height: 100px;
    margin-top: -50px;
    margin-bottom: var(--spacing-md);
    opacity: 0;
    transform: rotate(-10deg) scale(0.8);
    animation: seal-appear 500ms var(--ease-out) 1000ms forwards;
  }

  @keyframes seal-appear {
    to {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  .seal-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(232, 164, 180, 0.4) 0%,
      transparent 70%
    );
    filter: blur(12px);
    animation: seal-glow-pulse 3s ease-in-out infinite;
  }

  @keyframes seal-glow-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.1); }
  }

  .seal-avatar {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 4px solid var(--color-pink-l5);
    box-shadow: 
      0 0 0 3px rgba(250, 250, 250, 0.5),
      0 4px 16px rgba(232, 164, 180, 0.4),
      inset 0 2px 8px rgba(44, 62, 80, 0.1);
    object-fit: cover;
    transition: transform 400ms var(--ease-gentle);
  }

  .seal-decoration {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px dashed var(--color-pink-d5);
    opacity: 0.3;
  }

  /* ================================ */
  /* 信纸内容 */
  /* ================================ */
  .letter-content {
    width: 100%;
    text-align: left;
    
    > * {
      opacity: 0;
      transform: translateY(10px);
    }

    .letter-greeting {
      animation: line-fade 400ms var(--ease-gentle) 1200ms forwards;
    }
    .letter-name {
      animation: line-fade 400ms var(--ease-gentle) 1300ms forwards;
    }
    .letter-desc {
      animation: line-fade 400ms var(--ease-gentle) 1400ms forwards;
    }
    .letter-message {
      animation: line-fade 400ms var(--ease-gentle) 1500ms forwards;
    }
    .letter-meta {
      animation: line-fade 400ms var(--ease-gentle) 1600ms forwards;
    }
  }

  @keyframes line-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .letter-greeting {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    font-style: italic;
    margin: 0 0 var(--spacing-xs);
  }

  .letter-name {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-pink);
    margin: 0 0 var(--spacing-sm);
    letter-spacing: 0.02em;
  }

  .letter-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-lg);
  }

  .letter-message {
    position: relative;
    padding: var(--spacing-md) var(--spacing-lg);
    background: rgba(232, 164, 180, 0.04);
    border-left: 3px solid var(--color-pink-l10);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: 0 0 var(--spacing-lg);
    font-size: var(--font-size-base);
    font-style: italic;
    font-family: "KaiTi", "楷体", cursive, serif;
    color: var(--color-pink-d10);
    line-height: var(--line-height-relaxed);
    letter-spacing: 0.03em;

    .quote-mark-left,
    .quote-mark-right {
      font-size: var(--font-size-xl);
      font-weight: var(--font-weight-bold);
      font-family: Georgia, serif;
      opacity: 0.4;
      color: var(--color-pink);
    }

    .quote-mark-left {
      margin-right: 4px;
    }

    .quote-mark-right {
      margin-left: 4px;
    }
  }

  .letter-meta {
    display: flex;
    justify-content: flex-end;
    padding-right: var(--spacing-sm);
  }

  .letter-date {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
    
    &::before {
      content: "— ";
    }
  }

  /* ================================ */
  /* 访问按钮 */
  /* ================================ */
  .letter-action {
    margin-top: var(--spacing-lg);
    opacity: 0;
    animation: line-fade 400ms var(--ease-gentle) 1700ms forwards;
  }

  .action-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: linear-gradient(135deg, var(--color-pink), var(--color-pink-l8));
    color: var(--color-white);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px rgba(232, 164, 180, 0.3);
    transition: 
      box-shadow var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);

    svg {
      transition: transform var(--transition-fast) var(--ease-gentle);
    }
  }

  .letter-paper:hover .action-text {
    box-shadow: 0 4px 16px rgba(232, 164, 180, 0.4);
    transform: translateY(-2px);
  }

  /* ================================ */
  /* 响应式 */
  /* ================================ */
  @media (max-width: 640px) {
    .envelope-container {
      margin: 0 var(--spacing-md);
    }

    .letter-paper {
      padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-lg);
    }

    .wax-seal {
      width: 80px;
      height: 80px;
      margin-top: -40px;
    }

    .seal-avatar {
      width: 80px;
      height: 80px;
    }

    .letter-name {
      font-size: var(--font-size-xl);
    }

    .letter-message {
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--font-size-sm);
    }
  }
</style>
