---
// ================================
// 最好的朋友 - 信封展开式设计
// 模拟收到一封来信的仪式感体验
// ================================

interface Props {
  name: string;
  description: string;
  avatar: string;
  url: string;
  message: string; // 寄语
  friendSince: string;
  greeting: string;
  sinceLabel: string;
  visitText: string;
}

import { svgIcons } from '../../lib/svg-icons';

const { name, description, avatar, url, message, friendSince, greeting, sinceLabel, visitText } = Astro.props;
---

<section class="friend-letter-section" id="friend-spotlight">
  <!-- 信封容器 -->
  <div class="envelope-container">
    <!-- 信封主体 -->
    <div class="envelope">
      <div class="envelope-flap"></div>
      <div class="envelope-body"></div>
    </div>

    <!-- 信纸 -->
    <a href={url} target="_blank" rel="noopener" class="letter-paper">
      <!-- 蜡封印章（头像） -->
      <div class="wax-seal">
        <div class="seal-glow"></div>
        <img src={avatar} alt={name} class="seal-avatar" loading="eager" />
        <div class="seal-decoration"></div>
      </div>

      <!-- 信纸内容 -->
      <div class="letter-content">
        <p class="letter-greeting">{greeting}</p>
        <h2 class="letter-name">{name}</h2>
        <p class="letter-desc">{description}</p>
        
        <blockquote class="letter-message">
          <span class="quote-mark-left">"</span>
          {message}
          <span class="quote-mark-right">"</span>
        </blockquote>

        <div class="letter-meta">
          <span class="letter-date">{sinceLabel} {friendSince}</span>
        </div>
      </div>

      <!-- 访问按钮 -->
      <div class="letter-action">
        <span class="action-text">
          {visitText}
          <span class="action-icon" set:html={svgIcons.arrowRightLine}></span>
        </span>
      </div>
    </a>
  </div>
</section>

<style lang="scss">
@use "sass:color";

  // ================================
  // 信封展开式设计
  // ================================
  
  .friend-letter-section {
    display: flex;
    justify-content: center;
    padding: $spacing-xxl 0 $spacing-xxl * 1.5;
    perspective: 1000px; // 3D 视角
  }

  .envelope-container {
    position: relative;
    width: min(540px, 100%);
    min-height: 480px;
  }

  // ================================
  // 信封
  // ================================
  .envelope {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    max-width: 460px;
    height: 280px;
    z-index: 1;
    opacity: 0;
    animation: envelope-appear 500ms $ease-gentle 200ms forwards;
  }

  @keyframes envelope-appear {
    to { opacity: 1; }
  }

  // 信封主体
  .envelope-body {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(135deg, 
      color.adjust($lian-pink, $lightness: 15%) 0%,
      color.adjust($lian-pink, $lightness: 10%) 100%
    );
    border-radius: 0 0 $radius-lg $radius-lg;
    box-shadow: 
      0 4px 16px rgba($lian-pink, 0.2),
      inset 0 -2px 8px rgba($lian-white, 0.3);
  }

  // 信封盖（三角形）
  .envelope-flap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 160px;
    background: linear-gradient(180deg,
      color.adjust($lian-pink, $lightness: 12%) 0%,
      color.adjust($lian-pink, $lightness: 8%) 100%
    );
    clip-path: polygon(0 0, 50% 60%, 100% 0);
    transform-origin: top center;
    box-shadow: 0 2px 12px rgba($lian-pink, 0.3);
    animation: flap-open 600ms $ease-out 400ms forwards;
  }

  @keyframes flap-open {
    from {
      transform: rotateX(0deg);
    }
    to {
      transform: rotateX(-120deg);
    }
  }

  // ================================
  // 信纸
  // ================================
  .letter-paper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    max-width: 480px;
    margin: 0 auto;
    padding: $spacing-xxl $spacing-xl * 1.5 $spacing-xl;
    background: 
      repeating-linear-gradient(
        transparent,
        transparent 31px,
        rgba($lian-text-muted, 0.08) 31px,
        rgba($lian-text-muted, 0.08) 32px
      ),
      linear-gradient(to bottom,
        $lian-paper-warm 0%,
        $lian-paper-warm-light 100%
      );
    border-radius: $radius-lg;
    box-shadow: 
      0 8px 32px rgba($lian-text, 0.12),
      0 2px 8px rgba($lian-pink, 0.08);
    text-decoration: none;
    color: $lian-text;
    z-index: 2;
    
    transform: translateY(60px);
    opacity: 0;
    animation: letter-slide-out 800ms $ease-out 600ms forwards;

    transition: 
      transform 400ms $ease-gentle,
      box-shadow 400ms $ease-gentle;

    &:hover {
      transform: translateY(-6px);
      box-shadow: 
        0 12px 48px rgba($lian-text, 0.16),
        0 4px 16px rgba($lian-pink, 0.2);

      .seal-avatar {
        transform: rotate(5deg) scale(1.05);
      }

      .action-icon svg {
        transform: translateX(4px);
      }
    }
  }

  @keyframes letter-slide-out {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  // ================================
  // 蜡封印章
  // ================================
  .wax-seal {
    position: relative;
    width: 100px;
    height: 100px;
    margin-top: -50px;
    margin-bottom: $spacing-md;
    opacity: 0;
    transform: rotate(-10deg) scale(0.8);
    animation: seal-appear 500ms $ease-out 1000ms forwards;
  }

  @keyframes seal-appear {
    to {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  .seal-glow {
    position: absolute;
    inset: -8px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba($lian-pink, 0.4) 0%,
      transparent 70%
    );
    filter: blur(12px);
    animation: seal-glow-pulse 3s ease-in-out infinite;
  }

  @keyframes seal-glow-pulse {
    0%, 100% { opacity: 0.6; transform: scale(1); }
    50% { opacity: 0.9; transform: scale(1.1); }
  }

  .seal-avatar {
    position: relative;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 4px solid color.adjust($lian-pink, $lightness: 5%);
    box-shadow: 
      0 0 0 3px rgba($lian-white, 0.5),
      0 4px 16px rgba($lian-pink, 0.4),
      inset 0 2px 8px rgba($lian-text, 0.1);
    object-fit: cover;
    transition: transform 400ms $ease-gentle;
  }

  .seal-decoration {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px dashed color.adjust($lian-pink, $lightness: -5%);
    opacity: 0.3;
  }

  // ================================
  // 信纸内容
  // ================================
  .letter-content {
    width: 100%;
    text-align: left;
    
    > * {
      opacity: 0;
      transform: translateY(10px);
    }

    .letter-greeting {
      animation: line-fade 400ms $ease-gentle 1200ms forwards;
    }
    .letter-name {
      animation: line-fade 400ms $ease-gentle 1300ms forwards;
    }
    .letter-desc {
      animation: line-fade 400ms $ease-gentle 1400ms forwards;
    }
    .letter-message {
      animation: line-fade 400ms $ease-gentle 1500ms forwards;
    }
    .letter-meta {
      animation: line-fade 400ms $ease-gentle 1600ms forwards;
    }
  }

  @keyframes line-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .letter-greeting {
    font-size: $font-size-sm;
    color: $lian-text-light;
    font-style: italic;
    margin: 0 0 $spacing-xs;
  }

  .letter-name {
    font-size: $font-size-2xl;
    font-weight: $font-weight-bold;
    color: $lian-pink;
    margin: 0 0 $spacing-sm;
    letter-spacing: 0.02em;
  }

  .letter-desc {
    font-size: $font-size-base;
    color: $lian-text-light;
    line-height: $line-height-relaxed;
    margin: 0 0 $spacing-lg;
  }

  .letter-message {
    position: relative;
    padding: $spacing-md $spacing-lg;
    background: rgba($lian-pink, 0.04);
    border-left: 3px solid color.adjust($lian-pink, $lightness: 10%);
    border-radius: 0 $radius-sm $radius-sm 0;
    margin: 0 0 $spacing-lg;
    font-size: $font-size-base;
    font-style: italic;
    font-family: "KaiTi", "楷体", cursive, serif;
    color: color.adjust($lian-pink, $lightness: -10%);
    line-height: $line-height-relaxed;
    letter-spacing: 0.03em;

    .quote-mark-left,
    .quote-mark-right {
      font-size: $font-size-xl;
      font-weight: $font-weight-bold;
      font-family: Georgia, serif;
      opacity: 0.4;
      color: $lian-pink;
    }

    .quote-mark-left {
      margin-right: 4px;
    }

    .quote-mark-right {
      margin-left: 4px;
    }
  }

  .letter-meta {
    display: flex;
    justify-content: flex-end;
    padding-right: $spacing-sm;
  }

  .letter-date {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    font-style: italic;
    
    &::before {
      content: "— ";
    }
  }

  // ================================
  // 访问按钮
  // ================================
  .letter-action {
    margin-top: $spacing-lg;
    opacity: 0;
    animation: line-fade 400ms $ease-gentle 1700ms forwards;
  }

  .action-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: $spacing-sm $spacing-lg;
    background: linear-gradient(135deg, $lian-pink, color.adjust($lian-pink, $lightness: 8%));
    color: $lian-white;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    border-radius: $radius-lg;
    box-shadow: 0 2px 8px rgba($lian-pink, 0.3);
    transition: 
      box-shadow $transition-fast $ease-gentle,
      transform $transition-fast $ease-gentle;

    svg {
      transition: transform $transition-fast $ease-gentle;
    }
  }

  .letter-paper:hover .action-text {
    box-shadow: 0 4px 16px rgba($lian-pink, 0.4);
    transform: translateY(-2px);
  }

  // ================================
  // 响应式
  // ================================
  @media (max-width: $container-sm) {
    .envelope-container {
      margin: 0 $spacing-md;
    }

    .letter-paper {
      padding: $spacing-xl $spacing-lg $spacing-lg;
    }

    .wax-seal {
      width: 80px;
      height: 80px;
      margin-top: -40px;
    }

    .seal-avatar {
      width: 80px;
      height: 80px;
    }

    .letter-name {
      font-size: $font-size-xl;
    }

    .letter-message {
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-sm;
    }
  }
</style>
