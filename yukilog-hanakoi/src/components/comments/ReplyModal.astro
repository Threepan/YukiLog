---
// ================================
// 回复弹窗组件
// 用于显示回复表单的模态框
// ================================

import CommentForm from './CommentForm.astro';
import { svgIcons } from '../../lib/svg-icons';
import { contentConfig } from '../../lib/config';

const cc = contentConfig.components.comments;

interface Props {
  id?: string; // 弹窗唯一ID
}

const { id = 'reply-modal' } = Astro.props;
---

<div class="reply-modal" id={id} aria-hidden="true">
  <div class="modal-overlay" data-close-modal></div>
  
  <div class="modal-container">
    <div class="modal-header">
      <h3 class="modal-title">
        {cc.replyModalTitle} <span class="reply-to-nick"></span>
      </h3>
      <button class="btn-close" data-close-modal aria-label="关闭弹窗">
        <span class="close-icon" set:html={svgIcons.close}></span>
      </button>
    </div>
    
    <div class="modal-body">
      <!-- 预渲染完整样式的CommentForm -->
      <div data-reply-form-wrapper>
        <CommentForm isReply={true} parentId={0} parentNick="" />
      </div>
    </div>
  </div>
</div>

<script>
  // 弹窗管理
  function initReplyModal() {
    const modals = document.querySelectorAll<HTMLElement>('.reply-modal');
    
    modals.forEach((modal) => {
      const closeButtons = modal.querySelectorAll('[data-close-modal]');
      
      // 关闭弹窗
      const closeModal = () => {
        // 恢复滚动位置
        const scrollY = document.body.style.top;
        document.body.style.position = '';
        document.body.style.top = '';
        document.body.style.width = '';
        
        if (scrollY) {
          window.scrollTo(0, parseInt(scrollY || '0') * -1);
        }
        
        modal.classList.remove('is-open');
        modal.setAttribute('aria-hidden', 'true');
      };
      
      // 绑定关闭按钮
      closeButtons.forEach((btn) => {
        btn.addEventListener('click', closeModal);
      });
      
      // ESC 键关闭
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modal.classList.contains('is-open')) {
          closeModal();
        }
      });
    });
  }
  
  // 打开弹窗的全局函数
  (window as any).openReplyModal = (modalId: string, commentId: string, commentNick: string, buttonElement?: HTMLElement) => {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    
    // 保存当前滚动位置
    const scrollY = window.scrollY;
    
    // 更新标题中的昵称
    const nickSpan = modal.querySelector('.reply-to-nick');
    if (nickSpan) {
      nickSpan.textContent = commentNick ? ` @${commentNick}` : '';
    }
    
    // 更新表单的hidden input和reply-target
    const form = modal.querySelector('form');
    const parentIdInput = modal.querySelector('input[name="parent_id"]') as HTMLInputElement;
    const replyTarget = modal.querySelector('.reply-target strong');
    
    if (parentIdInput) {
      parentIdInput.value = commentId;
    }
    
    if (replyTarget) {
      replyTarget.textContent = `@${commentNick}`;
    }
    
    // 计算弹窗位置（如果提供了按钮元素）
    const container = modal.querySelector('.modal-container') as HTMLElement;
    if (buttonElement && container) {
      const buttonRect = buttonElement.getBoundingClientRect();
      const viewportWidth = window.innerWidth;
      const viewportHeight = window.innerHeight;
      const modalWidth = Math.min(viewportWidth * 0.9, 600);
      const modalMaxHeight = viewportHeight * 0.8;
      
      // 移动端保持居中
      if (viewportWidth <= 768) {
        container.style.top = '50%';
        container.style.left = '50%';
        container.style.transform = 'translate(-50%, -50%)';
      } else {
        // 桌面端：计算弹窗位置，优先在按钮右侧
        let top = buttonRect.top + scrollY;
        let left = buttonRect.right + 16; // 按钮右侧16px
        
        // 检查右侧是否有足够空间
        if (left + modalWidth > viewportWidth) {
          // 右侧空间不够，放在按钮下方
          left = Math.max(16, Math.min(buttonRect.left, viewportWidth - modalWidth - 16));
          top = buttonRect.bottom + scrollY + 8;
        }
        
        // 确保不超出视口顶部和底部
        const minTop = scrollY + 16;
        const maxTop = scrollY + viewportHeight - modalMaxHeight - 16;
        top = Math.max(minTop, Math.min(top, maxTop));
        
        // 确保不超出视口左侧
        left = Math.max(16, left);
        
        // 应用位置
        container.style.top = `${top}px`;
        container.style.left = `${left}px`;
        container.style.transform = 'none';
      }
    }
    
    // 更新form id和所有input id（确保唯一性）
    if (form) {
      const newFormId = `reply-form-${commentId}`;
      form.id = newFormId;
      
      // 更新所有input的id和对应的label的for属性
      const fields = form.querySelectorAll('.form-field');
      fields.forEach((field) => {
        const label = field.querySelector('label');
        const input = field.querySelector('input, textarea');
        
        if (label && input) {
          const inputName = input.getAttribute('name');
          const newId = `${newFormId}-${inputName}`;
          input.id = newId;
          label.setAttribute('for', newId);
        }
      });
      
      // 绑定localStorage
      const storageKey = `comment-form-reply-${commentId}`;
      const saved = localStorage.getItem(storageKey);
      
      if (saved) {
        try {
          const data = JSON.parse(saved);
          const nicknameInput = form.querySelector('[name="nickname"]') as HTMLInputElement;
          const emailInput = form.querySelector('[name="email"]') as HTMLInputElement;
          const websiteInput = form.querySelector('[name="website"]') as HTMLInputElement;
          const contentTextarea = form.querySelector('[name="content"]') as HTMLTextAreaElement;
          
          if (nicknameInput) nicknameInput.value = data.nickname || '';
          if (emailInput) emailInput.value = data.email || '';
          if (websiteInput) websiteInput.value = data.website || '';
          if (contentTextarea) {
            contentTextarea.value = data.content || '';
            const charCount = modal.querySelector('.char-count .current');
            if (charCount) charCount.textContent = (data.content || '').length.toString();
          }
        } catch (e) {
          console.error('Failed to parse saved form data', e);
        }
      }
      
      // 重新绑定提交事件（移除旧的）
      const newForm = form.cloneNode(true) as HTMLFormElement;
      form.parentNode?.replaceChild(newForm, form);
      
      // 绑定提交逻辑
      newForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = newForm.querySelector('.btn-submit') as HTMLButtonElement;
        const submitText = submitBtn?.querySelector('.submit-text') as HTMLElement;
        const submitLoading = submitBtn?.querySelector('.submit-loading') as HTMLElement;
        
        if (submitText) submitText.style.display = 'none';
        if (submitLoading) submitLoading.style.display = 'inline';
        if (submitBtn) submitBtn.disabled = true;
        
        try {
          const formData = new FormData(newForm);
          const postSlug = window.location.pathname.split('/').pop() || '';
          
          const data = {
            nickname: formData.get('nickname') as string,
            email: formData.get('email') as string,
            website: (formData.get('website') as string) || undefined,
            content: formData.get('content') as string,
            parent_id: parseInt(commentId),
          };
          
          const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
          const response = await fetch(`${apiUrl}/api/public/comments/${postSlug}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data),
          });
          
          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.message || '提交失败');
          }
          
          newForm.reset();
          const charCount = modal.querySelector('.char-count .current');
          if (charCount) charCount.textContent = '0';
          localStorage.removeItem(storageKey);
          
          alert('✅ 回复已提交！\n\n审核通过后将显示在评论区。感谢你的参与！');
          
          (window as any).closeReplyModal(modalId);
        } catch (error: any) {
          console.error('提交回复失败：', error);
          alert(`❌ 提交失败\n\n${error.message || '网络错误，请稍后重试'}`);
        } finally {
          if (submitText) submitText.style.display = 'inline';
          if (submitLoading) submitLoading.style.display = 'none';
          if (submitBtn) submitBtn.disabled = false;
        }
      });
      
      // 绑定input事件保存到localStorage
      newForm.addEventListener('input', () => {
        const nicknameInput = newForm.querySelector('[name="nickname"]') as HTMLInputElement;
        const emailInput = newForm.querySelector('[name="email"]') as HTMLInputElement;
        const websiteInput = newForm.querySelector('[name="website"]') as HTMLInputElement;
        const contentTextarea = newForm.querySelector('[name="content"]') as HTMLTextAreaElement;
        
        const data = {
          nickname: nicknameInput?.value || '',
          email: emailInput?.value || '',
          website: websiteInput?.value || '',
          content: contentTextarea?.value || '',
        };
        localStorage.setItem(storageKey, JSON.stringify(data));
        
        // 更新字符计数
        if (contentTextarea) {
          const charCount = modal.querySelector('.char-count .current');
          if (charCount) charCount.textContent = contentTextarea.value.length.toString();
        }
      });
    }
    
    // 打开弹窗
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    
    // 固定body位置防止滚动，同时保持视觉位置不变
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollY}px`;
    document.body.style.width = '100%';
    
    // 聚焦到文本框（不触发滚动）
    setTimeout(() => {
      const textarea = modal.querySelector('textarea[name="content"]') as HTMLTextAreaElement;
      if (textarea) {
        textarea.focus({ preventScroll: true });
      }
    }, 300);
  };
  
  // 关闭弹窗的全局函数
  (window as any).closeReplyModal = (modalId: string = 'reply-modal') => {
    const modal = document.getElementById(modalId);
    if (!modal) return;
    
    // 恢复滚动位置
    const scrollY = document.body.style.top;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.width = '';
    
    if (scrollY) {
      window.scrollTo(0, parseInt(scrollY || '0') * -1);
    }
    
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
  };
  
  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReplyModal);
  } else {
    initReplyModal();
  }
  
  document.addEventListener('astro:page-load', initReplyModal);
</script>

<style>
.reply-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none;
    pointer-events: none;
    
    &.is-open {
      display: block;
      pointer-events: auto;
    }
    
    &[aria-hidden="false"] {
      .modal-overlay {
        animation: fadeIn 0.2s var(--ease-gentle);
      }
      
      .modal-container {
        animation: modalFadeIn 0.2s var(--ease-gentle);
      }
    }
  }

  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--overlay-bg);
    backdrop-filter: blur(4px);
    cursor: pointer;
  }

  .modal-container {
    position: absolute;
    width: 90%;
    max-width: 600px;
    max-height: 80vh;
    background: var(--color-white);
    border-radius: 12px;
    box-shadow: 0 8px 32px var(--overlay-light);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    
    /* 默认居中位置（会被JS动态更新） */
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transform-origin: center center;
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md) var(--spacing-lg);
    border-bottom: 1px solid var(--color-divider);
    background: linear-gradient(135deg, rgba(232, 164, 180, 0.05), rgba(126, 182, 217, 0.05));
  }

  .modal-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    margin: 0;
    
    .reply-to-nick {
      color: var(--color-pink);
      font-weight: var(--font-weight-bold);
    }
  }

  .btn-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    background: transparent;
    border: none;
    border-radius: 50%;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all var(--transition-fast) var(--ease-gentle);
    
    &:hover {
      background: rgba(44, 62, 80, 0.08);
      color: var(--color-text);
    }
    
    &:active {
      transform: scale(0.95);
    }
  }

  .modal-body {
    flex: 1;
    overflow-y: auto;
    padding: var(--spacing-md);
    
    /* 弹窗中的CommentForm不需要外层背景 */
    :global(.comment-form) {
      background: transparent;
      border: none;
      padding: 0;
      border-radius: 0;
    }
    
    /* 滚动条样式 */
    &::-webkit-scrollbar {
      width: 6px;
    }
    
    &::-webkit-scrollbar-track {
      background: rgba(44, 62, 80, 0.05);
    }
    
    &::-webkit-scrollbar-thumb {
      background: rgba(232, 164, 180, 0.3);
      border-radius: 3px;
      
      &:hover {
        background: rgba(232, 164, 180, 0.5);
      }
    }
  }

  /* 动画 */
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      filter: blur(4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  /* 响应式 */
  @media (max-width: 640px) {
    .modal-container {
      width: 95%;
      max-height: 95vh;
    }
    
    .modal-header {
      padding: var(--spacing-sm) var(--spacing-md);
    }
    
    .modal-title {
      font-size: var(--font-size-base);
    }
    
    .modal-body {
      padding: var(--spacing-sm);
    }
  }
</style>
