---
// ================================
// 评论区容器组件
// 整合评论表单和评论列表
// ================================

import CommentForm from './CommentForm.astro';
import CommentList from './CommentList.astro';
import type { CommentNode } from '../../types/api';
import { contentConfig } from '../../lib/config';

const commentsConfig = contentConfig.components.comments;

interface Props {
  comments: CommentNode[];
  postSlug: string; // 文章 slug（用于 API 调用）
}

const { comments, postSlug } = Astro.props;

// 计算总评论数（包含所有嵌套回复）
function countTotalComments(nodes: CommentNode[]): number {
  let count = 0;
  for (const node of nodes) {
    count += 1;
    count += countTotalComments(node.children);
  }
  return count;
}

const totalCount = countTotalComments(comments);
---

<section class="comment-section" id="comments">
  <div class="section-header">
    <h2 class="section-title">{commentsConfig.sectionTitle}</h2>
    <p class="section-subtitle">{commentsConfig.sectionSubtitle}</p>
  </div>
  
  <!-- 评论表单 -->
  <CommentForm />
  
  <!-- 评论列表 -->
  <CommentList comments={comments} totalCount={totalCount} />
</section>

<script>
  // 回复按钮交互
  function initCommentReply() {
    const replyButtons = document.querySelectorAll<HTMLButtonElement>('.btn-reply');
    
    replyButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const commentId = btn.dataset.commentId;
        const commentNick = btn.dataset.commentNick;
        const container = document.getElementById(`reply-container-${commentId}`);
        
        if (!container || !commentId || !commentNick) return;
        
        // 如果已存在回复表单，移除（toggle 效果）
        if (container.querySelector('.comment-form')) {
          container.innerHTML = '';
          btn.textContent = '💬';
          return;
        }
        
        // 清空容器
        container.innerHTML = '';
        btn.textContent = '💬';
        
        // 创建回复表单
        const formWrapper = document.createElement('div');
        formWrapper.className = 'comment-form reply-form';
        formWrapper.innerHTML = `
          <div class="reply-target">
            <span class="reply-icon">↩️</span>
            回复 <strong>@${commentNick}</strong>
          </div>
          
          <form id="reply-form-${commentId}" class="form-content">
            <input type="hidden" name="parent_id" value="${commentId}" />
            
            <div class="form-row">
              <div class="form-field">
                <label for="reply-form-${commentId}-nick">昵称 *</label>
                <input
                  type="text"
                  id="reply-form-${commentId}-nick"
                  name="nickname"
                  placeholder="你的昵称"
                  required
                  maxlength="20"
                />
              </div>
              
              <div class="form-field">
                <label for="reply-form-${commentId}-email">邮箱 *</label>
                <input
                  type="email"
                  id="reply-form-${commentId}-email"
                  name="email"
                  placeholder="your@email.com"
                  required
                />
              </div>
            </div>
            
            <div class="form-field">
              <label for="reply-form-${commentId}-website">个人网站</label>
              <input
                type="url"
                id="reply-form-${commentId}-website"
                name="website"
                placeholder="https://your-site.com （可选）"
              />
            </div>
            
            <div class="form-field">
              <label for="reply-form-${commentId}-content">回复内容 *</label>
              <textarea
                id="reply-form-${commentId}-content"
                name="content"
                placeholder="支持 Markdown 格式：**粗体** *斜体* [链接](url)...也支持 emoji 😊"
                required
                rows="4"
                maxlength="500"
              ></textarea>
              <div class="char-count">
                <span class="current">0</span> / 500
              </div>
            </div>
            
            <div class="form-actions">
              <button type="button" class="btn-cancel" data-cancel-reply>
                取消
              </button>
              <button type="submit" class="btn-submit">
                <span class="submit-text">💬 回复</span>
                <span class="submit-loading" style="display: none;">提交中...</span>
              </button>
            </div>
          </form>
          
          <div class="form-hint">
            提交后需要等待审核哦 ~ 支持 Markdown 基础语法
          </div>
        `;
        
        container.appendChild(formWrapper);
        
        // 绑定新表单的事件
        const form = formWrapper.querySelector('form') as HTMLFormElement;
        const textarea = form.querySelector('textarea[name="content"]') as HTMLTextAreaElement;
        const charCount = form.querySelector('.char-count .current') as HTMLElement;
        const submitBtn = form.querySelector('.btn-submit') as HTMLButtonElement;
        const cancelBtn = form.querySelector('[data-cancel-reply]') as HTMLButtonElement;
        
        // 字符计数
        textarea.addEventListener('input', () => {
          charCount.textContent = textarea.value.length.toString();
        });
        
        // 本地存储
        const storageKey = `comment-form-reply-${commentId}`;
        const saved = localStorage.getItem(storageKey);
        if (saved) {
          try {
            const data = JSON.parse(saved);
            (form.querySelector('[name="nickname"]') as HTMLInputElement).value = data.nickname || '';
            (form.querySelector('[name="email"]') as HTMLInputElement).value = data.email || '';
            (form.querySelector('[name="website"]') as HTMLInputElement).value = data.website || '';
            textarea.value = data.content || '';
            charCount.textContent = (data.content || '').length.toString();
          } catch (e) {
            console.error('Failed to parse saved form data', e);
          }
        }
        
        form.addEventListener('input', () => {
          const data = {
            nickname: (form.querySelector('[name="nickname"]') as HTMLInputElement).value,
            email: (form.querySelector('[name="email"]') as HTMLInputElement).value,
            website: (form.querySelector('[name="website"]') as HTMLInputElement).value,
            content: textarea.value,
          };
          localStorage.setItem(storageKey, JSON.stringify(data));
        });
        
        // 表单提交
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          
          const submitText = submitBtn.querySelector('.submit-text') as HTMLElement;
          const submitLoading = submitBtn.querySelector('.submit-loading') as HTMLElement;
          
          submitText.style.display = 'none';
          submitLoading.style.display = 'inline';
          submitBtn.disabled = true;
          
          try {
            const formData = new FormData(form);
            const postSlug = window.location.pathname.split('/').pop() || '';
            
            const data = {
              nickname: formData.get('nickname') as string,
              email: formData.get('email') as string,
              website: (formData.get('website') as string) || undefined,
              content: formData.get('content') as string,
              parent_id: parseInt(commentId),
            };
            
            const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
            const response = await fetch(`${apiUrl}/api/public/comments/${postSlug}`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(data),
            });
            
            if (!response.ok) {
              const error = await response.json();
              throw new Error(error.message || '提交失败');
            }
            
            form.reset();
            charCount.textContent = '0';
            localStorage.removeItem(storageKey);
            
            alert('✅ 回复已提交！\n\n审核通过后将显示在评论区。感谢你的参与！');
            
            container.innerHTML = '';
            btn.textContent = '回复';
          } catch (error: any) {
            console.error('提交回复失败：', error);
            alert(`❌ 提交失败\n\n${error.message || '网络错误，请稍后重试'}`);
          } finally {
            submitText.style.display = 'inline';
            submitLoading.style.display = 'none';
            submitBtn.disabled = false;
          }
        });
        
        // 取消回复
        cancelBtn.addEventListener('click', () => {
          container.innerHTML = '';
          btn.textContent = '💬';
        });
        
        // 聚焦到文本框
        textarea.focus();
      });
    });
  }

  
  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCommentReply);
  } else {
    initCommentReply();
  }
  
  document.addEventListener('astro:page-load', initCommentReply);
</script>

<style lang="scss">
@use "sass:color";

  .comment-section {
    max-width: 800px;
    margin: $spacing-xl auto;
    padding: 0 $spacing-md;
  }

  .section-header {
    text-align: center;
    margin-bottom: $spacing-md;
  }

  .section-title {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: $lian-text;
    margin: 0 0 4px;
  }

  .section-subtitle {
    font-size: 11px;
    color: $lian-text-light;
    font-style: italic;
    margin: 0;
  }

  // 动态生成的回复表单样式（全部使用扁平 global 选择器）
  :global(.comment-form.reply-form) {
    background: linear-gradient(135deg, rgba($lian-blue, 0.05), rgba($lian-pink, 0.03));
    border: 1px solid color.adjust($lian-blue, $lightness: 24%);
    border-radius: 8px;
    padding: $spacing-sm $spacing-md;
    box-shadow: 0 2px 8px rgba($lian-blue, 0.12);
    margin-top: $spacing-sm;
    animation: slideDown 0.2s $ease-gentle;
  }

  @keyframes slideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.comment-form.reply-form .reply-target) {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    margin-bottom: $spacing-xs;
    padding: 5px $spacing-xs;
    background: rgba($lian-blue, 0.1);
    border-left: 3px solid $lian-blue;
    border-radius: 4px;
    font-size: 11px;
    font-weight: $font-weight-medium;
    color: $lian-text-light;
  }

  :global(.comment-form.reply-form .reply-target .reply-icon) {
    font-size: 13px;
  }

  :global(.comment-form.reply-form .reply-target strong) {
    color: $lian-blue;
    font-weight: $font-weight-semibold;
  }

  :global(.comment-form.reply-form .form-content) {
    display: block;
  }

  :global(.comment-form.reply-form .form-row) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: $spacing-xs;
    margin-bottom: $spacing-xs;
  }

  :global(.comment-form.reply-form .form-field) {
    position: relative;
    margin-bottom: $spacing-xs;
  }

  :global(.comment-form.reply-form .form-field label) {
    display: block;
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: $font-weight-semibold;
    color: $lian-text;
  }

  :global(.comment-form.reply-form .form-field input),
  :global(.comment-form.reply-form .form-field textarea) {
    width: 100%;
    padding: 7px $spacing-sm;
    background: white;
    border: 1.5px solid color.adjust($lian-blue, $lightness: 30%);
    border-radius: 5px;
    font-size: 12px;
    font-family: inherit;
    color: $lian-text;
    transition:
      border-color $transition-fast $ease-gentle,
      box-shadow $transition-fast $ease-gentle;
  }

  :global(.comment-form.reply-form .form-field input::placeholder),
  :global(.comment-form.reply-form .form-field textarea::placeholder) {
    color: color.adjust($lian-text-muted, $lightness: 10%);
    font-size: 11px;
  }

  :global(.comment-form.reply-form .form-field input:focus),
  :global(.comment-form.reply-form .form-field textarea:focus) {
    outline: none;
    border-color: $lian-blue;
    box-shadow: 0 0 0 2px rgba($lian-blue, 0.12);
    background: color.adjust($lian-blue, $lightness: 42%);
  }

  :global(.comment-form.reply-form .form-field textarea) {
    resize: vertical;
    line-height: 1.45;
    min-height: 64px;
  }

  :global(.comment-form.reply-form .char-count) {
    position: static;
    text-align: right;
    margin-top: 4px;
    font-size: 10px;
    color: $lian-text-muted;
  }

  :global(.comment-form.reply-form .char-count .current) {
    color: $lian-text-light;
    font-weight: $font-weight-medium;
  }

  :global(.comment-form.reply-form .form-actions) {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: $spacing-sm;
  }

  :global(.comment-form.reply-form .btn-cancel),
  :global(.comment-form.reply-form .btn-submit) {
    padding: 6px $spacing-md;
    border: none;
    border-radius: 5px;
    font-size: 12px;
    font-weight: $font-weight-semibold;
    font-family: inherit;
    cursor: pointer;
    transition:
      background $transition-fast $ease-gentle,
      box-shadow $transition-fast $ease-gentle,
      transform $transition-fast $ease-gentle;
  }

  :global(.comment-form.reply-form .btn-cancel) {
    background: white;
    color: $lian-text-light;
    border: 1.5px solid color.adjust($lian-text-muted, $lightness: 20%);
  }

  :global(.comment-form.reply-form .btn-cancel:hover) {
    background: rgba($lian-text-muted, 0.05);
    border-color: $lian-text-muted;
  }

  :global(.comment-form.reply-form .btn-submit) {
    background: linear-gradient(135deg, $lian-blue, color.adjust($lian-blue, $lightness: -8%));
    color: white;
    box-shadow: 0 2px 4px rgba($lian-blue, 0.3);
  }

  :global(.comment-form.reply-form .btn-submit:hover) {
    box-shadow: 0 3px 8px rgba($lian-blue, 0.4);
    transform: translateY(-1px);
  }

  :global(.comment-form.reply-form .btn-submit:active) {
    transform: translateY(0);
  }

  :global(.comment-form.reply-form .btn-submit:disabled) {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  :global(.comment-form.reply-form .form-hint) {
    margin-top: 6px;
    font-size: 10px;
    color: $lian-text-muted;
    font-style: italic;
    text-align: center;
  }

  @media (max-width: $container-sm) {
    .comment-section {
      padding: 0 $spacing-md;
    }

    :global(.comment-form.reply-form .form-row) {
      grid-template-columns: 1fr;
    }

    :global(.comment-form.reply-form) {
      padding: $spacing-sm;
    }
  }
</style>
