---
// ================================
// 单条评论组件（递归渲染）
// 显示评论内容、头像、元信息、回复按钮
// ================================

import { marked } from 'marked';
import type { CommentNode } from '../../types/api';
import { getRelativeTime } from '../../lib/date';
import { getCommentAvatar } from '../../lib/avatar';
import { contentConfig } from '../../lib/config';

const cc = contentConfig.components.comments;

interface Props {
  node: CommentNode;
  depth?: number; // 嵌套深度
}

const { node, depth = 0 } = Astro.props;
const { comment, children } = node;

// 配置 marked 用于评论的 markdown 渲染
marked.setOptions({
  breaks: true, // 支持换行
  gfm: true,    // GitHub Flavored Markdown
});

// 渲染评论内容（Markdown）
const renderedContent = marked.parse(comment.content);
const relativeTime = getRelativeTime(comment.created_at);

// 动态生成头像 URL：website favicon → Gravatar → 默认头像
const avatarUrl = getCommentAvatar(comment.guest_website, comment.guest_email);

// 最大嵌套深度（避免过深）
const maxDepth = 4;
const isMaxDepth = depth >= maxDepth;
---

<div class="comment-item" data-comment-id={comment.id} data-depth={depth}>
  
  <div class="comment-card">
    <!-- 头像 -->
    <div class="comment-avatar">
      <img src={avatarUrl} alt={comment.guest_nick} loading="lazy" />
    </div>
    
    <!-- 内容区 -->
    <div class="comment-body">
      <!-- 头部：用户信息 -->
      <div class="comment-header">
        <span class={`comment-author ${comment.guest_nick === '恋' ? 'is-lian' : ''}`}>
          {comment.guest_nick}
        </span>
        
        <span class="comment-time">{relativeTime}</span>
      </div>
      
      <!-- 用户元信息 -->
      <div class="comment-user-info">
        {comment.guest_email && (
          <a href={`mailto:${comment.guest_email}`} class="user-email" title="发送邮件">
            {cc.item.emailIcon} {comment.guest_email}
          </a>
        )}
        
        {comment.guest_website && (
          <a href={comment.guest_website} target="_blank" rel="noopener" class="user-website" title="访问网站">
            {cc.item.websiteIcon} {comment.guest_website}
          </a>
        )}
        
        {comment.visitor_info && (
          <span class="comment-meta" title={comment.visitor_info}>
            <span class="meta-icon">📍</span>
            <span class="meta-text">{comment.visitor_info}</span>
          </span>
        )}
      </div>
      
      <!-- 内容 -->
      <div class="comment-content markdown-body" set:html={renderedContent} />
      
      <!-- 回复表单容器（动态插入） -->
      <div class="reply-form-container" id={`reply-container-${comment.id}`}></div>
    </div>
    
    <!-- 回复按钮（右下角） -->
    {!isMaxDepth && (
      <button class="btn-reply" data-comment-id={comment.id} data-comment-nick={comment.guest_nick}>
        {cc.replyLabel.split(' ')[0]}
      </button>
    )}
  </div>
  
  <!-- 子评论（递归） -->
  {children.length > 0 && (
    <div class="comment-children">
      {children.map((child) => (
        <Astro.self node={child} depth={depth + 1} />
      ))}
    </div>
  )}
</div>
</div>

<style>
.comment-item {
    position: relative;
    margin-bottom: 20px;
  }
  
  .comment-children {
    margin-left: 40px;
    margin-top: 12px;
    padding-left: 16px;
    border-left: 2px solid var(--color-border-light);
  }

  .comment-card {
    position: relative;
    display: flex;
    gap: 12px;
    padding: 8px 0;
    transition: 
      opacity var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);
    
    &:hover {
      transform: scale(1.02);
      
      .btn-reply {
        opacity: 1;
      }
    }
    
    /* 当回复表单展开时，隐藏原来的回复按钮 */
    &:has(.reply-form-container:not(:empty)) .btn-reply {
      display: none;
    }
  }

  .comment-avatar {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    
    img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      border: 1px solid var(--color-border-lighter);
      object-fit: cover;
    }
  }

  .comment-body {
    flex: 1;
    min-width: 0;
  }

  .comment-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
    line-height: 1.2;
    flex-wrap: wrap;
  }

  .comment-author {
    font-size: 13px;
    font-weight: var(--font-weight-semibold);
    color: var(--color-blue);
    text-decoration: none;
    transition: color var(--transition-fast) var(--ease-gentle);
    
    &.is-lian {
      color: var(--color-pink);
    }
    
    &[href]:hover {
      opacity: 0.8;
    }
  }

  .comment-time {
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .comment-user-info {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 11px;
  }
  
  .user-email,
  .user-website {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-blue);
    text-decoration: none;
    transition: opacity var(--transition-fast) var(--ease-gentle);
    
    &:hover {
      opacity: 0.7;
      text-decoration: underline;
    }
  }
  
  .comment-meta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: var(--color-text-light);
    background: var(--color-bg-tertiary);
    border-radius: 4px;
  }

  .meta-icon {
    flex-shrink: 0;
    font-size: 11px;
  }

  .meta-text {
    max-width: 300px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .comment-content {
    margin-bottom: 0;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-text-light);
    word-wrap: break-word;
    
    /* Markdown 样式 */
    :global(p) {
      margin: 0 0 6px;
      
      &:last-child {
        margin-bottom: 0;
      }
    }
    
    :global(strong) {
      font-weight: var(--font-weight-semibold);
      color: var(--color-text);
    }
    
    :global(em) {
      font-style: italic;
    }
    
    :global(a) {
      color: var(--color-blue);
      text-decoration: none;
      border-bottom: 1px solid var(--color-blue-l20);
      transition: border-color var(--transition-fast) var(--ease-gentle);
      
      &:hover {
        border-color: var(--color-blue);
      }
    }
    
    :global(code) {
      padding: 2px 5px;
      background: var(--color-bg-tertiary);
      border-radius: 3px;
      font-family: 'Consolas', 'Monaco', monospace;
      font-size: 0.9em;
      color: var(--color-pink-d10);
    }
  }

  .btn-reply {
    position: absolute;
    bottom: 8px;
    right: 0;
    padding: 3px 6px;
    background: transparent;
    border: none;
    font-size: 14px;
    font-family: inherit;
    color: var(--color-text-muted);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);
    
    &:hover {
      transform: scale(1.15);
    }
    
    &:active {
      transform: scale(0.95);
    }
  }

  .reply-form-container {
    margin-top: 8px;
  }

  .comment-children {
    /* 暂时留空，稍后添加手绘连接线 */
  }

  @media (max-width: 640px) {
    .comment-avatar {
      width: 28px;
      height: 28px;
    }
    
    .comment-card {
      gap: 10px;
    }
    
    .btn-reply {
      opacity: 1; /* 移动端始终显示 */
    }
  }
</style>
