---
// ================================
// 评论表单组件
// 支持发表新评论和回复已有评论
// ================================

interface Props {
  parentId?: number; // 回复时传入父评论 ID
  parentNick?: string; // 回复时显示 @ 目标用户
  isReply?: boolean; // 是否为回复表单
}

const { parentId, parentNick, isReply = false } = Astro.props;
const formId = isReply ? `reply-form-${parentId}` : 'main-comment-form';

import { contentConfig } from '../../lib/config';
const cc = contentConfig.components.comments;
---

<div class={`comment-form ${isReply ? 'reply-form' : 'main-form'}`}>
  {isReply && parentNick && (
    <div class="reply-target">
      <span class="reply-icon">{cc.replyIcon}</span>
      回复 <strong>@{parentNick}</strong>
    </div>
  )}
  
  <form id={formId} class="form-content">
    <input type="hidden" name="parent_id" value={parentId || ''} />
    
    <!-- 主输入区 - 始终可见 -->
    <div class="form-field main-input">
      <textarea
        id={`${formId}-content`}
        name="content"
        placeholder={cc.form.placeholder}
        required
        rows={isReply ? 4 : 4}
        maxlength="500"
        data-expand-trigger
      ></textarea>
      <div class="char-count">
        <span class="current">0</span> / 500
      </div>
    </div>
    
    <!-- 扩展字段区 - focus后展开 -->
    <div class="expandable-fields" data-expandable>
      <div class="form-row">
        <div class="form-field">
          <label for={`${formId}-nick`}>{cc.form.nickLabel}</label>
          <input
            type="text"
            id={`${formId}-nick`}
            name="nickname"
            placeholder={cc.form.nickPlaceholder}
            required
            maxlength="20"
          />
        </div>
        
        <div class="form-field">
          <label for={`${formId}-email`}>{cc.form.emailLabel}</label>
          <input
            type="email"
            id={`${formId}-email`}
            name="email"
            placeholder={cc.form.emailPlaceholder}
            required
          />
        </div>
      </div>
      
      <div class="form-field">
        <label for={`${formId}-website`}>{cc.form.websiteLabel}</label>
        <input
          type="url"
          id={`${formId}-website`}
          name="website"
          placeholder={cc.form.websitePlaceholder}
        />
      </div>
      
      <div class="form-actions">
        {isReply && (
          <button type="button" class="btn-cancel" data-cancel-reply>
            {cc.cancelText}
          </button>
        )}
        <button type="submit" class="btn-submit">
          <span class="submit-text">{isReply ? cc.replyLabel : cc.submitText}</span>
          <span class="submit-loading" style="display: none;">{cc.submitLoadingText}</span>
        </button>
      </div>
      
      <div class="form-hint">
        {cc.form.hint}
      </div>
    </div>
  </form>
</div>

<style>
.comment-form {
    background: var(--color-white);
    border: 1px solid rgba(232, 164, 180, 0.25);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    box-shadow: 0 1px 3px rgba(44, 62, 80, 0.04);
    transition: box-shadow 300ms var(--ease-gentle);
    
    &.main-form {
      margin-bottom: var(--spacing-lg);
    }
    
    &.expanded {
      box-shadow: 0 2px 8px rgba(126, 182, 217, 0.08);
    }
  }

  .reply-target {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-bottom: var(--spacing-sm);
    padding: 6px var(--spacing-sm);
    background: rgba(126, 182, 217, 0.06);
    border-left: 2px solid var(--color-blue);
    border-radius: 4px;
    font-size: var(--font-size-xs);
    color: var(--color-text-light);

    .reply-icon {
      font-size: var(--font-size-sm);
    }

    strong {
      color: var(--color-blue);
      font-weight: var(--font-weight-semibold);
    }
  }

  .main-input {
    margin-bottom: 0 !important;
    
    textarea {
      border-radius: 8px;
      min-height: 64px;
      font-size: var(--font-size-sm);
      
      &::placeholder {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
      }
    }
  }
  
  .expandable-fields {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 300ms var(--ease-gentle),
      opacity 250ms var(--ease-gentle),
      margin-top 300ms var(--ease-gentle);
    
    &.expanded {
      max-height: 500px;
      opacity: 1;
      margin-top: var(--spacing-md);
    }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
  }

  .form-field {
    position: relative;
    margin-bottom: var(--spacing-sm);

    label {
      display: block;
      margin-bottom: 4px;
      font-size: var(--font-size-xs);
      font-weight: var(--font-weight-medium);
      color: var(--color-text-light);
    }

    input,
    textarea {
      width: 100%;
      padding: 8px var(--spacing-sm);
      background: var(--color-bg);
      border: 1.5px solid var(--color-pink-l28);
      border-radius: 6px;
      font-size: var(--font-size-sm);
      font-family: inherit;
      color: var(--color-text);
      transition:
        border-color var(--transition-fast) var(--ease-gentle),
        background var(--transition-fast) var(--ease-gentle);

      &::placeholder {
        color: var(--color-text-muted);
      }

      &:focus {
        outline: none;
        border-color: var(--color-pink);
        background: var(--color-white);
      }
    }

    textarea {
      resize: vertical;
      line-height: var(--line-height-base);
      min-height: 70px;
    }
  }

  .char-count {
    position: absolute;
    right: 8px;
    bottom: -18px;
    font-size: 11px;
    color: var(--color-text-muted);

    .current {
      color: var(--color-text-light);
      font-weight: var(--font-weight-medium);
    }
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
  }

  .btn-cancel,
  .btn-submit {
    padding: 7px var(--spacing-md);
    border: none;
    border-radius: 6px;
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    font-family: inherit;
    cursor: pointer;
    transition:
      background var(--transition-fast) var(--ease-gentle),
      box-shadow var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);
  }

  .btn-cancel {
    background: rgba(var(--color-text-muted), 0.1);
    color: var(--color-text-light);

    &:hover {
      background: rgba(var(--color-text-muted), 0.15);
    }
  }

  .btn-submit {
    background: linear-gradient(135deg, var(--color-pink), var(--color-pink-l8));
    color: white;
    box-shadow: 0 1px 3px rgba(232, 164, 180, 0.3);

    &:hover {
      box-shadow: 0 2px 6px rgba(232, 164, 180, 0.4);
      transform: translateY(-1px);
    }

    &:active {
      transform: translateY(0);
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }
  }

  .form-hint {
    margin-top: var(--spacing-sm);
    font-size: 11px;
    color: var(--color-text-muted);
    font-style: italic;
    text-align: center;
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 表单交互逻辑
  function initCommentForm() {
    const forms = document.querySelectorAll<HTMLFormElement>('.comment-form form');
    
    forms.forEach((form) => {
      const textarea = form.querySelector<HTMLTextAreaElement>('[data-expand-trigger]');
      const expandable = form.querySelector<HTMLElement>('[data-expandable]');
      const commentFormContainer = form.closest('.comment-form');
      const charCount = form.querySelector<HTMLElement>('.char-count .current');
      const submitBtn = form.querySelector<HTMLButtonElement>('.btn-submit');
      const cancelBtn = form.querySelector<HTMLButtonElement>('[data-cancel-reply]');
      
      // 渐进式展开 - Focus时展开额外字段
      let isExpanded = false;
      if (textarea && expandable) {
        const expandForm = () => {
          if (!isExpanded) {
            expandable.classList.add('expanded');
            commentFormContainer?.classList.add('expanded');
            isExpanded = true;
          }
        };
        
        textarea.addEventListener('focus', expandForm);
        textarea.addEventListener('input', expandForm);
      }
      
      // 字符计数
      if (textarea && charCount) {
        textarea.addEventListener('input', () => {
          charCount.textContent = textarea.value.length.toString();
        });
      }
      
      // 本地存储（防止误刷新丢失）
      const formId = form.id;
      const storageKey = `comment-form-${formId}`;
      
      // 恢复保存的数据
      const saved = localStorage.getItem(storageKey);
      if (saved) {
        try {
          const data = JSON.parse(saved);
          (form.querySelector('[name="nickname"]') as HTMLInputElement).value = data.nickname || '';
          (form.querySelector('[name="email"]') as HTMLInputElement).value = data.email || '';
          (form.querySelector('[name="website"]') as HTMLInputElement).value = data.website || '';
          if (textarea) textarea.value = data.content || '';
          if (charCount) charCount.textContent = (data.content || '').length.toString();
          
          // 如果有保存的内容，自动展开
          if (data.content && expandable) {
            expandable.classList.add('expanded');
            commentFormContainer?.classList.add('expanded');
            isExpanded = true;
          }
        } catch (e) {
          console.error('Failed to parse saved form data', e);
        }
      }
      
      // 自动保存
      form.addEventListener('input', () => {
        const data = {
          nickname: (form.querySelector('[name="nickname"]') as HTMLInputElement).value,
          email: (form.querySelector('[name="email"]') as HTMLInputElement).value,
          website: (form.querySelector('[name="website"]') as HTMLInputElement).value,
          content: textarea?.value || '',
        };
        localStorage.setItem(storageKey, JSON.stringify(data));
      });
      
      // 表单提交
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        if (!submitBtn) return;
        
        // 显示 loading
        const submitText = submitBtn.querySelector('.submit-text') as HTMLElement;
        const submitLoading = submitBtn.querySelector('.submit-loading') as HTMLElement;
        
        submitText.style.display = 'none';
        submitLoading.style.display = 'inline';
        submitBtn.disabled = true;
        
        try {
          // 获取表单数据
          const formData = new FormData(form);
          const postSlug = window.location.pathname.split('/').pop() || '';
          
          const data = {
            nickname: formData.get('nickname') as string,
            email: formData.get('email') as string,
            website: (formData.get('website') as string) || undefined,
            content: formData.get('content') as string,
            parent_id: formData.get('parent_id') ? parseInt(formData.get('parent_id') as string) : undefined,
          };
          
          // 调用 API
          const apiUrl = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
          const response = await fetch(`${apiUrl}/api/public/comments/${postSlug}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(data),
          });
          
          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.message || '提交失败');
          }
          
          // 成功后清空表单和本地存储
          form.reset();
          if (charCount) charCount.textContent = '0';
          localStorage.removeItem(storageKey);
          
          // 收起扩展区
          if (expandable) {
            expandable.classList.remove('expanded');
            commentFormContainer?.classList.remove('expanded');
            isExpanded = false;
          }
          
          // 提示
          alert('✅ 评论已提交！\n\n审核通过后将显示在评论区。感谢你的参与！');
          
          // 如果是回复表单，关闭
          if (cancelBtn) {
            cancelBtn.click();
          }
        } catch (error: any) {
          console.error('提交评论失败：', error);
          alert(`❌ 提交失败\n\n${error.message || '网络错误，请稍后重试'}`);
        } finally {
          // 恢复按钮
          submitText.style.display = 'inline';
          submitLoading.style.display = 'none';
          submitBtn.disabled = false;
        }
      });
      
      // 取消回复
      if (cancelBtn) {
        cancelBtn.addEventListener('click', () => {
          const replyForm = form.closest('.comment-form');
          if (replyForm) {
            replyForm.remove();
          }
        });
      }
    });
  }
  
  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCommentForm);
  } else {
    initCommentForm();
  }
  
  // Astro view transitions 兼容
  document.addEventListener('astro:page-load', initCommentForm);
</script>
