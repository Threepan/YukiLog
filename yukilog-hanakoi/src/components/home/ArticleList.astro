---
// ================================
// 文章列表容器
// 放置在第二屏及之后，位于固定侧栏中间
// 包裹文章卡片，支持懒加载滚动入场
// ================================

import ArticleCard from "./ArticleCard.astro";
import type { PostCardData } from "../../types";
import { contentConfig, allPosts } from "../../lib/config";

// 首页展示前7篇文章（已按日期降序排列在 allPosts 中）
const placeholderPosts = allPosts.slice(0, 7) as unknown as PostCardData[];
---

<section class="article-list-section" id="article-list">
  <div class="article-list-container">
    {placeholderPosts.map((post, i) => (
      <ArticleCard post={post} index={i} />
    ))}
  </div>
  
  <!-- 加载更多占位 -->
  <div class="load-more" id="load-more-sentinel">
    <span class="load-more-text">{contentConfig.pages.home.articleList.loadMoreText}</span>
  </div>
</section>

<style lang="scss">
  .article-list-section {
    width: 100%;
    padding-bottom: $spacing-xxl;
  }

  .article-list-container {
    // 居中，并避开两侧固定侧栏
    // 侧栏宽度 280px + 间距 $spacing-xl(48px) 每侧 ≈ 328px
    // 再加内容区与侧栏的间隙 24px
    max-width: 800px;
    margin: 0 auto;
    padding: $spacing-xxl * 2 $spacing-md 0;
    display: flex;
    flex-direction: column;
    gap: $spacing-xl;
  }

  .load-more {
    display: flex;
    justify-content: center;
    padding: $spacing-xxl 0 $spacing-lg;
  }

  .load-more-text {
    font-size: $font-size-sm;
    color: $lian-text-muted;
    letter-spacing: 0.1em;
  }

  // 响应式：小屏无侧栏，全宽
  @media (max-width: $container-lg) {
    .article-list-container {
      max-width: 100%;
      padding: $spacing-lg $spacing-md 0;
    }
  }
</style>

<script>
  // 懒加载入场动画 - IntersectionObserver
  const articleCards = document.querySelectorAll('.article-card');

  if (articleCards.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const card = entry.target as HTMLElement;
            const index = parseInt(card.dataset.index || '0', 10);
            // 交错延迟入场
            const delay = index * 120;
            setTimeout(() => {
              card.classList.add('visible');
            }, delay);
            observer.unobserve(card);
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -60px 0px',
      }
    );

    articleCards.forEach((card) => observer.observe(card));
  }
</script>
