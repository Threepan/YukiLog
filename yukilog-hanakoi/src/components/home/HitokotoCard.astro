---
// ================================
// 一言卡片（Hitokoto）
// 第二屏右上 - 每次访问显示一条随机二次元语录
// 动画: 从右往左滑入 100px + 淡入
// ================================

import { svgIcons } from '../../lib/svg-icons';
---

<div class="hitokoto-card" id="hitokoto-card">
  <!-- 标题 -->
  <div class="hitokoto-header">
    <span class="hitokoto-label">一言</span>
    <button class="hitokoto-refresh" id="hitokoto-refresh" aria-label="换一条" title="换一条">
      <span class="hitokoto-refresh-icon" set:html={svgIcons.refreshCcw}></span>
    </button>
  </div>

  <!-- 引用内容 -->
  <div class="hitokoto-body">
    <span class="hitokoto-quote-icon quote-open" set:html={svgIcons.openingQuotationMark}></span>
    <p class="hitokoto-text" id="hitokoto-text">
      加载中...
    </p>
    <span class="hitokoto-quote-icon quote-close" set:html={svgIcons.closingQuotationMark}></span>
  </div>

  <!-- 出处 -->
  <div class="hitokoto-source" id="hitokoto-source">
    <span class="hitokoto-from"></span>
  </div>
</div>

<style lang="scss">
.hitokoto-card {
  background: $lian-white;
  border-radius: $radius-lg;
  box-shadow: $shadow-pink;
  padding: $spacing-lg;
  min-height: 180px;
  display: flex;
  flex-direction: column;
  gap: 0;
  
  // 初始隐藏，等待动画触发
  opacity: 0;
  transform: translateX(100px);
  transition: opacity 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
              transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  
  &.visible {
    opacity: 1;
    transform: translateX(0);
  }
}

// ==================
// 标题栏
// ==================
.hitokoto-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: $spacing-md;
}

.hitokoto-label {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $lian-text-light;
  letter-spacing: 0.05em;
}

.hitokoto-refresh {
  width: 28px;
  height: 28px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: none;
  color: $lian-text-muted;
  cursor: pointer;
  border-radius: $radius-sm;
  transition: color $transition-base $ease-gentle,
              background $transition-base $ease-gentle;
  
  &:hover {
    color: $lian-blue;
    background: $lian-bg;
  }
}

// ==================
// 引用内容
// ==================
.hitokoto-body {
  display: flex;
  align-items: flex-start;
  gap: $spacing-sm;
  padding: 0 $spacing-xs;
}

.hitokoto-quote-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  margin-top: 4px;
  opacity: 0.3;
  color: $lian-text;
  
  :global(svg) {
    width: 100%;
    height: 100%;
    fill: currentColor;
    
    :global(path) {
      fill: currentColor;
    }
  }
  
  &.quote-close {
    align-self: flex-end;
    margin-top: 0;
    margin-bottom: 4px;
  }
}

.hitokoto-text {
  font-size: $font-size-base;
  font-weight: $font-weight-medium;
  color: $lian-text;
  line-height: $line-height-relaxed;
  margin: 0;
  flex: 1;
  min-height: 1.6em;
  transition: opacity 200ms $ease-gentle;
  
  &.loading {
    opacity: 0;
  }
}

// ==================
// 出处
// ==================
.hitokoto-source {
  margin-top: $spacing-md;
  padding-top: $spacing-sm;
  border-top: 1px solid $lian-divider;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 1.4em;
}

.hitokoto-from {
  font-size: $font-size-sm;
  color: $lian-text-light;
  font-style: italic;
  transition: opacity 200ms $ease-gentle;
  
  &.loading {
    opacity: 0;
  }
}

// ==================
// 响应式
// ==================
@media (max-width: $container-md) {
  .hitokoto-card {
    padding: $spacing-md;
  }
  
  .hitokoto-text {
    font-size: $font-size-sm;
  }
}
</style>

<script>
  const textEl = document.getElementById('hitokoto-text');
  const sourceEl = document.getElementById('hitokoto-source');
  const refreshBtn = document.getElementById('hitokoto-refresh');

  async function fetchHitokoto() {
    if (!textEl || !sourceEl) return;
    
    const fromEl = sourceEl.querySelector('.hitokoto-from');
    const card = textEl.closest('.hitokoto-card') as HTMLElement;
    
    // 锁定卡片当前高度，防止内容切换时抖动
    if (card) card.style.minHeight = `${card.offsetHeight}px`;
    
    // 淡出
    textEl.classList.add('loading');
    if (fromEl) fromEl.classList.add('loading');
    await new Promise(r => setTimeout(r, 200));

    try {
      const res = await fetch('https://v1.hitokoto.cn/?c=a');
      const data = await res.json();
      
      textEl.textContent = data.hitokoto || '...';
      
      let source = '';
      if (data.from_who && data.from) {
        source = `—— ${data.from_who}「${data.from}」`;
      } else if (data.from) {
        source = `——「${data.from}」`;
      }
      if (fromEl) fromEl.textContent = source;
    } catch {
      textEl.textContent = '获取失败，点击刷新重试';
    } finally {
      // 淡入
      textEl.classList.remove('loading');
      if (fromEl) fromEl.classList.remove('loading');
      // 内容渲染后释放高度锁定
      requestAnimationFrame(() => {
        if (card) card.style.minHeight = '';
      });
    }
  }

  // 首次加载
  fetchHitokoto();

  // 刷新按钮
  refreshBtn?.addEventListener('click', fetchHitokoto);
</script>
