---
// ================================
// 文章卡片组件
// 交替布局：奇数行封面在左(4-6)，偶数行封面在右(6-4)
// AA = 封面图 | AB = 信息区(ABA标题 + ABB分类/标签)
// ================================

import type { PostCardData } from "../../types";
import { svgIcons } from "../../lib/svg-icons";

interface Props {
  post: PostCardData;
  index: number; // 用于判断奇偶交替
}

const { post, index } = Astro.props;
const isReversed = index % 2 === 1; // 偶数行反转布局

// 占位封面
const placeholderCover = "/images/placeholder-cover.jpg";
const coverSrc = post.cover_image || placeholderCover;
---

<article class:list={["article-card", { reversed: isReversed }]} data-index={index}>
  <!-- AA: 封面区 -->
  <a href={`/posts/${post.slug}`} class="article-cover" aria-label={`阅读 ${post.title}`}>
    <div class="cover-inner">
      <img src={coverSrc} alt={post.title} loading="lazy" />
    </div>
  </a>

  <!-- AB: 信息区 -->
  <div class="article-info">
    <!-- ABA: 标题 -->
    <div class="article-header">
      <a href={`/posts/${post.slug}`} class="article-title">{post.title}</a>
      {post.summary && <p class="article-summary">{post.summary}</p>}
      <time class="article-date" datetime={post.created_at}>
        {new Date(post.created_at).toLocaleDateString("zh-CN", {
          year: "numeric",
          month: "long",
          day: "numeric",
        })}
      </time>
    </div>

    <!-- ABB: 分类 + 标签 -->
    <div class="article-meta">
      {post.theme && (
        <a href={`/themes/${post.theme.slug}`} class="article-theme">
          <span class="article-theme-icon" set:html={svgIcons.folderOpen}></span>
          {post.theme.name}
        </a>
      )}
      {post.tags && post.tags.length > 0 && (
        <div class="article-tags">
          {post.tags.slice(0, 3).map((tag) => (
            <a href={`/tags?tag=${tag.slug}`} class="tag-pill">
              <span class="tag-hash">#</span>{tag.name}
            </a>
          ))}
        </div>
      )}
    </div>
  </div>
</article>

<style lang="scss">
@use "sass:color";

  .article-card {
    display: grid;
    grid-template-columns: 4fr 6fr;
    gap: 0;
    background: var(--color-white);
    border-radius: $radius-lg;
    overflow: hidden;
    box-shadow: $shadow-blue;
    transition:
      box-shadow $transition-base $ease-gentle,
      transform $transition-base $ease-gentle;
    
    // 入场动画 - 默认不可见
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 600ms $ease-gentle,
      transform 600ms $ease-gentle,
      box-shadow $transition-base $ease-gentle;
    
    &.visible {
      opacity: 1;
      transform: translateY(0);
    }
    
    &:hover {
      box-shadow: $shadow-blue-hover;
    }

    // 偶数行反转：封面在右
    &.reversed {
      grid-template-columns: 6fr 4fr;

      .article-cover {
        order: 2;
      }

      .article-info {
        order: 1;
      }
    }
  }

  // AA: 封面区域
  .article-cover {
    display: block;
    overflow: hidden;
    position: relative;
    min-height: 240px;
    
    .cover-inner {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 500ms $ease-gentle;
    }

    &:hover img {
      transform: scale(1.08);
    }
  }

  // AB: 信息区域
  .article-info {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: $spacing-lg $spacing-xl;
  }

  // ABA: 标题区
  .article-header {
    display: flex;
    flex-direction: column;
    gap: $spacing-xs;
  }

  .article-title {
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    text-decoration: none;
    line-height: $line-height-tight;
    transition: color $transition-fast $ease-gentle;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;

    &:hover {
      color: $lian-blue;
    }
  }

  .article-summary {
    font-size: $font-size-sm;
    color: $lian-text-light;
    line-height: $line-height-base;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
  }

  .article-date {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    margin-top: $spacing-xs;
  }

  // ABB: 分类 + 标签区
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $spacing-xs;
    margin-top: $spacing-md;
  }

  .article-theme {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 12px;
    background: rgba($lian-blue, 0.1);
    color: $lian-blue;
    border-radius: 20px;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    text-decoration: none;
    transition:
      background $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;
    white-space: nowrap;
    
    svg {
      flex-shrink: 0;
    }

    &:hover {
      background: rgba($lian-blue, 0.2);
      color: color.adjust($lian-blue, $lightness: -10%);
    }
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    background: rgba($lian-pink, 0.08);
    color: $lian-pink;
    border-radius: 16px;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    text-decoration: none;
    transition:
      background $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;
    white-space: nowrap;

    .tag-hash {
      opacity: 0.6;
      margin-right: 1px;
    }

    &:hover {
      background: rgba($lian-pink, 0.18);
      color: color.adjust($lian-pink, $lightness: -10%);
    }
  }

  // 响应式
  @media (max-width: $container-md) {
    .article-card,
    .article-card.reversed {
      grid-template-columns: 1fr;

      .article-cover {
        order: 0;
        min-height: 180px;
      }

      .article-info {
        order: 1;
      }
    }
  }
</style>
