---
// ================================
// 个人信息面板
// 第二屏左上 - 头像、昵称、介绍、社交链接
// 动画: 从左往右滑入 100px + 淡入
// ================================

import { siteConfig } from '../../lib/config.ts';
import { socialIcons, uiIcons } from '../../lib/svg-icons';
import { Image } from 'astro:assets';
import avatarImage from '../../assets/icon/logo/logo.jpg';

const resolvedSocialIcons = siteConfig.social.map((s) => ({
  ...s,
  svg: socialIcons[s.icon] ?? '',
}));

const author = siteConfig.author;
const systemLogText = `# system.log █\n> [${author.systemLog.timestamp}]  \n> "${author.systemLog.message}"`;
---

<div class="profile-card" id="profile-card">
  <!-- 头像 -->
  <div class="profile-avatar">
    <Image
      src={avatarImage}
      alt={siteConfig.author.nickname}
      width={96}
      height={96}
      class="avatar-img"
    />
  </div>

  <!-- 昵称 -->
  <div class="profile-nickname">{siteConfig.author.nickname}</div>

  <!-- 个人签名 -->
  <div class="profile-bio">{author.bio}</div>

  <!-- 扩展信息 -->
  <div class="profile-meta">
    <div class="profile-meta-item">
      <span class="profile-meta-icon" set:html={uiIcons.cake}></span>
      <span class="profile-meta-text">{author.birthday}</span>
    </div>
    <div class="profile-meta-item">
      <span class="profile-meta-dot" aria-hidden="true"></span>
      <span class="profile-meta-text">{author.genderIdentity}</span>
    </div>
  </div>

  <!-- 分隔线 -->
  <div class="profile-divider"></div>

  <!-- 社交链接 -->
  <div class="profile-social">
    {resolvedSocialIcons.map((s) =>
      s.icon === 'gmail' ? (
        <span
          class="profile-social-btn"
          title={s.name}
          style={`--icon-color: ${s.color}`}
        >
          <span class="social-svg" set:html={s.svg}></span>
          <span class="social-name">{s.name}</span>
        </span>
      ) : (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="profile-social-btn"
          title={s.name}
          style={`--icon-color: ${s.color}`}
        >
          <span class="social-svg" set:html={s.svg}></span>
          <span class="social-name">{s.name}</span>
        </a>
      )
    )}
  </div>

  <div class="profile-log">
    <pre>{systemLogText}</pre>
  </div>
</div>

<style lang="scss">
.profile-card {
  background: $lian-white;
  border-radius: $radius-lg;
  box-shadow: $shadow-pink;
  padding: $spacing-xl $spacing-lg;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  
  opacity: 0;
  transform: translateX(-100px);
  transition: opacity 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
              transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);

  &.visible {
    opacity: 1;
    transform: translateX(0);
  }
}

// ==================
// 头像
// ==================
.profile-avatar {
  width: 96px;
  height: 96px;
  border-radius: 50%;
  overflow: hidden;
  border: 3px solid $lian-border;
  flex-shrink: 0;
  transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1),
              border-color 400ms $ease-gentle;
  
  &:hover {
    transform: scale(1.06);
    border-color: $lian-pink;
  }
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

// ==================
// 昵称
// ==================
.profile-nickname {
  margin-top: $spacing-md;
  font-size: $font-size-xl;
  font-weight: $font-weight-bold;
  color: $lian-text;
  text-align: center;
}

// ==================
// 个人签名
// ==================
.profile-bio {
  margin-top: $spacing-xs;
  font-size: $font-size-sm;
  color: $lian-text-light;
  text-align: center;
  line-height: $line-height-relaxed;
  max-width: 260px;
}

.profile-meta {
  margin-top: $spacing-sm;
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.profile-meta-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: $lian-text-muted;
  font-size: $font-size-xs;
  padding: 0 4px;
}

.profile-meta-icon {
  width: 14px;
  height: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: $lian-pink;

  :global(svg) {
    width: 100%;
    height: 100%;
    stroke: currentColor;
  }
}

.profile-meta-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: $lian-blue;
  opacity: 0.8;
}

.profile-meta-text {
  line-height: 1.2;
}

// ==================
// 分隔线
// ==================
.profile-divider {
  width: 40px;
  height: 2px;
  background: $lian-divider;
  margin: $spacing-md 0;
  border-radius: 1px;
  transition: width 400ms $ease-gentle, background 400ms $ease-gentle;
  
  .profile-card:hover & {
    width: 60px;
    background: $lian-pink;
  }
}

// ==================
// 社交链接
// ==================
.profile-social {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
}

.profile-social-btn {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
  padding: 8px 12px;
  border-radius: $radius-sm;
  color: $lian-text-light;
  text-decoration: none;
  cursor: pointer;
  transition: all $transition-base cubic-bezier(0.22, 0.61, 0.36, 1);
  
  .social-svg {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--icon-color);
    transition: transform $transition-base cubic-bezier(0.22, 0.61, 0.36, 1);
    
    :global(svg) {
      width: 100%;
      height: 100%;
      fill: currentColor;
    }
  }
  
  .social-name {
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    transition: color $transition-base $ease-gentle;
  }
  
  &:hover {
    background: $lian-bg;
    color: var(--icon-color);
    
    .social-svg {
      transform: scale(1.12);
    }
    
    .social-name {
      color: var(--icon-color);
    }
  }
}

.profile-log {
  width: 100%;
  margin-top: $spacing-md;

  pre {
    margin: 0;
    padding: $spacing-sm;
    border-radius: $radius-sm;
    background: rgba($lian-text, 0.04);
    border: 1px solid $lian-divider;
    color: $lian-text-light;
    font-size: 11px;
    line-height: 1.5;
    font-family: $font-family-code;
    white-space: pre-wrap;
  }
}

// ==================
// 响应式
// ==================
@media (max-width: $container-md) {
  .profile-card {
    padding: $spacing-lg $spacing-md;
  }
  
  .profile-avatar {
    width: 80px;
    height: 80px;
  }
  
  .profile-nickname {
    font-size: $font-size-lg;
  }
}
</style>
