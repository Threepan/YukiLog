---
// ================================
// 首屏欢迎卡片组件
// AA: 欢迎文字（逐字显现 + 渐变流动 + 悬停特效）
// AB: 引用文字 + 社交图标
// ================================

import { contentConfig, siteConfig } from '../../lib/config.ts';
import { socialIcons, svgIcons } from '../../lib/svg-icons';

const resolvedSocialIcons = siteConfig.social.map((s) => ({
  ...s,
  svg: socialIcons[s.icon as keyof typeof socialIcons] ?? '',
}));

// 欢迎文字拆分为单字
const welcomeText = siteConfig.welcomeText;
const chars = [...welcomeText];

// 引用文字
const quoteText = contentConfig.components.welcomeCard.quoteText;
---

<div class="welcome-card">
  <!-- AA: 欢迎大字 -->
  <div class="welcome-title">
    {chars.map((char, i) => (
      <span
        class="welcome-char"
        style={`--char-index: ${i}; --char-delay: ${i * 0.08}s`}
      >
        {char}
      </span>
    ))}
  </div>

  <!-- AB: 下半部分 -->
  <div class="welcome-sub">
    <!-- ABA: 间距区域 -->
    <div class="welcome-spacer"></div>

    <!-- ABB: 半透明卡片 -->
    <div class="welcome-info-card">
      <!-- ABBA: 引用文字 -->
      <div class="welcome-quote">
        <span class="quote-icon quote-open" set:html={svgIcons.openingQuotationMark}></span>
        <span class="quote-text">{quoteText}</span>
        <span class="quote-icon quote-close" set:html={svgIcons.closingQuotationMark}></span>
      </div>

      <!-- ABBB: 社交图标 -->
      <div class="welcome-social">
        {resolvedSocialIcons.map((s) => (
          s.icon === 'gmail' ? (
            <span
              class="social-icon-btn"
              title={s.name}
              style={`--icon-color: ${s.color}`}
            >
              <span set:html={s.svg}></span>
            </span>
          ) : (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn"
              title={s.name}
              style={`--icon-color: ${s.color}`}
            >
              <span set:html={s.svg}></span>
            </a>
          )
        ))}
      </div>
    </div>
  </div>
</div>

<style lang="scss">
// ==================
// 容器
// ==================
.welcome-card {
  width: min(580px, 70vw);
  display: flex;
  flex-direction: column;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
}

// ==================
// AA: 欢迎大字
// ==================
.welcome-title {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  padding: $spacing-md 0;
}

.welcome-char {
  display: inline-block;
  font-size: 3.0rem;
  font-weight: 900;
  color: $lian-white;
  opacity: 0;
  transform: translateY(12px);
  animation: char-appear 0.5s cubic-bezier(0.22, 0.61, 0.36, 1) var(--char-delay) forwards;
  cursor: default;
  text-shadow: 0 2px 16px rgba(0, 0, 0, 0.5), 0 0 4px rgba(0, 0, 0, 0.3);
  -webkit-text-stroke: 0.5px rgba(255, 255, 255, 0.9);
}

@keyframes char-appear {
  from {
    opacity: 0;
    transform: translateY(12px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

// ==================
// AB: 下半部分
// ==================
.welcome-sub {
  display: flex;
  flex-direction: column;
}

// ABA: 间距
.welcome-spacer {
  height: 20%;
  min-height: 12px;
}

// ABB: 半透明信息卡
.welcome-info-card {
  background: rgba(0, 0, 0, 0.6);
  border-radius: $radius-lg;
  padding: $spacing-xs $spacing-lg;
  display: flex;
  flex-direction: column;
  gap: 0;
}

// ==================
// ABBA: 引用文字
// ==================
.welcome-quote {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: $spacing-sm;
  padding-top: $spacing-md;
  padding-bottom: $spacing-xs;
}

.quote-icon {
  width: 18px;
  height: 18px;
  flex-shrink: 0;
  
  :global(svg) {
    width: 100%;
    height: 100%;
  }
}

.quote-text {
  font-size: $font-size-base;
  font-weight: $font-weight-bold;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.6;
  text-align: center;
}

// ==================
// ABBB: 社交图标
// ==================
.welcome-social {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: $spacing-md;
  padding-top: $spacing-sm;
}

.social-icon-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: var(--icon-color);
  text-decoration: none;
  transition: all 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  cursor: pointer;
  
  :global(svg) {
    width: 24px;
    height: 24px;
    fill: currentColor;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  
  &:hover {
    filter: brightness(1.3);
    transform: translateY(-3px);
    
    :global(svg) {
      transform: scale(1.15);
    }
  }
}

// ==================
// 响应式
// ==================
@media (max-width: $container-md) {
  .welcome-title {
    padding: $spacing-md 0;
  }
  
  .welcome-char {
    font-size: 2.2rem;
  }
  
  .welcome-info-card {
    padding: $spacing-xs $spacing-md;
  }
  
  .quote-text {
    font-size: $font-size-sm;
  }
  
  .social-icon-btn {
    width: 32px;
    height: 32px;
    
    :global(svg) {
      width: 20px;
      height: 20px;
    }
  }
}
</style>
