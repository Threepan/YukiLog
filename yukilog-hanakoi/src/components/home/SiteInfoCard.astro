---
// ================================
// 站点信息卡片
// 第二屏右下 - 文章数、字数、浏览量、运行时长、GitHub
// 动画: 从右往左滑入 100px + 淡入，延迟 400ms
// ================================

import { contentConfig, siteConfig } from '../../lib/config.ts';
import { svgIcons } from '../../lib/svg-icons';
import { statsApi } from '../../lib/api';
import type { SiteStats } from '../../types';

const infoConfig = contentConfig.components.siteInfoCard;

// 获取站点统计数据
const stats: SiteStats = await statsApi.get().catch((): SiteStats => ({
  total_posts: 0,
  total_views: 0,
  total_words: 0,
}));

// 格式化字数（转换为k）
const formattedWords = stats.total_words >= 1000 
  ? `${(stats.total_words / 1000).toFixed(1)}k`
  : stats.total_words.toString();
---

<div class="siteinfo-card" id="siteinfo-card" data-enter-delay="400">
  <!-- 标题 -->
  <div class="siteinfo-header">
    <span class="siteinfo-label">{infoConfig.title}</span>
  </div>

  <!-- 信息列表 -->
  <div class="siteinfo-list">
    <!-- 文章总数 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <span set:html={svgIcons.folderOpen}></span>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">文章总数</span>
        <span class="siteinfo-value">{stats.total_posts} 篇</span>
      </div>
    </div>

    <!-- 总字数 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <span set:html={svgIcons.wordCount}></span>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">总字数</span>
        <span class="siteinfo-value">{formattedWords} 字</span>
      </div>
    </div>

    <!-- 总浏览量 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <span set:html={svgIcons.eye}></span>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">总浏览量</span>
        <span class="siteinfo-value">{stats.total_views.toLocaleString()} 次</span>
      </div>
    </div>

    <!-- 运行时长 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <span set:html={svgIcons.clock}></span>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.labels.uptime}</span>
        <span class="siteinfo-value" id="siteinfo-uptime">{infoConfig.labels.calculating}</span>
      </div>
    </div>

    <!-- GitHub 开源 -->
    <a href={infoConfig.github.url} target="_blank" rel="noopener noreferrer" class="siteinfo-item">
      <div class="siteinfo-icon">
        <span set:html={svgIcons.githubMark}></span>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.github.name}</span>
        <span class="siteinfo-value link-value">{infoConfig.github.value}</span>
      </div>
      <span class="siteinfo-arrow" set:html={svgIcons.chevronRight}></span>
    </a>
  </div>
</div>

<style lang="scss">
.siteinfo-card {
  background: var(--color-white);
  border-radius: $radius-lg;
  box-shadow: $shadow-blue;
  padding: $spacing-lg;
  margin-top: $spacing-sm;
  display: flex;
  flex-direction: column;
  
  // 初始隐藏，等待动画触发
  opacity: 0;
  transform: translateX(100px);
  transition: opacity 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
              transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  
  &.visible {
    opacity: 1;
    transform: translateX(0);
  }
}

// ==================
// 标题
// ==================
.siteinfo-header {
  margin-bottom: $spacing-md;
}

.siteinfo-label {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: var(--color-text-light);
  letter-spacing: 0.05em;
}

// ==================
// 信息列表
// ==================
.siteinfo-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.siteinfo-item {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
  padding: 10px 12px;
  border-radius: $radius-sm;
  color: var(--color-text);
  text-decoration: none;
  transition: background $transition-base $ease-gentle;
  
  &:hover {
    background: var(--color-bg);
  }
  
  // 可点击的项（链接）
  &[href] {
    cursor: pointer;
  }
}

.siteinfo-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: var(--color-blue);
  background: var(--blue-alpha-08);
  border-radius: 8px;
  transition: all $transition-base $ease-gentle;
  
  .siteinfo-item:hover & {
    background: var(--blue-alpha-14);
  }
}

.siteinfo-detail {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.siteinfo-name {
  font-size: $font-size-xs;
  color: var(--color-text-muted);
  line-height: 1;
}

.siteinfo-value {
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: var(--color-text);
  line-height: 1.3;
  
  &.link-value {
    color: var(--color-blue);
  }
}

.siteinfo-arrow {
  flex-shrink: 0;
  color: var(--color-text-muted);
  transition: transform $transition-base $ease-gentle;
  
  .siteinfo-item:hover & {
    transform: translateX(3px);
    color: var(--color-blue);
  }
}

// ==================
// 响应式
// ==================
@media (max-width: $container-md) {
  .siteinfo-card {
    padding: $spacing-md;
  }
}
</style>

<script define:vars={{ startDate: siteConfig.startDate }}>
  document.addEventListener('astro:page-load', () => {
    // 清理上次的定时器，防止 View Transitions 导致多个定时器叠加
    if (typeof window.__uptimeTimer !== 'undefined') {
      clearInterval(window.__uptimeTimer);
    }

    const uptimeEl = document.getElementById('siteinfo-uptime');
    if (!uptimeEl) return;

    function updateUptime() {
      const start = new Date(startDate);
      const now = new Date();
      const diff = now.getTime() - start.getTime();

      if (diff < 0) {
        uptimeEl.textContent = '0 天 0 时 0 分 0 秒';
        return;
      }

      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((diff % (1000 * 60)) / 1000);

      uptimeEl.textContent = `${days} 天 ${hours} 时 ${minutes} 分 ${seconds} 秒`;
    }

    updateUptime();
    window.__uptimeTimer = setInterval(updateUptime, 1000);
  });
</script>
