---
// ================================
// 站点信息卡片
// 第二屏右下 - 主站链接、浏览量、运行时长、GitHub
// 动画: 从右往左滑入 100px + 淡入，延迟 400ms
// ================================

import { contentConfig, siteConfig } from '../../lib/config.ts';

const infoConfig = contentConfig.components.siteInfoCard;
---

<div class="siteinfo-card" id="siteinfo-card" data-enter-delay="400">
  <!-- 标题 -->
  <div class="siteinfo-header">
    <span class="siteinfo-label">{infoConfig.title}</span>
  </div>

  <!-- 信息列表 -->
  <div class="siteinfo-list">
    <!-- 前往主站 -->
    <a href={infoConfig.mainSite.url} target="_blank" rel="noopener noreferrer" class="siteinfo-item">
      <div class="siteinfo-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
        </svg>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.mainSite.name}</span>
        <span class="siteinfo-value link-value">{infoConfig.mainSite.value}</span>
      </div>
      <svg class="siteinfo-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </a>

    <!-- 总浏览量 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.labels.totalViews}</span>
        <span class="siteinfo-value" id="siteinfo-views">--</span>
      </div>
    </div>

    <!-- 运行时长 -->
    <div class="siteinfo-item">
      <div class="siteinfo-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.labels.uptime}</span>
        <span class="siteinfo-value" id="siteinfo-uptime">计算中...</span>
      </div>
    </div>

    <!-- GitHub 开源 -->
    <a href={infoConfig.github.url} target="_blank" rel="noopener noreferrer" class="siteinfo-item">
      <div class="siteinfo-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
      </div>
      <div class="siteinfo-detail">
        <span class="siteinfo-name">{infoConfig.github.name}</span>
        <span class="siteinfo-value link-value">{infoConfig.github.value}</span>
      </div>
      <svg class="siteinfo-arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 18l6-6-6-6"/>
      </svg>
    </a>
  </div>
</div>

<style lang="scss">
.siteinfo-card {
  background: $lian-white;
  border-radius: $radius-lg;
  box-shadow: $shadow-blue;
  padding: $spacing-lg;
  margin-top: $spacing-sm;
  display: flex;
  flex-direction: column;
  
  // 初始隐藏，等待动画触发
  opacity: 0;
  transform: translateX(100px);
  transition: opacity 600ms cubic-bezier(0.22, 0.61, 0.36, 1),
              transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  
  &.visible {
    opacity: 1;
    transform: translateX(0);
  }
}

// ==================
// 标题
// ==================
.siteinfo-header {
  margin-bottom: $spacing-md;
}

.siteinfo-label {
  font-size: $font-size-sm;
  font-weight: $font-weight-semibold;
  color: $lian-text-light;
  letter-spacing: 0.05em;
}

// ==================
// 信息列表
// ==================
.siteinfo-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.siteinfo-item {
  display: flex;
  align-items: center;
  gap: $spacing-sm;
  padding: 10px 12px;
  border-radius: $radius-sm;
  color: $lian-text;
  text-decoration: none;
  transition: background $transition-base $ease-gentle;
  
  &:hover {
    background: $lian-bg;
  }
  
  // 可点击的项（链接）
  &[href] {
    cursor: pointer;
  }
}

.siteinfo-icon {
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: $lian-blue;
  background: rgba($lian-blue, 0.08);
  border-radius: 8px;
  transition: all $transition-base $ease-gentle;
  
  .siteinfo-item:hover & {
    background: rgba($lian-blue, 0.14);
  }
}

.siteinfo-detail {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-width: 0;
}

.siteinfo-name {
  font-size: $font-size-xs;
  color: $lian-text-muted;
  line-height: 1;
}

.siteinfo-value {
  font-size: $font-size-sm;
  font-weight: $font-weight-medium;
  color: $lian-text;
  line-height: 1.3;
  
  &.link-value {
    color: $lian-blue;
  }
}

.siteinfo-arrow {
  flex-shrink: 0;
  color: $lian-text-muted;
  transition: transform $transition-base $ease-gentle;
  
  .siteinfo-item:hover & {
    transform: translateX(3px);
    color: $lian-blue;
  }
}

// ==================
// 响应式
// ==================
@media (max-width: $container-md) {
  .siteinfo-card {
    padding: $spacing-md;
  }
}
</style>

<script define:vars={{ startDate: siteConfig.startDate }}>
  // 实时更新运行时长
  const uptimeEl = document.getElementById('siteinfo-uptime');
  
  function updateUptime() {
    if (!uptimeEl) return;
    const start = new Date(startDate);
    const now = new Date();
    const diff = now.getTime() - start.getTime();
    
    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);
    
    uptimeEl.textContent = `${days} 天 ${hours} 时 ${minutes} 分 ${seconds} 秒`;
  }
  
  updateUptime();
  setInterval(updateUptime, 1000);
  
  // TODO: 总浏览量从后端 API 获取
  // const viewsEl = document.getElementById('siteinfo-views');
  // fetch(`${API_BASE_URL}/api/stats/views`)
  //   .then(res => res.json())
  //   .then(data => { if (viewsEl) viewsEl.textContent = data.total.toLocaleString(); })
  //   .catch(() => { if (viewsEl) viewsEl.textContent = '暂无数据'; });
</script>
