---
// ================================
// 管理后台布局
// 侧边栏 + 顶栏 + 内容区
// ================================

export const prerender = false;

interface Props {
  title: string;
  activeMenu?: 'posts' | 'comments' | 'themes' | 'tags' | 'links';
}

import BaseLayout from './BaseLayout.astro';
import { svgIcons } from '../lib/svg-icons';

const { title, activeMenu } = Astro.props;

const menuItems = [
  { key: 'posts', label: '文章管理', href: '/admin/posts', icon: svgIcons.folderOpen },
  { key: 'comments', label: '评论管理', href: '/admin/comments', icon: svgIcons.envelope },
  { key: 'themes', label: '主题管理', href: '/admin/themes', icon: svgIcons.theme },
  { key: 'tags', label: '标签管理', href: '/admin/tags', icon: svgIcons.tag },
  { key: 'links', label: '友链管理', href: '/admin/links', icon: svgIcons.links },
];
---

<BaseLayout title={title}>
  <div class="admin-layout">
    <!-- 侧边栏 -->
    <aside class="admin-sidebar">
      <div class="sidebar-header">
        <a href="/" class="sidebar-logo">YukiLog</a>
        <div class="sidebar-subtitle">管理后台</div>
      </div>

      <nav class="sidebar-nav">
        {menuItems.map(item => (
          <a 
            href={item.href} 
            class:list={["nav-item", { active: activeMenu === item.key }]}
          >
            <span class="nav-icon" set:html={item.icon}></span>
            <span class="nav-label">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="sidebar-footer">
        <a href="/" class="back-to-site">← 返回前台</a>
      </div>
    </aside>

    <!-- 主区域 -->
    <div class="admin-main">
      <!-- 顶栏 -->
      <header class="admin-header">
        <h1 class="page-title">{title}</h1>
        <div class="header-actions">
          <span class="admin-name">管理员</span>
          <button id="logout-btn" class="logout-btn">退出登录</button>
        </div>
      </header>

      <!-- 内容区 -->
      <main class="admin-content">
        <slot />
      </main>
    </div>
  </div>
</BaseLayout>

<script>
  import { guardAdminRoute, logout } from '../lib/admin-guard';

  // 守卫路由
  guardAdminRoute();

  // 登出按钮
  document.getElementById('logout-btn')?.addEventListener('click', logout);
</script>

<style lang="scss">
  .admin-layout {
    display: flex;
    min-height: 100vh;
    background: $lian-bg;
  }

  // ============ 侧边栏 ============
  .admin-sidebar {
    width: 240px;
    background: $lian-white;
    border-right: 1px solid $lian-border;
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .sidebar-header {
    padding: $spacing-lg;
    border-bottom: 1px solid $lian-divider;
  }

  .sidebar-logo {
    font-size: $font-size-xl;
    font-weight: $font-weight-bold;
    color: $lian-blue;
    text-decoration: none;
    display: block;

    &:hover {
      color: $lian-pink;
    }
  }

  .sidebar-subtitle {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    margin-top: 4px;
  }

  .sidebar-nav {
    flex: 1;
    padding: $spacing-md;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-sm $spacing-md;
    color: $lian-text-light;
    text-decoration: none;
    border-radius: $radius-sm;
    transition: all $transition-fast $ease-gentle;

    &:hover {
      background: $lian-bg;
      color: $lian-blue;
    }

    &.active {
      background: rgba($lian-blue, 0.08);
      color: $lian-blue;
      font-weight: $font-weight-medium;
    }
  }

  .nav-icon {
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    :global(svg) {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }
  }

  .nav-label {
    font-size: $font-size-sm;
  }

  .sidebar-footer {
    padding: $spacing-md;
    border-top: 1px solid $lian-divider;
  }

  .back-to-site {
    display: block;
    padding: $spacing-sm;
    font-size: $font-size-sm;
    color: $lian-text-muted;
    text-align: center;
    text-decoration: none;
    border-radius: $radius-sm;

    &:hover {
      background: $lian-bg;
      color: $lian-blue;
    }
  }

  // ============ 主区域 ============
  .admin-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .admin-header {
    height: 64px;
    background: $lian-white;
    border-bottom: 1px solid $lian-border;
    padding: 0 $spacing-xl;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .page-title {
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    margin: 0;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: $spacing-md;
  }

  .admin-name {
    font-size: $font-size-sm;
    color: $lian-text-light;
  }

  .logout-btn {
    padding: 6px $spacing-md;
    font-size: $font-size-sm;
    color: $lian-text-light;
    background: none;
    border: 1px solid $lian-border;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-fast $ease-gentle;

    &:hover {
      border-color: $lian-error;
      color: $lian-error;
    }
  }

  .admin-content {
    flex: 1;
    overflow-y: auto;
    padding: $spacing-xl;
  }

  // ============ 响应式 ============
  @media (max-width: $container-md) {
    .admin-sidebar {
      width: 200px;
    }

    .nav-label {
      font-size: $font-size-xs;
    }

    .admin-content {
      padding: $spacing-lg;
    }
  }

  @media (max-width: $container-sm) {
    .admin-sidebar {
      position: fixed;
      left: -240px;
      top: 0;
      bottom: 0;
      z-index: $z-modal;
      transition: left $transition-base $ease-gentle;

      &.open {
        left: 0;
      }
    }

    .admin-content {
      padding: $spacing-md;
    }
  }
</style>
