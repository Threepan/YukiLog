---
// ================================
// 基础布局 - 所有页面的根布局
// ================================

interface Props {
  title: string;
  description?: string;
  keywords?: string[];
  ogImage?: string;
}

import SEO from '../components/shared/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.scss';

const { title, description, keywords, ogImage } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <ClientRouter />
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      ogImage={ogImage}
    />
    <slot name="head" />
  </head>
  <body>
    <slot />
    
    <script>
      // 页面失去焦点时修改标题
      document.addEventListener('astro:page-load', () => {
        const originalTitle = document.title;
        
        // 移除旧监听（避免重复）
        if (window.__yukilogVisHandler) {
          document.removeEventListener('visibilitychange', window.__yukilogVisHandler);
        }
        
        window.__yukilogVisHandler = () => {
          if (document.hidden) {
            document.title = '...你 ... 要走了吗?';
          } else {
            document.title = originalTitle;
          }
        };
        
        document.addEventListener('visibilitychange', window.__yukilogVisHandler);
      });
      
      declare global {
        interface Window {
          __yukilogVisHandler?: () => void;
        }
      }
    </script>
  </body>
</html>

