---
// ================================
// 随记详情页
// Markdown 完整渲染 + 心情标记
// ================================

export const prerender = false;

import BlogLayout from "../../layouts/BlogLayout.astro";
import { contentConfig } from "../../lib/config";
import { renderMarkdown } from "../../lib/markdown";
import { notesApi } from "../../lib/api";

const { id } = Astro.params;

if (!id || isNaN(Number(id))) {
  return Astro.redirect("/404");
}

const noteId = Number(id);
const notesPageConfig = contentConfig.pages.notes;
const hp = contentConfig.markdown.headingPrefixes;

// 从后端获取随记详情
let note: any = null;
let apiError = null;
try {
  note = await notesApi.getById(noteId);
} catch (error) {
  console.error("获取随记详情失败：", error);
  apiError = error;
}

if (apiError || !note) {
  return Astro.redirect("/404");
}

// 渲染 Markdown
const { html: markdownHtml } = await renderMarkdown(note.content);

const moodLabel = note.mood
  ? (notesPageConfig.moodLabels as Record<string, string>)[note.mood] || note.mood
  : null;

const formattedDate = new Date(note.created_at).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  weekday: "long",
  hour: "2-digit",
  minute: "2-digit",
});
---

<BlogLayout title="随记" description="一条随记" stickyNav>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/katex.min.css" slot="head" />

  <div class="note-detail-page">
    <nav class="note-back-nav">
      <a href="/notes" class="note-back-link">← 返回随记</a>
    </nav>

    <article
      class="note-detail"
      style={`--h1p:"${hp.h1}";--h2p:"${hp.h2}";--h3p:"${hp.h3}";--h4p:"${hp.h4}";--h5p:"${hp.h5}";--h6p:"${hp.h6}";`}
    >
      <header class="note-header">
        <time class="note-date">{formattedDate}</time>
        {moodLabel && <span class="note-mood">{moodLabel}</span>}
      </header>

      <div class="note-content markdown-content" set:html={markdownHtml} />

      {note.updated_at !== note.created_at && (
        <footer class="note-footer">
          <span class="note-updated">
            最后编辑于 {new Date(note.updated_at).toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
              hour: "2-digit",
              minute: "2-digit",
            })}
          </span>
        </footer>
      )}
    </article>
  </div>
</BlogLayout>

<style>
  .note-detail-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 80px var(--spacing-lg) var(--spacing-xxl);
    min-height: 80vh;
  }

  /* 返回导航 */
  .note-back-nav {
    margin-bottom: var(--spacing-xl);
    opacity: 0;
    animation: fade-in 400ms var(--ease-gentle) 100ms forwards;
  }

  .note-back-link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 200ms var(--ease-gentle);

    &:hover {
      color: var(--color-blue);
    }
  }

  /* 随记卡片 */
  .note-detail {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl) var(--spacing-xxl);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    opacity: 0;
    animation: note-in 500ms var(--ease-gentle) 200ms forwards;
  }

  @keyframes note-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fade-in {
    to { opacity: 1; }
  }

  /* 头部 */
  .note-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing-xl);
    padding-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-divider);
    flex-wrap: wrap;
  }

  .note-date {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .note-mood {
    font-size: var(--font-size-xs);
    padding: 2px 10px;
    background: linear-gradient(135deg, rgba(126, 182, 217, 0.12), rgba(232, 164, 180, 0.12));
    border-radius: var(--radius-full);
    color: var(--color-text-light);
  }

  /* 正文 */
  .note-content {
    font-size: var(--font-size-base);
    line-height: 1.85;
    color: var(--color-text);

    :global(p) {
      margin: 0 0 var(--spacing-md);
    }

    :global(img) {
      max-width: 100%;
      border-radius: var(--radius-md);
      margin: var(--spacing-md) 0;
    }

    :global(pre) {
      border-radius: var(--radius-md);
      margin: var(--spacing-md) 0;
      overflow-x: auto;
    }

    :global(blockquote) {
      border-left: 3px solid var(--color-blue);
      padding-left: var(--spacing-md);
      color: var(--color-text-light);
      margin: var(--spacing-md) 0;
    }

    :global(a) {
      color: var(--color-blue);
      text-decoration: underline;
      text-underline-offset: 2px;

      &:hover {
        color: var(--color-pink);
      }
    }
  }

  /* 底部 */
  .note-footer {
    margin-top: var(--spacing-xl);
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-divider);
  }

  .note-updated {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* 响应式 */
  @media (max-width: 768px) {
    .note-detail-page {
      padding: 70px var(--spacing-md) var(--spacing-xl);
    }

    .note-detail {
      padding: var(--spacing-lg) var(--spacing-lg);
    }
  }
</style>
