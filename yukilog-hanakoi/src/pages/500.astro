---
// ================================
// 500 Server Error 页面
// ================================

export const prerender = false;

import BlogLayout from "../layouts/BlogLayout.astro";
import { contentConfig } from "../lib/config";

const e500 = contentConfig.pages.error500;
---

<BlogLayout title="500 - 服务器错误" description="服务器出了点问题" stickyNav>
  <div class="error-page">
    <div class="error-content">
      <div class="error-icon">{e500.icon}</div>
      <h1 class="error-code">500</h1>
      <p class="error-title">{e500.title}</p>
      <p class="error-desc" set:html={e500.description.replace('\n', '<br />')} />
      <ul class="error-reasons">
        {e500.reasons.map((reason) => (
          <li>{reason}</li>
        ))}
      </ul>
      <div class="error-actions">
        <a href="/" class="btn-primary">{e500.primaryButton}</a>
        <button onclick="location.reload()" class="btn-secondary">{e500.secondaryButton}</button>
      </div>
      <div class="error-hint">
        {e500.hint}
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    background: var(--color-bg);
  }

  .error-content {
    text-align: center;
    max-width: 600px;
    animation: fade-in 600ms var(--ease-gentle);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error-icon {
    font-size: 80px;
    margin-bottom: var(--spacing-md);
  }

  .error-code {
    font-size: 96px;
    font-weight: var(--font-weight-bold);
    background: linear-gradient(135deg, var(--color-pink), var(--color-pink-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    line-height: 1;
  }

  .error-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: var(--spacing-md) 0 var(--spacing-sm);
  }

  .error-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-md);
  }

  .error-reasons {
    list-style: none;
    padding: var(--spacing-md) var(--spacing-lg);
    background: var(--color-surface, #fff);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-pink);
    margin: 0 0 var(--spacing-xl);
    text-align: left;

    li {
      font-size: var(--font-size-sm);
      color: var(--color-text-light);
      line-height: var(--line-height-relaxed);
      padding: 4px 0;

      &::before {
        content: "• ";
        color: var(--color-pink);
        font-weight: var(--font-weight-bold);
        margin-right: 8px;
      }
    }
  }

  .error-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: var(--spacing-md);
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition:
      background var(--transition-fast) var(--ease-gentle),
      box-shadow var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-blue), var(--color-blue-light));
    color: var(--color-on-primary, #fff);
    box-shadow: 0 2px 8px rgba(126, 182, 217, 0.3);

    &:hover {
      box-shadow: 0 4px 12px rgba(126, 182, 217, 0.4);
      transform: translateY(-2px);
    }
  }

  .btn-secondary {
    background: var(--color-surface, #fff);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    box-shadow: 0 1px 3px rgba(44, 62, 80, 0.08);

    &:hover {
      background: var(--color-white);
      box-shadow: 0 2px 6px rgba(44, 62, 80, 0.12);
      transform: translateY(-2px);
    }
  }

  .error-hint {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
    margin-top: var(--spacing-md);
  }

  @media (max-width: 640px) {
    .error-code {
      font-size: 72px;
    }

    .error-title {
      font-size: var(--font-size-xl);
    }

    .error-reasons {
      padding: var(--spacing-sm) var(--spacing-md);
    }

    .error-actions {
      flex-direction: column;
      width: 100%;

      .btn-primary,
      .btn-secondary {
        width: 100%;
      }
    }
  }
</style>
