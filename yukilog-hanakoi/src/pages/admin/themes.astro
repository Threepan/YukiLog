---
// ================================
// 主题管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="主题管理" activeMenu="themes">
  <!-- 操作栏 -->
  <div class="action-bar">
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建主题
    </button>
  </div>

  <!-- 状态区 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无主题，点击「新建主题」创建第一个分类吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p id="error-msg">加载失败</p>
    <button id="retry-btn" class="btn-retry">重试</button>
  </div>

  <!-- 主题卡片网格 -->
  <div id="themes-grid" class="themes-grid" style="display:none"></div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建主题</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>主题名称 *</label>
            <input type="text" id="edit-name" required placeholder="例如：科技" />
          </div>
          <div class="form-group">
            <label>Slug *</label>
            <input type="text" id="edit-slug" required placeholder="例如：tech（自动生成）" />
            <span class="form-hint">URL 友好标识符，仅支持小写字母、数字和连字符</span>
          </div>
          <div class="form-group">
            <label>描述</label>
            <textarea id="edit-description" rows="3" placeholder="选填，简要描述这个主题"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { themesApi, adminApi } from '../../lib/api';
  import type { Theme } from '../../types/api';

  // ===== 状态管理（模块级，跨导航保持） =====
  let themes: Theme[] = [];
  let editingTheme: Theme | null = null;

  document.addEventListener('astro:page-load', () => {
    const themesGrid = document.getElementById('themes-grid')!;
    if (!themesGrid) return;

    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const errorMsg = document.getElementById('error-msg')!;
    const createBtn = document.getElementById('create-btn')!;
    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editSlug = document.getElementById('edit-slug') as HTMLInputElement;
    const editDescription = document.getElementById('edit-description') as HTMLTextAreaElement;

    function escapeHtml(text: string): string {
      const d = document.createElement('div'); d.textContent = text; return d.innerHTML;
    }

    function generateSlug(name: string): string {
      const map: Record<string, string> = { '科技':'tech','技术':'tech','随笔':'essay','生活':'life','旅行':'travel','摄影':'photo','读书':'reading','音乐':'music','电影':'movie','美食':'food' };
      return map[name.trim()] || name.trim().toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'').replace(/-+/g,'-');
    }

    function renderThemes() {
      themesGrid.innerHTML = themes.map(theme => `
        <div class="theme-card">
          <div class="theme-card-body">
            <div class="theme-card-top">
              <h3 class="theme-name">${escapeHtml(theme.name)}</h3>
              <code class="theme-slug-code">${escapeHtml(theme.slug)}</code>
            </div>
            ${theme.description ? `<p class="theme-desc">${escapeHtml(theme.description)}</p>` : ''}
            <div class="theme-stats">
              <span class="stat-item">📝 ${theme.post_count || 0} 篇文章</span>
              <span class="stat-item">👁 ${theme.view_count || 0} 次浏览</span>
            </div>
          </div>
          <div class="theme-card-actions">
            <button class="btn-edit" data-id="${theme.id}">编辑</button>
            <button class="btn-delete" data-id="${theme.id}" data-post-count="${theme.post_count || 0}">删除</button>
          </div>
        </div>
      `).join('');
      bindActionButtons();
    }

    async function loadThemes() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      themesGrid.style.display = 'none';
      try {
        themes = await themesApi.list();
        if (themes.length === 0) {
          loading.style.display = 'none'; empty.style.display = 'flex';
        } else {
          renderThemes(); loading.style.display = 'none'; themesGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorMsg.textContent = err.message || '加载主题失败';
        errorState.style.display = 'flex';
      }
    }

    function bindActionButtons() {
      themesGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => handleEdit(Number((e.target as HTMLElement).dataset.id)));
      });
      themesGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          handleDelete(Number(t.dataset.id), Number(t.dataset.postCount));
        });
      });
    }

    function openCreateModal() {
      editingTheme = null; modalTitle.textContent = '新建主题'; editForm.reset(); editModal.classList.add('active');
    }

    function handleEdit(id: number) {
      const theme = themes.find(t => t.id === id); if (!theme) return;
      editingTheme = theme; modalTitle.textContent = '编辑主题';
      editName.value = theme.name; editSlug.value = theme.slug; editDescription.value = theme.description || '';
      editModal.classList.add('active');
    }

    async function handleDelete(id: number, postCount: number) {
      const theme = themes.find(t => t.id === id); if (!theme) return;
      let msg = `确认删除主题《${theme.name}》？`;
      if (postCount > 0) msg += `\n\n关联的 ${postCount} 篇文章将变为无主题状态。`;
      if (!confirm(msg)) return;
      try { await adminApi.themes.delete(id); await loadThemes(); }
      catch (err: any) { alert(err.message || '删除失败'); }
    }

    async function handleSubmit(e: Event) {
      e.preventDefault();
      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true; saveBtn.textContent = editingTheme ? '保存中...' : '创建中...';
      const data = { name: editName.value.trim(), slug: editSlug.value.trim(), description: editDescription.value.trim() || null };
      if (!/^[a-z0-9-]+$/.test(data.slug)) {
        alert('Slug 仅支持小写字母、数字和连字符');
        saveBtn.disabled = false; saveBtn.textContent = '保存'; return;
      }
      try {
        if (editingTheme) { await adminApi.themes.update(editingTheme.id, data); }
        else { await adminApi.themes.create(data); }
        closeModal(); await loadThemes();
      } catch (err: any) { alert(err.message || '操作失败'); }
      finally { saveBtn.disabled = false; saveBtn.textContent = '保存'; }
    }

    function closeModal() { editModal.classList.remove('active'); editingTheme = null; editForm.reset(); }

    createBtn.addEventListener('click', openCreateModal);
    document.getElementById('retry-btn')?.addEventListener('click', loadThemes);
    document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
    document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);
    editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
    editForm.addEventListener('submit', handleSubmit);
    editName.addEventListener('input', () => { if (!editingTheme) editSlug.value = generateSlug(editName.value); });

    loadThemes();
  });
</script>

<style lang="scss">
  @use 'sass:color';

  // 操作栏
  .action-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: $spacing-lg;
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: $spacing-sm $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;

    &:hover {
      transform: translateY(-1px);
      box-shadow: $shadow-blue;
    }

    span {
      font-size: $font-size-xl;
    }
  }

  // 加载/空状态
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    color: $lian-text-muted;

    p {
      margin: $spacing-sm 0 0;
      font-size: $font-size-sm;
      text-align: center;
    }
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba($lian-border, 0.3);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  // 主题卡片网格
  .themes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
  }

  .theme-card {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    border: 1px solid $lian-divider;
    display: flex;
    flex-direction: column;
    transition: all $transition-base $ease-gentle;

    &:hover {
      box-shadow: $shadow-blue;
      border-color: rgba($lian-blue, 0.3);
      transform: translateY(-2px);
    }
  }

  .theme-card-body {
    flex: 1;
    padding: $spacing-lg;
    display: flex;
    flex-direction: column;
    gap: $spacing-sm;
  }

  .theme-card-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: $spacing-sm;
    flex-wrap: wrap;
  }

  .theme-name {
    font-size: $font-size-lg;
    font-weight: $font-weight-bold;
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
  }

  .theme-slug-code {
    font-size: $font-size-xs;
    font-family: $font-family-code;
    color: $lian-text-muted;
    background: rgba($lian-blue, 0.06);
    padding: 2px 8px;
    border-radius: 6px;
    white-space: nowrap;
  }

  .theme-desc {
    font-size: $font-size-sm;
    color: $lian-text-light;
    line-height: $line-height-base;
    margin: 0;
  }

  .theme-stats {
    display: flex;
    gap: $spacing-md;
    margin-top: auto;
    padding-top: $spacing-sm;
  }

  .stat-item {
    font-size: $font-size-xs;
    color: $lian-text-muted;
  }

  .theme-card-actions {
    display: flex;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-lg $spacing-md;
    border-top: 1px solid $lian-divider;
    background: rgba($lian-bg, 0.5);
    border-radius: 0 0 $radius-md $radius-md;
  }

  // 错误状态
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-md;
    padding: $spacing-xxl;
    p { font-size: $font-size-sm; color: $lian-error; }
  }

  .btn-retry {
    padding: $spacing-xs $spacing-lg;
    font-size: $font-size-sm;
    color: var(--color-white);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none; border-radius: $radius-sm; cursor: pointer;
    transition: all $transition-base $ease-gentle;
    &:hover { box-shadow: $shadow-blue; transform: translateY(-1px); }
  }

  // 操作按钮（卡片内）
  .btn-edit {
    flex: 1;
    padding: $spacing-xs $spacing-sm;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    color: $lian-blue;
    background: rgba($lian-blue, 0.08);
    border: 1px solid rgba($lian-blue, 0.25);
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    text-align: center;

    &:hover {
      background: $lian-blue;
      color: var(--color-white);
      box-shadow: $shadow-blue;
      transform: translateY(-1px);
    }
  }

  .btn-delete {
    flex: 1;
    padding: $spacing-xs $spacing-sm;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    color: $lian-error;
    background: rgba($lian-error, 0.08);
    border: 1px solid rgba($lian-error, 0.25);
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    text-align: center;

    &:hover {
      background: $lian-error;
      color: var(--color-white);
      box-shadow: 0 4px 12px rgba($lian-error, 0.3);
      transform: translateY(-1px);
    }
  }

  // 弹窗
  .modal {
    position: fixed;
    inset: 0;
    z-index: $z-modal;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity $transition-base $ease-gentle,
                visibility $transition-base $ease-gentle;

    &.active {
      opacity: 1;
      visibility: visible;

      .modal-card {
        transform: scale(1);
      }
    }
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay-bg);
    backdrop-filter: blur(8px);
    animation: fadeIn $transition-base $ease-gentle;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-card {
    position: relative;
    width: 90%;
    max-width: 520px;
    background: var(--color-white);
    border-radius: $radius-lg;
    box-shadow: var(--shadow-2xl);
    transform: scale(0.9) translateY(20px);
    transition: all $transition-base $ease-gentle;
    border: 1px solid rgba($lian-blue, 0.1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: $spacing-xl $spacing-xl $spacing-lg;
    background: linear-gradient(135deg, rgba($lian-blue, 0.03) 0%, rgba($lian-pink, 0.03) 100%);
    border-bottom: 1px solid $lian-divider;
    border-radius: $radius-lg $radius-lg 0 0;

    h3 {
      margin: 0;
      font-size: $font-size-xl;
      font-weight: $font-weight-bold;
      background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .modal-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: $font-size-2xl;
      color: $lian-text-muted;
      background: none;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;

      &:hover {
        background: linear-gradient(135deg, rgba($lian-blue, 0.1) 0%, rgba($lian-pink, 0.1) 100%);
        color: $lian-text;
        transform: rotate(90deg);
      }
    }
  }

  .modal-body {
    padding: $spacing-xl;
  }

  .form-group {
    margin-bottom: $spacing-md;

    &:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text;
      margin-bottom: $spacing-xs;
    }

    input,
    textarea {
      width: 100%;
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-base;
      color: $lian-text;
      background: var(--color-white);
      border: 2px solid $lian-border;
      border-radius: $radius-sm;
      font-family: $font-family-base;
      transition: all $transition-base $ease-gentle;

      &:focus {
        outline: none;
        border-color: $lian-blue;
        box-shadow: 0 0 0 4px rgba($lian-blue, 0.1);
        transform: translateY(-2px);
      }

      &:hover {
        border-color: rgba($lian-blue, 0.5);
      }

      &::placeholder {
        color: $lian-text-muted;
      }
    }

    textarea {
      resize: vertical;
      min-height: 60px;
    }

    .form-hint {
      display: block;
      margin-top: 4px;
      font-size: $font-size-xs;
      color: $lian-text-muted;
    }
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: $spacing-md;
    padding: $spacing-lg $spacing-xl $spacing-xl;
    border-top: 1px solid $lian-divider;

    button {
      padding: $spacing-sm $spacing-xl;
      font-size: $font-size-sm;
      font-weight: $font-weight-semibold;
      border: none;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;
    }

    .btn-secondary {
      color: $lian-text;
      background: $lian-bg;
      border: 2px solid $lian-border;

      &:hover {
        background: rgba($lian-blue, 0.05);
        border-color: $lian-blue;
        transform: translateY(-2px);
      }
    }

    .btn-primary {
      color: var(--color-on-primary);
      background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
      box-shadow: $shadow-blue;

      &:hover {
        transform: translateY(-2px);
        box-shadow: $shadow-blue-hover;
      }

      &:active {
        transform: translateY(0);
      }

      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
      }
    }
  }
</style>
