---
// ================================
// 主题管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="主题管理" activeMenu="themes">
  <!-- 操作栏 -->
  <div class="action-bar">
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建主题
    </button>
  </div>

  <!-- 状态区 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无主题，点击「新建主题」创建第一个分类吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p id="error-msg">加载失败</p>
    <button id="retry-btn" class="btn-retry">重试</button>
  </div>

  <!-- 主题卡片网格 -->
  <div id="themes-grid" class="themes-grid" style="display:none"></div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建主题</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>主题名称 *</label>
            <input type="text" id="edit-name" required placeholder="例如：科技" />
          </div>
          <div class="form-group">
            <label>Slug *</label>
            <input type="text" id="edit-slug" required placeholder="例如：tech（自动生成）" />
            <span class="form-hint">URL 友好标识符，仅支持小写字母、数字和连字符</span>
          </div>
          <div class="form-group">
            <label>描述</label>
            <textarea id="edit-description" rows="3" placeholder="选填，简要描述这个主题"></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { themesApi, adminApi } from '../../lib/api';
  import type { Theme } from '../../types/api';

  // ===== 状态管理（模块级，跨导航保持） =====
  let themes: Theme[] = [];
  let editingTheme: Theme | null = null;

  document.addEventListener('astro:page-load', () => {
    const themesGrid = document.getElementById('themes-grid')!;
    if (!themesGrid) return;

    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const errorMsg = document.getElementById('error-msg')!;
    const createBtn = document.getElementById('create-btn')!;
    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editSlug = document.getElementById('edit-slug') as HTMLInputElement;
    const editDescription = document.getElementById('edit-description') as HTMLTextAreaElement;

    function escapeHtml(text: string): string {
      const d = document.createElement('div'); d.textContent = text; return d.innerHTML;
    }

    function generateSlug(name: string): string {
      const map: Record<string, string> = { '科技':'tech','技术':'tech','随笔':'essay','生活':'life','旅行':'travel','摄影':'photo','读书':'reading','音乐':'music','电影':'movie','美食':'food' };
      return map[name.trim()] || name.trim().toLowerCase().replace(/\s+/g,'-').replace(/[^a-z0-9-]/g,'').replace(/-+/g,'-');
    }

    function renderThemes() {
      themesGrid.innerHTML = themes.map(theme => `
        <div class="theme-card">
          <div class="theme-card-header">
            <div class="theme-name-row">
              <h3 class="theme-name">${escapeHtml(theme.name)}</h3>
              <code class="theme-slug-code">${escapeHtml(theme.slug)}</code>
            </div>
            <p class="theme-desc">${theme.description ? escapeHtml(theme.description) : '<span class="no-desc">暂无描述</span>'}</p>
          </div>
          <div class="theme-stat-row">
            <div class="theme-stat-pill stat-blue">
              <span class="stat-num">${theme.post_count || 0}</span>
              <span class="stat-label">篇文章</span>
            </div>
            <div class="theme-stat-pill stat-pink">
              <span class="stat-num">${theme.view_count || 0}</span>
              <span class="stat-label">次浏览</span>
            </div>
          </div>
          <div class="theme-card-actions">
            <button class="btn-edit" data-id="${theme.id}">编辑</button>
            <button class="btn-delete" data-id="${theme.id}" data-post-count="${theme.post_count || 0}">删除</button>
          </div>
        </div>
      `).join('');
      bindActionButtons();
    }

    async function loadThemes() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      themesGrid.style.display = 'none';
      try {
        themes = await themesApi.list();
        if (themes.length === 0) {
          loading.style.display = 'none'; empty.style.display = 'flex';
        } else {
          renderThemes(); loading.style.display = 'none'; themesGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorMsg.textContent = err.message || '加载主题失败';
        errorState.style.display = 'flex';
      }
    }

    function bindActionButtons() {
      themesGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => handleEdit(Number((e.target as HTMLElement).dataset.id)));
      });
      themesGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const t = e.target as HTMLElement;
          handleDelete(Number(t.dataset.id), Number(t.dataset.postCount));
        });
      });
    }

    function openCreateModal() {
      editingTheme = null; modalTitle.textContent = '新建主题'; editForm.reset(); editModal.classList.add('active');
    }

    function handleEdit(id: number) {
      const theme = themes.find(t => t.id === id); if (!theme) return;
      editingTheme = theme; modalTitle.textContent = '编辑主题';
      editName.value = theme.name; editSlug.value = theme.slug; editDescription.value = theme.description || '';
      editModal.classList.add('active');
    }

    async function handleDelete(id: number, postCount: number) {
      const theme = themes.find(t => t.id === id); if (!theme) return;
      let msg = `确认删除主题《${theme.name}》？`;
      if (postCount > 0) msg += `\n\n关联的 ${postCount} 篇文章将变为无主题状态。`;
      if (!confirm(msg)) return;
      try { await adminApi.themes.delete(id); await loadThemes(); }
      catch (err: any) { alert(err.message || '删除失败'); }
    }

    async function handleSubmit(e: Event) {
      e.preventDefault();
      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true; saveBtn.textContent = editingTheme ? '保存中...' : '创建中...';
      const data = { name: editName.value.trim(), slug: editSlug.value.trim(), description: editDescription.value.trim() || null };
      if (!/^[a-z0-9-]+$/.test(data.slug)) {
        alert('Slug 仅支持小写字母、数字和连字符');
        saveBtn.disabled = false; saveBtn.textContent = '保存'; return;
      }
      try {
        if (editingTheme) { await adminApi.themes.update(editingTheme.id, data); }
        else { await adminApi.themes.create(data); }
        closeModal(); await loadThemes();
      } catch (err: any) { alert(err.message || '操作失败'); }
      finally { saveBtn.disabled = false; saveBtn.textContent = '保存'; }
    }

    function closeModal() { editModal.classList.remove('active'); editingTheme = null; editForm.reset(); }

    createBtn.addEventListener('click', openCreateModal);
    document.getElementById('retry-btn')?.addEventListener('click', loadThemes);
    document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
    document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);
    editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
    editForm.addEventListener('submit', handleSubmit);
    editName.addEventListener('input', () => { if (!editingTheme) editSlug.value = generateSlug(editName.value); });

    loadThemes();
  });
</script>

<style is:global>
  /* 操作栏 */
  .action-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 2rem;
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-create:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-blue-md);
  }

  .btn-create span {
    font-size: 1.25rem;
  }

  /* 加载/空状态 */
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }

  .loading p,
  .empty p {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-alpha-30);
    border-top-color: var(--color-blue);
    border-right-color: var(--color-pink);
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 主题卡片网格 */
  .themes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .theme-card {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .theme-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-color: var(--blue-alpha-30);
    transform: translateY(-2px);
  }

  /* 卡片顶部渐变区域 */
  .theme-card-header {
    padding: 1.75rem 2rem 1.25rem;
    background: var(--gradient-blue-pink);
    border-bottom: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .theme-name-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .theme-name {
    font-size: 1.25rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0;
    line-height: 1.2;
  }

  .theme-slug-code {
    font-size: 0.6875rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    color: var(--color-text-muted);
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-15);
    padding: 2px 8px;
    border-radius: 6px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .theme-desc {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .no-desc {
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* 统计行 */
  .theme-stat-row {
    display: flex;
    gap: 0.75rem;
    padding: 1.25rem 2rem;
    flex: 1;
  }

  .theme-stat-pill {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    flex: 1;
    justify-content: center;
  }

  .stat-blue {
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-15);
  }

  .stat-pink {
    background: var(--pink-alpha-08);
    border: 1px solid var(--pink-alpha-15);
  }

  .stat-num {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .stat-blue .stat-num { color: var(--color-blue); }
  .stat-pink .stat-num { color: var(--color-pink); }

  .stat-label {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  /* 操作按钮区 */
  .theme-card-actions {
    display: flex;
    gap: 0.5rem;
    padding: 0.875rem 2rem 1.25rem;
    border-top: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }

  /* 错误状态 */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 4rem;
  }

  .error-state p {
    font-size: 0.875rem;
    color: var(--color-error);
  }

  .btn-retry {
    padding: 0.5rem 2rem;
    font-size: 0.875rem;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-retry:hover {
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  /* 操作按钮 */
  .btn-edit {
    flex: 1;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-blue);
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-25);
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .btn-edit:hover {
    background: var(--color-blue);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  .btn-delete {
    flex: 1;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-error);
    background: var(--error-alpha-08);
    border: 1px solid var(--error-alpha-20);
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .btn-delete:hover {
    background: var(--color-error);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-error-md);
    transform: translateY(-1px);
  }

  /* 弹窗 */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms cubic-bezier(0.4, 0, 0.2, 1),
                visibility 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .modal.active {
    opacity: 1;
    visibility: visible;
  }

  .modal.active .modal-card {
    transform: scale(1) translateY(0);
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay-bg);
    backdrop-filter: blur(8px);
    animation: fadeIn 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-card {
    position: relative;
    width: 90%;
    max-width: 520px;
    background: var(--color-white);
    border-radius: 24px;
    box-shadow: var(--shadow-2xl);
    transform: scale(0.9) translateY(20px);
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    border: 1px solid var(--blue-alpha-10);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 3rem 3rem 2rem;
    background: var(--gradient-blue-pink);
    border-bottom: 1px solid var(--color-divider);
    border-radius: 24px 24px 0 0;
  }

  .modal-header h3 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .modal-close {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: var(--color-text-muted);
    background: none;
    border: none;
    border-radius: 50%;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .modal-close:hover {
    background: var(--gradient-blue-pink-8);
    color: var(--color-text);
    transform: rotate(90deg);
  }

  .modal-body {
    padding: 3rem;
  }

  .form-group {
    margin-bottom: 1.5rem;
  }

  .form-group:last-child {
    margin-bottom: 0;
  }

  .form-group label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem 1.5rem;
    font-size: 1rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 2px solid var(--color-border);
    border-radius: 16px;
    font-family: inherit;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-blue);
    box-shadow: var(--focus-ring-blue-lg);
    transform: translateY(-2px);
  }

  .form-group input:hover,
  .form-group textarea:hover {
    border-color: var(--blue-alpha-50);
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--color-text-muted);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 60px;
  }

  .form-hint {
    display: block;
    margin-top: 4px;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    padding: 2rem 3rem 3rem;
    border-top: 1px solid var(--color-divider);
  }

  .modal-footer button {
    padding: 1rem 3rem;
    font-size: 0.875rem;
    font-weight: 600;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .modal-footer .btn-secondary {
    color: var(--color-text);
    background: var(--color-bg);
    border: 2px solid var(--color-border);
  }

  .modal-footer .btn-secondary:hover {
    background: var(--blue-alpha-05);
    border-color: var(--color-blue);
    transform: translateY(-2px);
  }

  .modal-footer .btn-primary {
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    box-shadow: var(--shadow-blue-md);
  }

  .modal-footer .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-blue-hover);
  }

  .modal-footer .btn-primary:active {
    transform: translateY(0);
  }

  .modal-footer .btn-primary:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }
</style>
