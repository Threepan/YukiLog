---
// ================================
// 友链管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="友链管理" activeMenu="links">
  <!-- 待审核提示 -->
  <div id="pending-notice" class="notice" style="display:none">
    <div class="notice-icon">⏳</div>
    <div class="notice-content">
      <h4>有新的友链等待审核</h4>
      <p>共 <strong id="pending-count">0</strong> 条待审核友链，点击下方「待审核」标签查看</p>
    </div>
  </div>

  <!-- 操作栏 -->
  <div class="action-bar">
    <div class="tabs">
      <button class="tab active" data-status="all">全部</button>
      <button class="tab" data-status="pending">待审核</button>
      <button class="tab" data-status="active">已通过</button>
      <button class="tab" data-status="broken">已失效</button>
    </div>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建友链
    </button>
  </div>

  <!-- 友链列表 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无友链</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <div id="links-grid" class="links-grid" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination" style="display:none">
    <button id="prev-btn" class="page-btn" disabled>上一页</button>
    <span class="page-info">
      第 <span id="current-page">1</span> / <span id="total-pages">1</span> 页
    </span>
    <button id="next-btn" class="page-btn" disabled>下一页</button>
  </div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建友链</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>网站名称 *</label>
            <input type="text" id="edit-name" required placeholder="例如：Lian's Tech Blog" />
          </div>
          <div class="form-group">
            <label>网站地址 *</label>
            <input type="url" id="edit-url" required placeholder="https://example.com" />
          </div>
          <div class="form-group">
            <label>网站描述</label>
            <textarea id="edit-description" rows="3" placeholder="简单介绍一下这个网站..."></textarea>
          </div>
          <div class="form-group">
            <label>头像 URL</label>
            <input type="url" id="edit-avatar" placeholder="https://example.com/avatar.jpg" />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import type { Link } from '../../types/api';

  // ===== 状态管理（模块级）=====
  let allLinks: Link[] = [];
  let filteredLinks: Link[] = [];
  let currentStatus: 'all' | 'pending' | 'active' | 'broken' = 'all';
  let editingLink: Link | null = null;
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;

  document.addEventListener('astro:page-load', () => {
    const linksGrid = document.getElementById('links-grid') as HTMLDivElement;
    if (!linksGrid) return;

    // ===== DOM 元素 =====
    const pendingNotice = document.getElementById('pending-notice')!;
    const pendingCount = document.getElementById('pending-count')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const createBtn = document.getElementById('create-btn')!;

    const pagination = document.getElementById('pagination')!;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const currentPageSpan = document.getElementById('current-page')!;
    const totalPagesSpan = document.getElementById('total-pages')!;

    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editUrl = document.getElementById('edit-url') as HTMLInputElement;
    const editDescription = document.getElementById('edit-description') as HTMLTextAreaElement;
    const editAvatar = document.getElementById('edit-avatar') as HTMLInputElement;

    // 重置状态
    allLinks = [];
    filteredLinks = [];
    currentStatus = 'all';
    editingLink = null;
    currentPage = 1;
    totalPages = 1;

    // ===== 初始化 =====
    async function init() {
      await loadLinks();
      await checkPendingLinks();
      bindEvents();
    }

    // ===== 加载全部友链 =====
    async function loadLinks() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      linksGrid.style.display = 'none';
      pagination.style.display = 'none';

      try {
        allLinks = await adminApi.links.list();
        applyFilter();
      } catch (err: any) {
        loading.style.display = 'none';
        errorState.style.display = 'flex';
      }
    }

    // ===== 检查待审核友链 =====
    async function checkPendingLinks() {
      try {
        const pending = await adminApi.links.pending();
        if (pending.length > 0) {
          pendingCount.textContent = String(pending.length);
          pendingNotice.style.display = 'flex';
        } else {
          pendingNotice.style.display = 'none';
        }
      } catch { /* 静默失败 */ }
    }

    // ===== 应用筛选 =====
    function applyFilter() {
      filteredLinks = currentStatus === 'all'
        ? allLinks
        : allLinks.filter(link => link.status === currentStatus);

      currentPage = 1;
      totalPages = Math.ceil(filteredLinks.length / PAGE_SIZE);

      loading.style.display = 'none';
      if (filteredLinks.length === 0) {
        empty.style.display = 'flex';
        linksGrid.style.display = 'none';
        pagination.style.display = 'none';
      } else {
        renderLinks();
        linksGrid.style.display = 'grid';
        pagination.style.display = filteredLinks.length > PAGE_SIZE ? 'flex' : 'none';
      }
    }

    // ===== 渲染友链卡片 =====
    function renderLinks() {
      const start = (currentPage - 1) * PAGE_SIZE;
      const pageLinks = filteredLinks.slice(start, start + PAGE_SIZE);

      linksGrid.innerHTML = pageLinks.map(link => {
        const initial = (link.title || '?').charAt(0).toUpperCase();
        const avatarHtml = link.avatar
          ? `<img src="${escapeHtml(link.avatar)}" alt="${escapeHtml(link.title)}" class="site-avatar"
               onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div class="site-avatar-fallback" style="display:none">${initial}</div>`
          : `<div class="site-avatar-fallback">${initial}</div>`;

        return `
        <div class="link-card">
          <div class="link-top">
            <div class="link-avatar-wrap">${avatarHtml}</div>
            <div class="link-info">
              <span class="link-title">${escapeHtml(link.title)}</span>
              <a class="link-url-text" href="${escapeHtml(link.url)}" target="_blank" rel="noopener noreferrer">${escapeHtml(link.url)}</a>
            </div>
            <span class="status-dot status-dot-${link.status}" title="${getStatusText(link.status)}"></span>
          </div>
          ${link.description ? `<p class="link-desc">${escapeHtml(link.description)}</p>` : '<p class="link-no-desc">暂无描述</p>'}
          <div class="link-footer">
            <div class="link-footer-left">
              <span class="status-badge status-${link.status}">${getStatusText(link.status)}</span>
              <span class="link-date">${formatDate(link.created_at)}</span>
            </div>
            <div class="link-actions">
              ${link.status === 'pending' ? `<button class="btn-approve" data-id="${link.id}">通过</button>` : ''}
              ${link.status === 'active' ? `<button class="btn-broken" data-id="${link.id}">失效</button>` : ''}
              <button class="btn-edit" data-id="${link.id}">编辑</button>
              <button class="btn-delete" data-id="${link.id}">删除</button>
            </div>
          </div>
        </div>
      `}).join('');

      updatePaginationState();
      bindActionButtons();
    }

    // ===== 更新分页状态 =====
    function updatePaginationState() {
      currentPageSpan.textContent = String(currentPage);
      totalPagesSpan.textContent = String(totalPages);
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;
    }

    // ===== 绑定事件 =====
    function bindEvents() {
      createBtn.addEventListener('click', openCreateModal);
      document.getElementById('retry-btn')?.addEventListener('click', loadLinks);

      document.querySelectorAll<HTMLElement>('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
          currentStatus = tab.dataset.status as any;
          document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          applyFilter();
        });
      });

      prevBtn.addEventListener('click', () => { if (currentPage > 1) { currentPage--; renderLinks(); } });
      nextBtn.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; renderLinks(); } });

      document.getElementById('modal-close-btn')?.addEventListener('click', closeEditModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeEditModal);
      editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeEditModal);
      editForm.addEventListener('submit', handleSubmit);
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      linksGrid.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', (e) => handleApprove(Number((e.target as HTMLElement).dataset.id)));
      });
      linksGrid.querySelectorAll('.btn-broken').forEach(btn => {
        btn.addEventListener('click', (e) => handleMarkBroken(Number((e.target as HTMLElement).dataset.id)));
      });
      linksGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => handleEdit(Number((e.target as HTMLElement).dataset.id)));
      });
      linksGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => handleDelete(Number((e.target as HTMLElement).dataset.id)));
      });
    }

    async function handleApprove(id: number) {
      const link = allLinks.find(l => l.id === id);
      if (!link || !confirm(`确认通过友链《${link.title}》？`)) return;
      try { await adminApi.links.approve(id); await loadLinks(); await checkPendingLinks(); }
      catch (err: any) { alert(err.message || '操作失败'); }
    }

    async function handleMarkBroken(id: number) {
      const link = allLinks.find(l => l.id === id);
      if (!link || !confirm(`确认标记友链《${link.title}》为失效？`)) return;
      try { await adminApi.links.markBroken(id); await loadLinks(); }
      catch (err: any) { alert(err.message || '操作失败'); }
    }

    function openCreateModal() {
      editingLink = null;
      modalTitle.textContent = '新建友链';
      editForm.reset();
      editModal.classList.add('active');
    }

    function handleEdit(id: number) {
      const link = allLinks.find(l => l.id === id);
      if (!link) return;
      editingLink = link;
      modalTitle.textContent = '编辑友链';
      editName.value = link.title;
      editUrl.value = link.url;
      editDescription.value = link.description || '';
      editAvatar.value = link.avatar || '';
      editModal.classList.add('active');
    }

    async function handleDelete(id: number) {
      const link = allLinks.find(l => l.id === id);
      if (!link || !confirm(`确认删除友链《${link.title}》？\n\n此操作不可撤销。`)) return;
      try {
        await adminApi.links.delete(id);
        await loadLinks();
        if (link.status === 'pending') await checkPendingLinks();
      } catch (err: any) { alert(err.message || '删除失败'); }
    }

    async function handleSubmit(e: Event) {
      e.preventDefault();
      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = editingLink ? '保存中...' : '创建中...';
      const data: any = {
        title: editName.value.trim(),
        url: editUrl.value.trim(),
        description: editDescription.value.trim() || null,
        avatar: editAvatar.value.trim() || null,
      };
      try {
        if (editingLink) {
          await adminApi.links.update(editingLink.id, data);
        } else {
          await adminApi.links.create(data);
        }
        closeEditModal();
        await loadLinks();
        await checkPendingLinks();
      } catch (err: any) {
        alert(err.message || '操作失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }

    function closeEditModal() {
      editModal.classList.remove('active');
      editingLink = null;
      editForm.reset();
    }

    function getStatusText(status: string): string {
      const map: Record<string, string> = { pending: '待审核', active: '已通过', broken: '已失效' };
      return map[status] || status;
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      const now = new Date();
      const days = Math.floor((now.getTime() - date.getTime()) / (1000 * 60 * 60 * 24));
      if (days === 0) return '今天';
      if (days === 1) return '昨天';
      if (days < 7) return `${days}天前`;
      return date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    init();
  });
</script>


<style is:global>
  /* 待审核提示 */
  .notice {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem 2rem;
    margin-bottom: 2rem;
    background: var(--gradient-blue-pink);
    border-left: 3px solid var(--color-pink);
    border-radius: 16px;
  }

  .notice-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .notice-content {
    flex: 1;
  }

  .notice-content h4 {
    margin: 0 0 4px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .notice-content p {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .notice-content p strong {
    color: var(--color-pink);
    font-weight: 600;
  }

  /* 操作栏 */
  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
  }

  .tabs .tab {
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-light);
    background: transparent;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tabs .tab:hover {
    color: var(--color-text);
    background: var(--blue-alpha-05);
  }

  .tabs .tab.active {
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-create:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-blue-md);
  }

  .btn-create span {
    font-size: 1.25rem;
  }

  /* 友链卡片网格 */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .link-card {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-divider);
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .link-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-color: var(--blue-alpha-30);
    transform: translateY(-2px);
  }

  /* 顶部：头像 + 信息 + 状态点 */
  .link-top {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .link-avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }

  .site-avatar {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    object-fit: cover;
    border: 1px solid var(--color-divider);
  }

  .site-avatar-fallback {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--blue-alpha-15) 0%, var(--pink-alpha-15) 100%);
    border: 1px solid var(--blue-alpha-15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--color-blue);
  }

  .link-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .link-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-url-text {
    font-size: 0.75rem;
    color: var(--color-blue);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0.8;
  }

  .link-url-text:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* 状态指示点 */
  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-left: auto;
  }

  .status-dot-active   { background: #3ab26e; box-shadow: 0 0 0 3px rgba(58,178,110,0.2); }
  .status-dot-pending  { background: #e8984a; box-shadow: 0 0 0 3px rgba(232,152,74,0.2); }
  .status-dot-broken   { background: var(--color-error); box-shadow: 0 0 0 3px var(--error-alpha-15); }

  /* 描述 */
  .link-desc {
    font-size: 0.8125rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .link-no-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin: 0;
    font-style: italic;
  }

  /* 底部：状态徽章 + 日期 + 按钮 */
  .link-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--color-divider);
    padding-top: 0.875rem;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .link-footer-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .link-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .link-actions {
    display: flex;
    gap: 0.5rem;
  }

  .link-actions button {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid transparent;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 操作按钮 */
  .btn-approve {
    color: var(--color-blue);
    background: var(--blue-alpha-08);
    border-color: var(--blue-alpha-25) !important;
  }

  .btn-approve:hover {
    background: var(--color-blue);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  .btn-broken {
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-text-muted) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-text-muted) 20%, transparent) !important;
  }

  .btn-broken:hover {
    background: var(--color-text-muted);
    color: var(--color-on-primary);
    transform: translateY(-1px);
  }

  .btn-edit {
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    border-color: var(--pink-alpha-25) !important;
  }

  .btn-edit:hover {
    background: var(--color-pink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-pink-md);
    transform: translateY(-1px);
  }

  .btn-delete {
    color: var(--color-error);
    background: var(--error-alpha-08);
    border-color: var(--error-alpha-20) !important;
  }

  .btn-delete:hover {
    background: var(--color-error);
    color: var(--color-on-primary);
    transform: translateY(-1px);
  }

  /* 状态徽章 */
  .status-badge {
    display: inline-block;
    padding: 4px 10px;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 10px;
  }

  .status-badge.status-pending {
    background: var(--warning-alpha-15);
    color: #c48a2c;
  }

  .status-badge.status-active {
    background: var(--success-alpha-15);
    color: #4e9067;
  }

  .status-badge.status-broken {
    background: color-mix(in srgb, var(--color-text-muted) 15%, transparent);
    color: var(--color-text-muted);
  }

  /* 加载/空状态 */
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }

  .loading p,
  .empty p {
