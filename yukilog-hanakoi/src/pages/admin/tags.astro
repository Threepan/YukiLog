---
// ================================
// 标签管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="标签管理" activeMenu="tags">
  <!-- 操作栏 -->
  <div class="action-bar">
    <button class="btn-merge" id="merge-btn">
      🔗 合并标签
    </button>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建标签
    </button>
  </div>

  <!-- 标签列表 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无标签，点击「新建标签」创建第一个标签吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <div id="tags-grid" class="tags-grid" style="display:none"></div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建标签</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>标签名称 *</label>
            <input type="text" id="edit-name" required placeholder="例如：JavaScript" />
          </div>
          <div class="form-group">
            <label>Slug *</label>
            <input type="text" id="edit-slug" required placeholder="例如：javascript（自动生成）" />
            <span class="form-hint">URL 友好标识符，仅支持小写字母、数字和连字符</span>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>

  <!-- 合并弹窗 -->
  <div id="merge-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3>合并标签</h3>
        <button class="modal-close" id="merge-close-btn">×</button>
      </div>
      <div class="modal-body">
        <p class="merge-hint">
          将选中的标签合并到目标标签，所有文章关联将转移到目标标签，源标签将被删除。
        </p>
        <form id="merge-form">
          <div class="form-group">
            <label>选中的源标签（<span id="selected-count">0</span> 个）</label>
            <div id="selected-tags" class="selected-tags"></div>
          </div>
          <div class="form-group">
            <label>目标标签 *</label>
            <select id="target-tag" required>
              <option value="">请选择目标标签</option>
            </select>
            <span class="form-hint">源标签的所有文章将转移到此标签</span>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="merge-cancel-btn">取消</button>
        <button type="submit" form="merge-form" class="btn-primary" id="merge-save-btn">确认合并</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { tagsApi, adminApi } from '../../lib/api';
  import type { Tag } from '../../types/api';

  // ===== 状态管理（模块级）=====
  let tags: Tag[] = [];
  let editingTag: Tag | null = null;
  let selectedTagIds: Set<number> = new Set();

  document.addEventListener('astro:page-load', () => {
    const tagsGrid = document.getElementById('tags-grid') as HTMLDivElement;
    if (!tagsGrid) return;

    // ===== DOM 元素 =====
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const createBtn = document.getElementById('create-btn')!;
    const mergeBtn = document.getElementById('merge-btn')!;

    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editSlug = document.getElementById('edit-slug') as HTMLInputElement;

    const mergeModal = document.getElementById('merge-modal')!;
    const mergeForm = document.getElementById('merge-form') as HTMLFormElement;
    const selectedCount = document.getElementById('selected-count')!;
    const selectedTagsDiv = document.getElementById('selected-tags')!;
    const targetTagSelect = document.getElementById('target-tag') as HTMLSelectElement;

    // 重置状态
    tags = [];
    editingTag = null;
    selectedTagIds = new Set();

    // ===== 初始化 =====
    async function init() {
      await loadTags();
      bindEvents();
    }

    // ===== 加载标签列表 =====
    async function loadTags() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      tagsGrid.style.display = 'none';

      try {
        tags = await tagsApi.list();

        loading.style.display = 'none';
        if (tags.length === 0) {
          empty.style.display = 'flex';
        } else {
          renderTags();
          tagsGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorState.style.display = 'flex';
      }
    }

    // ===== 渲染标签卡片 =====
    function renderTags() {
      tagsGrid.innerHTML = tags.map(tag => `
        <div class="tag-card">
          <label class="tag-select" title="选择">
            <input type="checkbox" class="tag-checkbox" data-id="${tag.id}" ${selectedTagIds.has(tag.id) ? 'checked' : ''} />
          </label>
          <div class="tag-card-body">
            <span class="tag-badge">#${escapeHtml(tag.name)}</span>
            <code class="tag-slug-code">${escapeHtml(tag.slug)}</code>
            <span class="tag-count">${tag.post_count || 0} 篇文章</span>
          </div>
          <div class="tag-card-actions">
            <button class="btn-edit" data-id="${tag.id}">编辑</button>
            <button class="btn-delete" data-id="${tag.id}" data-post-count="${tag.post_count || 0}">删除</button>
          </div>
        </div>
      `).join('');

      bindActionButtons();
      bindCheckboxes();
    }

    // ===== 绑定事件 =====
    function bindEvents() {
      createBtn.addEventListener('click', openCreateModal);
      mergeBtn.addEventListener('click', openMergeModal);

      document.getElementById('retry-btn')?.addEventListener('click', loadTags);

      // 编辑弹窗
      document.getElementById('modal-close-btn')?.addEventListener('click', closeEditModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeEditModal);
      editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeEditModal);
      editForm.addEventListener('submit', handleSubmit);

      // 合并弹窗
      document.getElementById('merge-close-btn')?.addEventListener('click', closeMergeModal);
      document.getElementById('merge-cancel-btn')?.addEventListener('click', closeMergeModal);
      mergeModal.querySelector('.modal-backdrop')?.addEventListener('click', closeMergeModal);
      mergeForm.addEventListener('submit', handleMerge);

      // 名称自动生成 slug
      editName.addEventListener('input', () => {
        if (!editingTag) editSlug.value = generateSlug(editName.value);
      });
    }

    // ===== 绑定复选框 =====
    function bindCheckboxes() {
      tagsGrid.querySelectorAll('.tag-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const id = Number((e.target as HTMLInputElement).dataset.id);
          if ((e.target as HTMLInputElement).checked) {
            selectedTagIds.add(id);
          } else {
            selectedTagIds.delete(id);
          }
        });
      });
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      tagsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          handleEdit(id);
        });
      });
      tagsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          handleDelete(Number(target.dataset.id), Number(target.dataset.postCount));
        });
      });
    }

    // ===== 打开创建弹窗 =====
    function openCreateModal() {
      editingTag = null;
      modalTitle.textContent = '新建标签';
      editForm.reset();
      editModal.classList.add('active');
    }

    // ===== 打开编辑弹窗 =====
    function handleEdit(id: number) {
      const tag = tags.find(t => t.id === id);
      if (!tag) return;
      editingTag = tag;
      modalTitle.textContent = '编辑标签';
      editName.value = tag.name;
      editSlug.value = tag.slug;
      editModal.classList.add('active');
    }

    // ===== 删除标签 =====
    async function handleDelete(id: number, postCount: number) {
      const tag = tags.find(t => t.id === id);
      if (!tag) return;
      let confirmMsg = `确认删除标签《${tag.name}》？`;
      if (postCount > 0) confirmMsg += `\n\n关联的 ${postCount} 篇文章将移除此标签。`;
      if (!confirm(confirmMsg)) return;
      try {
        await adminApi.tags.delete(id);
        await loadTags();
      } catch (err: any) {
        alert(err.message || '删除失败');
      }
    }

    // ===== 提交表单 =====
    async function handleSubmit(e: Event) {
      e.preventDefault();
      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = editingTag ? '保存中...' : '创建中...';
      const data = { name: editName.value.trim(), slug: editSlug.value.trim() };
      if (!/^[a-z0-9-]+$/.test(data.slug)) {
        alert('Slug 仅支持小写字母、数字和连字符');
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
        return;
      }
      try {
        if (editingTag) {
          await adminApi.tags.update(editingTag.id, data);
        } else {
          await adminApi.tags.create(data);
        }
        closeEditModal();
        await loadTags();
      } catch (err: any) {
        alert(err.message || '操作失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }

    // ===== 打开合并弹窗 =====
    function openMergeModal() {
      if (selectedTagIds.size === 0) { alert('请先选择要合并的标签'); return; }
      selectedCount.textContent = String(selectedTagIds.size);
      const selectedTags = tags.filter(t => selectedTagIds.has(t.id));
      selectedTagsDiv.innerHTML = selectedTags.map(tag =>
        `<span class="selected-tag-badge">#${escapeHtml(tag.name)}</span>`
      ).join('');
      const availableTags = tags.filter(t => !selectedTagIds.has(t.id));
      targetTagSelect.innerHTML = '<option value="">请选择目标标签</option>' +
        availableTags.map(tag =>
          `<option value="${tag.id}">${escapeHtml(tag.name)} (${tag.post_count || 0} 篇文章)</option>`
        ).join('');
      mergeModal.classList.add('active');
    }

    // ===== 执行合并 =====
    async function handleMerge(e: Event) {
      e.preventDefault();
      const targetId = Number(targetTagSelect.value);
      if (!targetId) { alert('请选择目标标签'); return; }
      if (selectedTagIds.has(targetId)) { alert('目标标签不能是被合并的标签之一'); return; }
      const saveBtn = document.getElementById('merge-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = '合并中...';
      try {
        for (const sourceId of Array.from(selectedTagIds)) {
          await adminApi.tags.merge({ source_id: sourceId, target_id: targetId });
        }
        closeMergeModal();
        selectedTagIds.clear();
        await loadTags();
      } catch (err: any) {
        alert(err.message || '合并失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '确认合并';
      }
    }

    // ===== 关闭弹窗 =====
    function closeEditModal() {
      editModal.classList.remove('active');
      editingTag = null;
      editForm.reset();
    }
    function closeMergeModal() {
      mergeModal.classList.remove('active');
      mergeForm.reset();
    }

    // ===== 工具函数 =====
    function generateSlug(name: string): string {
      return name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-');
    }
    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    init();
  });
</script>

<style lang="scss">
  @use 'sass:color';

  // 操作栏
  .action-bar {
    display: flex;
    justify-content: flex-end;
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
  }

  .btn-merge {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: $lian-pink;
    background: var(--color-bg-primary);
    border: 2px solid rgba($lian-pink, 0.3);
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    box-shadow: $shadow-sm;

    &:hover {
      background: linear-gradient(135deg, rgba($lian-pink, 0.08) 0%, rgba($lian-pink, 0.12) 100%);
      border-color: $lian-pink;
      box-shadow: $shadow-pink;
      transform: translateY(-2px);
    }
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    box-shadow: $shadow-blue;

    &:hover {
      transform: translateY(-2px);
      box-shadow: $shadow-blue-hover;
    }

    &:active {
      transform: translateY(0);
    }

    span {
      font-size: $font-size-xl;
    }
  }

  // 加载/空状态
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    color: $lian-text-muted;
    p { margin: $spacing-md 0 0; font-size: $font-size-sm; text-align: center; }
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba($lian-border, 0.3);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  // 错误状态
  .error-state {
    display: flex; flex-direction: column; align-items: center;
    gap: $spacing-md; padding: $spacing-xxl;
    p { font-size: $font-size-sm; color: $lian-error; }
  }
  .btn-retry {
    padding: $spacing-xs $spacing-lg; font-size: $font-size-sm;
    color: var(--color-white); background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none; border-radius: $radius-sm; cursor: pointer;
    transition: all $transition-base $ease-gentle;
    &:hover { box-shadow: $shadow-blue; transform: translateY(-1px); }
  }

  // 标签卡片网格
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
  }

  .tag-card {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    border: 1px solid $lian-divider;
    display: flex;
    flex-direction: column;
    transition: all $transition-base $ease-gentle;

    &:hover {
      box-shadow: $shadow-pink;
      border-color: rgba($lian-pink, 0.3);
      transform: translateY(-2px);
    }
  }

  .tag-select {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: $spacing-xs $spacing-md 0;
    cursor: pointer;

    input[type="checkbox"] {
      width: 16px; height: 16px;
      cursor: pointer;
      accent-color: $lian-pink;
    }
  }

  .tag-card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: $spacing-xs;
    padding: $spacing-xs $spacing-lg $spacing-md;
  }

  .tag-badge {
    display: inline-block;
    padding: $spacing-xs $spacing-md;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: $lian-pink;
    background: linear-gradient(135deg, rgba($lian-pink, 0.08) 0%, rgba($lian-pink, 0.12) 100%);
    border-radius: 16px;
    border: 1px solid rgba($lian-pink, 0.2);
  }

  .tag-slug-code {
    font-family: $font-family-code;
    font-size: $font-size-xs;
    color: $lian-text-muted;
    background: rgba($lian-blue, 0.06);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .tag-count {
    font-size: $font-size-xs;
    color: $lian-text-muted;
  }

  .tag-card-actions {
    display: flex;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-md $spacing-md;
    border-top: 1px solid $lian-divider;

    button {
      flex: 1;
      padding: $spacing-xs $spacing-sm;
      font-size: $font-size-xs;
      font-weight: $font-weight-medium;
      border: 1px solid transparent;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;
      text-align: center;
    }
  }

  .btn-edit {
    color: $lian-pink; background: rgba($lian-pink, 0.08); border-color: rgba($lian-pink, 0.25);
    &:hover { background: $lian-pink; color: var(--color-white); box-shadow: $shadow-pink; transform: translateY(-1px); }
  }
  .btn-delete {
    color: $lian-error; background: rgba($lian-error, 0.08); border-color: rgba($lian-error, 0.25);
    &:hover { background: $lian-error; color: var(--color-white); transform: translateY(-1px); }
  }

  // 合并相关
  .merge-hint {
    padding: $spacing-md $spacing-lg;
    background: linear-gradient(135deg, rgba($lian-info, 0.08) 0%, rgba($lian-info, 0.05) 100%);
    border-left: 4px solid $lian-info;
    border-radius: $radius-sm;
    font-size: $font-size-sm;
    color: $lian-text;
    line-height: 1.6;
    margin-bottom: $spacing-lg;
  }

  .selected-tags {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-sm;
    padding: $spacing-md 0;
  }

  .selected-tag-badge {
    display: inline-block;
    padding: $spacing-xs $spacing-md;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: $lian-blue;
    background: linear-gradient(135deg, rgba($lian-blue, 0.08) 0%, rgba($lian-blue, 0.12) 100%);
    border-radius: 16px;
    border: 1px solid rgba($lian-blue, 0.2);
  }

  // 弹窗样式
  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity $transition-base $ease-gentle,
                visibility $transition-base $ease-gentle;

    &.active {
      opacity: 1;
      visibility: visible;

      .modal-card {
        transform: scale(1) translateY(0);
      }
    }
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-overlay-dark);
    backdrop-filter: blur(8px);
    animation: fadeIn $transition-base $ease-gentle;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-card {
    position: relative;
    width: 90%;
    max-width: 520px;
    background: var(--color-bg-primary);
    border-radius: $radius-lg;
    box-shadow: 0 20px 60px var(--color-shadow-dark);
    transform: scale(0.9) translateY(20px);
    transition: all $transition-base $ease-gentle;
    border: 1px solid rgba($lian-blue, 0.1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: $spacing-xl $spacing-xl $spacing-lg;
    background: linear-gradient(135deg, rgba($lian-blue, 0.03) 0%, rgba($lian-pink, 0.03) 100%);
    border-bottom: 1px solid $lian-divider;
    border-radius: $radius-lg $radius-lg 0 0;

    h3 {
      margin: 0;
      font-size: $font-size-xl;
      font-weight: $font-weight-bold;
      background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .modal-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: $font-size-2xl;
      color: $lian-text-muted;
      background: none;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;

      &:hover {
        background: linear-gradient(135deg, rgba($lian-blue, 0.1) 0%, rgba($lian-pink, 0.1) 100%);
        color: $lian-text;
        transform: rotate(90deg);
      }
    }
  }

  .modal-body {
    padding: $spacing-xl;
  }

  .form-group {
    margin-bottom: $spacing-lg;

    &:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      font-size: $font-size-sm;
      font-weight: $font-weight-semibold;
      color: $lian-text;
      margin-bottom: $spacing-sm;
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-base;
      color: $lian-text;
      background: var(--color-bg-primary);
      border: 2px solid $lian-border;
      border-radius: $radius-sm;
      font-family: $font-family-base;
      transition: all $transition-base $ease-gentle;

      &:focus {
        outline: none;
        border-color: $lian-blue;
        box-shadow: 0 0 0 4px rgba($lian-blue, 0.1);
        transform: translateY(-2px);
      }

      &:hover {
        border-color: rgba($lian-blue, 0.5);
      }

      &::placeholder {
