---
// ================================
// 标签管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="标签管理" activeMenu="tags">
  <!-- 操作栏 -->
  <div class="action-bar">
    <button class="btn-merge" id="merge-btn">
      🔗 合并标签
    </button>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建标签
    </button>
  </div>

  <!-- 标签列表 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无标签，点击「新建标签」创建第一个标签吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <div id="tags-grid" class="tags-grid" style="display:none"></div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建标签</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>标签名称 *</label>
            <input type="text" id="edit-name" required placeholder="例如：JavaScript" />
          </div>
          <div class="form-group">
            <label>Slug *</label>
            <input type="text" id="edit-slug" required placeholder="例如：javascript（自动生成）" />
            <span class="form-hint">URL 友好标识符，仅支持小写字母、数字和连字符</span>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>

  <!-- 合并弹窗 -->
  <div id="merge-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3>合并标签</h3>
        <button class="modal-close" id="merge-close-btn">×</button>
      </div>
      <div class="modal-body">
        <p class="merge-hint">
          将选中的标签合并到目标标签，所有文章关联将转移到目标标签，源标签将被删除。
        </p>
        <form id="merge-form">
          <div class="form-group">
            <label>选中的源标签（<span id="selected-count">0</span> 个）</label>
            <div id="selected-tags" class="selected-tags"></div>
          </div>
          <div class="form-group">
            <label>目标标签 *</label>
            <select id="target-tag" required>
              <option value="">请选择目标标签</option>
            </select>
            <span class="form-hint">源标签的所有文章将转移到此标签</span>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="merge-cancel-btn">取消</button>
        <button type="submit" form="merge-form" class="btn-primary" id="merge-save-btn">确认合并</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { tagsApi, adminApi } from '../../lib/api';
  import type { Tag } from '../../types/api';

  // ===== 状态管理（模块级）=====
  let tags: Tag[] = [];
  let editingTag: Tag | null = null;
  let selectedTagIds: Set<number> = new Set();

  document.addEventListener('astro:page-load', () => {
    const tagsGrid = document.getElementById('tags-grid') as HTMLDivElement;
    if (!tagsGrid) return;

    // ===== DOM 元素 =====
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const createBtn = document.getElementById('create-btn')!;
    const mergeBtn = document.getElementById('merge-btn')!;

    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editSlug = document.getElementById('edit-slug') as HTMLInputElement;

    const mergeModal = document.getElementById('merge-modal')!;
    const mergeForm = document.getElementById('merge-form') as HTMLFormElement;
    const selectedCount = document.getElementById('selected-count')!;
    const selectedTagsDiv = document.getElementById('selected-tags')!;
    const targetTagSelect = document.getElementById('target-tag') as HTMLSelectElement;

    // 重置状态
    tags = [];
    editingTag = null;
    selectedTagIds = new Set();

    // ===== 初始化 =====
    async function init() {
      await loadTags();
      bindEvents();
    }

    // ===== 加载标签列表 =====
    async function loadTags() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      tagsGrid.style.display = 'none';

      try {
        tags = await tagsApi.list();

        loading.style.display = 'none';
        if (tags.length === 0) {
          empty.style.display = 'flex';
        } else {
          renderTags();
          tagsGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorState.style.display = 'flex';
      }
    }

    // ===== 渲染标签卡片 =====
    function renderTags() {
      tagsGrid.innerHTML = tags.map(tag => `
        <div class="tag-card ${selectedTagIds.has(tag.id) ? 'is-selected' : ''}">
          <div class="tag-card-top">
            <div class="tag-name-wrap">
              <span class="tag-hash">#</span>
              <span class="tag-name-text">${escapeHtml(tag.name)}</span>
            </div>
            <label class="tag-checkbox-label" title="选择以合并">
              <input type="checkbox" class="tag-checkbox" data-id="${tag.id}" ${selectedTagIds.has(tag.id) ? 'checked' : ''} />
            </label>
          </div>
          <code class="tag-slug-code">${escapeHtml(tag.slug)}</code>
          <div class="tag-stats-row">
            <div class="tag-stat-block">
              <span class="tag-stat-num">${tag.post_count || 0}</span>
              <span class="tag-stat-label">文章</span>
            </div>
            <div class="tag-stat-divider"></div>
            <div class="tag-stat-block">
              <span class="tag-stat-num">${tag.view_count || 0}</span>
              <span class="tag-stat-label">浏览</span>
            </div>
          </div>
          <div class="tag-card-actions">
            <button class="btn-edit" data-id="${tag.id}">编辑</button>
            <button class="btn-delete" data-id="${tag.id}" data-post-count="${tag.post_count || 0}">删除</button>
          </div>
        </div>
      `).join('');

      bindActionButtons();
      bindCheckboxes();
    }

    // ===== 绑定事件 =====
    function bindEvents() {
      createBtn.addEventListener('click', openCreateModal);
      mergeBtn.addEventListener('click', openMergeModal);

      document.getElementById('retry-btn')?.addEventListener('click', loadTags);

      // 编辑弹窗
      document.getElementById('modal-close-btn')?.addEventListener('click', closeEditModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeEditModal);
      editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeEditModal);
      editForm.addEventListener('submit', handleSubmit);

      // 合并弹窗
      document.getElementById('merge-close-btn')?.addEventListener('click', closeMergeModal);
      document.getElementById('merge-cancel-btn')?.addEventListener('click', closeMergeModal);
      mergeModal.querySelector('.modal-backdrop')?.addEventListener('click', closeMergeModal);
      mergeForm.addEventListener('submit', handleMerge);

      // 名称自动生成 slug
      editName.addEventListener('input', () => {
        if (!editingTag) editSlug.value = generateSlug(editName.value);
      });
    }

    // ===== 绑定复选框 =====
    function bindCheckboxes() {
      tagsGrid.querySelectorAll('.tag-checkbox').forEach(checkbox => {
        checkbox.addEventListener('change', (e) => {
          const id = Number((e.target as HTMLInputElement).dataset.id);
          if ((e.target as HTMLInputElement).checked) {
            selectedTagIds.add(id);
          } else {
            selectedTagIds.delete(id);
          }
        });
      });
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      tagsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          handleEdit(id);
        });
      });
      tagsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          handleDelete(Number(target.dataset.id), Number(target.dataset.postCount));
        });
      });
    }

    // ===== 打开创建弹窗 =====
    function openCreateModal() {
      editingTag = null;
      modalTitle.textContent = '新建标签';
      editForm.reset();
      editModal.classList.add('active');
    }

    // ===== 打开编辑弹窗 =====
    function handleEdit(id: number) {
      const tag = tags.find(t => t.id === id);
      if (!tag) return;
      editingTag = tag;
      modalTitle.textContent = '编辑标签';
      editName.value = tag.name;
      editSlug.value = tag.slug;
      editModal.classList.add('active');
    }

    // ===== 删除标签 =====
    async function handleDelete(id: number, postCount: number) {
      const tag = tags.find(t => t.id === id);
      if (!tag) return;
      let confirmMsg = `确认删除标签《${tag.name}》？`;
      if (postCount > 0) confirmMsg += `\n\n关联的 ${postCount} 篇文章将移除此标签。`;
      if (!confirm(confirmMsg)) return;
      try {
        await adminApi.tags.delete(id);
        await loadTags();
      } catch (err: any) {
        alert(err.message || '删除失败');
      }
    }

    // ===== 提交表单 =====
    async function handleSubmit(e: Event) {
      e.preventDefault();
      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = editingTag ? '保存中...' : '创建中...';
      const data = { name: editName.value.trim(), slug: editSlug.value.trim() };
      if (!/^[a-z0-9-]+$/.test(data.slug)) {
        alert('Slug 仅支持小写字母、数字和连字符');
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
        return;
      }
      try {
        if (editingTag) {
          await adminApi.tags.update(editingTag.id, data);
        } else {
          await adminApi.tags.create(data);
        }
        closeEditModal();
        await loadTags();
      } catch (err: any) {
        alert(err.message || '操作失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }

    // ===== 打开合并弹窗 =====
    function openMergeModal() {
      if (selectedTagIds.size === 0) { alert('请先选择要合并的标签'); return; }
      selectedCount.textContent = String(selectedTagIds.size);
      const selectedTags = tags.filter(t => selectedTagIds.has(t.id));
      selectedTagsDiv.innerHTML = selectedTags.map(tag =>
        `<span class="selected-tag-badge">#${escapeHtml(tag.name)}</span>`
      ).join('');
      const availableTags = tags.filter(t => !selectedTagIds.has(t.id));
      targetTagSelect.innerHTML = '<option value="">请选择目标标签</option>' +
        availableTags.map(tag =>
          `<option value="${tag.id}">${escapeHtml(tag.name)} (${tag.post_count || 0} 篇文章)</option>`
        ).join('');
      mergeModal.classList.add('active');
    }

    // ===== 执行合并 =====
    async function handleMerge(e: Event) {
      e.preventDefault();
      const targetId = Number(targetTagSelect.value);
      if (!targetId) { alert('请选择目标标签'); return; }
      if (selectedTagIds.has(targetId)) { alert('目标标签不能是被合并的标签之一'); return; }
      const saveBtn = document.getElementById('merge-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = '合并中...';
      try {
        for (const sourceId of Array.from(selectedTagIds)) {
          await adminApi.tags.merge({ source_id: sourceId, target_id: targetId });
        }
        closeMergeModal();
        selectedTagIds.clear();
        await loadTags();
      } catch (err: any) {
        alert(err.message || '合并失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '确认合并';
      }
    }

    // ===== 关闭弹窗 =====
    function closeEditModal() {
      editModal.classList.remove('active');
      editingTag = null;
      editForm.reset();
    }
    function closeMergeModal() {
      mergeModal.classList.remove('active');
      mergeForm.reset();
    }

    // ===== 工具函数 =====
    function generateSlug(name: string): string {
      return name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '').replace(/-+/g, '-');
    }
    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    init();
  });
</script>

<style>
  /* 操作栏 */
  .action-bar {
    display: flex;
    justify-content: flex-end;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .btn-merge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-pink);
    background: var(--color-white);
    border: 2px solid var(--pink-alpha-30);
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-sm);
  }

  .btn-merge:hover {
    background: var(--gradient-pink-blue-8);
    border-color: var(--color-pink);
    box-shadow: var(--shadow-pink-md);
    transform: translateY(-2px);
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: var(--shadow-blue-md);
  }

  .btn-create:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-blue-hover);
  }

  .btn-create:active {
    transform: translateY(0);
  }

  .btn-create span {
    font-size: 1.25rem;
  }

  /* 标签卡片网格 */
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .tag-card {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tag-card:hover {
    box-shadow: var(--shadow-pink-md);
    border-color: var(--pink-alpha-30);
    transform: translateY(-2px);
  }

  .tag-card.is-selected {
    border-color: var(--pink-alpha-40);
    box-shadow: var(--shadow-pink-md);
  }

  /* 顶部：标签名 + checkbox */
  .tag-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 1.5rem 1.5rem 0.75rem;
    gap: 0.5rem;
  }

  .tag-name-wrap {
    display: flex;
    align-items: baseline;
    gap: 2px;
    min-width: 0;
  }

  .tag-hash {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-pink);
    line-height: 1;
    flex-shrink: 0;
  }

  .tag-name-text {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .tag-checkbox-label {
    flex-shrink: 0;
    cursor: pointer;
    padding: 2px;
  }

  .tag-checkbox-label input[type="checkbox"] {
    width: 16px;
    height: 16px;
    cursor: pointer;
    accent-color: var(--color-pink);
  }

  /* slug */
  .tag-card > .tag-slug-code {
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background: var(--blue-alpha-06);
    padding: 2px 8px;
    border-radius: 6px;
    display: inline-block;
    margin: 0 1.5rem 1rem;
    width: fit-content;
    max-width: calc(100% - 3rem);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 统计行：文章数 + 浏览数 */
  .tag-stats-row {
    display: flex;
    align-items: stretch;
    margin: 0 1.5rem 1.25rem;
    background: linear-gradient(135deg, var(--pink-alpha-05) 0%, var(--blue-alpha-05) 100%);
    border: 1px solid var(--color-divider);
    border-radius: 12px;
    overflow: hidden;
  }

  .tag-stat-block {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.625rem 0.5rem;
    gap: 1px;
  }

  .tag-stat-num {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1;
  }

  .tag-stat-label {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .tag-stat-divider {
    width: 1px;
    background: var(--color-divider);
    flex-shrink: 0;
  }

  /* 操作按钮 */
  .tag-card-actions {
    display: flex;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    border-top: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
  }

  .tag-card-actions button {
    flex: 1;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: 1px solid transparent;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .btn-edit {
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    border-color: var(--pink-alpha-25);
  }

  .btn-edit:hover {
    background: var(--color-pink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-pink-md);
    transform: translateY(-1px);
  }

  .btn-delete {
    color: var(--color-error);
    background: var(--error-alpha-08);
    border-color: var(--error-alpha-20);
  }

  .btn-delete:hover {
    background: var(--color-error);
    color: var(--color-on-primary);
    transform: translateY(-1px);
  }

  /* 合并相关 */
  .merge-hint {
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, var(--info-alpha-08) 0%, var(--info-alpha-05) 100%);
    border-left: 4px solid var(--color-info);
    border-radius: 16px;
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .selected-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.5rem 0;
  }

  .selected-tag-badge {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-blue);
    background: linear-gradient(135deg, var(--blue-alpha-08) 0%, var(--blue-alpha-12) 100%);
    border-radius: 16px;
    border: 1px solid var(--blue-alpha-20);
  }

  /* 加载/空状态 */
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }

  .loading p,
  .empty p {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-alpha-30);
    border-top-color: var(--color-blue);
    border-right-color: var(--color-pink);
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 错误状态 */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 4rem;
  }

  .error-state p {
    font-size: 0.875rem;
    color: var(--color-error);
  }

  .btn-retry {
    padding: 0.5rem 2rem;
    font-size: 0.875rem;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-retry:hover {
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  /* 分页 */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .pagination .page-btn {
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pagination .page-btn:hover:not(:disabled) {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .pagination .page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination .page-info {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  /* 弹窗 */
