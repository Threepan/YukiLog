---
// ================================
// 评论管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="评论管理" activeMenu="comments">
  <!-- 待审核提示卡片 -->
  <div id="pending-alert" class="pending-alert" style="display:none">
    <span class="alert-icon">📬</span>
    <span id="pending-count">0</span> 条评论待审核
  </div>

  <!-- 筛选区域 -->
  <div class="filter-bar">
    <div class="filter-tabs">
      <button class="filter-tab active" data-status="">全部</button>
      <button class="filter-tab" data-status="pending">待审核</button>
      <button class="filter-tab" data-status="approved">已通过</button>
      <button class="filter-tab" data-status="rejected">已拒绝</button>
    </div>
  </div>

  <!-- 评论列表 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无评论</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <div id="comments-grid" class="comments-grid" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination"></div>

  <!-- 编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3>编辑评论</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>评论内容</label>
            <textarea id="edit-content" rows="4" required></textarea>
          </div>
          <div class="form-group">
            <label>作者昵称</label>
            <input type="text" id="edit-name" required />
          </div>
          <div class="form-group">
            <label>作者邮箱</label>
            <input type="email" id="edit-email" required />
          </div>
          <div class="form-group">
            <label>作者网站</label>
            <input type="url" id="edit-website" placeholder="选填" />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import type { Comment } from '../../types/api';

  // ===== 状态管理（模块级，保留引用）=====
  let comments: Comment[] = [];
  let currentPage = 1;
  let totalPages = 1;
  let currentStatus = '';
  let editingComment: Comment | null = null;
  const PAGE_SIZE = 20;

  document.addEventListener('astro:page-load', () => {
    const commentsGrid = document.getElementById('comments-grid') as HTMLDivElement;
    if (!commentsGrid) return;

    // ===== DOM 元素 =====
    const pendingAlert = document.getElementById('pending-alert')!;
    const pendingCount = document.getElementById('pending-count')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const pagination = document.getElementById('pagination')!;
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');

    const editModal = document.getElementById('edit-modal')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editContent = document.getElementById('edit-content') as HTMLTextAreaElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editEmail = document.getElementById('edit-email') as HTMLInputElement;
    const editWebsite = document.getElementById('edit-website') as HTMLInputElement;

    // 重置状态
    comments = [];
    currentPage = 1;
    totalPages = 1;
    currentStatus = '';
    editingComment = null;

    // ===== 初始化 =====
    async function init() {
      await loadPendingCount();
      await loadComments();
      bindEvents();
    }

    // ===== 加载待审核数量 =====
    async function loadPendingCount() {
      try {
        const pendingComments = await adminApi.comments.pending();
        const count = pendingComments.length;
        if (count > 0) {
          pendingCount.textContent = String(count);
          pendingAlert.style.display = 'flex';
        }
      } catch (err) {
        console.error('加载待审核数量失败', err);
      }
    }

    // ===== 加载评论列表 =====
    async function loadComments() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      commentsGrid.style.display = 'none';

      try {
        const params: Record<string, any> = { page: currentPage, page_size: PAGE_SIZE };
        if (currentStatus) params.status = currentStatus;

        const data = await adminApi.comments.list(params);
        comments = data.items;
        totalPages = data.total_pages;

        loading.style.display = 'none';
        if (comments.length === 0) {
          empty.style.display = 'flex';
        } else {
          renderComments();
          renderPagination();
          commentsGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorState.style.display = 'flex';
      }
    }

    // ===== 渲染评论卡片 =====
    function renderComments() {
      commentsGrid.innerHTML = comments.map(comment => {
        const statusClass = `status-${comment.status}`;
        const statusText = getStatusText(comment.status);
        const canApprove = comment.status === 'pending';
        const canReject = comment.status === 'pending';

        return `
          <div class="comment-card">
            <div class="comment-body">
              <p class="comment-text">${escapeHtml(comment.content)}</p>
              <div class="comment-meta">
                <span class="author-name">${escapeHtml(comment.guest_nick)}</span>
                <span class="author-email">${escapeHtml(comment.guest_email)}</span>
                <span class="post-ref">${escapeHtml(comment.post_title || comment.post_slug || '未知文章')}</span>
                <span class="comment-date">${formatDate(comment.created_at)}</span>
              </div>
            </div>
            <div class="comment-footer">
              <span class="status-badge ${statusClass}">${statusText}</span>
              <div class="comment-actions">
                ${canApprove ? `<button class="btn-approve" data-id="${comment.id}">通过</button>` : ''}
                ${canReject ? `<button class="btn-reject" data-id="${comment.id}">拒绝</button>` : ''}
                <button class="btn-edit" data-id="${comment.id}">编辑</button>
                <button class="btn-delete" data-id="${comment.id}">删除</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      bindActionButtons();
    }

    // ===== 渲染分页 =====
    function renderPagination() {
      if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
      }

      pagination.innerHTML = `
        <button class="page-btn" id="prev-btn" ${currentPage <= 1 ? 'disabled' : ''}>上一页</button>
        <span class="page-info">${currentPage} / ${totalPages}</span>
        <button class="page-btn" id="next-btn" ${currentPage >= totalPages ? 'disabled' : ''}>下一页</button>
      `;

      document.getElementById('prev-btn')?.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; loadComments(); }
      });
      document.getElementById('next-btn')?.addEventListener('click', () => {
        if (currentPage < totalPages) { currentPage++; loadComments(); }
      });
    }

    // ===== 绑定筛选事件 =====
    function bindEvents() {
      filterTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          filterTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentStatus = tab.dataset.status || '';
          currentPage = 1;
          loadComments();
        });
      });

      document.getElementById('retry-btn')?.addEventListener('click', loadComments);
      document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);
      editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
      editForm.addEventListener('submit', handleEditSubmit);
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      commentsGrid.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleApprove(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-reject').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleReject(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          handleEdit(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleDelete(id);
        });
      });
    }

    // ===== 操作：通过 =====
    async function handleApprove(id: number) {
      try {
        await adminApi.comments.approve(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 操作：拒绝 =====
    async function handleReject(id: number) {
      if (!confirm('确认拒绝此评论？')) return;
      try {
        await adminApi.comments.reject(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 操作：编辑 =====
    function handleEdit(id: number) {
      const comment = comments.find(c => c.id === id);
      if (!comment) return;

      editingComment = comment;
      editContent.value = comment.content;
      editName.value = comment.guest_nick;
      editEmail.value = comment.guest_email;
      editWebsite.value = comment.guest_website || '';

      editModal.classList.add('active');
    }

    // ===== 操作：删除 =====
    async function handleDelete(id: number) {
      if (!confirm('确认删除此评论？此操作不可恢复')) return;
      try {
        await adminApi.comments.delete(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 提交编辑 =====
    async function handleEditSubmit(e: Event) {
      e.preventDefault();
      if (!editingComment) return;

      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = '保存中...';

      try {
        await adminApi.comments.update(editingComment.id, {
          content: editContent.value,
          guest_nick: editName.value,
          guest_email: editEmail.value,
          guest_website: editWebsite.value || null,
        });
        closeModal();
        await loadComments();
      } catch (err: any) {
        alert(err.message || '保存失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }

    // ===== 关闭弹窗 =====
    function closeModal() {
      editModal.classList.remove('active');
      editingComment = null;
      editForm.reset();
    }

    // ===== 工具函数 =====
    function getStatusText(status: string): string {
      const map: Record<string, string> = {
        pending: '待审核',
        approved: '已通过',
        rejected: '已拒绝',
      };
      return map[status] || status;
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      return date.toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit',
      });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // 初始化
    init();
  });
</script>

<style lang="scss">
  @use 'sass:color';

  // 待审核提示
  .pending-alert {
    display: flex;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-md $spacing-lg;
    background: linear-gradient(135deg, rgba($lian-pink, 0.08) 0%, rgba($lian-blue, 0.08) 100%);
    border-left: 3px solid $lian-pink;
    border-radius: $radius-sm;
    margin-bottom: $spacing-lg;
    font-size: $font-size-sm;
    color: $lian-text;

    .alert-icon {
      font-size: $font-size-xl;
    }
  }

  // 筛选区域
  .filter-bar {
    margin-bottom: $spacing-lg;
  }

  .filter-tabs {
    display: flex;
    gap: $spacing-xs;
  }

  .filter-tab {
    padding: $spacing-xs $spacing-md;
    font-size: $font-size-sm;
    color: $lian-text-light;
    background: $lian-white;
    border: 1px solid $lian-border;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-fast $ease-gentle;

    &:hover {
      border-color: $lian-blue;
      color: $lian-blue;
    }

    &.active {
      background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
      color: var(--color-white);
      border-color: transparent;
    }
  }

  // 表格容器 → 评论卡片网格
  .comments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
  }

  .comment-card {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    border: 1px solid $lian-divider;
    display: flex;
    flex-direction: column;
    transition: all $transition-base $ease-gentle;

    &:hover {
      box-shadow: $shadow-blue;
      border-color: rgba($lian-blue, 0.3);
      transform: translateY(-2px);
    }
  }

  .comment-body {
    flex: 1;
    padding: $spacing-md $spacing-lg $spacing-sm;
    display: flex;
    flex-direction: column;
    gap: $spacing-xs;
  }

  .comment-text {
    font-size: $font-size-sm;
    color: $lian-text;
    line-height: $line-height-base;
    margin: 0;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  .comment-meta {
    display: flex;
    flex-wrap: wrap;
    gap: $spacing-xs;
    align-items: center;
    font-size: $font-size-xs;
    color: $lian-text-muted;
    margin-top: $spacing-xs;
  }

  .author-name {
    font-weight: $font-weight-medium;
    color: $lian-text;
  }

  .author-email {
    font-family: $font-family-code;
    color: $lian-text-muted;
  }

  .post-ref {
    background: rgba($lian-blue, 0.06);
    color: $lian-blue;
    padding: 1px 6px;
    border-radius: 4px;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .comment-date {
    font-family: $font-family-code;
    margin-left: auto;
  }

  .comment-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: $spacing-sm;
    padding: $spacing-sm $spacing-lg $spacing-md;
    border-top: 1px solid $lian-divider;
    background: rgba($lian-bg, 0.5);
    border-radius: 0 0 $radius-md $radius-md;
    flex-wrap: wrap;
  }

  .comment-actions {
    display: flex;
    gap: $spacing-xs;
    flex-wrap: wrap;

    button {
      padding: $spacing-xs $spacing-sm;
      font-size: $font-size-xs;
      font-weight: $font-weight-medium;
      border: none;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;
    }
  }

  .btn-approve {
    color: $lian-blue;
    background: rgba($lian-blue, 0.08);
    border: 1px solid rgba($lian-blue, 0.25) !important;
    &:hover { background: $lian-blue; color: var(--color-white); box-shadow: $shadow-blue; transform: translateY(-1px); }
  }

  .btn-reject {
    color: $lian-text-muted;
    background: rgba($lian-text-muted, 0.1);
    border: 1px solid rgba($lian-text-muted, 0.2) !important;
    &:hover { background: $lian-text-muted; color: var(--color-white); transform: translateY(-1px); }
  }

  .btn-edit {
    color: $lian-pink;
    background: rgba($lian-pink, 0.08);
    border: 1px solid rgba($lian-pink, 0.25) !important;
    &:hover { background: $lian-pink; color: var(--color-white); box-shadow: $shadow-pink; transform: translateY(-1px); }
  }

  .btn-delete {
    color: $lian-error;
    background: rgba($lian-error, 0.08);
    border: 1px solid rgba($lian-error, 0.25) !important;
    &:hover { background: $lian-error; color: var(--color-white); transform: translateY(-1px); }
  }

  // 错误状态
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: $spacing-md;
    padding: $spacing-xxl;
    p { font-size: $font-size-sm; color: $lian-error; }
  }

  .btn-retry {
    padding: $spacing-xs $spacing-lg;
    font-size: $font-size-sm;
    color: var(--color-white);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none; border-radius: $radius-sm; cursor: pointer;
    transition: all $transition-base $ease-gentle;
    &:hover { box-shadow: $shadow-blue; transform: translateY(-1px); }
  }
  // 加载/空状态
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    color: $lian-text-muted;

    p {
      margin: $spacing-sm 0 0;
      font-size: $font-size-sm;
    }
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba($lian-border, 0.3);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  // 状态徽章
  .status-badge {
    display: inline-block;
    padding: 2px 8px;
    font-size: $font-size-xs;
    border-radius: 12px;
    font-weight: $font-weight-medium;

    &.status-pending {
      background: rgba($lian-warning, 0.15);
      color: color.adjust($lian-warning, $lightness: -20%);
    }

    &.status-approved {
      background: rgba($lian-success, 0.15);
      color: color.adjust($lian-success, $lightness: -20%);
    }

    &.status-rejected {
      background: rgba($lian-text-muted, 0.15);
      color: $lian-text-muted;
    }
  }

  // 分页
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: $spacing-sm;
    padding: $spacing-lg 0;

    .page-btn {
      padding: $spacing-xs $spacing-md;
      font-size: $font-size-sm;
      color: $lian-text-light;
      background: $lian-white;
      border: 1px solid $lian-border;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-fast $ease-gentle;

      &:hover:not(:disabled) {
        border-color: $lian-blue;
        color: $lian-blue;
      }

      &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
    }

    .page-info {
      font-size: $font-size-sm;
      color: $lian-text-muted;
      font-family: $font-family-code;
    }
  }

  // 弹窗
  .modal {
    position: fixed;
    inset: 0;
    z-index: $z-modal;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity $transition-base $ease-gentle,
                visibility $transition-base $ease-gentle;

    &.active {
      opacity: 1;
      visibility: visible;

      .modal-card {
        transform: scale(1);
      }
    }
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: var(--modal-backdrop);
    backdrop-filter: blur(8px);
    animation: fadeIn $transition-base $ease-gentle;
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-card {
    position: relative;
    width: 90%;
    max-width: 520px;
    background: var(--color-white);
    border-radius: $radius-lg;
    box-shadow: var(--shadow-modal);
    transform: scale(0.9) translateY(20px);
    transition: all $transition-base $ease-gentle;
    border: 1px solid rgba($lian-blue, 0.1);
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: $spacing-xl $spacing-xl $spacing-lg;
    background: linear-gradient(135deg, rgba($lian-blue, 0.03) 0%, rgba($lian-pink, 0.03) 100%);
    border-bottom: 1px solid $lian-divider;
    border-radius: $radius-lg $radius-lg 0 0;

    h3 {
      margin: 0;
      font-size: $font-size-xl;
      font-weight: $font-weight-bold;
      background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .modal-close {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: $font-size-2xl;
      color: $lian-text-muted;
      background: none;
      border: none;
      border-radius: 50%;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;

      &:hover {
        background: linear-gradient(135deg, rgba($lian-blue, 0.1) 0%, rgba($lian-pink, 0.1) 100%);
        color: $lian-text;
        transform: rotate(90deg);
      }
    }
  }

  .modal-body {
    padding: $spacing-xl;
  }

  .form-group {
    margin-bottom: $spacing-md;

    label {
      display: block;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text;
      margin-bottom: $spacing-xs;
    }

    input,
    textarea {
      width: 100%;
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-base;
      color: $lian-text;
      background: var(--color-white);
      border: 2px solid $lian-border;
      border-radius: $radius-sm;
