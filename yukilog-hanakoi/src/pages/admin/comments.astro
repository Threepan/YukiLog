---
// ================================
// 评论管理页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="评论管理" activeMenu="comments">
  <!-- 待审核提示卡片 -->
  <div id="pending-alert" class="pending-alert" style="display:none">
    <span class="alert-icon">📬</span>
    <span id="pending-count">0</span> 条评论待审核
  </div>

  <!-- 筛选区域 -->
  <div class="filter-bar">
    <div class="filter-tabs">
      <button class="filter-tab active" data-status="">全部</button>
      <button class="filter-tab" data-status="pending">待审核</button>
      <button class="filter-tab" data-status="approved">已通过</button>
      <button class="filter-tab" data-status="rejected">已拒绝</button>
    </div>
  </div>

  <!-- 评论列表 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无评论</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <div id="comments-grid" class="comments-grid" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination"></div>

  <!-- 编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3>编辑评论</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>评论内容</label>
            <textarea id="edit-content" rows="4" required></textarea>
          </div>
          <div class="form-group">
            <label>作者昵称</label>
            <input type="text" id="edit-name" required />
          </div>
          <div class="form-group">
            <label>作者邮箱</label>
            <input type="email" id="edit-email" required />
          </div>
          <div class="form-group">
            <label>作者网站</label>
            <input type="url" id="edit-website" placeholder="选填" />
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import type { Comment } from '../../types/api';

  // ===== 状态管理（模块级，保留引用）=====
  let comments: Comment[] = [];
  let currentPage = 1;
  let totalPages = 1;
  let currentStatus = '';
  let editingComment: Comment | null = null;
  const PAGE_SIZE = 20;

  document.addEventListener('astro:page-load', () => {
    const commentsGrid = document.getElementById('comments-grid') as HTMLDivElement;
    if (!commentsGrid) return;

    // ===== DOM 元素 =====
    const pendingAlert = document.getElementById('pending-alert')!;
    const pendingCount = document.getElementById('pending-count')!;
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const pagination = document.getElementById('pagination')!;
    const filterTabs = document.querySelectorAll<HTMLElement>('.filter-tab');

    const editModal = document.getElementById('edit-modal')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editContent = document.getElementById('edit-content') as HTMLTextAreaElement;
    const editName = document.getElementById('edit-name') as HTMLInputElement;
    const editEmail = document.getElementById('edit-email') as HTMLInputElement;
    const editWebsite = document.getElementById('edit-website') as HTMLInputElement;

    // 重置状态
    comments = [];
    currentPage = 1;
    totalPages = 1;
    currentStatus = '';
    editingComment = null;

    // ===== 初始化 =====
    async function init() {
      await loadPendingCount();
      await loadComments();
      bindEvents();
    }

    // ===== 加载待审核数量 =====
    async function loadPendingCount() {
      try {
        const pendingComments = await adminApi.comments.pending();
        const count = pendingComments.length;
        if (count > 0) {
          pendingCount.textContent = String(count);
          pendingAlert.style.display = 'flex';
        }
      } catch (err) {
        console.error('加载待审核数量失败', err);
      }
    }

    // ===== 加载评论列表 =====
    async function loadComments() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      commentsGrid.style.display = 'none';

      try {
        const params: Record<string, any> = { page: currentPage, page_size: PAGE_SIZE };
        if (currentStatus) params.status = currentStatus;

        const data = await adminApi.comments.list(params);
        comments = data.items;
        totalPages = data.total_pages;

        loading.style.display = 'none';
        if (comments.length === 0) {
          empty.style.display = 'flex';
        } else {
          renderComments();
          renderPagination();
          commentsGrid.style.display = 'grid';
        }
      } catch (err: any) {
        loading.style.display = 'none';
        errorState.style.display = 'flex';
      }
    }

    // ===== 头像渐变色（按昵称首字母散列）=====
    function avatarGradient(name: string): string {
      const palettes = [
        'linear-gradient(135deg, #4a90d9 0%, #7ab3e8 100%)',
        'linear-gradient(135deg, #d9659a 0%, #e8a0c0 100%)',
        'linear-gradient(135deg, #7c6ff7 0%, #a89ff5 100%)',
        'linear-gradient(135deg, #e8984a 0%, #f5c87a 100%)',
        'linear-gradient(135deg, #3ab26e 0%, #7dd6a4 100%)',
        'linear-gradient(135deg, #e05252 0%, #f0948e 100%)',
      ];
      let h = 0;
      for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
      return palettes[Math.abs(h) % palettes.length];
    }

    // ===== 渲染评论卡片 =====
    function renderComments() {
      commentsGrid.innerHTML = comments.map(comment => {
        const statusClass = `status-${comment.status}`;
        const statusText = getStatusText(comment.status);
        const canApprove = comment.status === 'pending';
        const canReject = comment.status === 'pending';
        const initial = (comment.guest_nick || '?').charAt(0).toUpperCase();
        const bg = avatarGradient(comment.guest_nick || '?');
        const postLabel = escapeHtml(comment.post_title || comment.post_slug || '未知文章');
        const postHref = comment.post_slug ? `/posts/${escapeHtml(comment.post_slug)}` : '#';

        return `
          <div class="comment-card">
            <div class="comment-header">
              <div class="author-avatar" style="background:${bg}">${initial}</div>
              <div class="author-info">
                <div class="author-top-row">
                  <span class="author-name">${escapeHtml(comment.guest_nick)}</span>
                  <span class="status-badge ${statusClass}">${statusText}</span>
                </div>
                <span class="author-email">${escapeHtml(comment.guest_email)}</span>
                ${comment.visitor_info ? `<span class="visitor-info">${escapeHtml(comment.visitor_info)}</span>` : ''}
              </div>
            </div>
            <div class="comment-body">
              <p class="comment-text">${escapeHtml(comment.content)}</p>
            </div>
            <div class="comment-meta-row">
              <a class="post-chip" href="${postHref}" target="_blank" rel="noopener noreferrer">${postLabel}</a>
              <span class="comment-date">${formatDate(comment.created_at)}</span>
            </div>
            <div class="comment-footer">
              <div class="comment-actions">
                ${canApprove ? `<button class="btn-approve" data-id="${comment.id}">通过</button>` : ''}
                ${canReject ? `<button class="btn-reject" data-id="${comment.id}">拒绝</button>` : ''}
                <button class="btn-edit" data-id="${comment.id}">编辑</button>
                <button class="btn-delete" data-id="${comment.id}">删除</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      bindActionButtons();
    }

    // ===== 渲染分页 =====
    function renderPagination() {
      if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
      }

      pagination.innerHTML = `
        <button class="page-btn" id="prev-btn" ${currentPage <= 1 ? 'disabled' : ''}>上一页</button>
        <span class="page-info">${currentPage} / ${totalPages}</span>
        <button class="page-btn" id="next-btn" ${currentPage >= totalPages ? 'disabled' : ''}>下一页</button>
      `;

      document.getElementById('prev-btn')?.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; loadComments(); }
      });
      document.getElementById('next-btn')?.addEventListener('click', () => {
        if (currentPage < totalPages) { currentPage++; loadComments(); }
      });
    }

    // ===== 绑定筛选事件 =====
    function bindEvents() {
      filterTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          filterTabs.forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentStatus = tab.dataset.status || '';
          currentPage = 1;
          loadComments();
        });
      });

      document.getElementById('retry-btn')?.addEventListener('click', loadComments);
      document.getElementById('modal-close-btn')?.addEventListener('click', closeModal);
      document.getElementById('modal-cancel-btn')?.addEventListener('click', closeModal);
      editModal.querySelector('.modal-backdrop')?.addEventListener('click', closeModal);
      editForm.addEventListener('submit', handleEditSubmit);
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      commentsGrid.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleApprove(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-reject').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleReject(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          handleEdit(id);
        });
      });
      commentsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const id = Number((e.target as HTMLElement).dataset.id);
          await handleDelete(id);
        });
      });
    }

    // ===== 操作：通过 =====
    async function handleApprove(id: number) {
      try {
        await adminApi.comments.approve(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 操作：拒绝 =====
    async function handleReject(id: number) {
      if (!confirm('确认拒绝此评论？')) return;
      try {
        await adminApi.comments.reject(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 操作：编辑 =====
    function handleEdit(id: number) {
      const comment = comments.find(c => c.id === id);
      if (!comment) return;

      editingComment = comment;
      editContent.value = comment.content;
      editName.value = comment.guest_nick;
      editEmail.value = comment.guest_email;
      editWebsite.value = comment.guest_website || '';

      editModal.classList.add('active');
    }

    // ===== 操作：删除 =====
    async function handleDelete(id: number) {
      if (!confirm('确认删除此评论？此操作不可恢复')) return;
      try {
        await adminApi.comments.delete(id);
        await loadComments();
        await loadPendingCount();
      } catch (err: any) {
        alert(err.message || '操作失败');
      }
    }

    // ===== 提交编辑 =====
    async function handleEditSubmit(e: Event) {
      e.preventDefault();
      if (!editingComment) return;

      const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
      saveBtn.disabled = true;
      saveBtn.textContent = '保存中...';

      try {
        await adminApi.comments.update(editingComment.id, {
          content: editContent.value,
          guest_nick: editName.value,
          guest_email: editEmail.value,
          guest_website: editWebsite.value || null,
        });
        closeModal();
        await loadComments();
      } catch (err: any) {
        alert(err.message || '保存失败');
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = '保存';
      }
    }

    // ===== 关闭弹窗 =====
    function closeModal() {
      editModal.classList.remove('active');
      editingComment = null;
      editForm.reset();
    }

    // ===== 工具函数 =====
    function getStatusText(status: string): string {
      const map: Record<string, string> = {
        pending: '待审核',
        approved: '已通过',
        rejected: '已拒绝',
      };
      return map[status] || status;
    }

    function formatDate(dateStr: string): string {
      const date = new Date(dateStr);
      return date.toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit',
        hour: '2-digit', minute: '2-digit',
      });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // 初始化
    init();
  });
</script>

<style>
  /* 待审核提示 */
  .pending-alert {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 2rem;
    background: linear-gradient(135deg, var(--pink-alpha-08) 0%, var(--blue-alpha-08) 100%);
    border-left: 3px solid var(--color-pink);
    border-radius: 16px;
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--color-text);
  }

  .pending-alert .alert-icon {
    font-size: 1.25rem;
  }

  /* 筛选区域 */
  .filter-bar {
    margin-bottom: 2rem;
  }

  .filter-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .filter-tab {
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text-light);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .filter-tab:hover {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .filter-tab.active {
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    color: var(--color-on-primary);
    border-color: transparent;
  }

  /* 评论卡片网格 */
  .comments-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .comment-card {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .comment-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-color: var(--blue-alpha-30);
    transform: translateY(-2px);
  }

  /* 卡片头部：头像 + 作者信息 */
  .comment-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem 1.75rem 0;
  }

  .author-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    flex-shrink: 0;
    letter-spacing: 0;
  }

  .author-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author-email {
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    color: var(--color-text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .visitor-info {
    font-size: 0.6875rem;
    color: var(--color-text-muted);
    background: var(--blue-alpha-05);
    padding: 1px 6px;
    border-radius: 6px;
    display: inline-block;
    margin-top: 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* 评论正文 */
  .comment-body {
    padding: 1rem 1.75rem 0.75rem;
  }

  .comment-text {
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1.65;
    margin: 0;
    padding-left: 0.875rem;
    border-left: 3px solid var(--blue-alpha-20);
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
  }

  /* 来源文章行 */
  .comment-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 1.75rem 1rem;
    flex-wrap: wrap;
  }

  .post-chip {
    display: inline-flex;
    align-items: center;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.75rem;
    color: var(--color-blue);
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-15);
    padding: 2px 8px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 150ms;
  }

  .post-chip:hover {
    background: var(--blue-alpha-15);
  }

  .comment-date {
    font-size: 0.75rem;
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
    color: var(--color-text-muted);
    margin-left: auto;
  }

  /* 底部操作区 */
  .comment-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    padding: 0.875rem 1.75rem 1.25rem;
    border-top: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
    flex-wrap: wrap;
  }

  .comment-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .comment-actions button {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 操作按钮 */
  .btn-approve {
    color: var(--color-blue);
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-25) !important;
  }

  .btn-approve:hover {
    background: var(--color-blue);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  .btn-reject {
    color: var(--color-text-muted);
    background: color-mix(in srgb, var(--color-text-muted) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-text-muted) 20%, transparent) !important;
  }

  .btn-reject:hover {
    background: var(--color-text-muted);
    color: var(--color-on-primary);
    transform: translateY(-1px);
  }

  .btn-edit {
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    border: 1px solid var(--pink-alpha-25) !important;
  }

  .btn-edit:hover {
    background: var(--color-pink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-pink-md);
    transform: translateY(-1px);
  }

  .btn-delete {
    color: var(--color-error);
    background: var(--error-alpha-08);
    border: 1px solid var(--error-alpha-20) !important;
  }

  .btn-delete:hover {
    background: var(--color-error);
    color: var(--color-on-primary);
    transform: translateY(-1px);
  }

  /* 状态徽章 */
  .status-badge {
    display: inline-block;
    padding: 2px 8px;
    font-size: 0.75rem;
    border-radius: 12px;
    font-weight: 500;
  }

  .status-badge.status-pending {
    background: var(--warning-alpha-15);
    color: #c48a2c;
  }

  .status-badge.status-approved {
    background: var(--success-alpha-15);
    color: #4e9067;
  }

  .status-badge.status-rejected {
    background: color-mix(in srgb, var(--color-text-muted) 15%, transparent);
    color: var(--color-text-muted);
  }

  /* 加载/空状态 */
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }

  .loading p,
  .empty p {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-alpha-30);
    border-top-color: var(--color-blue);
    border-right-color: var(--color-pink);
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 错误状态 */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    padding: 4rem;
  }

  .error-state p {
    font-size: 0.875rem;
    color: var(--color-error);
  }

  .btn-retry {
    padding: 0.5rem 2rem;
    font-size: 0.875rem;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-retry:hover {
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  /* 分页 */
  .pagination {
