---
// ================================
// 文章管理列表页
// ================================

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="文章管理" activeMenu="posts">
  <!-- 操作栏 -->
  <div class="action-bar">
    <div class="tabs">
      <button class="tab active" data-status="all">全部</button>
      <button class="tab" data-status="published">已发布</button>
      <button class="tab" data-status="draft">草稿箱</button>
    </div>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建文章
    </button>
  </div>

  <!-- 状态区 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无文章，点击「新建文章」开始创作吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p id="error-msg">加载失败，请检查网络连接</p>
    <button id="retry-btn" class="btn-retry">重新加载</button>
  </div>

  <!-- 文章卡片列表 -->
  <div id="posts-grid" class="posts-grid" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination" style="display:none">
    <button id="prev-btn" class="page-btn" disabled>上一页</button>
    <span class="page-info">
      第 <span id="current-page">1</span> / <span id="total-pages">1</span> 页
    </span>
    <button id="next-btn" class="page-btn" disabled>下一页</button>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../../lib/api';
  import type { PostWithRelations } from '../../../types/api';

  // 扁平化文章数据（合并 post + relations）
  interface FlatPost {
    id: number;
    title: string;
    slug: string;
    status: string;
    view_count: number;
    created_at: string;
    theme: { name: string; slug: string } | null;
    tags: { name: string; slug: string }[];
  }

  function flattenPost(item: PostWithRelations): FlatPost {
    return {
      id: item.post.id,
      title: item.post.title,
      slug: item.post.slug,
      status: item.post.status,
      view_count: item.post.view_count,
      created_at: item.post.created_at,
      theme: item.theme,
      tags: item.tags,
    };
  }

  // ===== 状态管理（模块级，跨导航保持） =====
  let allPosts: FlatPost[] = [];
  let filteredPosts: FlatPost[] = [];
  let currentStatus: 'all' | 'published' | 'draft' = 'all';
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;

  // ===== 每次页面加载/导航时重新绑定 =====
  document.addEventListener('astro:page-load', () => {
    // 检查是否在文章列表页
    const postsGrid = document.getElementById('posts-grid')!;
    if (!postsGrid) return;

    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const errorMsg = document.getElementById('error-msg')!;
    const retryBtn = document.getElementById('retry-btn')!;
    const pagination = document.getElementById('pagination')!;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const currentPageSpan = document.getElementById('current-page')!;
    const totalPagesSpan = document.getElementById('total-pages')!;
    const createBtn = document.getElementById('create-btn')!;

    // ===== 工具函数 =====
    function formatDate(dateStr: string): string {
      return new Date(dateStr).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit'
      });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ===== 渲染文章卡片列表 =====
    function renderPosts() {
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const pagePosts = filteredPosts.slice(start, end);

      postsGrid.innerHTML = pagePosts.map(post => `
        <div class="post-card">
          <div class="post-card-body">
            <div class="post-card-top">
              <a href="/posts/${escapeHtml(post.slug)}" target="_blank" rel="noopener noreferrer" class="post-title-link">
                ${escapeHtml(post.title)}
              </a>
              <span class="status-badge status-${post.status}">
                ${post.status === 'published' ? '已发布' : '草稿'}
              </span>
            </div>
            <div class="post-card-meta">
              ${post.theme ? `<span class="theme-badge">${escapeHtml(post.theme.name)}</span>` : ''}
              <span class="meta-date">📅 ${formatDate(post.created_at)}</span>
              <span class="meta-views">👁 ${post.view_count || 0} 次</span>
            </div>
            ${post.tags.length > 0 ? `
              <div class="post-card-tags">
                ${post.tags.slice(0, 4).map(t => `<span class="tag-chip">#${escapeHtml(t.name)}</span>`).join('')}
              </div>
            ` : ''}
          </div>
          <div class="post-card-actions">
            <button class="btn-edit" data-slug="${escapeHtml(post.slug)}">编辑</button>
            <button class="btn-delete" data-slug="${escapeHtml(post.slug)}" data-title="${escapeHtml(post.title)}">删除</button>
          </div>
        </div>
      `).join('');

      // 更新分页状态
      currentPageSpan.textContent = String(currentPage);
      totalPagesSpan.textContent = String(totalPages);
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages || totalPages === 0;

      bindActionButtons();
    }

    // ===== 应用筛选 =====
    function applyFilter() {
      filteredPosts = currentStatus === 'all'
        ? allPosts
        : allPosts.filter(p => p.status === currentStatus);

      currentPage = 1;
      totalPages = Math.max(1, Math.ceil(filteredPosts.length / PAGE_SIZE));

      if (filteredPosts.length === 0) {
        loading.style.display = 'none';
        empty.style.display = 'flex';
        postsGrid.style.display = 'none';
        pagination.style.display = 'none';
      } else {
        renderPosts();
        loading.style.display = 'none';
        empty.style.display = 'none';
        postsGrid.style.display = 'grid';
        pagination.style.display = filteredPosts.length > PAGE_SIZE ? 'flex' : 'none';
      }
    }

    // ===== 加载文章列表 =====
    async function loadPosts() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      postsGrid.style.display = 'none';
      pagination.style.display = 'none';

      try {
        const response = await adminApi.posts.list();
        allPosts = response.items.map(flattenPost);
        applyFilter();
      } catch (err: any) {
        loading.style.display = 'none';
        errorMsg.textContent = err.message || '加载文章失败，请检查网络连接';
        errorState.style.display = 'flex';
      }
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      postsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const slug = (e.target as HTMLElement).dataset.slug;
          window.location.href = `/admin/posts/edit/${slug}`;
        });
      });

      postsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const slug = target.dataset.slug || '';
          const title = target.dataset.title || '';
          if (!confirm(`确认删除文章《${title}》？\n\n此操作不可撤销。`)) return;
          try {
            await adminApi.posts.delete(slug);
            await loadPosts();
          } catch (err: any) {
            alert(err.message || '删除失败');
          }
        });
      });
    }

    // ===== 绑定主事件 =====
    createBtn.addEventListener('click', () => {
      window.location.href = '/admin/posts/new';
    });

    retryBtn.addEventListener('click', loadPosts);

    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        currentStatus = target.dataset.status as any;
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        target.classList.add('active');
        applyFilter();
      });
    });

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderPosts(); }
    });

    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) { currentPage++; renderPosts(); }
    });

    // 初始加载
    loadPosts();
  });
</script>

<style>
  /* 操作栏 */
  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .tabs {
    display: flex;
    gap: 0.5rem;
  }

  .tabs .tab {
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-light);
    background: transparent;
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .tabs .tab:hover {
    color: var(--color-text);
    background: var(--blue-alpha-05);
  }

  .tabs .tab.active {
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-create:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-blue-md);
  }

  .btn-create span {
    font-size: 1.25rem;
  }

  /* 加载/空状态 */
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    color: var(--color-text-muted);
  }

  .loading p,
  .empty p {
    margin: 1rem 0 0;
    font-size: 0.875rem;
    text-align: center;
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--border-alpha-30);
    border-top-color: var(--color-blue);
    border-right-color: var(--color-pink);
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  /* 错误状态 */
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem;
    gap: 1.5rem;
    color: var(--color-text-muted);
  }

  .error-state p {
    font-size: 0.875rem;
    text-align: center;
    color: var(--color-error);
  }

  .btn-retry {
    padding: 0.5rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-primary);
    background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
    border: none;
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .btn-retry:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-blue-md);
  }

  /* 文章卡片网格 */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .post-card {
    background: var(--color-white);
    border-radius: 20px;
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-divider);
    display: flex;
    flex-direction: column;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-card:hover {
    box-shadow: var(--shadow-blue-md);
    border-color: var(--blue-alpha-30);
    transform: translateY(-2px);
  }

  .post-card-body {
    flex: 1;
    padding: 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .post-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .post-title-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.25;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .post-title-link:hover {
    color: var(--color-blue);
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2px;
  }

  .meta-date,
  .meta-views {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .tag-chip {
    display: inline-block;
    padding: 1px 8px;
    font-size: 0.75rem;
    color: var(--color-pink);
    background: var(--pink-alpha-08);
    border-radius: 10px;
  }

  .theme-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-blue);
    background: var(--blue-alpha-10);
    border-radius: 10px;
  }

  .status-badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: 10px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .status-badge.status-published {
    background: var(--success-alpha-15);
    color: #5a9e71;
  }

  .status-badge.status-draft {
    background: var(--warning-alpha-15);
    color: #c4933a;
  }

  .post-card-actions {
    display: flex;
    gap: 0.5rem;
    padding: 1rem 2rem 1.5rem;
    border-top: 1px solid var(--color-divider);
    background: color-mix(in srgb, var(--color-bg) 50%, transparent);
    border-radius: 0 0 20px 20px;
  }

  .btn-edit {
    flex: 1;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-blue);
    background: var(--blue-alpha-08);
    border: 1px solid var(--blue-alpha-25);
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .btn-edit:hover {
    background: var(--color-blue);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-blue-md);
    transform: translateY(-1px);
  }

  .btn-delete {
    flex: 1;
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-error);
    background: var(--error-alpha-08);
    border: 1px solid var(--error-alpha-20);
    border-radius: 16px;
    cursor: pointer;
    transition: all 300ms cubic-bezier(0.4, 0, 0.2, 1);
    text-align: center;
  }

  .btn-delete:hover {
    background: var(--color-error);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-error-md);
    transform: translateY(-1px);
  }

  /* 分页 */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 1.5rem 0 2rem;
  }

  .pagination .page-btn {
    padding: 0.5rem 1.5rem;
    font-size: 0.875rem;
    color: var(--color-text);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    cursor: pointer;
    transition: all 200ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .pagination .page-btn:hover:not(:disabled) {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .pagination .page-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination .page-info {
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
