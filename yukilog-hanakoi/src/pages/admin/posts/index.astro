---
// ================================
// 文章管理列表页
// ================================

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="文章管理" activeMenu="posts">
  <!-- 操作栏 -->
  <div class="action-bar">
    <div class="tabs">
      <button class="tab active" data-status="all">全部</button>
      <button class="tab" data-status="published">已发布</button>
      <button class="tab" data-status="draft">草稿箱</button>
    </div>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建文章
    </button>
  </div>

  <!-- 状态区 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无文章，点击「新建文章」开始创作吧</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p id="error-msg">加载失败，请检查网络连接</p>
    <button id="retry-btn" class="btn-retry">重新加载</button>
  </div>

  <!-- 文章卡片列表 -->
  <div id="posts-grid" class="posts-grid" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination" style="display:none">
    <button id="prev-btn" class="page-btn" disabled>上一页</button>
    <span class="page-info">
      第 <span id="current-page">1</span> / <span id="total-pages">1</span> 页
    </span>
    <button id="next-btn" class="page-btn" disabled>下一页</button>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../../lib/api';
  import type { PostWithRelations } from '../../../types/api';

  // 扁平化文章数据（合并 post + relations）
  interface FlatPost {
    id: number;
    title: string;
    slug: string;
    status: string;
    view_count: number;
    created_at: string;
    theme: { name: string; slug: string } | null;
    tags: { name: string; slug: string }[];
  }

  function flattenPost(item: PostWithRelations): FlatPost {
    return {
      id: item.post.id,
      title: item.post.title,
      slug: item.post.slug,
      status: item.post.status,
      view_count: item.post.view_count,
      created_at: item.post.created_at,
      theme: item.theme,
      tags: item.tags,
    };
  }

  // ===== 状态管理（模块级，跨导航保持） =====
  let allPosts: FlatPost[] = [];
  let filteredPosts: FlatPost[] = [];
  let currentStatus: 'all' | 'published' | 'draft' = 'all';
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;

  // ===== 每次页面加载/导航时重新绑定 =====
  document.addEventListener('astro:page-load', () => {
    // 检查是否在文章列表页
    const postsGrid = document.getElementById('posts-grid')!;
    if (!postsGrid) return;

    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const errorMsg = document.getElementById('error-msg')!;
    const retryBtn = document.getElementById('retry-btn')!;
    const pagination = document.getElementById('pagination')!;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const currentPageSpan = document.getElementById('current-page')!;
    const totalPagesSpan = document.getElementById('total-pages')!;
    const createBtn = document.getElementById('create-btn')!;

    // ===== 工具函数 =====
    function formatDate(dateStr: string): string {
      return new Date(dateStr).toLocaleDateString('zh-CN', {
        year: 'numeric', month: '2-digit', day: '2-digit'
      });
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ===== 渲染文章卡片列表 =====
    function renderPosts() {
      const start = (currentPage - 1) * PAGE_SIZE;
      const end = start + PAGE_SIZE;
      const pagePosts = filteredPosts.slice(start, end);

      postsGrid.innerHTML = pagePosts.map(post => `
        <div class="post-card">
          <div class="post-card-body">
            <div class="post-card-top">
              <a href="/posts/${escapeHtml(post.slug)}" target="_blank" rel="noopener noreferrer" class="post-title-link">
                ${escapeHtml(post.title)}
              </a>
              <span class="status-badge status-${post.status}">
                ${post.status === 'published' ? '已发布' : '草稿'}
              </span>
            </div>
            <div class="post-card-meta">
              ${post.theme ? `<span class="theme-badge">${escapeHtml(post.theme.name)}</span>` : ''}
              <span class="meta-date">📅 ${formatDate(post.created_at)}</span>
              <span class="meta-views">👁 ${post.view_count || 0} 次</span>
            </div>
            ${post.tags.length > 0 ? `
              <div class="post-card-tags">
                ${post.tags.slice(0, 4).map(t => `<span class="tag-chip">#${escapeHtml(t.name)}</span>`).join('')}
              </div>
            ` : ''}
          </div>
          <div class="post-card-actions">
            <button class="btn-edit" data-slug="${escapeHtml(post.slug)}">编辑</button>
            <button class="btn-delete" data-slug="${escapeHtml(post.slug)}" data-title="${escapeHtml(post.title)}">删除</button>
          </div>
        </div>
      `).join('');

      // 更新分页状态
      currentPageSpan.textContent = String(currentPage);
      totalPagesSpan.textContent = String(totalPages);
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages || totalPages === 0;

      bindActionButtons();
    }

    // ===== 应用筛选 =====
    function applyFilter() {
      filteredPosts = currentStatus === 'all'
        ? allPosts
        : allPosts.filter(p => p.status === currentStatus);

      currentPage = 1;
      totalPages = Math.max(1, Math.ceil(filteredPosts.length / PAGE_SIZE));

      if (filteredPosts.length === 0) {
        loading.style.display = 'none';
        empty.style.display = 'flex';
        postsGrid.style.display = 'none';
        pagination.style.display = 'none';
      } else {
        renderPosts();
        loading.style.display = 'none';
        empty.style.display = 'none';
        postsGrid.style.display = 'grid';
        pagination.style.display = filteredPosts.length > PAGE_SIZE ? 'flex' : 'none';
      }
    }

    // ===== 加载文章列表 =====
    async function loadPosts() {
      loading.style.display = 'flex';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      postsGrid.style.display = 'none';
      pagination.style.display = 'none';

      try {
        const response = await adminApi.posts.list();
        allPosts = response.items.map(flattenPost);
        applyFilter();
      } catch (err: any) {
        loading.style.display = 'none';
        errorMsg.textContent = err.message || '加载文章失败，请检查网络连接';
        errorState.style.display = 'flex';
      }
    }

    // ===== 绑定操作按钮 =====
    function bindActionButtons() {
      postsGrid.querySelectorAll('.btn-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const slug = (e.target as HTMLElement).dataset.slug;
          window.location.href = `/admin/posts/edit/${slug}`;
        });
      });

      postsGrid.querySelectorAll('.btn-delete').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.target as HTMLElement;
          const slug = target.dataset.slug || '';
          const title = target.dataset.title || '';
          if (!confirm(`确认删除文章《${title}》？\n\n此操作不可撤销。`)) return;
          try {
            await adminApi.posts.delete(slug);
            await loadPosts();
          } catch (err: any) {
            alert(err.message || '删除失败');
          }
        });
      });
    }

    // ===== 绑定主事件 =====
    createBtn.addEventListener('click', () => {
      window.location.href = '/admin/posts/new';
    });

    retryBtn.addEventListener('click', loadPosts);

    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        currentStatus = target.dataset.status as any;
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        target.classList.add('active');
        applyFilter();
      });
    });

    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) { currentPage--; renderPosts(); }
    });

    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) { currentPage++; renderPosts(); }
    });

    // 初始加载
    loadPosts();
  });
</script>

<style lang="scss">
  @use 'sass:color';

  // 操作栏
  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: $spacing-lg;
  }

  .tabs {
    display: flex;
    gap: $spacing-xs;

    .tab {
      padding: $spacing-xs $spacing-md;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text-light;
      background: transparent;
      border: none;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-fast $ease-gentle;

      &:hover {
        color: $lian-text;
        background: rgba($lian-blue, 0.05);
      }

      &.active {
        color: var(--color-on-primary);
        background: var(--gradient-primary);
      }
    }
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: $spacing-sm $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-on-primary);
    background: var(--gradient-primary);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;

    &:hover {
      transform: translateY(-1px);
      box-shadow: $shadow-blue;
    }

    span {
      font-size: $font-size-xl;
    }
  }

  // 表格容器
  .posts-table {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    overflow: hidden;
  }

  // 加载/空状态
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    color: $lian-text-muted;

    p {
      margin: $spacing-sm 0 0;
      font-size: $font-size-sm;
      text-align: center;
    }
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba($lian-border, 0.3);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  // 错误状态
  .error-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    gap: $spacing-md;
    color: $lian-text-muted;

    p {
      font-size: $font-size-sm;
      text-align: center;
      color: $lian-error;
    }
  }

  .btn-retry {
    padding: $spacing-xs $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-white);
    background: linear-gradient(135deg, $lian-blue 0%, $lian-pink 100%);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;

    &:hover {
      transform: translateY(-2px);
      box-shadow: $shadow-blue;
    }
  }

  // 文章卡片网格
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: $spacing-md;
    margin-bottom: $spacing-lg;
  }

  .post-card {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    border: 1px solid $lian-divider;
    display: flex;
    flex-direction: column;
    transition: all $transition-base $ease-gentle;

    &:hover {
      box-shadow: $shadow-blue;
      border-color: rgba($lian-blue, 0.3);
      transform: translateY(-2px);
    }
  }

  .post-card-body {
    flex: 1;
    padding: $spacing-md $spacing-lg;
    display: flex;
    flex-direction: column;
    gap: $spacing-xs;
  }

  .post-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: $spacing-sm;
  }

  .post-title-link {
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: $lian-text;
    text-decoration: none;
    line-height: $line-height-tight;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color $transition-fast $ease-gentle;

    &:hover {
      color: $lian-blue;
    }
  }

  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: $spacing-xs;
    margin-top: 2px;
  }

  .meta-date,
  .meta-views {
    font-size: $font-size-xs;
    color: $lian-text-muted;
    font-family: $font-family-code;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 2px;
  }

  .tag-chip {
    display: inline-block;
    padding: 1px 8px;
    font-size: $font-size-xs;
    color: $lian-pink;
    background: rgba($lian-pink, 0.08);
    border-radius: 10px;
  }

  .theme-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    color: $lian-blue;
    background: rgba($lian-blue, 0.1);
    border-radius: 10px;
  }

  .status-badge {
    display: inline-block;
    padding: 3px 10px;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    border-radius: 10px;
    white-space: nowrap;
    flex-shrink: 0;

    &.status-published {
      background: rgba($lian-success, 0.15);
      color: darken($lian-success, 15%);
    }

    &.status-draft {
      background: rgba($lian-warning, 0.15);
      color: darken($lian-warning, 20%);
    }
  }

  .post-card-actions {
    display: flex;
    gap: $spacing-xs;
    padding: $spacing-sm $spacing-lg $spacing-md;
    border-top: 1px solid $lian-divider;
    background: rgba($lian-bg, 0.5);
    border-radius: 0 0 $radius-md $radius-md;
  }

  .btn-edit {
    flex: 1;
    padding: $spacing-xs $spacing-sm;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    color: $lian-blue;
    background: rgba($lian-blue, 0.08);
    border: 1px solid rgba($lian-blue, 0.25);
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    text-align: center;

    &:hover {
      background: $lian-blue;
      color: var(--color-white);
      box-shadow: $shadow-blue;
      transform: translateY(-1px);
    }
  }

  .btn-delete {
    flex: 1;
    padding: $spacing-xs $spacing-sm;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    color: $lian-error;
    background: rgba($lian-error, 0.08);
    border: 1px solid rgba($lian-error, 0.25);
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;
    text-align: center;

    &:hover {
      background: $lian-error;
      color: var(--color-white);
      box-shadow: 0 4px 12px rgba($lian-error, 0.3);
      transform: translateY(-1px);
    }
  }

  // 分页
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: $spacing-md;
    padding: $spacing-md 0 $spacing-lg;

    .page-btn {
      padding: $spacing-xs $spacing-md;
      font-size: $font-size-sm;
      color: $lian-text;
      background: $lian-white;
      border: 1px solid $lian-border;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-fast $ease-gentle;

      &:hover:not(:disabled) {
        border-color: $lian-blue;
        color: $lian-blue;
      }

      &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
    }

    .page-info {
      font-size: $font-size-sm;
      color: $lian-text-light;
    }
  }

  @media (max-width: 600px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
