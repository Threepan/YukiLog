---
// ================================
// 文章管理列表页
// ================================

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="文章管理" activeMenu="posts">
  <!-- 操作栏 -->
  <div class="action-bar">
    <div class="tabs">
      <button class="tab active" data-status="all">全部</button>
      <button class="tab" data-status="published">已发布</button>
      <button class="tab" data-status="draft">草稿箱</button>
    </div>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建文章
    </button>
  </div>

  <!-- 文章列表 -->
  <div class="posts-table">
    <div id="loading" class="loading">
      <div class="spinner"></div>
      <p>加载中...</p>
    </div>

    <div id="empty" class="empty" style="display:none">
      <p>暂无文章，点击「新建文章」开始创作吧</p>
    </div>

    <table id="table-content" style="display:none">
      <thead>
        <tr>
          <th>标题</th>
          <th style="width: 100px">主题</th>
          <th style="width: 80px">状态</th>
          <th style="width: 80px">浏览</th>
          <th style="width: 120px">创建时间</th>
          <th style="width: 150px">操作</th>
        </tr>
      </thead>
      <tbody id="posts-tbody"></tbody>
    </table>
  </div>

  <!-- 分页 -->
  <div id="pagination" class="pagination" style="display:none">
    <button id="prev-btn" class="page-btn" disabled>上一页</button>
    <span class="page-info">
      第 <span id="current-page">1</span> / <span id="total-pages">1</span> 页
    </span>
    <button id="next-btn" class="page-btn" disabled>下一页</button>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../../lib/api';
  import type { PostWithRelations } from '../../../types/api';

  // 扁平化文章数据（合并 post + relations）
  interface FlatPost {
    id: number;
    title: string;
    slug: string;
    status: string;
    view_count: number;
    created_at: string;
    theme: { name: string; slug: string } | null;
    tags: { name: string; slug: string }[];
  }

  function flattenPost(item: PostWithRelations): FlatPost {
    return {
      id: item.post.id,
      title: item.post.title,
      slug: item.post.slug,
      status: item.post.status,
      view_count: item.post.view_count,
      created_at: item.post.created_at,
      theme: item.theme,
      tags: item.tags,
    };
  }

  // ===== 状态管理 =====
  let allPosts: FlatPost[] = [];
  let filteredPosts: FlatPost[] = [];
  let currentStatus: 'all' | 'published' | 'draft' = 'all';

  // 分页
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;

  // ===== DOM 元素 =====
  const loading = document.getElementById('loading')!;
  const empty = document.getElementById('empty')!;
  const tableContent = document.getElementById('table-content') as HTMLTableElement;
  const postsTbody = document.getElementById('posts-tbody')!;
  const createBtn = document.getElementById('create-btn')!;

  const pagination = document.getElementById('pagination')!;
  const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
  const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
  const currentPageSpan = document.getElementById('current-page')!;
  const totalPagesSpan = document.getElementById('total-pages')!;

  // ===== 初始化 =====
  async function init() {
    await loadPosts();
    bindEvents();
  }

  // ===== 加载文章列表 =====
  async function loadPosts() {
    loading.style.display = 'flex';
    empty.style.display = 'none';
    tableContent.style.display = 'none';
    pagination.style.display = 'none';

    try {
      const response = await adminApi.posts.list();
      allPosts = response.items.map(flattenPost);
      applyFilter();
    } catch (err: any) {
      loading.style.display = 'none';
      alert(err.message || '加载文章失败');
    }
  }

  // ===== 应用筛选 =====
  function applyFilter() {
    if (currentStatus === 'all') {
      filteredPosts = allPosts;
    } else {
      filteredPosts = allPosts.filter(post => post.status === currentStatus);
    }

    currentPage = 1;
    totalPages = Math.ceil(filteredPosts.length / PAGE_SIZE);

    if (filteredPosts.length === 0) {
      loading.style.display = 'none';
      empty.style.display = 'flex';
      tableContent.style.display = 'none';
      pagination.style.display = 'none';
    } else {
      renderPosts();
      loading.style.display = 'none';
      tableContent.style.display = 'table';
      pagination.style.display = filteredPosts.length > PAGE_SIZE ? 'flex' : 'none';
    }
  }

  // ===== 渲染文章列表 =====
  function renderPosts() {
    const start = (currentPage - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const pagePosts = filteredPosts.slice(start, end);

    postsTbody.innerHTML = pagePosts.map(post => `
      <tr>
        <td class="post-title">
          <a href="/posts/${escapeHtml(post.slug)}" target="_blank" rel="noopener noreferrer">
            ${escapeHtml(post.title)}
          </a>
        </td>
        <td>
          ${post.theme ? `<span class="theme-badge">${escapeHtml(post.theme.name)}</span>` : '-'}
        </td>
        <td>
          <span class="status-badge status-${post.status}">
            ${post.status === 'published' ? '已发布' : '草稿'}
          </span>
        </td>
        <td class="text-center">${post.view_count || 0}</td>
        <td class="text-muted">${formatDate(post.created_at)}</td>
        <td class="actions">
          <button class="btn-edit" data-slug="${escapeHtml(post.slug)}">编辑</button>
          <button class="btn-delete" data-slug="${escapeHtml(post.slug)}" data-title="${escapeHtml(post.title)}">删除</button>
        </td>
      </tr>
    `).join('');

    updatePaginationState();
    bindActionButtons();
  }

  // ===== 更新分页状态 =====
  function updatePaginationState() {
    currentPageSpan.textContent = String(currentPage);
    totalPagesSpan.textContent = String(totalPages);
    prevBtn.disabled = currentPage === 1;
    nextBtn.disabled = currentPage === totalPages;
  }

  // ===== 绑定事件 =====
  function bindEvents() {
    createBtn.addEventListener('click', () => {
      window.location.href = '/admin/posts/new';
    });

    // Tabs
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        currentStatus = target.dataset.status as any;
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        target.classList.add('active');
        applyFilter();
      });
    });

    // 分页
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderPosts();
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        renderPosts();
      }
    });
  }

  // ===== 绑定操作按钮 =====
  function bindActionButtons() {
    document.querySelectorAll('.btn-edit').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const slug = (e.target as HTMLElement).dataset.slug;
        window.location.href = `/admin/posts/edit/${slug}`;
      });
    });

    document.querySelectorAll('.btn-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const slug = target.dataset.slug || '';
        const title = target.dataset.title || '';
        handleDelete(slug, title);
      });
    });
  }

  // ===== 删除文章 =====
  async function handleDelete(slug: string, title: string) {
    if (!confirm(`确认删除文章《${title}》？\n\n此操作不可撤销。`)) return;

    try {
      await adminApi.posts.delete(slug);
      await loadPosts();
    } catch (err: any) {
      alert(err.message || '删除失败');
    }
  }

  // ===== 工具函数 =====
  function formatDate(dateStr: string): string {
    const date = new Date(dateStr);
    return date.toLocaleDateString('zh-CN', {
      year: 'numeric',
      month: '2-digit',
      day: '2-digit'
    });
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  init();
</script>

<style lang="scss">
  @use 'sass:color';

  // 操作栏
  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: $spacing-lg;
  }

  .tabs {
    display: flex;
    gap: $spacing-xs;

    .tab {
      padding: $spacing-xs $spacing-md;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text-light;
      background: transparent;
      border: none;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-fast $ease-gentle;

      &:hover {
        color: $lian-text;
        background: rgba($lian-blue, 0.05);
      }

      &.active {
        color: var(--color-on-primary);
        background: var(--gradient-primary);
      }
    }
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: $spacing-sm $spacing-lg;
    font-size: $font-size-sm;
    font-weight: $font-weight-medium;
    color: var(--color-on-primary);
    background: var(--gradient-primary);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;

    &:hover {
      transform: translateY(-1px);
      box-shadow: $shadow-blue;
    }

    span {
      font-size: $font-size-xl;
    }
  }

  // 表格容器
  .posts-table {
    background: $lian-white;
    border-radius: $radius-md;
    box-shadow: $shadow-sm;
    overflow: hidden;
  }

  // 加载/空状态
  .loading,
  .empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: $spacing-xxl;
    color: $lian-text-muted;

    p {
      margin: $spacing-sm 0 0;
      font-size: $font-size-sm;
      text-align: center;
    }
  }

  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid rgba($lian-border, 0.3);
    border-top-color: $lian-blue;
    border-right-color: $lian-pink;
    border-radius: 50%;
    animation: spin 600ms linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  // 表格
  table {
    width: 100%;
    border-collapse: collapse;

    thead {
      background: var(--gradient-primary-light);
      border-bottom: 2px solid var(--color-primary-alpha-10);

      th {
        padding: $spacing-md $spacing-lg;
        font-size: $font-size-sm;
        font-weight: $font-weight-semibold;
        color: $lian-text;
        text-align: left;
      }
    }

    tbody {
      tr {
        border-bottom: 1px solid $lian-divider;
        transition: all $transition-base $ease-gentle;

        &:hover {
          background: var(--gradient-primary-subtle);
          transform: scale(1.01);
        }
      }

      td {
        padding: $spacing-md $spacing-lg;
        font-size: $font-size-sm;
        color: $lian-text;
      }
    }
  }

  .post-title {
    a {
      color: $lian-text;
      text-decoration: none;
      font-weight: $font-weight-medium;

      &:hover {
        color: $lian-blue;
      }
    }
  }

  .theme-badge {
    display: inline-block;
    padding: $spacing-xs $spacing-sm;
    font-size: $font-size-xs;
    font-weight: $font-weight-semibold;
    color: $lian-blue;
    background: var(--bg-primary-soft);
    border-radius: 12px;
    border: 1px solid var(--color-primary-alpha-20);
    transition: all $transition-fast $ease-gentle;

    &:hover {
      background: var(--bg-primary-soft-hover);
      transform: scale(1.05);
    }
  }

  .status-badge {
    display: inline-block;
    padding: 4px 10px;
    font-size: $font-size-xs;
    font-weight: $font-weight-medium;
    border-radius: 10px;

    &.status-published {
      background: rgba($lian-success, 0.15);
      color: color.adjust($lian-success, $lightness: -10%);
    }

    &.status-draft {
      background: rgba($lian-warning, 0.15);
      color: color.adjust($lian-warning, $lightness: -10%);
    }
  }

  .text-center {
    text-align: center;
    font-family: $font-family-code;
  }

  .text-muted {
    color: $lian-text-muted;
    font-size: $font-size-xs;
  }

  // 操作按钮
  .actions {
    display: flex;
    gap: $spacing-xs;

    button {
      padding: $spacing-xs $spacing-sm;
      font-size: $font-size-xs;
      font-weight: $font-weight-medium;
      border: none;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-base $ease-gentle;
    }

    .btn-edit {
      background: var(--gradient-primary);
      color: var(--color-on-primary);
      box-shadow: 0 2px 8px var(--color-primary-alpha-20);

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px var(--color-primary-alpha-30);
      }
    }

    .btn-delete {
      background: var(--gradient-error);
      color: var(--color-on-primary);
      box-shadow: 0 2px 8px var(--color-error-alpha-20);

      &:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px var(--color-error-alpha-30);
      }
    }
  }

  // 分页
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: $spacing-md;
    padding: $spacing-lg;

    .page-btn {
      padding: $spacing-xs $spacing-md;
      font-size: $font-size-sm;
      color: $lian-text;
      background: $lian-white;
      border: 1px solid $lian-border;
      border-radius: $radius-sm;
      cursor: pointer;
      transition: all $transition-fast $ease-gentle;

      &:hover:not(:disabled) {
        background: $lian-bg;
        border-color: $lian-blue;
        color: $lian-blue;
      }

      &:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }
    }

    .page-info {
      font-size: $font-size-sm;
      color: $lian-text-light;
    }
  }
</style>
