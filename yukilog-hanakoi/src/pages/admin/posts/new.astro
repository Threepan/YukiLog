---
// ================================
// 创建文章页
// ================================

export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="新建文章" activeMenu="posts">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vditor@3.11.2/dist/index.css" />
  <script is:inline src="https://cdn.jsdelivr.net/npm/vditor@3.11.2/dist/index.min.js"></script>

  <form id="post-form" class="post-form">
    <!-- 基础信息 -->
    <div class="form-section">
      <h3 class="section-title">基础信息</h3>
      <div class="form-row">
        <div class="form-group">
          <label>文章标题 *</label>
          <input type="text" id="title" required placeholder="例如：使用 Rust 构建博客后端" />
        </div>
        <div class="form-group">
          <label>URL Slug *</label>
          <input type="text" id="slug" required placeholder="自动生成，可手动修改" />
          <span class="form-hint">URL 路径：/posts/<span id="slug-preview" class="slug-preview">...</span></span>
        </div>
      </div>

      <div class="form-group">
        <label>文章摘要</label>
        <textarea id="summary" rows="3" placeholder="简短介绍文章内容（可选，若不填写将自动从正文提取）"></textarea>
      </div>

      <div class="form-group">
        <label>封面图 URL</label>
        <input type="url" id="cover_image" placeholder="https://example.com/cover.jpg" />
      </div>
    </div>

    <!-- 分类与标签 -->
    <div class="form-section">
      <h3 class="section-title">分类与标签</h3>
      <div class="form-row">
        <div class="form-group">
          <label>主题分类</label>
          <select id="theme_slug">
            <option value="">无主题</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>标签</label>
        <div id="tag-selector" class="tag-selector">
          <div id="tag-checkboxes" class="tag-checkboxes"></div>
        </div>
        <span class="form-hint">已选择 <span id="selected-tag-count">0</span> 个标签</span>
      </div>

      <div class="form-group">
        <label class="featured-toggle-label">
          <input type="checkbox" id="is_featured" />
          <span>设为精选文章</span>
        </label>
        <span class="form-hint">精选文章将显示在主页文章列表中</span>
      </div>
    </div>

    <!-- 文章内容 -->
    <div class="form-section">
      <h3 class="section-title">文章内容 *</h3>
      <div id="vditor-editor"></div>
    </div>

    <!-- 操作按钮 -->
    <div class="form-actions">
      <button type="button" id="cancel-btn" class="btn-secondary">取消</button>
      <button type="button" id="save-draft" class="btn-draft">保存草稿</button>
      <button type="submit" id="publish-btn" class="btn-primary">发布文章</button>
    </div>
  </form>
</AdminLayout>

<script>
  import { adminApi, themesApi, tagsApi } from '../../../lib/api';
  import { generateSlug, isValidSlug } from '../../../lib/slugify';
  import type { Theme, Tag } from '../../../types/api';

  // ===== 状态管理 =====
  let editor: any;
  let themes: Theme[] = [];
  let tags: Tag[] = [];
  let selectedTagSlugs: Set<string> = new Set();
  let slugManuallyEdited = false;

  // ===== DOM 元素 =====
  const form = document.getElementById('post-form') as HTMLFormElement;
  const titleInput = document.getElementById('title') as HTMLInputElement;
  const slugInput = document.getElementById('slug') as HTMLInputElement;
  const slugPreview = document.getElementById('slug-preview')!;
  const summaryInput = document.getElementById('summary') as HTMLTextAreaElement;
  const coverImageInput = document.getElementById('cover_image') as HTMLInputElement;
  const themeSelect = document.getElementById('theme_slug') as HTMLSelectElement;
  const tagCheckboxesDiv = document.getElementById('tag-checkboxes')!;
  const selectedTagCount = document.getElementById('selected-tag-count')!;
  const isFeaturedCheckbox = document.getElementById('is_featured') as HTMLInputElement;
  
  const cancelBtn = document.getElementById('cancel-btn')!;
  const saveDraftBtn = document.getElementById('save-draft') as HTMLButtonElement;
  const publishBtn = document.getElementById('publish-btn') as HTMLButtonElement;

  // ===== 初始化 =====
  async function init() {
    // 显示加载提示
    publishBtn.disabled = true;
    publishBtn.textContent = '加载中...';

    try {
      // 等待 Vditor 从 CDN 加载
      await waitForVditor();

      // 并行加载主题和标签（允许失败）
      try {
        [themes, tags] = await Promise.all([
          themesApi.list(),
          tagsApi.list()
        ]);
      } catch (apiErr) {
        themes = [];
        tags = [];
      }

      renderThemeOptions();
      renderTagCheckboxes();

      // 初始化 Vditor
      initVditor();

      // 绑定事件
      bindEvents();

      publishBtn.disabled = false;
      publishBtn.textContent = '发布文章';


    } catch (err: any) {
      alert('初始化失败：' + (err.message || '未知错误'));
      publishBtn.textContent = '初始化失败';
    }
  }

  // ===== 等待 Vditor 加载 =====
  function waitForVditor(): Promise<void> {
    return new Promise((resolve, reject) => {
      if (typeof (window as any).Vditor !== 'undefined') {
        resolve();
        return;
      }
      
      let attempts = 0;
      const maxAttempts = 50;
      const interval = setInterval(() => {
        attempts++;
        if (typeof (window as any).Vditor !== 'undefined') {
          clearInterval(interval);
          resolve();
        } else if (attempts >= maxAttempts) {
          clearInterval(interval);
          reject(new Error('Vditor 加载超时'));
        }
      }, 100);
    });
  }

  // ===== 初始化 Vditor =====
  function initVditor() {
    const Vditor = (window as any).Vditor;
    editor = new Vditor('vditor-editor', {
      mode: 'ir',  // 即时渲染模式
      height: 600,
      placeholder: '开始写作吧...',
      theme: 'classic',
      counter: {
        enable: true,
        type: 'markdown'
      },
      cache: {
        enable: false  // 后台禁用缓存
      },
      toolbar: [
        'headings', 'bold', 'italic', 'strike', '|',
        'quote', 'code', 'line', '|',
        'list', 'ordered-list', 'check', '|',
        'link', 'table', '|',
        'undo', 'redo', '|',
        'preview', 'fullscreen'
      ],
      upload: {
        handler: () => {
          alert('请使用图床外链 URL（例如：![alt](https://example.com/image.jpg)）');
          return null;
        }
      }
    });
  }

  // ===== 渲染主题选项 =====
  function renderThemeOptions() {
    const options = themes.map(theme => 
      `<option value="${escapeHtml(theme.slug)}">${escapeHtml(theme.name)}</option>`
    ).join('');
    themeSelect.innerHTML = '<option value="">无主题</option>' + options;
  }

  // ===== 渲染标签复选框 =====
  function renderTagCheckboxes() {
    tagCheckboxesDiv.innerHTML = tags.map(tag => `
      <label class="tag-checkbox-label">
        <input type="checkbox" class="tag-checkbox" value="${escapeHtml(tag.slug)}" />
        <span class="tag-name">#${escapeHtml(tag.name)}</span>
      </label>
    `).join('');

    // 绑定复选框事件
    document.querySelectorAll('.tag-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', (e) => {
        const slug = (e.target as HTMLInputElement).value;
        if ((e.target as HTMLInputElement).checked) {
          selectedTagSlugs.add(slug);
        } else {
          selectedTagSlugs.delete(slug);
        }
        updateSelectedTagCount();
      });
    });
  }

  // ===== 更新选中标签计数 =====
  function updateSelectedTagCount() {
    selectedTagCount.textContent = String(selectedTagSlugs.size);
  }

  // ===== 绑定事件 =====
  function bindEvents() {
    // 标题自动生成 slug
    titleInput.addEventListener('input', () => {
      if (!slugManuallyEdited) {
        slugInput.value = generateSlug(titleInput.value);
        updateSlugPreview();
      }
    });

    // slug 手动编辑标记
    slugInput.addEventListener('input', () => {
      slugManuallyEdited = true;
      updateSlugPreview();
    });

    // 取消按钮
    cancelBtn.addEventListener('click', () => {
      if (confirm('确认取消？未保存的内容将丢失。')) {
        window.location.href = '/admin/posts';
      }
    });

    // 保存草稿
    saveDraftBtn.addEventListener('click', () => handleSubmit('draft'));

    // 发布文章
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSubmit('published');
    });
  }

  // ===== 更新 slug 预览 =====
  function updateSlugPreview() {
    slugPreview.textContent = slugInput.value || '...';
  }

  // ===== 提交表单 =====
  async function handleSubmit(status: 'draft' | 'published') {
    const btn = status === 'published' ? publishBtn : saveDraftBtn;
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = status === 'published' ? '发布中...' : '保存中...';

    // 收集数据
    const title = titleInput.value.trim();
    const slug = slugInput.value.trim();
    const content = editor.getValue();
    const summary = summaryInput.value.trim() || null;
    const cover_image = coverImageInput.value.trim() || null;
    const theme_slug = themeSelect.value || null;
    const tag_slugs = Array.from(selectedTagSlugs);

    // 校验
    if (!title) {
      alert('请输入文章标题');
      btn.disabled = false;
      btn.textContent = originalText;
      return;
    }

    if (!slug) {
      alert('请输入 URL Slug');
      btn.disabled = false;
      btn.textContent = originalText;
      return;
    }

    if (!isValidSlug(slug)) {
      alert('Slug 格式不正确，仅支持小写字母、数字和连字符');
      btn.disabled = false;
      btn.textContent = originalText;
      return;
    }

    if (!content.trim()) {
      alert('请输入文章内容');
      btn.disabled = false;
      btn.textContent = originalText;
      return;
    }

    // 提交
    try {
      const post = await adminApi.posts.create({
        title,
        slug,
        content,
        summary,
        cover_image,
        theme_slug,
        tag_slugs,
        status,
        is_featured: isFeaturedCheckbox.checked,
      });

      alert(`文章「${post.title}」${status === 'published' ? '发布' : '保存草稿'}成功！`);
      window.location.href = '/admin/posts';
    } catch (err: any) {
      alert(err.message || '操作失败');
      btn.disabled = false;
      btn.textContent = originalText;
    }
  }

  // ===== 工具函数 =====
  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  init();
</script>

<style>
  @use 'sass:color';

  .post-form {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* 表单区块 */
  .form-section {
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    margin-bottom: var(--spacing-lg);
    box-shadow: var(--shadow-sm);

    .section-title {
      margin: 0 0 var(--spacing-md);
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
      color: var(--color-text);
      padding-bottom: var(--spacing-sm);
      border-bottom: 2px solid var(--color-divider);
    }
  }

  /* 表单行 */
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);

    @media (max-width: 768px) {
      grid-template-columns: 1fr;
    }
  }

  /* 表单组 */
  .form-group {
    margin-bottom: var(--spacing-md);

    &:last-child {
      margin-bottom: 0;
    }

    label {
      display: block;
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      color: var(--color-text);
      margin-bottom: var(--spacing-xs);
    }

    input,
    select,
    textarea {
      width: 100%;
      padding: var(--spacing-sm) var(--spacing-md);
      font-size: var(--font-size-base);
      color: var(--color-text);
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      font-family: var(--font-family-base);
      transition: all var(--transition-fast) var(--ease-gentle);

      &:focus {
        outline: none;
        border-color: var(--color-blue);
        box-shadow: 0 0 0 3px var(--color-primary-alpha-10);
      }

      &::placeholder {
        color: var(--color-text-muted);
      }
    }

    textarea {
      resize: vertical;
      min-height: 80px;
      line-height: var(--line-height-base);
    }

    .form-hint {
      display: block;
      margin-top: 4px;
      font-size: var(--font-size-xs);
      color: var(--color-text-muted);

      .slug-preview {
        color: var(--color-blue);
        font-family: var(--font-family-code);
        font-weight: var(--font-weight-medium);
      }
    }
  }

  /* 标签选择器 */
  .tag-selector {
    .tag-checkboxes {
      display: flex;
      flex-wrap: wrap;
      gap: var(--spacing-xs);
      padding: var(--spacing-sm);
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      max-height: 200px;
      overflow-y: auto;
    }

    .tag-checkbox-label {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 4px 10px;
      background: var(--color-white);
      border: 1px solid var(--color-border);
      border-radius: 12px;
      cursor: pointer;
      transition: all var(--transition-fast) var(--ease-gentle);

      &:hover {
        border-color: var(--color-blue);
        background: var(--bg-primary-subtle);
      }

      input[type="checkbox"] {
        width: auto;
        margin: 0;
        cursor: pointer;
      }

      .tag-name {
        font-size: var(--font-size-xs);
        color: var(--color-text-light);
        user-select: none;
      }

      &:has(input:checked) {
        background: var(--bg-secondary-subtle);
        border-color: var(--color-pink);

        .tag-name {
          color: var(--color-pink);
          font-weight: var(--font-weight-medium);
        }
      }
    }
  }

  /* 精选开关 */
  .featured-toggle-label {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-sm);
    cursor: pointer;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);

    input[type="checkbox"] {
      width: 16px;
      height: 16px;
      cursor: pointer;
      accent-color: var(--color-pink);
    }
  }

  /* Vditor 容器 */
  #vditor-editor {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;

    :global(.vditor) {
      border: none;
    }
  }

  /* 操作按钮 */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-sm);
    padding: var(--spacing-lg);
    background: var(--color-white);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);

    button {
      padding: var(--spacing-sm) var(--spacing-xl);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-medium);
      border: none;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: all var(--transition-fast) var(--ease-gentle);

      &:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
    }

    .btn-secondary {
      color: var(--color-text-light);
      background: var(--color-bg);

      &:hover:not(:disabled) {
        background: var(--color-bg-d5);
      }
    }

    .btn-draft {
      color: var(--color-warning-d10);
      background: var(--bg-warning-subtle);

      &:hover:not(:disabled) {
        background: var(--bg-warning-soft);
      }
    }

    .btn-primary {
      color: var(--color-on-primary);
      background: var(--gradient-primary);

      &:hover:not(:disabled) {
        transform: translateY(-1px);
        box-shadow: var(--shadow-blue);
      }
    }
  }
</style>
