---
// ================================
// 管理后台首页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { siteConfig } from '../../lib/config';
---

<AdminLayout title="管理后台" activeMenu="posts">
  <div class="dashboard">
    <div class="welcome">
      <h2>欢迎使用 {siteConfig.name} 管理后台</h2>
      <p>请从左侧菜单选择功能模块，开始管理你的博客内容</p>
    </div>
    
    <div class="quick-links">
      <a href="/admin/posts" class="quick-link-card">
        <div class="card-icon">📝</div>
        <h3>文章管理</h3>
        <p>管理所有文章、草稿和发布状态</p>
      </a>
      
      <a href="/admin/comments" class="quick-link-card">
        <div class="card-icon">💬</div>
        <h3>评论审核</h3>
        <p>审核、编辑和删除评论</p>
      </a>
      
      <a href="/admin/themes" class="quick-link-card">
        <div class="card-icon">🎨</div>
        <h3>主题管理</h3>
        <p>创建和管理文章主题分类</p>
      </a>
      
      <a href="/admin/tags" class="quick-link-card">
        <div class="card-icon">🏷️</div>
        <h3>标签管理</h3>
        <p>创建、编辑和合并标签</p>
      </a>
      
      <a href="/admin/links" class="quick-link-card">
        <div class="card-icon">🔗</div>
        <h3>友链管理</h3>
        <p>审核和管理友情链接</p>
      </a>
      
      <a href="/admin/notes" class="quick-link-card">
        <div class="card-icon">📓</div>
        <h3>随记管理</h3>
        <p>管理随记、草稿和发布状态</p>
      </a>
    </div>
  </div>
</AdminLayout>

<style>
  .dashboard {
    /* 移除max-width限制，让内容充分利用admin-content空间 */
    width: 100%;
  }

  .welcome {
    margin-bottom: var(--spacing-xxl);
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);

    h2 {
      font-size: var(--font-size-2xl);
      font-weight: var(--font-weight-bold);
      background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      margin: 0 0 var(--spacing-sm);
    }

    p {
      font-size: var(--font-size-base);
      color: var(--color-text-light);
      margin: 0;
    }
  }

  .quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-lg);
  }

  .quick-link-card {
    padding: var(--spacing-xl);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-blue);
    text-decoration: none;
    display: block;
    position: relative;
    overflow: hidden;
    transition: all var(--transition-base) var(--ease-gentle);

    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--color-blue) 0%, var(--color-pink) 100%);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transition-base) var(--ease-gentle);
    }

    &:hover {
      box-shadow: var(--shadow-blue-offset-hover);
      transform: translateY(-8px);

      &::before {
        transform: scaleX(1);
      }

      .card-icon {
        transform: scale(1.1) rotate(5deg);
      }
    }

    .card-icon {
      font-size: 2.5rem;
      margin-bottom: var(--spacing-md);
      transition: transform var(--transition-base) var(--ease-gentle);
      display: inline-block;
    }

    h3 {
      font-size: var(--font-size-lg);
      font-weight: var(--font-weight-semibold);
      color: var(--color-blue);
      margin: 0 0 var(--spacing-xs);
      transition: color var(--transition-fast) var(--ease-gentle);
    }

    p {
      font-size: var(--font-size-sm);
      color: var(--color-text-light);
      margin: 0;
      line-height: 1.6;
    }

    &:hover h3 {
      background: linear-gradient(135deg, var(--color-blue) 0%, var(--color-pink) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  @media (max-width: 640px) {
    .quick-links {
      grid-template-columns: 1fr;
    }
  }
</style>
