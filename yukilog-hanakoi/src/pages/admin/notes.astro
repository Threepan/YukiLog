---
// ================================
// 随记管理页
// 列表 + 创建/编辑弹窗 + 状态筛选 + 分页
// ================================

export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="随记管理" activeMenu="notes">
  <!-- 操作栏 -->
  <div class="action-bar">
    <div class="tabs">
      <button class="tab active" data-status="all">全部</button>
      <button class="tab" data-status="published">已发布</button>
      <button class="tab" data-status="draft">草稿</button>
      <button class="tab" data-status="private">私密</button>
    </div>
    <button class="btn-create" id="create-btn">
      <span>+</span> 新建随记
    </button>
  </div>

  <!-- 加载状态 -->
  <div id="loading" class="loading">
    <div class="spinner"></div>
    <p>加载中...</p>
  </div>

  <div id="empty" class="empty" style="display:none">
    <p>暂无随记</p>
  </div>

  <div id="error-state" class="error-state" style="display:none">
    <p>加载失败，请稍后重试</p>
    <button class="btn-retry" id="retry-btn">重新加载</button>
  </div>

  <!-- 随记列表 -->
  <div id="notes-list" class="notes-list" style="display:none"></div>

  <!-- 分页 -->
  <div id="pagination" class="pagination" style="display:none">
    <button id="prev-btn" class="page-btn" disabled>上一页</button>
    <span class="page-info">
      第 <span id="current-page">1</span> / <span id="total-pages">1</span> 页
    </span>
    <button id="next-btn" class="page-btn" disabled>下一页</button>
  </div>

  <!-- 创建/编辑弹窗 -->
  <div id="edit-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card">
      <div class="modal-header">
        <h3 id="modal-title">新建随记</h3>
        <button class="modal-close" id="modal-close-btn">×</button>
      </div>
      <div class="modal-body">
        <form id="edit-form">
          <div class="form-group">
            <label>内容 *（支持 Markdown）</label>
            <textarea id="edit-content" rows="12" required placeholder="写点什么..."></textarea>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label>心情</label>
              <select id="edit-mood">
                <option value="">不设置</option>
                <option value="happy">😊 开心</option>
                <option value="thinking">🤔 思考</option>
                <option value="sad">😢 难过</option>
                <option value="angry">😤 生气</option>
                <option value="calm">😌 平静</option>
                <option value="excited">🤩 兴奋</option>
                <option value="tired">😴 疲惫</option>
                <option value="nostalgic">🥹 怀旧</option>
              </select>
            </div>
            <div class="form-group">
              <label>状态</label>
              <select id="edit-status">
                <option value="published">已发布</option>
                <option value="draft">草稿</option>
                <option value="private">私密</option>
              </select>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="modal-cancel-btn">取消</button>
        <button type="submit" form="edit-form" class="btn-primary" id="modal-save-btn">保存</button>
      </div>
    </div>
  </div>

  <!-- 删除确认弹窗 -->
  <div id="delete-modal" class="modal">
    <div class="modal-backdrop"></div>
    <div class="modal-card modal-card-sm">
      <div class="modal-header">
        <h3>确认删除</h3>
      </div>
      <div class="modal-body">
        <p>确定要删除这条随记吗？此操作不可撤回。</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn-secondary" id="delete-cancel-btn">取消</button>
        <button type="button" class="btn-danger" id="delete-confirm-btn">删除</button>
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { adminApi } from '../../lib/api';
  import type { Note } from '../../types/api';

  // ===== 状态 =====
  let currentStatus: 'all' | 'published' | 'draft' | 'private' = 'all';
  let currentPage = 1;
  let totalPages = 1;
  let editingNote: Note | null = null;
  let deletingNoteId: number | null = null;
  const PAGE_SIZE = 15;

  // 心情标签
  const moodMap: Record<string, string> = {
    happy: "😊 开心",
    thinking: "🤔 思考",
    sad: "😢 难过",
    angry: "😤 生气",
    calm: "😌 平静",
    excited: "🤩 兴奋",
    tired: "😴 疲惫",
    nostalgic: "🥹 怀旧",
  };

  const statusMap: Record<string, { label: string; class: string }> = {
    published: { label: "已发布", class: "status-published" },
    draft: { label: "草稿", class: "status-draft" },
    private: { label: "私密", class: "status-private" },
  };

  document.addEventListener('astro:page-load', () => {
    const notesList = document.getElementById('notes-list');
    if (!notesList) return;

    // DOM 元素
    const loading = document.getElementById('loading')!;
    const empty = document.getElementById('empty')!;
    const errorState = document.getElementById('error-state')!;
    const pagination = document.getElementById('pagination')!;
    const prevBtn = document.getElementById('prev-btn') as HTMLButtonElement;
    const nextBtn = document.getElementById('next-btn') as HTMLButtonElement;
    const currentPageSpan = document.getElementById('current-page')!;
    const totalPagesSpan = document.getElementById('total-pages')!;
    const createBtn = document.getElementById('create-btn')!;

    const editModal = document.getElementById('edit-modal')!;
    const modalTitle = document.getElementById('modal-title')!;
    const editForm = document.getElementById('edit-form') as HTMLFormElement;
    const editContent = document.getElementById('edit-content') as HTMLTextAreaElement;
    const editMood = document.getElementById('edit-mood') as HTMLSelectElement;
    const editStatus = document.getElementById('edit-status') as HTMLSelectElement;

    const deleteModal = document.getElementById('delete-modal')!;

    // 重置
    currentStatus = 'all';
    currentPage = 1;
    editingNote = null;
    deletingNoteId = null;

    // ===== 初始化 =====
    async function init() {
      await loadNotes();
      bindEvents();
    }

    // ===== 加载随记列表 =====
    async function loadNotes() {
      loading.style.display = '';
      notesList.style.display = 'none';
      empty.style.display = 'none';
      errorState.style.display = 'none';
      pagination.style.display = 'none';

      try {
        const params: any = { page: currentPage, page_size: PAGE_SIZE };
        if (currentStatus !== 'all') params.status = currentStatus;

        const response = await adminApi.notes.list(params);
        totalPages = response.total_pages;

        loading.style.display = 'none';

        if (response.items.length === 0) {
          empty.style.display = '';
          return;
        }

        renderNotes(response.items);
        notesList.style.display = '';

        // 分页
        if (totalPages > 1) {
          pagination.style.display = '';
          currentPageSpan.textContent = String(currentPage);
          totalPagesSpan.textContent = String(totalPages);
          prevBtn.disabled = currentPage <= 1;
          nextBtn.disabled = currentPage >= totalPages;
        }
      } catch (err) {
        console.error('加载随记失败:', err);
        loading.style.display = 'none';
        errorState.style.display = '';
      }
    }

    // ===== 渲染列表 =====
    function renderNotes(notes: Note[]) {
      notesList.innerHTML = notes.map(note => {
        const preview = note.content.length > 100
          ? note.content.slice(0, 100) + '…'
          : note.content;
        const mood = note.mood ? moodMap[note.mood] || note.mood : '';
        const status = statusMap[note.status] || { label: note.status, class: '' };
        const time = new Date(note.created_at).toLocaleDateString('zh-CN', {
          year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit',
        });

        return `
          <div class="note-row" data-id="${note.id}">
            <div class="note-info">
              <div class="note-preview">${escapeHtml(preview)}</div>
              <div class="note-row-meta">
                <time>${time}</time>
                ${mood ? `<span class="note-row-mood">${mood}</span>` : ''}
                <span class="note-status ${status.class}">${status.label}</span>
              </div>
            </div>
            <div class="note-actions">
              <button class="btn-icon btn-edit" data-id="${note.id}" title="编辑">✏️</button>
              <button class="btn-icon btn-delete" data-id="${note.id}" title="删除">🗑️</button>
            </div>
          </div>
        `;
      }).join('');
    }

    function escapeHtml(text: string): string {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ===== 事件绑定 =====
    function bindEvents() {
      // Tab 切换
      document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
          document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
          tab.classList.add('active');
          currentStatus = (tab as HTMLElement).dataset.status as any;
          currentPage = 1;
          loadNotes();
        });
      });

      // 分页
      prevBtn.addEventListener('click', () => {
        if (currentPage > 1) { currentPage--; loadNotes(); }
      });
      nextBtn.addEventListener('click', () => {
        if (currentPage < totalPages) { currentPage++; loadNotes(); }
      });

      // 新建
      createBtn.addEventListener('click', () => openEditModal(null));

      // 列表事件委托
      notesList.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;
        const id = Number(target.dataset.id);
        if (!id) return;

        if (target.classList.contains('btn-edit')) {
          // 获取实际数据编辑
          try {
            const response = await adminApi.notes.list({ page: 1, page_size: 1 });
            // 从当前列表中找
            const row = notesList.querySelector(`.note-row[data-id="${id}"]`);
            if (row) {
              // 重新获取列表以找到完整 note 对象
              const all = await adminApi.notes.list({ page: 1, page_size: 999 });
              const note = all.items.find((n: Note) => n.id === id);
              if (note) openEditModal(note);
            }
          } catch (err) {
            console.error('获取随记失败:', err);
          }
        }

        if (target.classList.contains('btn-delete')) {
          deletingNoteId = id;
          deleteModal.classList.add('active');
        }
      });

      // 弹窗 - 关闭
      document.getElementById('modal-close-btn')!.addEventListener('click', closeEditModal);
      document.getElementById('modal-cancel-btn')!.addEventListener('click', closeEditModal);
      editModal.querySelector('.modal-backdrop')!.addEventListener('click', closeEditModal);

      // 弹窗 - 保存
      editForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const saveBtn = document.getElementById('modal-save-btn') as HTMLButtonElement;
        saveBtn.disabled = true;
        saveBtn.textContent = '保存中...';

        try {
          const content = editContent.value.trim();
          const mood = editMood.value || null;
          const status = editStatus.value;

          if (editingNote) {
            await adminApi.notes.update(editingNote.id, { content, mood, status });
          } else {
            await adminApi.notes.create({ content, mood, status });
          }

          closeEditModal();
          await loadNotes();
        } catch (err) {
          console.error('保存失败:', err);
          alert('保存失败，请重试');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = '保存';
        }
      });

      // 删除确认
      document.getElementById('delete-confirm-btn')!.addEventListener('click', async () => {
        if (deletingNoteId === null) return;
        try {
          await adminApi.notes.delete(deletingNoteId);
          deleteModal.classList.remove('active');
          deletingNoteId = null;
          await loadNotes();
        } catch (err) {
          console.error('删除失败:', err);
          alert('删除失败，请重试');
        }
      });
      document.getElementById('delete-cancel-btn')!.addEventListener('click', () => {
        deleteModal.classList.remove('active');
        deletingNoteId = null;
      });
      deleteModal.querySelector('.modal-backdrop')!.addEventListener('click', () => {
        deleteModal.classList.remove('active');
        deletingNoteId = null;
      });

      // 重试
      document.getElementById('retry-btn')!.addEventListener('click', loadNotes);
    }

    // ===== 弹窗操作 =====
    function openEditModal(note: Note | null) {
      editingNote = note;
      modalTitle.textContent = note ? '编辑随记' : '新建随记';
      editContent.value = note?.content || '';
      editMood.value = note?.mood || '';
      editStatus.value = note?.status || 'published';
      editModal.classList.add('active');
      editContent.focus();
    }

    function closeEditModal() {
      editModal.classList.remove('active');
      editingNote = null;
      (document.getElementById('edit-form') as HTMLFormElement).reset();
    }

    init();
  });
</script>

<style>
  /* 操作栏 */
  .action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    flex-wrap: wrap;
    gap: var(--spacing-md);
  }

  .tabs {
    display: flex;
    gap: var(--spacing-xs);
  }

  .tab {
    padding: 6px 16px;
    border: none;
    background: var(--color-white);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
    cursor: pointer;
    transition: all 200ms var(--ease-gentle);

    &:hover {
      background: var(--color-bg);
    }

    &.active {
      background: var(--color-blue);
      color: white;
    }
  }

  .btn-create {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 8px 18px;
    background: linear-gradient(135deg, var(--color-blue), var(--color-pink));
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: opacity 200ms;

    &:hover { opacity: 0.9; }
  }

  /* 加载/空/错误 */
  .loading, .empty, .error-state {
    text-align: center;
    padding: var(--spacing-xxl);
    color: var(--color-text-muted);
  }

  .spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-blue);
    border-radius: 50%;
    animation: spin 800ms linear infinite;
    margin: 0 auto var(--spacing-md);
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .btn-retry {
    margin-top: var(--spacing-md);
    padding: 6px 16px;
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  /* 列表 */
  .notes-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .note-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-white);
    border-radius: var(--radius-md);
    padding: var(--spacing-md) var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border);
    transition: box-shadow 200ms var(--ease-gentle);

    &:hover {
      box-shadow: var(--shadow-md);
    }
  }

  .note-info {
    flex: 1;
    min-width: 0;
  }

  .note-preview {
    font-size: var(--font-size-base);
    color: var(--color-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: var(--spacing-xs);
  }

  .note-row-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .note-row-mood {
    padding: 1px 6px;
    background: rgba(126, 182, 217, 0.1);
    border-radius: var(--radius-full);
  }

  .note-status {
    padding: 1px 8px;
    border-radius: var(--radius-full);
    font-size: 11px;
  }
  .status-published { background: rgba(76, 175, 80, 0.12); color: #4caf50; }
  .status-draft { background: rgba(255, 152, 0, 0.12); color: #ff9800; }
  .status-private { background: rgba(156, 39, 176, 0.12); color: #9c27b0; }

  .note-actions {
    display: flex;
    gap: var(--spacing-xs);
    flex-shrink: 0;
    margin-left: var(--spacing-md);
  }

  .btn-icon {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: 14px;
    transition: background 200ms;

    &:hover { background: var(--color-bg); }
  }

  /* 分页 */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-xl);
  }

  .page-btn {
    padding: 6px 14px;
    border: 1px solid var(--color-border);
    background: var(--color-white);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: all 200ms;

    &:hover:not(:disabled) { border-color: var(--color-blue); color: var(--color-blue); }
    &:disabled { opacity: 0.5; cursor: default; }
  }

  .page-info {
    font-size: var(--font-size-sm);
    color: var(--color-text-light);
  }

  /* 弹窗 */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms var(--ease-gentle);

    &.active {
      opacity: 1;
      pointer-events: auto;
    }
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
  }

  .modal-card {
    position: relative;
    width: 90%;
    max-width: 640px;
    max-height: 85vh;
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform: scale(0.95);
    transition: transform 300ms var(--ease-gentle);

    .active & { transform: scale(1); }
  }

  .modal-card-sm {
    max-width: 420px;
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-lg) var(--spacing-xl);
    border-bottom: 1px solid var(--color-divider);

    h3 { margin: 0; font-size: var(--font-size-lg); }
  }

  .modal-close {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    font-size: 18px;
    cursor: pointer;
    border-radius: var(--radius-md);
    color: var(--color-text-muted);

    &:hover { background: var(--color-bg); }
  }

  .modal-body {
    padding: var(--spacing-xl);
    overflow-y: auto;

    p { color: var(--color-text-light); margin: 0; }
  }

  .modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--spacing-sm);
    padding: var(--spacing-md) var(--spacing-xl);
    border-top: 1px solid var(--color-divider);
  }

  /* 表单 */
  .form-group {
    margin-bottom: var(--spacing-md);

    label {
      display: block;
      font-size: var(--font-size-sm);
      font-weight: 500;
      color: var(--color-text);
      margin-bottom: var(--spacing-xs);
    }

    input, textarea, select {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      font-size: var(--font-size-sm);
      font-family: inherit;
      background: var(--color-white);
      transition: border-color 200ms;

      &:focus {
        outline: none;
        border-color: var(--color-blue);
      }
    }

    textarea {
      resize: vertical;
      min-height: 200px;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      line-height: 1.6;
    }
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  .btn-primary {
    padding: 8px 20px;
    background: var(--color-blue);
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: opacity 200ms;

    &:hover { opacity: 0.9; }
    &:disabled { opacity: 0.6; cursor: default; }
  }

  .btn-secondary {
    padding: 8px 20px;
    background: var(--color-white);
    color: var(--color-text-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: all 200ms;

    &:hover { border-color: var(--color-text-muted); }
  }

  .btn-danger {
    padding: 8px 20px;
    background: #e74c3c;
    color: white;
    border: none;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    cursor: pointer;
    transition: opacity 200ms;

    &:hover { opacity: 0.9; }
  }
</style>
