---
// ================================
// 管理员登录页（SSR 动态渲染）
// ================================

export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../lib/config';
---

<BaseLayout title={`管理员登录 - ${siteConfig.name}`}>
  <div class="login-container">
    <div class="login-card">
      <h1>{siteConfig.name} 管理后台</h1>
      
      <form id="login-form">
        <div class="form-group">
          <label for="username">用户名</label>
          <input 
            type="text" 
            id="username" 
            required 
            autocomplete="username"
            placeholder="请输入用户名"
          />
        </div>
        
        <div class="form-group">
          <label for="password">密码</label>
          <input 
            type="password" 
            id="password" 
            required 
            autocomplete="current-password"
            placeholder="请输入密码"
          />
        </div>
        
        <div id="error-message" class="error-message"></div>
        
        <button type="submit" id="submit-btn" class="submit-btn">
          登录
        </button>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  import { authApi } from '../../lib/api';
  import { setToken, isAuthenticated } from '../../lib/auth';

  // 已登录自动跳转
  if (isAuthenticated()) {
    window.location.href = '/admin';
  }

  const form = document.getElementById('login-form') as HTMLFormElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const errorMsg = document.getElementById('error-message')!;

  // 正常登录
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const username = usernameInput.value.trim();
    const password = passwordInput.value;

    if (!username || !password) {
      showError('请输入用户名和密码');
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = '登录中...';
    errorMsg.textContent = '';

    try {
      const data = await authApi.login({ username, password });
      setToken(data.token, data.expires_in);
      
      // 登录成功跳转
      window.location.href = '/admin';
    } catch (err: any) {
      showError(err.message || '登录失败，请检查用户名和密码');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = '登录';
    }
  });

  function showError(msg: string) {
    errorMsg.textContent = msg;
    errorMsg.style.display = 'block';
  }
</script>

<style lang="scss">
  .login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-primary-light);
    padding: $spacing-lg;
  }

  .login-card {
    width: 100%;
    max-width: 420px;
    background: $lian-white;
    border-radius: $radius-lg;
    box-shadow: $shadow-md;
    padding: $spacing-xxl $spacing-xl;

    h1 {
      font-size: $font-size-2xl;
      font-weight: $font-weight-bold;
      color: $lian-text;
      text-align: center;
      margin: 0 0 $spacing-xl;
    }
  }

  .form-group {
    margin-bottom: $spacing-md;

    label {
      display: block;
      font-size: $font-size-sm;
      font-weight: $font-weight-medium;
      color: $lian-text;
      margin-bottom: $spacing-xs;
    }

    input {
      width: 100%;
      padding: $spacing-sm $spacing-md;
      font-size: $font-size-base;
      color: $lian-text;
      background: $lian-white;
      border: 1px solid $lian-border;
      border-radius: $radius-sm;
      transition: all $transition-fast $ease-gentle;

      &::placeholder {
        color: $lian-text-muted;
      }

      &:focus {
        outline: none;
        border-color: $lian-blue;
        box-shadow: 0 0 0 3px var(--color-primary-alpha-10);
      }
    }
  }

  .error-message {
    display: none;
    padding: $spacing-sm;
    margin-bottom: $spacing-md;
    font-size: $font-size-sm;
    color: $lian-error;
    background: var(--bg-error-subtle);
    border-radius: $radius-sm;
    text-align: center;
  }

  .submit-btn {
    width: 100%;
    padding: $spacing-sm $spacing-md;
    font-size: $font-size-base;
    font-weight: $font-weight-semibold;
    color: var(--color-on-primary);
    background: var(--gradient-primary);
    border: none;
    border-radius: $radius-sm;
    cursor: pointer;
    transition: all $transition-base $ease-gentle;

    &:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: $shadow-blue;
    }

    &:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  }

  @media (max-width: $container-sm) {
    .login-card {
      padding: $spacing-xl $spacing-lg;
    }
  }
</style>
