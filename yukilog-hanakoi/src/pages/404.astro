---
// ================================
// 404 Not Found 页面
// ================================

import BlogLayout from "../layouts/BlogLayout.astro";
import { contentConfig } from "../lib/config";

const e404 = contentConfig.pages.error404;
---

<BlogLayout title="404 - 页面未找到" description="你迷路了" stickyNav>
  <div class="error-page">
    <div class="error-content">
      <div class="error-icon">{e404.icon}</div>
      <h1 class="error-code">404</h1>
      <p class="error-title">{e404.title}</p>
      <p class="error-desc" set:html={e404.description.replace('\n', '<br />')} />
      <div class="error-actions">
        <a href="/" class="btn-primary">{e404.primaryButton}</a>
        <button onclick="history.back()" class="btn-secondary">{e404.secondaryButton}</button>
      </div>
    </div>
  </div>
</BlogLayout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-xl) var(--spacing-lg);
    background: var(--color-bg);
  }

  .error-content {
    text-align: center;
    max-width: 500px;
    animation: fade-in 600ms var(--ease-gentle);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error-icon {
    font-size: 80px;
    margin-bottom: var(--spacing-md);
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .error-code {
    font-size: 96px;
    font-weight: var(--font-weight-bold);
    background: linear-gradient(135deg, var(--color-pink), var(--color-blue));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
    line-height: 1;
  }

  .error-title {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text);
    margin: var(--spacing-md) 0 var(--spacing-sm);
  }

  .error-desc {
    font-size: var(--font-size-base);
    color: var(--color-text-light);
    line-height: var(--line-height-relaxed);
    margin: 0 0 var(--spacing-xl);
  }

  .error-actions {
    display: flex;
    gap: var(--spacing-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 28px;
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    transition:
      background var(--transition-fast) var(--ease-gentle),
      box-shadow var(--transition-fast) var(--ease-gentle),
      transform var(--transition-fast) var(--ease-gentle);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--color-blue), var(--color-blue-light));
    color: var(--color-on-primary, #fff);
    box-shadow: 0 2px 8px rgba(126, 182, 217, 0.3);

    &:hover {
      box-shadow: 0 4px 12px rgba(126, 182, 217, 0.4);
      transform: translateY(-2px);
    }
  }

  .btn-secondary {
    background: var(--color-surface, #fff);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    box-shadow: 0 1px 3px rgba(44, 62, 80, 0.08);

    &:hover {
      background: var(--color-white);
      box-shadow: 0 2px 6px rgba(44, 62, 80, 0.12);
      transform: translateY(-2px);
    }
  }

  @media (max-width: 640px) {
    .error-code {
      font-size: 72px;
    }

    .error-title {
      font-size: var(--font-size-xl);
    }

    .error-actions {
      flex-direction: column;
      width: 100%;

      .btn-primary,
      .btn-secondary {
        width: 100%;
      }
    }
  }
</style>
