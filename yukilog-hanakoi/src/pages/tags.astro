---
// ================================
// 标签页面
// Hero + 标签云 + 点击标签后展示文章列表
// 文章卡片全部在服务端预渲染（PostListCard 组件），
// JS 仅负责切换可见性，保证样式完全一致。
// ================================

export const prerender = false;

import BlogLayout from "../layouts/BlogLayout.astro";
import PageHero from "../components/shared/PageHero.astro";
import PostListCard from "../components/shared/PostListCard.astro";
import { contentConfig, siteConfig } from "../lib/config";
import { navIcons } from "../lib/svg-icons";
import { tagsApi, postsApi } from "../lib/api";

const tagIcon = navIcons.tag;

const tagsPageConfig = contentConfig.pages.tags;

// 从后端 API 获取标签列表
let tags: any[] = [];
let apiError = null;
try {
  tags = await tagsApi.list();
} catch (error) {
  console.error("获取标签列表失败：", error);
  apiError = error;
}

// 如果 API 失败，显示错误页
if (apiError) {
  return Astro.redirect("/500");
}

// 计算标签云大小（基于文章数量）
const maxCount = Math.max(...tags.map((t) => t.post_count), 1);
const tagCloud = tags.map((tag) => ({
  ...tag,
  size: Math.max(1, Math.min(5, Math.ceil((tag.post_count / maxCount) * 5))),
}));

// 为每个标签获取文章列表（预渲染）
const tagPosts: Record<string, any[]> = {};
for (const tag of tags) {
  try {
    const response = await postsApi.list({
      tag_slugs: tag.slug,
      status: "published",
      page_size: 999,
    });
    // 转换后端返回的数据结构为前端期望的扁平格式
    tagPosts[tag.slug] = (response.items || []).map((item: any) => ({
      ...item.post,
      theme: item.theme,
      tags: item.tags,
    }));
  } catch (error) {
    console.error(`获取标签 ${tag.slug} 的文章失败：`, error);
    tagPosts[tag.slug] = [];
  }
}

const colorCycle = tagsPageConfig.colorCycle;
const colorNames = tagsPageConfig.colorNames;

// 为每个拥有文章的标签准备数据
const tagSlugsWithPosts = Object.keys(tagPosts).filter(
  (slug) => tagPosts[slug].length > 0
);
---

<BlogLayout title={`标签 - ${siteConfig.name}`} stickyNav>
  <PageHero title="标签" subtitle={`共 ${tagCloud.length} 个标签`} icon={tagIcon} />

  <div class="tags-page">
    <!-- 标签云 -->
    <section class="tag-cloud-section">
      <div class="tag-cloud">
        {tagCloud.map((tag, i) => (
          <button
            class="tag-bubble"
            data-slug={tag.slug}
            data-size={tag.size}
            data-color={colorNames[colorCycle[i % colorCycle.length]]}
            style={`--i: ${i}`}
          >
            <span class="tag-name">{tag.name}</span>
            <span class="tag-count">{tag.post_count}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- 选中标签后的文章列表 -->
    <section class="tag-posts-section" id="tagPosts">
      <div class="tag-posts-header" id="tagPostsHeader">
        <h2 class="tag-posts-title" id="tagPostsTitle"></h2>
        <button class="tag-posts-close" id="tagPostsClose" aria-label="关闭">×</button>
      </div>

      {/* 预渲染每个标签的文章列表，默认隐藏 */}
      {tagSlugsWithPosts.map((slug) => (
        <div class="tag-group" data-tag-group={slug}>
          {tagPosts[slug].map((post, i) => (
            <PostListCard post={post} index={i} />
          ))}
        </div>
      ))}

      <p class="tag-posts-empty" id="tagPostsEmpty">{tagsPageConfig.emptyText}</p>
    </section>
  </div>
</BlogLayout>

<script>
  const bubbles = document.querySelectorAll<HTMLElement>('.tag-bubble');
  const postsSection = document.getElementById('tagPosts')!;
  const postsTitle = document.getElementById('tagPostsTitle')!;
  const postsEmpty = document.getElementById('tagPostsEmpty')!;
  const postsClose = document.getElementById('tagPostsClose')!;
  const tagGroups = document.querySelectorAll<HTMLElement>('.tag-group');

  let activeSlug: string | null = null;

  // 标签云入场
  const cloudObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          cloudObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );
  const cloudSection = document.querySelector('.tag-cloud-section');
  if (cloudSection) cloudObserver.observe(cloudSection);

  // 卡片入场 observer
  const cardObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          cardObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  function showTagGroup(slug: string) {
    // 隐藏所有标签组
    tagGroups.forEach((g) => g.classList.remove('active'));
    postsEmpty.style.display = 'none';

    // 显示目标标签组
    const target = document.querySelector<HTMLElement>(`.tag-group[data-tag-group="${slug}"]`);
    if (target) {
      target.classList.add('active');
      // 为卡片触发入场动画
      target.querySelectorAll<HTMLElement>('.post-list-card').forEach((card) => {
        card.classList.remove('visible');
        cardObserver.observe(card);
      });
    } else {
      postsEmpty.style.display = 'block';
    }
  }

  // 点击标签
  bubbles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.slug!;
      const name = btn.querySelector('.tag-name')!.textContent!;

      if (activeSlug === slug) {
        closePostsPanel();
        return;
      }

      activeSlug = slug;
      bubbles.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      postsTitle.textContent = `# ${name}`;
      showTagGroup(slug);
      postsSection.classList.add('show');

      postsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  // 关闭面板
  postsClose.addEventListener('click', closePostsPanel);

  function closePostsPanel() {
    activeSlug = null;
    bubbles.forEach((b) => b.classList.remove('active'));
    tagGroups.forEach((g) => g.classList.remove('active'));
    postsSection.classList.remove('show');
  }

  // 支持 ?tag=xxx 自动选中标签
  const urlParams = new URLSearchParams(window.location.search);
  const autoTag = urlParams.get('tag');
  if (autoTag) {
    const targetBtn = document.querySelector<HTMLElement>(`.tag-bubble[data-slug="${autoTag}"]`);
    if (targetBtn) {
      setTimeout(() => targetBtn.click(), 700);
    }
  }
</script>

<style lang="scss">
  .tags-page {
    max-width: 800px;
    margin: 0 auto;
    padding: $spacing-xl $spacing-lg $spacing-xxl * 2;
  }

  // ================================
  // 标签云
  // ================================
  .tag-cloud-section {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 600ms $ease-gentle,
      transform 600ms $ease-gentle;

    &.visible {
      opacity: 1;
      transform: translateY(0);

      .tag-bubble {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: $spacing-sm;
    padding: $spacing-md 0;
  }

  .tag-bubble {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border: 1.5px solid transparent;
    border-radius: 24px;
    background: var(--color-surface, #fff);
    color: $lian-text;
    cursor: pointer;
    font-family: inherit;
    transition:
      border-color $transition-fast $ease-gentle,
      background $transition-fast $ease-gentle,
      box-shadow $transition-fast $ease-gentle,
      transform $transition-fast $ease-gentle,
      opacity 400ms $ease-gentle,
      color $transition-fast $ease-gentle;
    
    opacity: 0;
    transform: translateY(12px);
    transition-delay: calc(var(--i) * 40ms);

    &[data-size="1"] { font-size: $font-size-xs; padding: 6px 14px; }
    &[data-size="2"] { font-size: $font-size-sm; }
    &[data-size="3"] { font-size: $font-size-base; }
    &[data-size="4"] { font-size: $font-size-lg; padding: 10px 22px; }
    &[data-size="5"] { font-size: $font-size-xl; padding: 12px 26px; }

    &[data-color="pink"] {
      background: rgba($lian-pink, 0.12);
      border-color: rgba($lian-pink, 0.2);
      .tag-count { background: rgba($lian-pink, 0.15); color: $lian-pink; }
      &:hover { background: rgba($lian-pink, 0.2); box-shadow: $shadow-pink; transform: translateY(-2px); }
    }

    &[data-color="blue"] {
      background: rgba($lian-blue, 0.12);
      border-color: rgba($lian-blue, 0.2);
      .tag-count { background: rgba($lian-blue, 0.15); color: $lian-blue; }
      &:hover { background: rgba($lian-blue, 0.2); box-shadow: $shadow-blue; transform: translateY(-2px); }
    }

    &[data-color="white"] {
      background: var(--color-surface, #fff);
      border-color: $lian-border;
      .tag-count { background: rgba($lian-text-muted, 0.1); color: $lian-text-muted; }
      &:hover { background: $lian-white; box-shadow: $shadow-sm; transform: translateY(-2px); }
    }

    &.active {
      background: $lian-blue;
      color: var(--color-on-primary, #fff);
      border-color: $lian-blue;
      box-shadow: $shadow-blue-hover;
      .tag-count { background: rgba(255, 255, 255, 0.25); color: var(--color-on-primary, #fff); }
    }
  }

  .tag-name {
    font-weight: $font-weight-medium;
  }

  .tag-count {
    font-size: $font-size-xs;
    padding: 1px 8px;
    border-radius: 10px;
    transition:
      background $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;
  }

  // ================================
  // 文章列表面板
  // ================================
  .tag-posts-section {
    margin-top: $spacing-xl;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 500ms $ease-gentle,
      opacity 400ms $ease-gentle;

    &.show {
      max-height: 5000px;
      opacity: 1;
    }
  }

  .tag-posts-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: $spacing-md;
    padding-bottom: $spacing-sm;
    border-bottom: 1.5px solid $lian-divider;
  }

  .tag-posts-title {
    font-size: $font-size-xl;
    font-weight: $font-weight-semibold;
    color: $lian-blue;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .tag-posts-close {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    background: rgba($lian-text-muted, 0.08);
    color: $lian-text-muted;
    border-radius: 50%;
    cursor: pointer;
    font-size: $font-size-lg;
    transition:
      background $transition-fast $ease-gentle,
      color $transition-fast $ease-gentle;

    &:hover {
      background: rgba($lian-pink, 0.12);
      color: $lian-pink;
    }
  }

  // 标签文章组：默认隐藏，激活后显示
  .tag-group {
    display: none;
    flex-direction: column;
    gap: $spacing-md;

    &.active {
      display: flex;
    }
  }

  .tag-posts-empty {
    display: none;
    text-align: center;
    color: $lian-text-muted;
    font-size: $font-size-sm;
    font-style: italic;
    padding: $spacing-xl 0;
  }

  // ================================
  // 响应式
  // ================================
  @media (max-width: $container-sm) {
    .tags-page {
      padding: $spacing-lg $spacing-sm $spacing-xxl;
    }

    .tag-cloud {
      gap: $spacing-xs;
    }
  }
</style>
