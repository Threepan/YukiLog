---
// ================================
// 主题详情页
// 展示某个主题下的所有文章
// ================================

export const prerender = false;

import BlogLayout from "../../layouts/BlogLayout.astro";
import PageHero from "../../components/shared/PageHero.astro";
import PostListCard from "../../components/shared/PostListCard.astro";
import { navIcons } from "../../lib/svg-icons";
import { contentConfig } from "../../lib/config";
import { themesApi, postsApi } from "../../lib/api";

const themeIcon = navIcons.theme;

// 获取 URL 参数
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// 从后端 API 获取主题信息
let theme;
let posts: any[] = [];
let apiError = null;

try {
  theme = await themesApi.getBySlug(slug);
  // 获取该主题下的所有文章
  const response = await postsApi.list({ 
    theme_slugs: slug, 
    status: "published",
    page_size: 999 
  });
  // 转换后端返回的数据结构为前端期望的扁平格式
  posts = (response.items || []).map((item: any) => ({
    ...item.post,
    theme: item.theme,
    tags: item.tags,
  }));
} catch (error) {
  console.error("获取主题详情失败：", error);
  apiError = error;
}

// 如果主题不存在或 API 失败，返回 404
if (apiError || !theme) {
  return Astro.redirect("/404");
}
---

<BlogLayout title={theme.name} description={theme.description || `${theme.name} 主题下的所有文章`} stickyNav>
  <PageHero
    title={theme.name}
    subtitle={theme.description || `共 ${theme.post_count} 篇文章`}
    icon={themeIcon}
  />

  <div class="theme-detail-page">
    <a href="/themes" class="back-link">{contentConfig.pages.themes.backToAll}</a>

    <div class="post-list-container">
      {posts.map((post, i) => (
        <PostListCard post={post} index={i} />
      ))}
    </div>
  </div>
</BlogLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const cards = document.querySelectorAll<HTMLElement>('.post-list-card');
    if (!cards.length) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    cards.forEach((card) => observer.observe(card));
  });
</script>

<style lang="scss">
  .theme-detail-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: $spacing-xl $spacing-lg $spacing-xxl * 2;
  }

  .post-list-container {
    columns: 2;
    column-gap: $spacing-lg;
  }

  @media (max-width: $container-md) {
    .post-list-container {
      columns: 1;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: $spacing-lg;
    font-size: $font-size-sm;
    color: $lian-text-muted;
    text-decoration: none;
    transition: color $transition-fast $ease-gentle;

    &:hover {
      color: $lian-blue;
    }
  }

  @media (max-width: $container-sm) {
    .theme-detail-page {
      padding: $spacing-lg $spacing-sm $spacing-xxl;
    }
  }
</style>
