---
// ================================
// 主题详情页
// 展示某个主题下的所有文章
// ================================

export const prerender = false;

import BlogLayout from "../../layouts/BlogLayout.astro";
import PageHero from "../../components/shared/PageHero.astro";
import PostListCard from "../../components/shared/PostListCard.astro";
import { navIcons } from "../../lib/svg-icons";
import { contentConfig } from "../../lib/config";
import { themesApi, postsApi } from "../../lib/api";

const themeIcon = navIcons.theme;

// 获取 URL 参数
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// 从后端 API 获取主题信息
let theme;
let posts: any[] = [];
let apiError = null;

try {
  theme = await themesApi.getBySlug(slug);
  // 获取该主题下的所有文章
  const response = await postsApi.list({ 
    theme_slugs: slug, 
    status: "published",
    page_size: 999 
  });
  // 转换后端返回的数据结构为前端期望的扁平格式
  posts = (response.items || []).map((item: any) => ({
    ...item.post,
    theme: item.theme,
    tags: item.tags,
  }));
} catch (error) {
  console.error("获取主题详情失败：", error);
  apiError = error;
}

// 如果主题不存在或 API 失败，返回 404
if (apiError || !theme) {
  return Astro.redirect("/404");
}
---

<BlogLayout title={theme.name} description={theme.description || `${theme.name} 主题下的所有文章`} stickyNav>
  <PageHero
    title={theme.name}
    subtitle={theme.description || `共 ${theme.post_count} 篇文章`}
    icon={themeIcon}
  />

  <div class="theme-detail-page" data-theme-slug={slug}>
    <a href="/themes" class="back-link">{contentConfig.pages.themes.backToAll}</a>

    <div class="post-list-container">
      <div class="post-list-column" data-column="0"></div>
      <div class="post-list-column" data-column="1"></div>

      <!-- 隐藏的卡片模板，用于 JS 动态分配 -->
      <div class="post-list-source" style="display: none;">
        {posts.map((post, i) => (
          <PostListCard post={post} index={i} />
        ))}
      </div>
    </div>
  </div>
</BlogLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const page = document.querySelector<HTMLElement>('.theme-detail-page');
    const themeSlug = page?.dataset.themeSlug;
    if (themeSlug) {
      // 增加主题浏览量（fire-and-forget）
      fetch(`/api/public/themes/${themeSlug}/view`, { method: 'POST' }).catch(() => {});
    }

    // 动态平衡双栏布局
    const source = document.querySelector<HTMLElement>('.post-list-source');
    const columns = document.querySelectorAll<HTMLElement>('.post-list-column');

    if (!source || columns.length !== 2) return;

    const cards = Array.from(source.querySelectorAll<HTMLElement>('.post-list-card'));
    if (!cards.length) return;

    // 检测是否为移动端
    const isMobile = window.innerWidth <= 768;

    if (isMobile) {
      // 移动端：所有卡片放入第一栏
      cards.forEach((card) => {
        columns[0].appendChild(card.cloneNode(true));
      });
    } else {
      // 桌面端：动态平衡分配
      const columnHeights = [0, 0];

      cards.forEach((card) => {
        // 克隆卡片以获取其高度
        const clone = card.cloneNode(true) as HTMLElement;
        clone.style.visibility = 'hidden';
        clone.style.position = 'absolute';
        document.body.appendChild(clone);

        const cardHeight = clone.offsetHeight;
        document.body.removeChild(clone);

        // 找到当前高度较小的栏
        const targetColumn = columnHeights[0] <= columnHeights[1] ? 0 : 1;

        // 将卡片添加到目标栏
        columns[targetColumn].appendChild(card.cloneNode(true));
        columnHeights[targetColumn] += cardHeight + 20; // 20 = margin-bottom
      });
    }

    // 清理源容器
    source.remove();

    // 入场动画
    const allCards = document.querySelectorAll<HTMLElement>('.post-list-card');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08 }
    );
    allCards.forEach((card) => observer.observe(card));

    // 响应式处理：窗口大小变化时重新布局
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        location.reload();
      }, 500);
    });
  });
</script>

<style>
  .theme-detail-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: var(--spacing-xl) var(--spacing-lg) var(--spacing-xxl) * 2;
  }

  .post-list-container {
    display: flex;
    gap: var(--spacing-lg);
    align-items: flex-start;
  }

  .post-list-column {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 768px) {
    .post-list-container {
      flex-direction: column;
    }

    .post-list-column:not(:first-child) {
      display: none;
    }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: var(--spacing-lg);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast) var(--ease-gentle);

    &:hover {
      color: var(--color-blue);
    }
  }

  @media (max-width: 640px) {
    .theme-detail-page {
      padding: var(--spacing-lg) var(--spacing-sm) var(--spacing-xxl);
    }
  }
</style>
