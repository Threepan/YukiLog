---
// ================================
// 友链页面 - 信笺风格
// 导航栏直接以 sticky 岛屿模式展示
// ================================

export const prerender = false;

import BlogLayout from "../layouts/BlogLayout.astro";
import FriendSpotlight from "../components/links/FriendSpotlight.astro";
import FriendCard from "../components/links/FriendCard.astro";
import ApplyLinkModal from "../components/links/ApplyLinkModal.astro";
import { contentConfig } from "../lib/config";
import { linksApi } from "../lib/api";

const linksPageConfig = contentConfig.pages.links;
const bestFriend = linksPageConfig.bestFriend;

// 从后端 API 获取友链列表
let apiLinks: any[] = [];
let apiError = null;
try {
  const response = await linksApi.list();
  // 只显示已通过审核的友链
  apiLinks = response.filter((link) => link.status === "active");
} catch (error) {
  console.error("获取友链列表失败：", error);
  apiError = error;
}

// 如果 API 失败，显示错误页
if (apiError) {
  return Astro.redirect("/500");
}

// 将 API 返回的友链转换为组件所需格式
const friends = apiLinks.map((link) => ({
  name: link.title,
  description: link.description || "",
  avatar: link.avatar,
  url: link.url,
}));
---

<BlogLayout title="友链 - YukiLog" stickyNav>
  <div class="links-page">
    <!-- 页头独白 -->
    <header class="links-header">
      <p class="links-greeting">{contentConfig.pages.links.greeting}</p>
      <div class="links-divider"></div>
    </header>

    <!-- 最好的朋友 Spotlight -->
    <FriendSpotlight {...bestFriend} />

    <!-- 朋友们 - 散落便签 -->
    <section class="friends-section">
      <h2 class="friends-title">{linksPageConfig.friendsTitle}</h2>
      <div class="friends-grid">
        {friends.map((friend, i) => (
          <FriendCard {...friend} index={i} />
        ))}
      </div>
    </section>

    <!-- 申请友链 -->
    <ApplyLinkModal />
  </div>
</BlogLayout>

<style lang="scss">
  .links-page {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 $spacing-lg;
    min-height: 100vh;
  }

  // 页头
  .links-header {
    padding-top: 80px; // 给 sticky 导航栏留空间
    text-align: center;
    opacity: 0;
    animation: header-enter 700ms $ease-gentle 100ms forwards;
  }

  @keyframes header-enter {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .links-greeting {
    font-size: $font-size-lg;
    color: $lian-text-light;
    font-style: italic;
    margin: 0;
    line-height: $line-height-relaxed;
  }

  .links-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, $lian-pink, $lian-blue);
    margin: $spacing-lg auto 0;
    border-radius: 1px;
  }

  // 朋友们区域
  .friends-section {
    padding-top: $spacing-xl;
  }

  .friends-title {
    font-size: $font-size-base;
    font-weight: $font-weight-medium;
    color: $lian-text-muted;
    text-align: center;
    margin: 0 0 $spacing-xl;
    letter-spacing: 0.15em;
  }

  .friends-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: $spacing-lg;
    padding: 0 $spacing-md;

    // 给子元素批量设置入场延迟
    :global(.friend-card) {
      @for $i from 0 through 11 {
        &:nth-child(#{$i + 1}) {
          --i: #{$i};
        }
      }
    }
  }

  // 响应式
  @media (max-width: $container-sm) {
    .links-page {
      padding: 0 $spacing-sm;
    }

    .links-header {
      padding-top: 70px;
    }

    .friends-grid {
      gap: $spacing-md;
      padding: 0;
    }
  }
</style>
