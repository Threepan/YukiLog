---
export const prerender = false;

import BlogLayout from "../../layouts/BlogLayout.astro";
import ProfileCard from "../../components/home/ProfileCard.astro";
import TableOfContents from "../../components/posts/TableOfContents.astro";
import CommentSection from "../../components/comments/CommentSection.astro";
import { contentConfig, siteConfig } from "../../lib/config";
import { renderMarkdown } from "../../lib/markdown";
import { postsApi, commentsApi } from "../../lib/api";
import type { CommentNode } from "../../types/api";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

// 从后端 API 获取文章详情
let currentPost;
let apiError = null;
try {
  currentPost = await postsApi.getBySlug(slug);
} catch (error) {
  console.error("获取文章详情失败：", error);
  apiError = error;
}

// 如果文章不存在或 API 失败，返回 404
if (apiError || !currentPost) {
  return Astro.redirect("/404");
}

// 解构文章数据
const post = currentPost.post;
const postTheme = currentPost.theme;
const postTags = currentPost.tags;

// 增加浏览数（后台异步，不阻塞渲染）
postsApi.incrementView(slug).catch((err) => {
  console.error("增加浏览数失败：", err);
});

// 获取评论列表
let comments: CommentNode[] = [];
try {
  comments = await commentsApi.getPostComments(slug);
} catch (error) {
  console.error("获取评论失败：", error);
  // 评论获取失败不影响文章显示，继续渲染
}

const hp = contentConfig.markdown.headingPrefixes;

// 渲染 Markdown 内容
const { html: markdownHtml, headings } = await renderMarkdown(post.content);
---

<BlogLayout
  title={`${post.title} | ${siteConfig.name}`}
  description={post.summary ?? undefined}
  keywords={["Markdown", "样式测试", "占位文章"]}
  stickyNav={true}
>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.28/dist/katex.min.css" slot="head" />

  <section class="post-page">
    <!-- 左侧个人卡片：固定定位，与主页一致 -->
    <aside class="post-author-fixed">
      <ProfileCard />
    </aside>

    <!-- 文章 + 目录 -->
    <div class="post-main">
      <article
        class="post-content"
        style={`--h1p:"${hp.h1}";--h2p:"${hp.h2}";--h3p:"${hp.h3}";--h4p:"${hp.h4}";--h5p:"${hp.h5}";--h6p:"${hp.h6}";`}
      >
        <nav class="post-back-nav">
          <a href="javascript:void(0)" class="post-back-link" id="post-back-link">← 返回</a>
        </nav>

        <header class="post-header">
          <h1 class="post-title">{post.title}</h1>
          <p class="post-summary">{post.summary}</p>
          <time datetime={post.created_at}>
            {new Date(post.created_at).toLocaleDateString("zh-CN", {
              year: "numeric",
              month: "long",
              day: "numeric",
            })}
          </time>
        </header>

        <div class="post-divider" aria-hidden="true"></div>

        <div class="markdown-body" set:html={markdownHtml} />

        <!-- 评论区 -->
        <CommentSection comments={comments} postSlug={slug} />
      </article>

      <script>
        const backLink = document.getElementById('post-back-link');
        if (backLink) {
          backLink.addEventListener('click', (e) => {
            e.preventDefault();
            if (document.referrer && new URL(document.referrer).origin === window.location.origin) {
              history.back();
            } else {
              window.location.href = '/';
            }
          });
        }
      </script>

      <aside class="post-toc">
        {headings.length > 0 && <TableOfContents headings={headings} />}
      </aside>
    </div>
  </section>
</BlogLayout>

<style lang="scss" is:global>
  // ================================
  // 文章页布局
  // ================================
  .post-page {
    padding-top: calc(#{$spacing-xl} + 44px);
    padding-bottom: $spacing-xxl;
    min-height: 100vh;
  }

  // 左侧个人卡片：固定定位，位置与主页 .fixed-sidebar-left 一致
  .post-author-fixed {
    position: fixed;
    left: $spacing-xl * 2;
    top: 88px;
    width: 280px;
    z-index: $z-nav - 1;
  }

  // 强制覆盖 ProfileCard scoped 样式的 opacity/transform
  .post-author-fixed .profile-card {
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  // 文章 + 目录：和主页文章列表一样，在全宽内居中
  .post-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: $spacing-xl;
    align-items: start;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 $spacing-md;
    transform: translateX(130px);
  }

  .post-content {
    background: $lian-white;
    border: 1px solid $lian-border;
    border-radius: $radius-lg;
    box-shadow: $shadow-blue;
    padding: $spacing-xl;
    width: 100%;
  }

  .post-back-nav {
    margin-bottom: $spacing-md;
  }

  .post-back-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: $font-size-sm;
    color: $lian-text-muted;
    text-decoration: none;
    transition: color $transition-fast $ease-gentle;

    &:hover {
      color: $lian-blue;
    }

    &::after {
      content: none !important;
    }
  }

  .post-header {
    display: flex;
    flex-direction: column;
    gap: $spacing-xs;
    margin-bottom: $spacing-lg;

    .post-title {
      font-size: $font-size-3xl;
      font-weight: $font-weight-bold;
      color: $lian-text;
      line-height: $line-height-tight;
      &::before { content: none !important; }
    }

    .post-summary {
      color: $lian-text-light;
      line-height: $line-height-relaxed;
      font-size: $font-size-base;
    }

    time {
      color: $lian-text-muted;
      font-size: $font-size-sm;
    }
  }

  .post-divider {
    height: 1px;
    background: linear-gradient(to right, $lian-pink, $lian-blue);
    opacity: 0.35;
    margin-bottom: $spacing-xl;
  }

  // ================================
  // Markdown 正文样式
  // ================================
  .markdown-body {
    line-height: $line-height-relaxed;
    color: $lian-text;
    font-size: $font-size-base;
    word-break: break-word;

    // ---- 全局间距节奏 ----
    > * + * {
      margin-top: 1.25em;
    }

    // ---- 标题 ----
    h1, h2, h3, h4, h5, h6 {
      line-height: $line-height-tight;
      font-weight: $font-weight-semibold;
      color: $lian-text;
      scroll-margin-top: 96px;
      margin-top: 2em;
      margin-bottom: 0.75em;

      &::before {
        font-weight: $font-weight-normal;
        margin-right: 0.25em;
      }
    }

    h1 {
      font-size: $font-size-3xl;
      padding-bottom: 0.4em;
      border-bottom: 2px solid $lian-divider;
      &::before { content: var(--h1p, ""); color: $lian-pink; }
    }

    h2 {
      font-size: $font-size-2xl;
      padding-bottom: 0.3em;
      border-bottom: 1px solid $lian-divider;
      &::before { content: var(--h2p, ""); color: $lian-pink; }
    }

    h3 {
      font-size: $font-size-xl;
      &::before { content: var(--h3p, ""); color: $lian-blue; }
    }

    h4 {
      font-size: $font-size-lg;
      &::before { content: var(--h4p, ""); color: $lian-blue; }
    }

    h5 {
      font-size: $font-size-base;
      &::before { content: var(--h5p, ""); color: $lian-text-light; }
    }

    h6 {
      font-size: $font-size-sm;
      color: $lian-text-light;
      &::before { content: var(--h6p, ""); color: $lian-text-muted; }
    }

    // ---- 段落 ----
    p {
      line-height: $line-height-relaxed;
    }

    // ---- 链接（动态下划线，从左拉开） ----
    a {
      color: $lian-blue;
      text-decoration: none;
      position: relative;
      display: inline;
      background: none;

      &::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -1px;
        width: 0;
        height: 1.5px;
        background: $lian-blue;
        transition: width $transition-base $ease-gentle;
      }

      &:hover {
        color: color-mix(in srgb, $lian-blue 82%, black);
        &::after {
          width: 100%;
        }
      }
    }

    // ---- 行内代码 ----
    :not(pre) > code {
      font-family: $font-family-code;
      font-size: 0.88em;
      color: color-mix(in srgb, $lian-pink 70%, #333);
      background: rgba($lian-pink, 0.1);
      border: 1px solid rgba($lian-pink, 0.2);
      border-radius: 4px;
      padding: 0.15em 0.4em;
      word-break: break-word;
    }

    // ---- 代码块（shiki 高亮） ----
    .code-block {
      position: relative;
      margin-top: 1.25em;
      margin-bottom: 1.25em;
      border-radius: $radius-md;
      border: 1px solid $lian-border;
      background: #fafbfc;
      box-shadow: $shadow-sm;
      overflow: hidden;

      &[data-lang]::before {
        content: attr(data-lang);
        position: absolute;
        top: 0;
        right: 0;
        padding: 2px 12px;
        font-size: $font-size-xs;
        font-family: $font-family-code;
        color: $lian-text-muted;
        background: rgba($lian-blue, 0.08);
        border-bottom-left-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        user-select: none;
        z-index: 1;
      }

      pre {
        margin: 0 !important;
        padding: $spacing-md;
        padding-top: calc($spacing-md + 4px);
        background: transparent !important;
        border: none !important;
        box-shadow: none !important;
        border-radius: 0;
        overflow-x: auto;

        code {
          font-family: $font-family-code;
          font-size: $font-size-sm;
          line-height: 1.7;
          display: block;
          background: none !important;
          border: none !important;
          padding: 0;
          color: inherit;
        }
      }
    }

    // ---- 引用块 ----
    blockquote {
      margin: 1.25em 0;
      padding: $spacing-sm $spacing-md;
      border-left: 4px solid $lian-pink;
      background: rgba($lian-pink, 0.06);
      border-radius: 0 $radius-sm $radius-sm 0;
      color: $lian-text-light;

      p {
        margin: 0.5em 0;
        &:first-child { margin-top: 0; }
        &:last-child { margin-bottom: 0; }
      }

      blockquote {
        border-left-color: $lian-blue;
        background: rgba($lian-blue, 0.06);

        blockquote {
          border-left-color: $lian-text-muted;
          background: rgba($lian-text-muted, 0.06);
        }
      }
    }

    // ---- 列表 ----
    ul, ol {
      padding-left: 1.75em;
      margin: 1em 0;
      line-height: $line-height-relaxed;
    }

    li {
      margin: 0.35em 0;
      > ul, > ol {
        margin: 0.25em 0;
      }
    }

    ul { list-style-type: disc; ul { list-style-type: circle; } }
    ol { list-style-type: decimal; }

    // ---- 任务列表 ----
    .task-item {
      list-style: none;
      margin-left: -1.75em;
      padding-left: 0;

      .task-check {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        font-size: 12px;
        vertical-align: middle;
        margin-right: 0.4em;
        position: relative;
        top: -1px;

        &.checked {
          background: $lian-blue;
          color: white;
          border: 1.5px solid $lian-blue;
        }

        &.unchecked {
          background: $lian-white;
          border: 1.5px solid $lian-border;
        }
      }
    }

    // ---- 表格 ----
    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      margin: 1.5em 0;
      border: 1px solid $lian-border;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: $shadow-sm;
      background: $lian-white;
      font-size: $font-size-sm;

      thead th {
        background: rgba($lian-blue, 0.1);
        color: color-mix(in srgb, $lian-blue 65%, black);
        font-weight: $font-weight-semibold;
        padding: 12px 16px;
        text-align: left;
        border-bottom: 2px solid rgba($lian-blue, 0.2);
        white-space: nowrap;
      }

      tbody {
        td {
          padding: 10px 16px;
          border-bottom: 1px solid $lian-divider;
          color: $lian-text;
        }

        tr:nth-child(even) { background: rgba($lian-pink, 0.05); }

        tr:hover {
          background: rgba($lian-blue, 0.06);
          transition: background $transition-fast $ease-gentle;
        }

        tr:last-child td { border-bottom: none; }
      }
    }

    // ---- 分隔线 ----
    hr {
      border: none;
      height: 1px;
      margin: 2.5em auto;
      max-width: 60%;
      background: linear-gradient(
        to right,
        transparent,
        $lian-pink,
        $lian-blue,
        transparent
      );
      position: relative;

      &::after {
        content: "✦";
        display: block;
        text-align: center;
        color: $lian-text-muted;
        font-size: $font-size-sm;
        line-height: 1;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: $lian-white;
        padding: 0 0.75em;
      }
    }

    // ---- 图片 ----
    .md-image {
      margin: 1.5em 0;
      text-align: center;

      img {
        max-width: 100%;
        border-radius: $radius-md;
        box-shadow: $shadow-md;
        display: inline-block;
      }

      figcaption {
        margin-top: 0.5em;
        font-size: $font-size-sm;
        color: $lian-text-muted;
        font-style: italic;
      }
    }

    // ---- 删除线 ----
    del {
      text-decoration: line-through;
      color: $lian-text-muted;
    }

    strong {
      font-weight: $font-weight-semibold;
      color: $lian-text;
    }

    em {
      color: $lian-pink;
      font-style: italic;
    }

    // ---- 脚注 ----
    .footnotes {
      margin-top: 3em;
      padding-top: 1.5em;
      border-top: 1px solid $lian-divider;
      font-size: $font-size-sm;
      color: $lian-text-light;

      ol { padding-left: 1.25em; }
      li { margin: 0.5em 0; }

      a[data-footnote-backref] {
        color: $lian-pink;
        font-size: $font-size-xs;
        &::after { content: none; }
      }
    }

    sup a[data-footnote-ref] {
      color: $lian-pink;
      font-weight: $font-weight-medium;
      font-size: 0.8em;
      text-decoration: none;
      &::after { content: none; }
    }

    .footnotes-sep {
      display: none;
    }

    // ---- 数学公式 ----
    .math-block {
      margin: 1.5em 0;
      text-align: center;
      overflow-x: auto;
      padding: $spacing-sm 0;
    }

    .math-error {
      color: $lian-error;
      font-family: $font-family-code;
      font-size: $font-size-sm;
    }

    // ---- HTML 容器 ----
    > div[style] {
      border-radius: $radius-sm;
      margin: 1.25em 0;
    }
  }

  // ================================
  // 右侧目录
  // ================================
  .post-toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 120px);
    overflow: visible;
    padding-right: $spacing-lg;
  }

  .toc-container {
    font-size: $font-size-sm;
  }

  .toc-title {
    font-size: $font-size-sm;
    font-weight: $font-weight-semibold;
    color: $lian-text-light;
    margin-bottom: $spacing-sm;
    padding-left: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .toc-scroll-area {
    position: relative;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    scrollbar-width: none;
    &::-webkit-scrollbar { display: none; }
    // 上下留出少量 padding 即可，不用 mask 遮罩
    padding: $spacing-xs 0;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-item {
    padding-left: calc(14px + var(--indent, 0) * 12px);
    transition: all 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);

    &.active .toc-link {
      color: color-mix(in srgb, $lian-blue 85%, #000);
      font-weight: $font-weight-semibold;
      transform: scale(1.2) translateX(-6px);
      transform-origin: left center;
    }

    &:not(.active) .toc-link {
      color: $lian-text-muted;
    }
  }

  .toc-link {
    display: block;
    padding: 4px 0;
    line-height: 1.5;
    text-decoration: none;
    transition: color 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;

    &:hover {
      color: color-mix(in srgb, $lian-blue 80%, black) !important;
    }

    // 覆盖 markdown-body 中的 a::after 动画下划线
    &::after {
      content: none !important;
    }
  }

  // 左侧指示线
  .toc-indicator {
    position: absolute;
    left: 0;
    top: 0;
    width: 2.5px;
    height: 20px;
    border-radius: 2px;
    background: linear-gradient(to bottom, $lian-pink, $lian-blue);
    opacity: 0;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), height 0.5s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    pointer-events: none;
  }

  // ================================
  // 响应式
  // ================================
  @media (max-width: $container-lg) {
    .post-author-fixed {
      display: none;
    }

    .post-main {
      grid-template-columns: minmax(0, 1fr);
      max-width: 780px;
      padding: 0 $spacing-sm;
    }

    .post-toc {
      display: none;
    }
  }

  @media (max-width: $container-md) {
    .post-content {
      padding: $spacing-lg $spacing-md;
    }
  }
</style>
