---
// ================================
// 首页 - 双屏设计
// ================================

export const prerender = false;

import BlogLayout from "../layouts/BlogLayout.astro";
import WelcomeCard from "../components/home/WelcomeCard.astro";
import ProfileCard from "../components/home/ProfileCard.astro";
import HitokotoCard from "../components/home/HitokotoCard.astro";
import SiteInfoCard from "../components/home/SiteInfoCard.astro";
import ArticleList from "../components/home/ArticleList.astro";
import { uiIcons } from "../lib/svg-icons";
import { siteConfig } from "../lib/config";
import { postsApi } from "../lib/api";

const arrowIcon = uiIcons.arrow;

// 读取排序参数（默认 created_at）
const url = new URL(Astro.request.url);
const currentSort = (url.searchParams.get('sort') || 'created_at') as 'created_at' | 'updated_at' | 'view_count';

// 从后端 API 获取精选已发布文章
let recentPosts: any[] = [];
let apiError = null;
try {
  const response = await postsApi.list({
    page: 1,
    page_size: 20,
    status: "published",
    sort: currentSort,
    is_featured: true,
  });
  // 转换后端返回的数据结构为前端期望的扁平格式
  recentPosts = (response.items || []).map((item: any) => ({
    ...item.post,
    theme: item.theme,
    tags: item.tags,
  }));
} catch (error) {
  console.error("获取文章列表失败：", error);
  apiError = error;
}

// 如果 API 失败，显示错误页
if (apiError) {
  return Astro.redirect("/500");
}

// 导入所有背景图（使用 ?url 获取路径）
const backgrounds = import.meta.glob("../assets/image/background/*.jpg", {
  eager: true,
  query: "?url",
  import: "default",
});
const backgroundImages = Object.values(backgrounds) as string[];

// 随机选择一张背景图
const randomBackground =
  backgroundImages[Math.floor(Math.random() * backgroundImages.length)];
---

<BlogLayout title={siteConfig.name}>
  <div class="home-first-screen">
    <div
      class="home-bg"
      style={`background-image: url(${randomBackground})`}
    ></div>
    <WelcomeCard />
    
    <button class="scroll-arrow" id="scroll-arrow" aria-label="滚动到下一屏">
      <span set:html={arrowIcon}></span>
    </button>
  </div>
  
  <!-- 固定侧栏卡片（与导航栏同步显隐） -->
  <aside class="fixed-sidebar fixed-sidebar-left" id="fixed-sidebar-left">
    <ProfileCard />
  </aside>

  <div class="home-second-screen" id="second-screen">
    <ArticleList posts={recentPosts} currentSort={currentSort} />
  </div>
  
  <aside class="fixed-sidebar fixed-sidebar-right" id="fixed-sidebar-right">
    <HitokotoCard />
    <SiteInfoCard />
  </aside>
</BlogLayout>

<style>
  .home-first-screen {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  
  .home-bg {
    position: absolute;
    inset: 0;
    background-color: var(--color-surface-dark, #0a0a0a);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: bg-fade-in 1.2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    filter: brightness(0.3) blur(8px);
    z-index: 0;
  }
  
  @keyframes bg-fade-in {
    from {
      filter: brightness(0.3) blur(8px);
    }
    to {
      filter: brightness(0.7) blur(0);
    }
  }
  
  /* 底部滚动箭头 */
  .scroll-arrow {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-on-primary-alpha-70, rgba(255, 255, 255, 0.7));
    animation: arrow-float 2.5s ease-in-out infinite;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    
    :global(svg) {
      width: 36px;
      height: 36px;
      fill: currentColor;
    }
    
    &:hover {
      color: var(--color-on-primary-alpha-95, rgba(255, 255, 255, 0.95));
      animation: arrow-float 2.5s ease-in-out infinite;
      transform: translateX(-50%) scale(1.25);
    }
  }
  
  @keyframes arrow-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 10px; }
  }
  
  /* 侧栏布局共享变量 */
  :root {
    --sidebar-width: clamp(240px, 24vw, 280px);
    --sidebar-offset: clamp(24px, 5vw, 80px);
    --sidebar-gap: 24px;
    --sidebar-total: calc(var(--sidebar-width) + var(--sidebar-offset) + var(--sidebar-gap));
    /* 三栏布局最大宽度：侧栏×2 + 内容区最大900px + offset×2 + gap×2 */
    --layout-max-width: 1668px;
  }

  /* 第二屏：加 max-width 让超宽屏整体居中 */
  .home-second-screen {
    width: 100%;
    max-width: var(--layout-max-width);
    min-height: 100vh;
    background: var(--color-bg);
    margin: 0 auto;
    padding-left: var(--sidebar-total);
    padding-right: var(--sidebar-total);
  }

  /* 固定侧栏：超过 max-width 后跟随容器居中，不再贴屏幕边缘 */
  .fixed-sidebar {
    position: fixed;
    top: 70px;
    width: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    z-index: 99;
    pointer-events: none;

    /* 子元素可交互 */
    :global(> *) {
      pointer-events: auto;
    }
  }

  .fixed-sidebar-left {
    /* 超过 max-width 后：容器左边距 = (100vw - max-width) / 2，侧栏再加 offset */
    left: max(var(--sidebar-offset), calc((100vw - var(--layout-max-width)) / 2 + var(--sidebar-offset)));
  }

  .fixed-sidebar-right {
    right: max(var(--sidebar-offset), calc((100vw - var(--layout-max-width)) / 2 + var(--sidebar-offset)));
  }
  
  /* 响应式：小于 1400px 转为流式布局（侧栏与内容不再重叠） */
  @media (max-width: 1400px) {
    .home-second-screen {
      padding-left: 0;
      padding-right: 0;
    }

    .fixed-sidebar {
      position: static;
      top: auto;
      left: auto;
      right: auto;
      width: min(100%, 800px);
      margin: 0 auto;
      padding: 0 var(--spacing-md);
      z-index: auto;
      pointer-events: auto;
    }

    .fixed-sidebar-left {
      margin-top: var(--spacing-lg);
      margin-bottom: var(--spacing-lg);
    }

    .fixed-sidebar-right {
      margin-top: 0;
      margin-bottom: var(--spacing-xl);
    }

    .fixed-sidebar-right :global(#hitokoto-card) {
      display: none;
    }

    :global(#profile-card),
    :global(#hitokoto-card),
    :global(#siteinfo-card) {
      opacity: 1 !important;
      transform: translateX(0) !important;
    }
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    // 清理上次绑定
    window.__yukilogHomepageCleanup?.();

    const btn = document.getElementById('scroll-arrow');
    const target = document.getElementById('second-screen');
    if (btn && target) {
      btn.addEventListener('click', () => {
        target.scrollIntoView({ behavior: 'smooth' });
      });
    }

    // 固定侧栏显隐 - 与导航栏 sticky 同步
    const getThreshold = () => window.innerHeight;

    function updateSidebars() {
      const mobileLayout = window.innerWidth <= 1400;

      const threshold = getThreshold();
      const shouldShow = window.scrollY >= threshold - 50;

      // 左侧卡片
      const profileCard = document.getElementById('profile-card');
      // 右侧卡片
      const hitokotoCard = document.getElementById('hitokoto-card');
      const siteinfoCard = document.getElementById('siteinfo-card');

      if (mobileLayout || shouldShow) {
        profileCard?.classList.add('visible');
        if (!mobileLayout) {
          hitokotoCard?.classList.add('visible');
        } else {
          hitokotoCard?.classList.remove('visible');
        }
        // 站点信息延迟 400ms
        if (siteinfoCard && !siteinfoCard.classList.contains('visible')) {
          setTimeout(() => siteinfoCard.classList.add('visible'), 400);
        }
      } else {
        profileCard?.classList.remove('visible');
        hitokotoCard?.classList.remove('visible');
        siteinfoCard?.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', updateSidebars);
    window.addEventListener('resize', updateSidebars);
    // 初始检查
    updateSidebars();

    window.__yukilogHomepageCleanup = () => {
      window.removeEventListener('scroll', updateSidebars);
      window.removeEventListener('resize', updateSidebars);
    };
  });

  declare global {
    interface Window {
      __yukilogHomepageCleanup?: () => void;
    }
  }
</script>
