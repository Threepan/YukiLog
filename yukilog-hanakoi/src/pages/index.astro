---
// ================================
// 首页 - 双屏设计
// ================================

export const prerender = false;

import BlogLayout from "../layouts/BlogLayout.astro";
import MusicPlayer from "../components/shared/MusicPlayer.astro";
import WelcomeCard from "../components/home/WelcomeCard.astro";
import ProfileCard from "../components/home/ProfileCard.astro";
import HitokotoCard from "../components/home/HitokotoCard.astro";
import SiteInfoCard from "../components/home/SiteInfoCard.astro";
import ArticleList from "../components/home/ArticleList.astro";
import { uiIcons } from "../lib/svg-icons";
import { siteConfig } from "../lib/config";
import { postsApi } from "../lib/api";

const arrowIcon = uiIcons.arrow;

// 从后端 API 获取最新 20 篇已发布文章
let recentPosts: any[] = [];
let apiError = null;
try {
  const response = await postsApi.list({
    page: 1,
    page_size: 20,
    status: "published",
  });
  recentPosts = response.items || [];
} catch (error) {
  console.error("获取文章列表失败：", error);
  apiError = error;
}

// 如果 API 失败，显示错误页
if (apiError) {
  return Astro.redirect("/500");
}

// 导入所有背景图（使用 ?url 获取路径）
const backgrounds = import.meta.glob("../assets/image/background/*.jpg", {
  eager: true,
  query: "?url",
  import: "default",
});
const backgroundImages = Object.values(backgrounds) as string[];

// 随机选择一张背景图
const randomBackground =
  backgroundImages[Math.floor(Math.random() * backgroundImages.length)];
---

<BlogLayout title={siteConfig.name}>
  <div class="home-first-screen">
    <div
      class="home-bg"
      style={`background-image: url(${randomBackground})`}
    ></div>
    <WelcomeCard />
    
    <button class="scroll-arrow" id="scroll-arrow" aria-label="滚动到下一屏">
      <span set:html={arrowIcon}></span>
    </button>
  </div>
  
  <div class="home-second-screen" id="second-screen">
    <ArticleList posts={recentPosts} />
  </div>
  
  <!-- 固定侧栏卡片（与导航栏同步显隐） -->
  <aside class="fixed-sidebar fixed-sidebar-left" id="fixed-sidebar-left">
    <ProfileCard />
  </aside>
  
  <aside class="fixed-sidebar fixed-sidebar-right" id="fixed-sidebar-right">
    <HitokotoCard />
    <SiteInfoCard />
  </aside>
  
  <MusicPlayer />
</BlogLayout>

<style lang="scss">
  .home-first-screen {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  
  .home-bg {
    position: absolute;
    inset: 0;
    background-color: #0a0a0a;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: bg-fade-in 1.2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    filter: brightness(0.3) blur(8px);
    z-index: 0;
  }
  
  @keyframes bg-fade-in {
    from {
      filter: brightness(0.3) blur(8px);
    }
    to {
      filter: brightness(0.7) blur(0);
    }
  }
  
  // 底部滚动箭头
  .scroll-arrow {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: rgba(255, 255, 255, 0.7);
    animation: arrow-float 2.5s ease-in-out infinite;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    
    :global(svg) {
      width: 36px;
      height: 36px;
      fill: currentColor;
    }
    
    &:hover {
      color: rgba(255, 255, 255, 0.95);
      animation: arrow-float 2.5s ease-in-out infinite;
      transform: translateX(-50%) scale(1.25);
    }
  }
  
  @keyframes arrow-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 10px; }
  }
  
  // 第二屏
  .home-second-screen {
    width: 100%;
    min-height: 100vh;
    background: $lian-bg;
  }
  
  // 固定侧栏（跟随导航栏显隐）
  .fixed-sidebar {
    position: fixed;
    top: 70px;
    width: 280px;
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
    z-index: $z-nav - 1;
    pointer-events: none;
    
    // 子元素可交互
    :global(> *) {
      pointer-events: auto;
    }
  }
  
  .fixed-sidebar-left {
    left: $spacing-xl * 2;
  }
  
  .fixed-sidebar-right {
    right: $spacing-xl * 2;
  }
  
  // 响应式：小屏隐藏固定侧栏
  @media (max-width: $container-lg) {
    .fixed-sidebar {
      display: none;
    }
  }
</style>

<script>
  const btn = document.getElementById('scroll-arrow');
  const target = document.getElementById('second-screen');
  if (btn && target) {
    btn.addEventListener('click', () => {
      target.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // 固定侧栏显隐 - 与导航栏 sticky 同步
  const leftSidebar = document.getElementById('fixed-sidebar-left');
  const rightSidebar = document.getElementById('fixed-sidebar-right');
  const getThreshold = () => window.innerHeight;

  function updateSidebars() {
    const threshold = getThreshold();
    const shouldShow = window.scrollY >= threshold - 50;

    // 左侧卡片
    const profileCard = document.getElementById('profile-card');
    // 右侧卡片
    const hitokotoCard = document.getElementById('hitokoto-card');
    const siteinfoCard = document.getElementById('siteinfo-card');

    if (shouldShow) {
      profileCard?.classList.add('visible');
      hitokotoCard?.classList.add('visible');
      // 站点信息延迟 400ms
      if (siteinfoCard && !siteinfoCard.classList.contains('visible')) {
        setTimeout(() => siteinfoCard.classList.add('visible'), 400);
      }
    } else {
      profileCard?.classList.remove('visible');
      hitokotoCard?.classList.remove('visible');
      siteinfoCard?.classList.remove('visible');
    }
  }

  window.addEventListener('scroll', updateSidebars);
  // 初始检查
  updateSidebars();
</script>
