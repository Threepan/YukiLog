---
// ================================
// 首页 - 双屏设计
// ================================

import BlogLayout from "../layouts/BlogLayout.astro";
import MusicPlayer from "../components/shared/MusicPlayer.astro";
import WelcomeCard from "../components/home/WelcomeCard.astro";
import ProfileCard from "../components/home/ProfileCard.astro";

// 箭头图标
const arrowIcon = await import('../assets/icon/ui/arrow.svg?raw');

// 导入所有背景图（使用 ?url 获取路径）
const backgrounds = import.meta.glob("../assets/image/background/*.jpg", {
  eager: true,
  query: "?url",
  import: "default",
});
const backgroundImages = Object.values(backgrounds) as string[];

// 随机选择一张背景图
const randomBackground =
  backgroundImages[Math.floor(Math.random() * backgroundImages.length)];
---

<BlogLayout title="YukiLog">
  <div class="home-first-screen">
    <div
      class="home-bg"
      style={`background-image: url(${randomBackground})`}
    ></div>
    <WelcomeCard />
    
    <button class="scroll-arrow" id="scroll-arrow" aria-label="滚动到下一屏">
      <span set:html={arrowIcon.default}></span>
    </button>
  </div>
  
  <div class="home-second-screen" id="second-screen">
    <div class="second-screen-container">
      <aside class="sidebar">
        <ProfileCard />
      </aside>
      
      <main class="main-content">
      </main>
    </div>
  </div>
  
  <MusicPlayer />
</BlogLayout>

<style lang="scss">
  .home-first-screen {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
  }
  
  .home-bg {
    position: absolute;
    inset: 0;
    background-color: #0a0a0a;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    animation: bg-fade-in 1.2s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
    filter: brightness(0.3) blur(8px);
    z-index: 0;
  }
  
  @keyframes bg-fade-in {
    from {
      filter: brightness(0.3) blur(8px);
    }
    to {
      filter: brightness(0.7) blur(0);
    }
  }
  
  // 底部滚动箭头
  .scroll-arrow {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    color: rgba(255, 255, 255, 0.7);
    animation: arrow-float 2.5s ease-in-out infinite;
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
    
    :global(svg) {
      width: 36px;
      height: 36px;
      fill: currentColor;
    }
    
    &:hover {
      color: rgba(255, 255, 255, 0.95);
      animation: arrow-float 2.5s ease-in-out infinite;
      transform: translateX(-50%) scale(1.25);
    }
  }
  
  @keyframes arrow-float {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 10px; }
  }
  
  // 第二屏
  .home-second-screen {
    width: 100%;
    min-height: 100vh;
    background: $lian-bg;
    padding: $spacing-xxl 0;
    padding-top: calc(#{$spacing-xxl} + 30px);
  }
  
  .second-screen-container {
    max-width: $container-xl;
    margin: 0 auto;
    padding: 0 $spacing-xl;
    transform: translateX(-250px);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: $spacing-xl;
    align-items: start;
  }
  
  .sidebar {
    position: sticky;
    top: 70px; // navbar (50px) + 10px top + 10px gap
    display: flex;
    flex-direction: column;
    gap: $spacing-lg;
  }
  
  .main-content {
    min-height: 400px;
  }
  
  // 响应式：小屏改为单列
  @media (max-width: $container-lg) {
    .second-screen-container {
      grid-template-columns: 1fr;
      padding: 0 $spacing-md;
    }
    
    .sidebar {
      position: static;
    }
  }
</style>

<script>
  const btn = document.getElementById('scroll-arrow');
  const target = document.getElementById('second-screen');
  if (btn && target) {
    btn.addEventListener('click', () => {
      target.scrollIntoView({ behavior: 'smooth' });
    });
  }

  // 第二屏组件入场动画 - IntersectionObserver
  const observerCallback: IntersectionObserverCallback = (entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        // 支持延迟入场
        const delay = parseInt(el.dataset.enterDelay || '0', 10);
        setTimeout(() => {
          el.classList.add('visible');
        }, delay);
      }
    });
  };

  const observer = new IntersectionObserver(observerCallback, {
    threshold: 0.15,
    rootMargin: '0px 0px -40px 0px',
  });

  // 观察所有需要入场动画的元素
  const profileCard = document.getElementById('profile-card');
  if (profileCard) observer.observe(profileCard);
</script>
