# ====================================
# YukiLog Backend 配置示例
# ====================================
# 复制此文件为 .env 并填入实际配置

# ----------------
# 数据库配置
# ----------------
DATABASE_URL=postgresql://username:password@localhost:5432/yukilog

# ----------------
# 服务器配置
# ----------------
SERVER_HOST=127.0.0.1
SERVER_PORT=3000

# ----------------
# JWT 配置
# ----------------
# 请使用随机生成的强密钥（至少 32 字节）
# 生成命令: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-this-in-production-use-openssl-rand

# JWT 过期时间（秒）
# 86400 = 24小时
# 604800 = 7天
JWT_EXPIRES_IN=604800

# ----------------
# 管理员凭据
# ----------------
ADMIN_USERNAME=admin

# 管理员密码哈希 (使用 Argon2)
# 生成方法: cargo run --bin hash_password -- your_password
# 下面是示例哈希（对应密码 "password123"），生产环境请务必更换！
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$aG9ua0tyRWRRd0FCdA$TLn7Jz7dKzD9XZVhQJ5R5A

# ----------------
# CORS 配置（可选）
# ----------------
# 允许的前端域名，多个用逗号分隔
# 留空表示允许所有域名（开发环境）
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# ----------------
# 日志级别
# ----------------
# trace, debug, info, warn, error
RUST_LOG=info
