# ==================== 服务器配置 ====================

# 监听地址
# - 开发环境: 127.0.0.1 (仅本地访问)
# - 生产环境: 0.0.0.0 (允许外部访问)
SERVER__HOST=127.0.0.1

# 监听端口
SERVER__PORT=3000

# ==================== 数据库配置 ====================

# 数据库连接 URL
# 格式: postgres://用户名:密码@主机:端口/数据库名
DATABASE__URL=postgres://yukilog:password@localhost:5432/yukilog

# 连接池配置
DATABASE__MAX_CONNECTIONS=10
DATABASE__MIN_CONNECTIONS=2
DATABASE__CONNECT_TIMEOUT=30

# 是否启用 SQL 日志（开发环境建议开启）
DATABASE__ENABLE_LOGGING=true

# ==================== JWT 配置 ====================

# JWT 签名密钥（必须设置！）
# 生成方式: openssl rand -base64 32
# ⚠️ 生产环境务必使用强随机字符串，不要使用下面的示例值
JWT__SECRET=your-secret-key-change-me-in-production

# Access Token 有效期（秒）
# 默认 900 秒 = 15 分钟
JWT__ACCESS_TOKEN_EXPIRES=900

# Refresh Token 有效期（秒）
# 默认 604800 秒 = 7 天
JWT__REFRESH_TOKEN_EXPIRES=604800
